--- hand-completed/05_c-linux-file-utils_gQRmSlcTq9c/src/mkdir.c	2026-11-11 00:34:12.337265200 -0800
+++ hand-remade/05_c-linux-file-utils_gQRmSlcTq9c//src/mkdir.c	2026-11-11 00:58:27.538597200 -0800
@@ -1,15 +1,48 @@
 #include <stdio.h>
+#include <string.h>
+#include <errno.h>
 #include <sys/stat.h>
 
+// mkdir that is ok when dir already there
+int make(const char *path) {
+  if (mkdir(path, 0777) == 0)
+    return 0;
+
+  struct stat st;
+  if (errno == EEXIST && stat(path, &st) == 0 && S_ISDIR(st.st_mode))
+    return 0;
+  return 1;
+}
+
+// -p: make each parent first, "a/b/c" -> "a", "a/b", "a/b/c"
+int make_parents(char *path) {
+  for (char *p = path + 1; *p; p++) {
+    if (*p != '/')
+      continue;
+    *p = '\0';
+    int err = make(path);
+    *p = '/';
+    if (err)
+      return 1;
+  }
+  return make(path);
+}
+
 int main(int argc, char *argv[]) {
-  if (argc == 1) {
-    printf("Usage: mkdir [path]...\n");
+  int i = 1, parents = 0;
+  if (argc > 1 && strcmp(argv[1], "-p") == 0) {
+    parents = 1;
+    i = 2;
+  }
+
+  if (i == argc) {
+    printf("Usage: mkdir [-p] [path]...\n");
     return 0;
   }
 
-  for (int i = 1; i < argc; i++) {
-    const char *path = argv[i];
-    if (mkdir(path, 0777)) {
+  for (; i < argc; i++) {
+    char *path = argv[i];
+    if (parents ? make_parents(path) : mkdir(path, 0777)) {
       perror(path);
       return 1;
     }
