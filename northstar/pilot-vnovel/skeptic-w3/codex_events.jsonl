5c\\ub2e4.\r\n20: const CANCEL_SENTINEL: &str = \"__DIST_DOWNLOAD_CANCELLED__\";\r\n21: \r\n22: /// \\uc9c4\\ud589 \\uc911\\uc778 \\ub2e4\\uc6b4\\ub85c\\ub4dc\\uc758 \\ucde8\\uc18c \\ud50c\\ub798\\uadf8 \\ub808\\uc9c0\\uc2a4\\ud2b8\\ub9ac(\\ud1a0\\ud070 \\u2192 \\ud50c\\ub798\\uadf8).\r\n23: /// \\ub2e4\\uc6b4\\ub85c\\ub4dc task\\ub294 `dist_host`\\uac00 spawn\\ud558\\ubbc0\\ub85c, \\ucde8\\uc18c \\ucee4\\ub9e8\\ub4dc\\uac00 \\ud1a0\\ud070\\uc73c\\ub85c \\ucc3e\\uc544 \\uc2e0\\ud638\\ud560 \\uc218 \\uc788\\uac8c\r\n24: /// \\ud55c \\uacf3\\uc5d0 \\ubaa8\\uc740\\ub2e4.\r\n25: static CANCELLERS: LazyLock<std::sync::Mutex<HashMap<String, Arc<AtomicBool>>>> =\r\n26:     LazyLock::new(|| std::sync::Mutex::new(HashMap::new()));\r\n27: \r\n28: /// \\ud1a0\\ud070\\uc5d0 \\ub300\\ud55c \\ucde8\\uc18c \\ud50c\\ub798\\uadf8\\ub97c \\ub9cc\\ub4e4\\uc5b4 \\ub4f1\\ub85d\\ud558\\uace0 \\ub3cc\\ub824\\uc900\\ub2e4.\r\n29: pub fn register_cancel(token: &str) -> Arc<AtomicBool> {\r\n30:     let flag = Arc::new(AtomicBool::new(false));\r\n31:     if let Ok(mut map) = CANCELLERS.lock() {\r\n32:         map.insert(token.to_string(), flag.clone());\r\n33:     }\r\n34:     flag\r\n35: }\r\n36: \r\n37: /// \\ud574\\ub2f9 \\ud1a0\\ud070\\uc758 \\ub2e4\\uc6b4\\ub85c\\ub4dc\\uc5d0 \\ucde8\\uc18c\\ub97c \\uc2e0\\ud638\\ud55c\\ub2e4. \\ub4f1\\ub85d\\ub41c \\uac8c \\uc788\\uc73c\\uba74 true.\r\n38: pub fn request_cancel(token: &str) -> bool {\r\n39:     if let Ok(map) = CANCELLERS.lock() {\r\n40:         if let Some(flag) = map.get(token) {\r\n41:             flag.store(true, Ordering::SeqCst);\r\n42:             return true;\r\n43:         }\r\n44:     }\r\n45:     false\r\n46: }\r\n47: \r\n48: /// \\uc644\\ub8cc\\xb7\\uc2e4\\ud328\\xb7\\ucde8\\uc18c\\ub85c \\ub05d\\ub09c \\ud1a0\\ud070\\uc758 \\ud50c\\ub798\\uadf8\\ub97c \\uc81c\\uac70\\ud55c\\ub2e4.\r\n49: pub fn clear_cancel(token: &str) {\r\n50:     if let Ok(mut map) = CANCELLERS.lock() {\r\n51:         map.remove(token);\r\n52:     }\r\n53: }\r\n54: \r\n55: fn cancelled(flag: &AtomicBool) -> bool {\r\n56:     flag.load(Ordering::Relaxed)\r\n57: }\r\n58: \r\n59: const CONNECTIONS: usize = 8;\r\n60: const SEGMENTS_PER_CONNECTION: usize = 2;\r\n61: const MAX_RETRIES: usize = 4;\r\n62: const PROGRESS_EMIT_INTERVAL: Duration = Duration::from_millis(250);\r\n63: const RESUME_CHECKPOINT_BYTES: u64 = 1024 * 1024;\r\n64: const USER_AGENT: &str = \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 \\\\\r\n65:      (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36\";\r\n66: \r\n67: #[derive(Debug, Clone)]\r\n68: pub struct DownloadRequest {\r\n69:     pub url: String,\r\n70:     pub destination: PathBuf,\r\n71:     pub cookie_header: Option<String>,\r\n72:     pub referer: Option<String>,\r\n73: }\r\n74: \r\n75: #[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize)]\r\n76: #[serde(rename_all = \"lowercase\")]\r\n77: pub enum DownloadMode {\r\n78:     Segmented,\r\n79:     Single,\r\n80: }\r\n81: \r\n82: #[derive(Debug, Clone, Copy)]\r\n83: pub struct DownloadProgress {\r\n84:     pub received: u64,\r\n85:     pub total: Option<u64>,\r\n86:     pub mode: DownloadMode,\r\n87: }\r\n88: \r\n89: #[derive(Debug, Serialize, Deserialize)]\r\n90: struct ResumeMeta {\r\n91:     version: u8,\r\n92:     total: u64,\r\n93:     segment_count: usize,\r\n94: }\r\n95: \r\n96: struct ProgressEmitter {\r\n97:     received: Arc<AtomicU64>,\r\n98:     total: Option<u64>,\r\n99:     mode: DownloadMode,\r\n100:     last_emit_ms: AtomicU64,\r\n101:     started: Instant,\r\n102:     callback: Arc<dyn Fn(DownloadProgress) + Send + Sync>,\r\n103: }\r\n104: \r\n105: impl ProgressEmitter {\r\n106:     fn new(\r\n107:         received: Arc<AtomicU64>,\r\n108:         total: Option<u64>,\r\n109:         mode: DownloadMode,\r\n110:         callback: Arc<dyn Fn(DownloadProgress) + Send + Sync>,\r\n111:     ) -> Self {\r\n112:         Self {\r\n113:             received,\r\n114:             total,\r\n115:             mode,\r\n116: