e8\\uc77c \\uc2a4\\ud2b8\\ub9bc\\uc740 \\uc7ac\\uac1c \\ubd88\\uac00.\r\n5: //! Cost: \\uccad\\ud06c\\ub9c8\\ub2e4 mutex \\ud558\\ub098(\\uae30\\ub85d+\\uc9c4\\ud589 \\uac31\\uc2e0), 1 MiB\\ub9c8\\ub2e4 \\uc0c1\\ud0dc \\ud30c\\uc77c \\uc81c\\uc790\\ub9ac \\ub36e\\uc5b4\\uc4f0\\uae30. \\ub290\\ub9b0 \\uc5f0\\uacb0\\uc740 \\ub05d\\uc5d0\\uc11c \\ub0a8\\uc740 \\uad6c\\uac04\\uc744 \\ube48 \\uc5f0\\uacb0\\uc5d0 \\ub118\\uaca8(steal) \\ubcf4\\uc644\\ud558\\ub418 \\ubc84\\ub824\\uc9c0\\ub294 \\uc804\\uc1a1 \\uc911 \\ubc14\\uc774\\ud2b8\\uac00 \\uc788\\ub2e4.\r\n6: \r\n7: use reqwest::header::{ACCEPT_ENCODING, CONTENT_RANGE, COOKIE, RANGE, REFERER};\r\n8: use reqwest::{Client, RequestBuilder, StatusCode};\r\n9: use serde::Serialize;\r\n10: use std::collections::HashMap;\r\n11: use std::io::{Seek, SeekFrom, Write};\r\n12: use std::path::{Path, PathBuf};\r\n13: use std::sync::atomic::{AtomicBool, Ordering};\r\n14: use std::sync::{Arc, LazyLock, Mutex, MutexGuard, PoisonError};\r\n15: use std::time::{Duration, Instant};\r\n16: use tokio::task::JoinSet;\r\n17: \r\n18: const CONNECTIONS: usize = 8; // D3: \\ub3d9\\uc2dc \\uc5f0\\uacb0 \\uc0c1\\ud55c\r\n19: const MAX_TRIES: usize = 4; // D6: \\uad6c\\uac04\\ub2f9 \\uc2dc\\ub3c4 \\ud69f\\uc218 (\\ub300\\uae30 0.5s, 1s, 1.5s)\r\n20: const PROGRESS_EVERY: Duration = Duration::from_millis(250); // D8\r\n21: const CHECKPOINT_BYTES: u64 = 1024 * 1024; // D4: \\uc0c1\\ud0dc \\uae30\\ub85d \\uac04\\uaca9 = \\uc7ac\\uc218\\uc2e0 \\uc0c1\\ud55c\r\n22: const MIN_STEAL: u64 = 128 * 1024; // \\ub0a8\\uc740 \\uad6c\\uac04\\uc774 \\uc774 \\ub450 \\ubc30 \\ubbf8\\ub9cc\\uc774\\uba74 \\ucabc\\uac1c\\uc9c0 \\uc54a\\ub294\\ub2e4\r\n23: const STATE_BYTES: usize = 4096; // \\uc0c1\\ud0dc \\ud30c\\uc77c\\uc740 \\ud56d\\uc0c1 \\uc774 \\ud06c\\uae30\\ub85c \\ub36e\\uc5b4\\uc368 \\ub0a1\\uc740 \\uaf2c\\ub9ac\\uac00 \\ub0a8\\uc9c0 \\uc54a\\ub294\\ub2e4\r\n24: const CANCELLED: &str = \"\\ucde8\\uc18c\\ub428\";\r\n25: const USER_AGENT: &str = \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 \\\\\r\n26:      (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36\";\r\n27: \r\n28: #[derive(Debug, Clone)]\r\n29: pub struct DownloadRequest {\r\n30:     pub url: String,\r\n31:     pub destination: PathBuf,\r\n32:     pub cookie_header: Option<String>,\r\n33:     pub referer: Option<String>,\r\n34: }\r\n35: \r\n36: #[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize)]\r\n37: #[serde(rename_all = \"lowercase\")]\r\n38: pub enum DownloadMode {\r\n39:     Segmented,\r\n40:     Single,\r\n41: }\r\n42: \r\n43: #[derive(Debug, Clone, Copy)]\r\n44: pub struct DownloadProgress {\r\n45:     pub received: u64,\r\n46:     pub total: Option<u64>,\r\n47:     pub mode: DownloadMode,\r\n48: }\r\n49: \r\n50: // D7: \\ud1a0\\ud070 \\u2192 \\ucde8\\uc18c \\ud50c\\ub798\\uadf8. dist_host\\uac00 spawn\\ud55c task\\ub97c \\ucde8\\uc18c \\ucee4\\ub9e8\\ub4dc\\uac00 \\ud1a0\\ud070\\uc73c\\ub85c \\ucc3e\\ub294\\ub2e4.\r\n51: static CANCELLERS: LazyLock<Mutex<HashMap<String, Arc<AtomicBool>>>> = LazyLock::new(Default::default);\r\n52: \r\n53: fn registry() -> MutexGuard<'static, HashMap<String, Arc<AtomicBool>>> {\r\n54:     CANCELLERS.lock().unwrap_or_else(PoisonError::into_inner)\r\n55: }\r\n56: \r\n57: pub fn register_cancel(token: &str) -> Arc<AtomicBool> {\r\n58:     let flag = Arc::new(AtomicBool::new(false));\r\n59:     registry().insert(token.to_string(), flag.clone());\r\n60:     flag\r\n61: }\r\n62: \r\n63: pub fn request_cancel(token: &str) -> bool {\r\n64:     registry().get(token).map(|f| f.store(true, Ordering::SeqCst)).is_some()\r\n65: }\r\n66: \r\n67: pub fn clear_cancel(token: &str) {\r\n68:     registry().remove(token);\r\n69: }\r\n70: \r\n71: /// D9: \\ubaa8\\ub4e0 \\uc694\\uccad\\uc758 \\uacf5\\ud1b5 \\ud5e4\\ub354. identity\\uac00 \\uc544\\ub2c8\\uba74 \\ubc14\\uc774\\ud2b8 \\uc624\\ud504\\uc14b\\uc774 \\ud30c\\uc77c \\uc624\\ud504\\uc14b\\uacfc \\ub2ec\\ub77c\\uc9c4\\ub2e4.\r\n72: fn get(client: &Client, req: &DownloadRequest) -> RequestBuilder {\r\n73:     let mut b = client.get(&req.url).header(ACCEPT_ENCODING, \"identity\");\r\n74:     if let Some(v) = req.cookie_header.as_deref().filter(|v| !v.is_empty()) {\r\n75:         b = b.header(COOKIE, v);\r\n76:     }\r\n77:     if let Some(v) = req.referer.as_deref().filter(|v| !v.is_empty()) {\r\n78:         b = b.header(REFERER, v);\r\n79:     }\r\n80:     b\r\n81: }\r\n82: \r\n83: fn side(dest: &Path, suffix: &str) -> PathBuf {\r\n84:     let mut s = dest.as_os_str().to_owned();\r\n85:     s.push(suffix);\r\n86:     s.into()\r\n87: }\r\n88: \r\n89: type Span = (u64, u64); // [start, end)\r\n90: \r\n91: /// \\uc2a4\\ucf00\\uc904\\ub9c1 \\uc0c1\\ud0dc \\uc804\\ubd80: \\ubbf8\\ubc30\\uc815 \\uad6c\\uac04, \\uc5f0\\uacb0\\ubcc4 \\uc9c4\\ud589 \\uc911 \\uad6c\\uac04(start\\uac00 \\uace7 \\uc7ac\\uac1c \\uc624\\ud504\\uc14b), \\ubc1b\\uc740 \\ucd1d\\ub7c9.\r\n92: struct Shared {\r\n93:     todo: Vec<Span>,\r\n94:     slots: Vec<Span>,\r\n95:     state: std::fs::File,\r\n96:     done: u64,\r\n97:     last_ckpt: u64,\r\n98:     last_emit: Instant,\r\n99: }\r\n100: \r\n101: impl Shared {\r\n102:     /// \\uc5f0\\uacb0 `slot`\\uc5d0 \\uad6c\\uac04\\uc744 \\ubc30\\uc815\\ud55c\\ub2e4: \\ubbf8\\ubc30\\uc815 \\uad6c\\uac04 \\uc6b0\\uc120, \\uc5c6\\uc73c\\uba74 \\uac00\\uc7a5 \\ub9ce\\uc774 \\ub0a8\\uc740 \\uc5f0\\uacb0\\uc758 \\ub4a4 \\uc808\\ubc18\\uc744\r\n103:     /// \\uac00\\uc838\\uc628\\ub2e4(\\ub290\\ub9b0 \\uc5f0\\uacb0\\uc744 \\ube60\\ub978 \\uc5f0\\uacb0\\uc774 \\ub3d5\\ub294\\ub2e4). \\uc904 \\uac8c \\uc5c6\\uc73c\\uba74 false.\r\n104:     fn claim(&mut self, slot: usize) -> bool {\r\n105:         let span = self.todo.pop().or_else(|| {\r\n106:             let (v, (pos, end)) =\r\n107:                 self.slots.iter().copied().enumerate().max_by_key(|(_, (p, e))| e - p)?;\r\n108:             let rest = end - pos;\r\n109:             if rest < 2 * MIN_STEAL {\r\n110:                 return None;\r\n111:             }\r\n112:             self.slots[v].1 = pos + rest / 2;\r\n113:             Some((pos + rest / 2, end))\r\n114:         });\r\n115:         self.slots[slot] = span.unwrap_or((0, 0));\r\n116:         span.is_some()\r\n117:     }\r\n118: \r\n119:     /// D4/D5: \\ub0a8\\uc740 \\uad6c\\uac04\\uc744 \\uc0c1\\ud0dc \\ud30c\\uc77c\\uc5d0 \\uc81c\\uc790\\ub9ac\\ub85c \\uc4f4\\ub2e4. \\ub05d \\ud45c\\uc2dd(`end`)\\uc774 \\uc5c6\\ub294 \\ud30c\\uc77c\\uc740 \\uc77d\\uc744 \\ub54c \\ubc84\\ub824\\uc9c4\\ub2e4.\r\n120:     /// \\uc0c1\\ud0dc\\ub294 \\ud56d\\uc0c1 \\uc2e4\\uc81c\\ubcf4\\ub2e4 \\ub35c \\uc9c4\\ud589\\ub41c \\ucabd(\\ub0a8\\uc740 \\uad6c\\uac04\\uc758 \\uc0c1\\uc704 \\uc9d1\\ud569)\\uc774\\ub77c \\ub0a1\\uc740 \\uae30\\ub85d\\ub3c4 \\uc548\\uc804\\ud558\\ub2e4. \\uc2e4\\ud328\\ud574\\ub3c4 \\uc7ac\\uac1c\\ub9cc \\uc190\\ud574.\r\n121:     fn checkpoint(&mut self, total: u64) {\r\n122:         let mut text = format!(\"{total}\\\\n\");\r\n123:         for (a, b) in self.remaining() {\r\n124:             text += &format!(\"{a} {b}\\\\n\");\r\n125:         }\r\n126:         let text = format!(\"{:<w$}\", text + \"end\\\\n\", w = STATE_BYTES);\r\n127:         if text.len() == STATE_BYTES {\r\n128:             let _ = self.state.seek(SeekFrom::Start(0)).and_then(|_| self.state.write_all(text.as_bytes()));\r\n129:         }\r\n130:     }\r\n131: \r\n132:     /// \\uc544\\uc9c1 \\uc548 \\ubc1b\\uc740 \\ubaa8\\ub4e0 \\uad6c\\uac04 (D4 \\uc0c1\\ud0dc\\uc774\\uc790 \\uc644\\ub8cc \\ud310\\uc815 \\uadfc\\uac70).\r\n133:     fn remaining(&self) -> Vec<Span> {\r\n134:         self.todo.iter().chain(&self.slots).copied().filter(|(a, b)| a < b).collect()\r\n135:     }\r\n136: }\r\n137: \r\n138: struct Ctx {\r\n139:     client: Client,\r\n140:     req: DownloadRequest,\r\n141:     total: u64,\r\n142:     part: PathBuf,\r\n143:     cancel: Arc<AtomicBool>,\r\n144:     on_progress: Box<dyn Fn(DownloadProgress) + Send + Sync>,\r\n145:     sh: Mutex<Shared>,\r\n146: }\r\n147: \r\n148: enum Fail