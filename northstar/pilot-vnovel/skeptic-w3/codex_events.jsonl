nge\\ub098 \\uc694\\uccad\\ubcf4\\ub2e4 \\uae34 \\ubcf8\\ubb38\\uc740 \\uce58\\uba85\\uc801.\r\n191:     async fn stream(&self, slot: usize, file: &mut std::fs::File, pos: u64, end: u64) -> Result<(), Fail> {\r\n192:         let mut resp = get(&self.client, &self.req)\r\n193:             .header(RANGE, format!(\"bytes={pos}-{}\", end - 1))\r\n194:             .send()\r\n195:             .await\r\n196:             .map_err(|e| Fail::Retry(format!(\"\\uad6c\\uac04 \\uc5f0\\uacb0 \\uc2e4\\ud328: {e}\")))?;\r\n197:         if resp.status() != StatusCode::PARTIAL_CONTENT {\r\n198:             return Err(Fail::Retry(format!(\"Range \\uc751\\ub2f5\\uc774 \\uc544\\ub2d9\\ub2c8\\ub2e4: HTTP {}\", resp.status())));\r\n199:         }\r\n200:         let want = format!(\"bytes {pos}-\");\r\n201:         let range = resp.headers().get(CONTENT_RANGE).and_then(|v| v.to_str().ok());\r\n202:         if !range.is_some_and(|v| v.starts_with(&want)) {\r\n203:             return Err(Fail::Fatal(\"Content-Range\\uac00 \\uc694\\uccad \\ubc94\\uc704\\uc640 \\ub2e4\\ub985\\ub2c8\\ub2e4\".into()));\r\n204:         }\r\n205:         file.seek(SeekFrom::Start(pos)).map_err(|e| Fail::Fatal(format!(\"seek \\uc2e4\\ud328: {e}\")))?;\r\n206:         let mut at = pos;\r\n207:         while let Some(chunk) = resp.chunk().await.map_err(|e| Fail::Retry(format!(\"\\uc218\\uc2e0 \\uc2e4\\ud328: {e}\")))? {\r\n208:             if self.cancel.load(Ordering::Relaxed) {\r\n209:                 return Err(Fail::Fatal(CANCELLED.into()));\r\n210:             }\r\n211:             at += chunk.len() as u64;\r\n212:             if at > end {\r\n213:                 return Err(Fail::Fatal(\"\\uc751\\ub2f5\\uc774 \\uc694\\uccad\\ud55c \\ud06c\\uae30\\ub97c \\ucd08\\uacfc\\ud588\\uc2b5\\ub2c8\\ub2e4\".into()));\r\n214:             }\r\n215:             if self.accept(slot, file, &chunk).map_err(Fail::Fatal)? {\r\n216:                 return Ok(());\r\n217:             }\r\n218:         }\r\n219:         Err(Fail::Retry(\"\\uc751\\ub2f5\\uc774 \\uc694\\uccad\\ud55c \\ud06c\\uae30\\ubcf4\\ub2e4 \\uc9e7\\uc2b5\\ub2c8\\ub2e4\".into()))\r\n220:     }\r\n221: \r\n222:     /// D6: \\ubc30\\uc815\\ub41c \\uad6c\\uac04\\uc744 \\ub05d\\uae4c\\uc9c0 \\ubc1b\\ub294\\ub2e4. \\uc7ac\\uc2dc\\ub3c4\\ub294 \\ubc1b\\uc740 \\uacf3\\ubd80\\ud130 \\uc774\\uc5b4 \\uac04\\ub2e4.\r\n223:     async fn fetch(&self, slot: usize) -> Result<(), String> {\r\n224:         let mut file = std::fs::OpenOptions::new()\r\n225:             .write(true)\r\n226:             .open(&self.part)\r\n227:             .map_err(|e| format!(\"\\uc784\\uc2dc \\ud30c\\uc77c \\uc5f4\\uae30 \\uc2e4\\ud328: {e}\"))?;\r\n228:         let mut last = String::new();\r\n229:         for attempt in 0..MAX_TRIES {\r\n230:             if attempt > 0 {\r\n231:                 tokio::time::sleep(Duration::from_millis(500 * attempt as u64)).await;\r\n232:             }\r\n233:             if self.cancel.load(Ordering::Relaxed) {\r\n234:                 return Err(CANCELLED.into());\r\n235:             }\r\n236:             let (pos, end) = self.lock().slots[slot];\r\n237:             if pos >= end {\r\n238:                 return Ok(());\r\n239:             }\r\n240:             match self.stream(slot, &mut file, pos, end).await {\r\n241:                 Ok(()) => return Ok(()),\r\n242:                 Err(Fail::Fatal(e)) => return Err(e),\r\n243:                 Err(Fail::Retry(e)) => last = e,\r\n244:             }\r\n245:         }\r\n246:         Err(format!(\"\\ub2e4\\uc6b4\\ub85c\\ub4dc \\uc2e4\\ud328(\\uc7ac\\uc2dc\\ub3c4 {MAX_TRIES}\\ud68c \\ucd08\\uacfc): {last}\"))\r\n247:     }\r\n248: }\r\n249: \r\n250: /// D4: \\uc800\\uc7a5\\ub41c \\ub0a8\\uc740 \\uad6c\\uac04 \\ubaa9\\ub85d. \\ud06c\\uae30\\uac00 \\ub2e4\\ub974\\uac70\\ub098 \\ud615\\uc2dd/\\ubc94\\uc704\\uac00 \\uc774\\uc0c1\\ud558\\uba74 None(\\u2192 \\ucc98\\uc74c\\ubd80\\ud130).\r\n251: fn load_state(state: &Path, part: &Path, total: u64) -> Option<Vec<Span>> {\r\n252:     let text = std::fs::read_to_string(state).ok()?;\r\n253:     if std::fs::metadata(part).ok()?.len() != total {\r\n254:         return None;\r\n255:     }\r\n256:     let mut lines = text.split_once(\"end\\\\n\")?.0.lines();\r\n257:     if lines.next()?.parse::<u64>().ok()? != total {\r\n258:         return None;\r\n259:     }\r\n260:     lines\r\n261:         .map(|l| {\r\n262:             let (a, b) = l.split_once(' ')?;\r\n263:             let (a, b) = (a.parse().ok()?, b.parse().ok()?);\r\n264:             (a < b && b <= total).then_some((a, b))\r\n265:         })\r\n266:         .collect()\r\n267: }\r\n268: \r\n269: /// D2: `bytes=0-0` \\ud504\\ub85c\\ube0c. 206 + \\uc54c\\ub824\\uc9c4 \\ucd1d\\ub7c9\\uc774\\uba74 Some(total)(\\ubd84\\ud560), \\uadf8 \\uc678 \\uc131\\uacf5\\uc774\\uba74 None(\\ub2e8\\uc77c \\uc2a4\\ud2b8\\ub9bc).\r\n270: async fn probe(client: &Client, req: &DownloadRequest) -> Result<Option<u64>, String> {\r\n271:     let resp = get(client, req)\r\n272:         .header(RANGE, \"bytes=0-0\")\r\n273:         .send()\r\n274:         .await\r\n275:         .map_err(|e| format!(\"\\ub2e4\\uc6b4\\ub85c\\ub4dc \\uc11c\\ubc84 \\uc5f0\\uacb0 \\uc2e4\\ud328: {e}\"))?;\r\n276:     match resp.status() {\r\n277:         StatusCode::PARTIAL_CONTENT => Ok(resp\r\n278:             .headers()\r\n279:             .get(CONTENT_RANGE)\r\n280:             .and_then(|v| v.to_str().ok())\r\n281:             .and_then(|v| v.rsplit_once('/')?.1.parse().ok())\r\n282:             .filter(|n| *n > 0)),\r\n283:         s if s.is_success() => Ok(None),\r\n284:         s => Err(format!(\"\\ub2e4\\uc6b4\\ub85c\\ub4dc \\uc11c\\ubc84\\uac00 \\uc694\\uccad\\uc744 \\uac70\\ubd80\\ud588\\uc2b5\\ub2c8\\ub2e4: HTTP {s}\")),\r\n285:     }\r\n286: }\r\n287: \r\n288: async fn segmented(\r\n289:     client: Client,\r\n290:     req: DownloadRequest,\r\n291:     total: u64,\r\n292:     cancel: Arc<AtomicBool>,\r\n293:     on_progress: Box<dyn Fn(DownloadProgress) + Send + Sync>,\r\n294: ) -> Result<(), String> {\r\n295:     let part = side(&req.destination, \".download\");\r\n296:     let state_path = side(&req.destination, \".download.state\");\r\n297:     let todo = match load_state(&state_path, &part, total) {\r\n298:         Some(todo) => todo,\r\n299:         None => {\r\n300:             let file = std::fs::File::create(&part).map_err(|e| format!(\"\\uc784\\uc2dc \\ud30c\\uc77c \\uc0dd\\uc131 \\uc2e4\\ud328: {e}\"))?;\r\n301:             file.set_len(total).map_err(|e| format!(\"\\uc784\\uc2dc \\ud30c\\uc77c \\ud06c\\uae30 \\uc124\\uc815 \\uc2e4\\ud328: {e}\"))?;\r\n302:             let n = CONNECTIONS as u64;\r\n303:             (0..n).map(|i| (total * i / n, total * (i + 1) / n)).filter(|(a, b)| a < b).collect()\r\n304:         }\r\n305:     };\r\n306:     let left: u64 = todo.iter().map(|(a, b)| b - a).sum();\r\n307:     let done = total.saturating_sub(left);\r\n308:     let state = std::fs::OpenOptions::new()\r\n309:         .write(true)\r\n310:         .create(true)\r\n311:         .truncate(false)\r\n312:         .open(&state_path)\r\n313:         .map_err(|e| format!(\"\\uc0c1\\ud0dc \\ud30c\\uc77c \\uc5f4\\uae30 \\uc2e4\\ud328: {e}\"))?;\r\n314:     let slots = vec![(0, 0); CONNECTIONS];\r\n315:     let sh = Shared { todo, slots, state, done, last_ckpt: done, last_emit: Instant::now() };\r\n316:     let ctx = Arc::new(Ctx { client, req, total, part, cancel, on_progress, sh: Mutex::new(sh) });\r\n317:     ctx.emit(done);\r\n318:     ctx.lock().checkpoint(total);\r\n319: \r\n320:     let mut workers = JoinSet::new();\r\n321:     for slot in 0..CONNECTIONS {\r\n322:         let ctx = ctx.clone();\r\n323:         workers.spawn(async move {\r\n324:             while ctx.lock().claim(slot) {\r\n325:                 ctx.fetch(slot).await?;\r\n326:             }\r\n327:             Ok::<(), String>(())\r\n328:         });\r\n329:     }\r\n330:     let mut result = Ok(());\r\n331:     while let Some(joined) = workers.join_next().await {\r\n3