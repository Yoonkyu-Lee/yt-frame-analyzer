t!(\"?�료 ?�일 ?�동 ?�패: {e}\"))\r\n 382:     }\r\n 383:     .await;\r\n 384:     if copied.is_err() {\r\n 385:         let _ = std::fs::remove_file(&part);\r\n 386:     }\r\n 387:     copied\r\n 388: }\r\n 389: \r\n 390: /// `Ok(Some(path))` ?�료, `Ok(None)` 취소(?�개 ?�태 ?��?), `Err` ?�패(D10: ?�국??메시지).\r\n 391: pub async fn download<F>(\r\n 392:     request: DownloadRequest,\r\n 393:     cancel: Arc<AtomicBool>,\r\n 394:     on_progress: F,\r\n 395: ) -> Result<Option<PathBuf>, String>\r\n 396: where\r\n 397:     F: Fn(DownloadProgress) + Send + Sync + 'static,\r\n 398: {\r\n 399:     let client = Client::builder()\r\n 400:         .connect_timeout(Duration::from_secs(20))\r\n 401:         .redirect(reqwest::redirect::Policy::limited(10))\r\n 402:         .referer(false) // D9: 리디?�트 ?�에???�출?��? 준 Referer�?그�?�?보낸??\r\n 403:         .user_agent(USER_AGENT)\r\n 404:         .build()\r\n 405:         .map_err(|e| format!(\"HTTP ?�라?�언???�성 ?�패: {e}\"))?;\r\n 406:     let dest = request.destination.clone();\r\n 407:     let on_progress = Box::new(on_progress);\r\n 408:     let flag = cancel.clone();\r\n 409:     let result = match probe(&client, &request).await? {\r\n 410:         Some(total) => segmented(client, request, total, cancel, on_progress).await,\r\n 411:         None => single(client, request, cancel, on_progress).await,\r\n 412:     };\r\n 413:     match result {\r\n 414:         Ok(()) => {\r\n 415:             let _ = std::fs::remove_file(side(&dest, \".download.state\")); // D1: ?�공 ???�여�??�음\r\n 416:             Ok(Some(dest))\r\n 417:         }\r\n 418:         Err(_) if flag.load(Ordering::Relaxed) => Ok(None),\r\n 419:         Err(e) => Err(e),\r\n 420:     }\r\n 421: }\r\n 422: \r\n 423: #[cfg(test)]\r\n 424: mod tests {\r\n 425:     use super::*;\r\n 426:     use std::io::Read;\r\n 427:     use std::net::{TcpListener, TcpStream};\r\n 428:     use std::sync::atomic::{AtomicU64, AtomicUsize};\r\n 429: \r\n 430:     /// ?�스???�버 ?�작 ?�위�?(0/false = ?�상).\r\n 431:     #[derive(Clone, Default)]\r\n 432:     struct Opt {\r\n 433:         ignore_range: bool,\r\n 434:         unknown_total: bool,\r\n 435:         status: u16,\r\n 436:         wrong_start: bool,\r\n 437:         extra_byte: bool,\r\n 438:         short_first: usize, // 처음 N개의 본문 ?�답?� ?�반�?보내�??�는??\r\n 439:         delay_ms: u64,      // 본문 ???��?(?�시 ?�결 관찰용)\r\n 440:         chunk_ms: u64,      // 64 KiB마다 ?��?(?�린 ?�송)\r\n 441:     }\r\n 442: \r\n 443:     #[derive(Clone)]\r\n 444:     struct Srv {\r\n 445:         url: String,\r\n 446:         log: Arc<Mutex<Vec<String>>>,\r\n 447:         served: Arc<AtomicU64>,\r\n 448:         peak: Arc<AtomicUsize>,\r\n 449:         active: Arc<AtomicUsize>,\r\n 450:         shorts: Arc<AtomicUsize>,\r\n 451:         data: Arc<Vec<u8>>,\r\n 452:         o: Opt,\r\n 453:     }\r\n 454: \r\n 455:     fn serve(data: Vec<u8>, o: Opt) -> Srv {\r\n 456:         let l = TcpListener::bind(\"127.0.0.1:0\").unwrap();\r\n 457:         let s = Srv {\r\n 458:             url: format!(\"http://{}\", l.local_addr().unwrap()),\r\n 459:             log: Default::default(),\r\n 460:             served: Default::default(),\r\n 461:             peak: Default::default(),\r\n 462:             active: Default::default(),\r\n 463:             shorts: Arc::new(AtomicUsize::new(o.short_first)),\r\n 464:             data: Arc::new(data),\r\n 465:             o,\r\n 466:         };\r\n 467:         let srv = s.clone();\r\n 468:         std::thread::spawn(move || {\r\n 469:             for conn in l.incoming().flatten() {\r\n 470:                 let srv = srv.clone();\r\n 471:                 std::thread::spawn(move || {\r\n 472:                     let _ = handle(&srv, conn);\r\n 473:                 });\r\n 474:             }\r\n 475:         });\r\n 476:         s\r\n 477:     }\r\n 478: \r\n 479:     fn handle(s: &Srv, mut c: TcpStream) -> std::io::Result<()> {\r\n 480:         let (mut buf, mut tmp) = (Vec::new(), [0u8; 1024]);\r\n 481:         while !buf.windows(4).any(|w| w == b\"\\r\\n\\r\\n\") {\r\n 482:             let n = c.read(&mut tmp)?;\r\n 483:             if n == 0 {\r\n 484:                 return Ok(());\r\n 485:             }\r\n 486:             buf.extend_from_slice(&tmp[..n]);\r\n 487:         }\r\n 488:         let head = String::from_utf8_lossy(&buf).into_owned();\r\n 489:         s.log.lock().unwrap().push(head.clone());\r\n 490:         let range = head\r\n 491:             .lines()\r\n 492:             .find_map(|l| l.to_ascii_lowercase().strip_prefix(\"range: bytes=\").map(str::to_string))\r\n 493:             .and_then(|v| {\r\n 494:                 let (a, b) = v.split_once('-')?;\r\n 495:                 Some((a.trim().parse::<usize>().ok()?, b.trim().parse::<usize>().ok()?))\r\n 496:             });\r\n 497:         if head.starts_with(\"GET /redirect\") {\r\n 498:             return write!(c, \"HTTP/1.1 302 Found\\r\\nLocation: /file.bin\\r\\nContent-Length: 0\\r\\nConnection: close\\r\\n\\r\\n\");\r\n 499:         }\r\n 500:         if s.o.status != 0 {\r\n 501:             return write!(c, \"HTTP/1.1 {} X\\r\\nContent-Length: 0\\r\\nConnection: close\\r\\n\\r\\n\", s.o.status);\r\n 502:         }\r\n 503:         let len = s.data.len();\r\n 504:         let probe = range == Some((0, 0));\r\n 505:         let (status, a, e, cr) = match range {\r\n 506:             Some((a, b)) if !s.o.ignore_range && a < len => {\r\n 507:                 let e = b.min(len - 1);\r\n 508:                 let shown = if s.o.wrong_start && !probe { a + 1 } else { a };\r\n 509:                 let t = if s.o.unknown_total { \"*\".to_string() } else { len.to_string() };\r\n 510:                 (\"206 Partial Content\", a, e, format!(\"Content-Range: bytes {shown}-{e}/{t}\\r\\n\"))\r\n 511:             }\r\n 512:             _ => (\"200 OK\", 0, len.saturating_sub(1), String::new()),\r\n 513:         };\r\n 514:         let mut body = if len == 0 { vec![] } else { s.data[a..=e].to_vec() };\r\n 515:         if s.o.extra_byte && !cr.is_empty() && !probe {\r\n 516:             body.push(0xAB);\r\n 517:         }\r\n 518:         write!(c, \"HTTP/1.1 {status}\\r\\nContent-Length: {}\\r\\n{cr}Connection: close\\r\\n\\r\\n\", body.len())?;\r\n 519:         let cut = !probe && s.shorts.fetch_update(Ordering::SeqCst, Ordering::SeqCst, |n| n.checked_sub(1)).is_ok();\r\n 520:         let limit = if cut { body.len() / 2 } else { body.len() };\r\n 521:         if !probe {\r\n 522:             s.peak.fetch_max(s.active.fetch_add(1, Ordering::SeqCst) + 1, Ordering::SeqCst);\r\n 523:             std::thread::sleep(Duration::from_millis(s.o.delay_ms));\r\n 524:         }\r\n 525:         let sent = (|| {\r\n 526:             for ch in body[..limit].chunks(64 * 1024) {\r\n 527:                 c.write_all(ch)?;\r\n 528:                 s.served.fetch_add(ch.len() as u64, Ordering::SeqCst);\r\n 529:                 std::thread::sleep(Duration::from_millis(s.o.chunk_ms));\r\n 530:             }\r\n 531:             std::io::Result::Ok(())\r\n 532:         })();\r\n 533:         if !probe {\r\n 534:             s.active.fetch_sub(1, Ordering::SeqCst);\r\n 535:         }\r\n 536:         sent\r\n 537:     }\r\n 538: \r\n 539:     fn pattern(n: usize) -> Vec<u8> {\r\n 540:         (0..n).map(|i| (i * 7 % 251) as u8).collect()\r\n 541:     }\r\n 542: \r\n 543:     fn tmp_dir(tag: &str) -> PathBuf {\r\n 544:         let t = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos();\r\n 545:         let dir = std::env::temp_dir().join(format!(\"segdl-{tag}-{}-{t}\", std::process::id()));\r\n 546:         std::fs::create_dir_all(&dir).unwrap();\r\n 547:         dir\r\n 548:     }\r\n 549: \r\n 550:     fn files(dir: &Path) -> Vec<String> {\r\n 551:         let mut v: Vec<String> =\r\n 552:             std::fs::read_dir(dir).unwrap().map(|e| e.unwrap().file_name().to_string_lossy().into_owned()).collect();\r\n 553:         v.sort();\r\n 554:     