.len() / 2 } else { body.len() };\r\n521:         if !probe {\r\n522:             s.peak.fetch_max(s.active.fetch_add(1, Ordering::SeqCst) + 1, Ordering::SeqCst);\r\n523:             std::thread::sleep(Duration::from_millis(s.o.delay_ms));\r\n524:         }\r\n525:         let sent = (|| {\r\n526:             for ch in body[..limit].chunks(64 * 1024) {\r\n527:                 c.write_all(ch)?;\r\n528:                 s.served.fetch_add(ch.len() as u64, Ordering::SeqCst);\r\n529:                 std::thread::sleep(Duration::from_millis(s.o.chunk_ms));\r\n530:             }\r\n531:             std::io::Result::Ok(())\r\n532:         })();\r\n533:         if !probe {\r\n534:             s.active.fetch_sub(1, Ordering::SeqCst);\r\n535:         }\r\n536:         sent\r\n537:     }\r\n538: \r\n539:     fn pattern(n: usize) -> Vec<u8> {\r\n540:         (0..n).map(|i| (i * 7 % 251) as u8).collect()\r\n541:     }\r\n542: \r\n543:     fn tmp_dir(tag: &str) -> PathBuf {\r\n544:         let t = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos();\r\n545:         let dir = std::env::temp_dir().join(format!(\"segdl-{tag}-{}-{t}\", std::process::id()));\r\n546:         std::fs::create_dir_all(&dir).unwrap();\r\n547:         dir\r\n548:     }\r\n549: \r\n550:     fn files(dir: &Path) -> Vec<String> {\r\n551:         let mut v: Vec<String> =\r\n552:             std::fs::read_dir(dir).unwrap().map(|e| e.unwrap().file_name().to_string_lossy().into_owned()).collect();\r\n553:         v.sort();\r\n554:         v\r\n555:     }\r\n556: \r\n557:     fn run(\r\n558:         url: &str,\r\n559:         dest: &Path,\r\n560:         cancel: Arc<AtomicBool>,\r\n561:         cb: impl Fn(DownloadProgress) + Send + Sync + 'static,\r\n562:     ) -> Result<Option<PathBuf>, String> {\r\n563:         let request = DownloadRequest {\r\n564:             url: url.to_string(),\r\n565:             destination: dest.to_path_buf(),\r\n566:             cookie_header: None,\r\n567:             referer: None,\r\n568:         };\r\n569:         let rt = tokio::runtime::Builder::new_multi_thread().worker_threads(4).enable_all().build().unwrap();\r\n570:         rt.block_on(download(request, cancel, cb))\r\n571:     }\r\n572: \r\n573:     fn plain(url: &str, dest: &Path) -> Result<Option<PathBuf>, String> {\r\n574:         run(&format!(\"{url}/file.bin\"), dest, Arc::new(AtomicBool::new(false)), |_| {})\r\n575:     }\r\n576: \r\n577:     // D1: \\uc5b4\\ub5a4 \\ud06c\\uae30\\ub4e0(0 \\ubc14\\uc774\\ud2b8 \\ud3ec\\ud568) \\ubc14\\uc774\\ud2b8\\uac00 \\uac19\\uace0 \\ud3f4\\ub354\\uc5d0 \\ubaa9\\uc801 \\ud30c\\uc77c\\ub9cc \\ub0a8\\ub294\\ub2e4.\r\n578:     #[test]\r\n579:     fn exact_bytes_and_no_leftovers_for_any_size() {\r\n580:         for n in [0usize, 1, 7, 100, 1_000_003] {\r\n581:             let (data, dir) = (pattern(n), tmp_dir(\"size\"));\r\n582:             let dest = dir.join(\"a.bin\");\r\n583:             let s = serve(data.clone(), Opt::default());\r\n584:             assert_eq!(plain(&s.url, &dest).unwrap(), Some(dest.clone()), \"size {n}\");\r\n585:             assert_eq!(std::fs::read(&dest).unwrap(), data, \"size {n}\");\r\n586:             assert_eq!(files(&dir), vec![\"a.bin\"], \"size {n}\");\r\n587:             std::fs::remove_dir_all(dir).ok();\r\n588:         }\r\n589:     }\r\n590: \r\n591:     // D3: \\uc5ec\\ub7ec \\uc5f0\\uacb0\\uc744 \\uc4f0\\ub418 8\\uac1c\\ub97c \\ub118\\uc9c0 \\uc54a\\ub294\\ub2e4.\r\n592:     #[test]\r\n593:     fn uses_several_connections_but_at_most_eight() {\r\n594:         let (dir, s) = (tmp_dir(\"conn\"), serve(pattern(4_000_000), Opt { delay_ms: 80, ..Default::default() }));\r\n595:         plain(&s.url, &dir.join(\"a.bin\")).unwrap();\r\n596:         let peak = s.peak.load(Ordering::SeqCst);\r\n597:         assert!((2..=8).contains(&peak), \"peak {peak}\");\r\n598:         std::fs::remove_dir_all(dir).ok();\r\n599:     }\r\n600: \r\n601:     // D2 + D9: \\uccab \\uc694\\uccad\\uc740 bytes=0-0, \\ubaa8\\ub4e0 \\uc694\\uccad\\uc5d0 identity/\\ucfe0\\ud0a4/\\ub9ac\\ud37c\\ub7ec/\\ud06c\\ub86c UA, \\ub9ac\\ub514\\ub809\\ud2b8\\ub97c \\ub530\\ub77c\\uac04\\ub2e4.\r\n602:     #[test]\r\n603:     fn probe_first_and_every_request_carries_headers() {\r\n604:         let (dir, s) = (tmp_dir(\"hdr\"), serve(pattern(300_000), Opt::default()));\r\n605:         let dest = dir.join(\"a.bin\");\r\n606:         let request = DownloadRequest {\r\n607:             url: format!(\"{}/redirect\", s.url),\r\n608:             destination: dest.clone(),\r\n609:             cookie_header: Some(\"sid=abc\".into()),\r\n610:             referer: Some(\"https://host.example/page\".into()),\r\n611:         };\r\n612:         let rt = tokio::runtime::Runtime::new().unwrap();\r\n613:         let r = rt.block_on(download(request, Arc::new(AtomicBool::new(false)), |_| {}));\r\n614:         assert_eq!(r.unwrap(), Some(dest.clone()));\r\n615:         assert_eq!(std::fs::read(&dest).unwrap(), pattern(300_000));\r\n616:         let log = s.log.lock().unwrap();\r\n617:         assert!(log[0].to_ascii_lowercase().contains(\"range: bytes=0-0\"), \"{}\", log[0]);\r\n618:         for head in log.iter() {\r\n619:             let h = head.to_ascii_lowercase();\r\n620:             assert!(h.contains(\"accept-encoding: identity\"), \"{head}\");\r\n621:             assert!(h.contains(\"cookie: sid=abc\"), \"{head}\");\r\n622:             assert!(h.contains(\"referer: https://host.example/page\"), \"{head}\");\r\n623:             assert!(h.contains(\"user-agent: mozilla/5.0 (windows nt 10.0\") && h.contains(\"chrome/\"), \"{head}\");\r\n624:         }\r\n625:         std::fs::remove_dir_all(dir).ok();\r\n626:     }\r\n627: \r\n628:     // D2: Range \\ubb34\\uc2dc(200)\\uc640 \\ucd1d\\ub7c9 \\ubaa8\\ub984(`*`)\\uc740 \\ub2e8\\uc77c \\uc2a4\\ud2b8\\ub9bc\\uc73c\\ub85c \\ubc1b\\ub294\\ub2e4.\r\n629:     #[test]\r\n630:     fn range_ignored_or_unknown_total_uses_single_stream() {\r\n631:         for o in [Opt { ignore_range: true, ..Default::default() }, Opt { unknown_total: true, ..Default::default() }] {\r\n632:             let (data, dir) = (pattern(100_000), tmp_dir(\"single\"));\r\n633:             let (s, dest) = (serve(data.clone(), o), dir.join(\"a.bin\"));\r\n634:             let modes = Arc::new(Mutex::new(Vec::new()));\r\n635:             let m = modes.clone();\r\n636:             let r = run(&format!(\"{}/file.bin\", s.url), &dest, Arc::new(AtomicBool::new(false)), move |p| {\r\n637:                 m.lock().unwrap().push((p.mode, p.received, p.total))\r\n638:             });\r\n639:             assert_eq!(r.unwrap(), Some(dest.clone()));\r\n640:             assert_eq!(std::fs::read(&dest).unwrap(), data);\r\n641:             let modes = modes.lock().unwrap();\r\n642:             assert!(modes.iter().all(|m| m.0 == DownloadMode::Single));\r\n643:             assert_eq!(modes.last().unwrap().1, 100_000);\r\n644:             assert_eq!(files(&dir), vec![\"a.bin\"]);\r\n645:             std::fs::remove_dir_all(dir).ok();\r\n646:         }\r\n647:     }\r\n648: \r\n649:     // D2 + D10: HTTP \\uc624\\ub958\\ub294 \\ud55c\\uad6d\\uc5b4 Err\\uc774\\uace0 \\ud30c\\uc77c\\uc774 \\ub0a8\\uc9c0 \\uc54a\\ub294\\ub2e4.\r\n650:     #[test]\r\n651:     fn http_error_is_korean_err_and_leaves_nothing() {\r\n652:         let (dir, s) = (tmp_dir(\"http\"), serve(pattern(10), Opt { status: 404, ..Default::default() }));\r\n653:         let err = plain(&s.url, &dir.join(\"a.bin\")).unwrap_err();\r\n654:         assert!(err.contains(\"HTTP 404\") && err.chars().any(|c| ('\\uac00'..='\\ud7a3').contains(&c)), \"{err}\");\r\n655:         assert!(files(&dir).is_empty());\r\n656:         std::fs::remove_dir_all(dir).ok();\r\n657:     }\r\n658: \r\n659:     // D6: \\uc77c\\uc2dc\\uc801 \\ub04a\\uae40\\uc740 \\uc7ac\\uc2dc\\ub3c4\\ub85c \\ubcf5\\uad6c\\ub418\\uace0, \\uacc4\\uc18d \\uc2e4\\ud328\\ud558\\uba74 \\uba87 \\ucd08 \\uc548\\uc5d0 Err\\ub85c \\ub05d\\ub09c\\ub2e4.\r\n660:     #[test]\r\n661:     fn transient_drops_retry_and_persistent_failure_errs_quickly() {\r\n662:         let (data, dir) = (pattern(1_000_000), tmp_dir(\"retry\"));\r\n663:         let s = serve(data.clone(), Opt { short_first: 3, ..Default::default() });\r\n664:         let dest = dir.join(\"a.bin\");\r\n665:         assert_eq!(plain(&s.url, &dest).unwrap(), Some(dest.clone()));\r\n666:         assert_eq!(std::fs::read(&dest).unwrap(), data);\r\n667: \r\n668:         let (dir2, s2) = (tmp_dir(\"retry2\"), serve(data, Opt { short_first: 10_000, ..Default::default() }));\r\n669:         let t = Instant::now();\r\n670:         let err = plain(&s2.url, &dir2.join(\"a.bin\")).unwrap_err();\r\n671:         assert!(t.elapsed() < Duration::from_secs(15), \"{:?}\", t.elapsed());\r\n672:         assert!(!err.is_empty() && !dir2.join(\"a.bin\").exists());\r\n673:         std::fs::remove_dir_all(dir).ok();\r\n674:         std::fs::remove_dir_all(dir2).ok();\r\n675:     }\r\n676: \r\n677:     // D5: \\uc2dc\\uc791\\uc774 \\uc5b4\\uae0b\\ub09c Content-Range / \\ub354 \\uae34 \\ubcf8\\ubb38\\uc740 Err\\uc774\\uac70\\ub098 \\uc62c\\ubc14\\ub978 \\ud30c\\uc77c\\uc774\\uc5b4\\uc57c \\ud558\\uba70 \\ud2c0\\ub9b0 \\ud30c\\uc77c\\uc740 \\uc5c6\\ub2e4.\r\n678:     #[test]\r\n679:     fn wrong_range_or_oversize_never_yields_wrong_file() {\r\n680:         for o in [Opt { wrong_start: true, ..Default::default() }, Opt { extra_byte: true, ..Default::default() }] {\r\n681:             let (data, dir) = (pattern(500_000), tmp_dir(\"bad\"));\r\n682:             let (s, dest) = (serve(data.clone(), o.clone()), dir.join(\"a.bin\"));\r\n683:             let r = plain(&s.url, &dest);\r\n684:             if o.wrong_start {\r\n685:                 assert!(r.is_err(), \"\\uc5b4\\uae0b\\ub09c Content-Range\\ub294 Err\");\r\n686:             }\r\n687:             if dest.exists() {\r\n688:                 assert_eq!(std::fs::read(&dest).unwrap(), data);\r\n689:             } else {\r\n690:                 assert!(r.is_err());\r\n691:             }\r\n692:             std::fs::remove_dir_all(dir).ok();\r\n693:         }\r\n694:     }\r\n695: \r\n696:     // D7: \\ubbf8\\ub9ac \\ucf20 \\ucde8\\uc18c\\ub294 \\ud504\\ub85c\\ube0c\\ub9cc \\ubcf4\\ub0b4\\uace0 Ok(None), \\ubaa9\\uc801 \\ud30c\\uc77c \\uc5c6\\uc74c, \\uc7ac\\uac1c \\uc0c1\\ud0dc \\uc720\\uc9c0.\r\n697:     #[test]\r\n698:     fn preset_cancel_returns_none_and_keeps_state() {\r\n699:         let (dir, s) = (tmp_dir(\"pre\"), serve(pattern(200_000), Opt::default()));\r\n700:         let dest = dir.join(\"a.bin\");\r\n701:         let r = run(&format!(\"{}/file.bin\", s.url), &dest, Arc::new(AtomicBool::new(true)), |_| {});\r\n702:         assert_eq!(r.unwrap(), None);\r\n703:         assert!(!dest.exists() && side(&dest, \".download\").exists() && side(&dest, \".download.state\").exists());\r\n704:         assert_eq!(s.log.lock().unwrap().len(), 1, \"\\ud504\\ub85c\\ube0c\\ub9cc\");\r\n705:         std::fs::remove_dir_all(dir).ok();\r\n706:     }\r\n707: \r\n708:     // D4 + D7: \\uc804\\uc1a1 \\uc911 \\ucde8\\uc18c \\u2192 \\uc0c1\\ud0dc \\uc720\\uc9c0 \\u2192 \\uac19\\uc740 URL \\uc7ac\\uc2e4\\ud589\\uc740 \\ube60\\uc9c4 \\ub9cc\\ud07c\\ub9cc \\ubc1b\\ub294\\ub2e4.\r\n709:     #[test]\r\n710:     fn cancel_midway_then_resume_fetches_only_missing() {\r\n711:         let (data, dir) = (pattern(8_000_000), tmp_dir(\"resume\"));\r\n712:         let dest = dir.join(\"a.bin\");\r\n713:         let s = serve(data.clone(), Opt { chunk_ms: 20, ..Default::default() });\r\n714:         let cancel = Arc::new(AtomicBool::new(false));\r\n715:         let (flag, served) = (cancel.clone(), s.served.clone());\r\n716:         std::thread::spawn(move || {\r\n717:             while served.load(Ordering::SeqCst) < 2_000_000 {\r\n718:                 std::thread::sleep(Duration::from_millis(1));\r\n719:             }\r\n720:             flag.store(true, Ordering::SeqCst);\r\n721:         });\r\n722:         assert_eq!(run(&format!(\"{}/file.bin\", s.url), &dest, cancel, |_| {}).unwrap(), None);\r\n723:         assert!(!dest.exists());\r\n724:         let state = std::fs::read_to_string(side(&dest, \".download.state\")).unwrap();\r\n725:         let left: u64 = state.split_once(\"end\").unwrap().0.lines().skip(1).map(|l| {\r\n726:             let (a, b) = l.split_once(' ').unwrap();\r\n727:             b.parse::<u64>().unwrap() - a.parse::<u64>().unwrap()\r\n728:         }).sum();\r\n729: \r\n730:         let s2 = serve(data.clone(), Opt::default());\r\n731:         assert_eq!(plain(&s2.url, &dest).unwrap(), Some(dest.clone()));\r\n732:         assert_eq!(std::fs::read(&dest).unwrap(), data);\r\n733:         let fetched = s2.served.load(Ordering::SeqCst) - 1;\r\n734:         assert!(fetched >= left && fetched <= left + 8 * 1024 * 1024, \"\\ub0a8\\uc740 {left} \\uc678 \\ub0ad\\ube44 \\uacfc\\ub2e4: {fetched}\");\r\n735:         assert!(left < 8_000_000, \"\\ucde8\\uc18c \\uc804 \\uc9c4\\ud589\\ubd84\\uc740 \\ub2e4\\uc2dc \\ubc1b\\uc9c0 \\uc54a\\ub294\\ub2e4\");\r\n736:         assert_eq!(files(&dir), vec![\"a.bin\"]);\r\n737:         std::fs::remove_dir_all(dir).ok();\r\n738:     }\r\n739: \r\n740:     // D4: \\uc0c1\\ud0dc \\ud30c\\uc77c\\uc774 \\uac00\\ub9ac\\ud0a4\\ub294 \\ub0a8\\uc740 \\uad6c\\uac04\\ub9cc \\uc694\\uccad\\ud55c\\ub2e4.\r\n741:     #[test]\r\n742:     fn saved_state_limits_requests_to_remaining_spans() {\r\n743:         let (data, dir) = (pattern(1_000_000), tmp_dir(\"state\"));\r\n744:         let dest = dir.join(\"a.bin\");\r\n745:         let mut part = data.clone();\r\n746:         part[300_000..400_000].fill(0);\r\n747:         part[900_000..].fill(0);\r\n748:         std::fs::write(side(&dest, \".download\"), &part).unwrap();\r\n749:         std::fs::write(side(&dest, \".download.state\"), \"1000000\\\\n300000 400000\\\\n900000 1000000\\\\nend\\\\n\").unwrap();\r\n750:         let s = serve(data.clone(), Opt::default());\r\n751:         assert_eq!(plain(&s.url, &dest).unwrap(), Some(dest.clone()));\r\n752:         assert_eq!(std::fs::read(&dest).unwrap(), data);\r\n753:         assert_eq!(s.served.load(Ordering::SeqCst), 200_000 + 1, \"\\ub0a8\\uc740 \\uad6c\\uac04 + \\ud504\\ub85c\\ube0c 1\\ubc14\\uc774\\ud2b8\");\r\n754:         assert_eq!(files(&dir), vec![\"a.bin\"]);\r\n755:         std::fs::remove_dir_all(dir).ok();\r\n756:     }\r\n757: \r\n758:     // D4 + D5: \\ub2e4\\ub978 \\ud06c\\uae30/\\uc190\\uc0c1/\\ubc94\\uc704 \\ubc16 \\uc0c1\\ud0dc\\ub294 \\ubc84\\ub9ac\\uace0 \\ucc98\\uc74c\\ubd80\\ud130 \\ubc1b\\ub294\\ub2e4.\r\n759:     #[test]\r\n760:     fn foreign_or_damaged_state_is_discarded() {\r\n761:         let data = pattern(400_000);\r\n762:         for (state, part_len) in [\r\n763:             (\"garbage\", 400_000),\r\n764:             (\"999\\\\n0 999\\\\n\", 400_000),             // \\ub2e4\\ub978 \\ud30c\\uc77c(\\ud06c\\uae30 \\ub2e4\\ub984)\r\n765:             (\"400000\\\\n0 99999999\\\\n\", 400_000),     // \\ubc94\\uc704\\uac00 \\ud30c\\uc77c \\ubc16\r\n766:             (\"400000\\\\n5 3\\\\n\", 400_000),            // \\ub4a4\\uc9d1\\ud78c \\ubc94\\uc704\r\n767:             (\"400000\\\\nabc def\\\\n\", 400_000),        // \\uc22b\\uc790\\uac00 \\uc544\\ub2d8\r\n768:             (\"400000\\\\nend\\\\n\", 12_345),            // \\uc784\\uc2dc \\ud30c\\uc77c \\ud06c\\uae30 \\ubd88\\uc77c\\uce58\r\n769:             (\"400000\\\\n0 400000\\\\n\", 400_000),      // \\ub05d \\ud45c\\uc2dd \\uc5c6\\uc74c(\\uc4f0\\ub2e4 \\ub9cc \\ud30c\\uc77c)\r\n770:         ] {\r\n771:             let dir = tmp_dir(\"dmg\");\r\n772:             let dest = dir.join(\"a.bin\");\r\n773:             std::fs::write(side(&dest, \".download\"), vec![0xFFu8; part_len]).unwrap();\r\n774:             std::fs::write(side(&dest, \".download.state\"), state).unwrap();\r\n775:             let s = serve(data.clone(), Opt::default());\r\n776:             assert_eq!(plain(&s.url, &dest).unwrap(), Some(dest.clone()), \"{state:?}\");\r\n777:             assert_eq!(std::fs::read(&dest).unwrap(), data, \"{state:?}\");\r\n778:             std::fs::remove_dir_all(dir).ok();\r\n779:         }\r\n780:     }\r\n781: \r\n782:     // D8: received\\ub294 \\ub4a4\\ub85c \\uac00\\uc9c0 \\uc54a\\uace0, total\\uc740 \\uc804\\uccb4 \\ud06c\\uae30, mode\\ub294 \\uacbd\\ub85c, \\ucd08\\ub2f9 4\\ud68c \\uc548\\ud30e, \\ub9c8\\uc9c0\\ub9c9\\uc740 received == total.\r\n783:     #[test]\r\n784:     fn progress_is_monotone_rate_limited_and_ends_at_total() {\r\n785:         let (dir, s) = (tmp_dir(\"prog\"), serve(pattern(4_000_000), Opt { chunk_ms: 25, ..Default::default() }));\r\n786:         let events = Arc::new(Mutex::new(Vec::new()));\r\n787:         let e = events.clone();\r\n788:         let t = Instant::now();\r\n789:         run(&format!(\"{}/file.bin\", s.url), &dir.join(\"a.bin\"), Arc::new(AtomicBool::new(false)), move |p| {\r\n790:             e.lock().unwrap().push(p)\r\n791:         })\r\n792:         .unwrap();\r\n793:         let secs = t.elapsed().as_secs_f64();\r\n794:         let ev = events.lock().unwrap();\r\n795:         assert!(ev.windows(2).all(|w| w[0].received <= w[1].received));\r\n796:         assert!(ev.iter().all(|p| p.total == Some(4_000_000) && p.mode == DownloadMode::Segmented));\r\n797:         assert_eq!(ev.last().unwrap().received, 4_000_000);\r\n798:         assert!(ev.len() as f64 <= secs * 4.0 + 4.0, \"{} events in {secs}s\", ev.len());\r\n799:         std::fs::remove_dir_all(dir).ok();\r\n800:     }\r\n801: \r\n802:     // D7: \\ub2e8\\uc77c \\uc2a4\\ud2b8\\ub9bc \\ucde8\\uc18c\\ub3c4 Ok(None)\\uc774\\uba70 \\ud3f4\\ub354\\uc5d0 \\uc544\\ubb34\\uac83\\ub3c4 \\ub0a8\\uae30\\uc9c0 \\uc54a\\ub294\\ub2e4.\r\n803:     #[test]\r\n804:     fn cancel_during_single_stream_returns_none_and_cleans_up() {\r\n805:         let (dir, s) = (tmp_dir(\"scancel\"), serve(pattern(2_000_000), Opt { ignore_range: true, chunk_ms: 20, ..Default::default() }));\r\n806:         let cancel = Arc::new(AtomicBool::new(false));\r\n807:         let (flag, served) = (cancel.clone(), s.served.clone());\r\n808:         std::thread::spawn(move || {\r\n809:             while served.load(Ordering::SeqCst) < 300_000 {\r\n810:                 std::thread::sleep(Duration::from_millis(1));\r\n811:             }\r\n812:             flag.store(true, Ordering::SeqCst);\r\n813:         });\r\n814:         assert_eq!(run(&format!(\"{}/file.bin\", s.url), &dir.join(\"a.bin\"), cancel, |_| {}).unwrap(), None);\r\n815:         assert!(files(&dir).is_empty());\r\n816:         std::fs::remove_dir_all(dir).ok();\r\n817:     }\r\n818: \r\n819:     // D9: \\ube44\\uc5b4 \\uc788\\ub294 \\ucfe0\\ud0a4/\\ub9ac\\ud37c\\ub7ec\\ub294 \\ubcf4\\ub0b4\\uc9c0 \\uc54a\\ub294\\ub2e4.\r\n820:     #[test]\r\n821:     fn empty_cookie_and_referer_are_not_sent() {\r\n822:         let (dir, s) = (tmp_dir(\"empty\"), serve(pattern(1000), Opt::default()));\r\n823:         let request = DownloadRequest {\r\n824:             url: format!(\"{}/file.bin\", s.url),\r\n825:             destination: dir.join(\"a.bin\"),\r\n826:             cookie_header: Some(String::new()),\r\n827:             referer: Some(String::new()),\r\n828:         };\r\n829:         let rt = tokio::runtime::Runtime::new().unwrap();\r\n830:         rt.block_on(download(request, Arc::new(AtomicBool::new(false)), |_| {})).unwrap();\r\n831:         let log = s.log.lock().unwrap().join(\"\").to_ascii_lowercase();\r\n832:         assert!(!log.contains(\"cookie:\") && !log.contains(\"referer:\"));\r\n833:         std::fs::remove_dir_all(dir).ok();\r\n834:     }\r\n835: \r\n836:     // D7: \\ud1a0\\ud070 \\ub808\\uc9c0\\uc2a4\\ud2b8\\ub9ac.\r\n837:     #[test]\r\n838:     fn cancel_tokens_register_request_clear() {\r\n839:         let flag = register_cancel(\"t-w3\");\r\n840:         assert!(!flag.load(Ordering::SeqCst));\r\n841:         assert!(request_cancel(\"t-w3\") && flag.load(Ordering::SeqCst));\r\n842:         clear_cancel(\"t-w3\");\r\n843:         assert!(!request_cancel(\"t-w3\") && !request_cancel(\"never-registered\"));\r\n844:         assert!(!register_cancel(\"t-w3\").load(Ordering::SeqCst), \"\\uc0c8 \\ub4f1\\ub85d\\uc740 \\uc0c8 \\ud50c\\ub798\\uadf8\");\r\n845:         clear_cancel(\"t-w3\");\r\n846:     }\r\n847: \r\n848:     // \\uc2a4\\ucf00\\uc904\\ub9c1: \\ubbf8\\ubc30\\uc815 \\uad6c\\uac04 \\uba3c\\uc800, \\uc5c6\\uc73c\\uba74 \\uac00\\uc7a5 \\ub9ce\\uc774 \\ub0a8\\uc740 \\uc5f0\\uacb0\\uc758 \\ub4a4 \\uc808\\ubc18, \\ub108\\ubb34 \\uc791\\uc73c\\uba74 \\ud3ec\\uae30. \\uad6c\\uac04\\uc740 \\uacb9\\uce58\\uc9c0 \\uc54a\\ub294\\ub2e4.\r\n849:     #[test]\r\n850:     fn claim_takes_todo_then_steals_half_then_gives_up() {\r\n851:         let big = 10 * MIN_STEAL;\r\n852:         let state = std::fs::File::create(std::env::temp_dir().join(format!(\"segdl-claim-{}\", std::process::id()))).unwrap();\r\n853:         let mut sh = Shared { todo: vec![(0, big)], slots: vec![(0, 0); 3], state, done: 0, last_ckpt: 0, last_emit: Instant::now() };\r\n854:         assert!(sh.claim(0) && sh.slots[0] == (0, big));\r\n855:         sh.slots[0].0 = 2 * MIN_STEAL; // \\uc5f0\\uacb0 0\\uc774 \\uc870\\uae08 \\ubc1b\\uc740 \\ub4a4\r\n856:         assert!(sh.claim(1));\r\n857:         let mid = 2 * MIN_STEAL + 4 * MIN_STEAL;\r\n858:         assert_eq!((sh.slots[0], sh.slots[1]), ((2 * MIN_STEAL, mid), (mid, big)));\r\n859:         sh.slots[0].0 = mid - MIN_STEAL; // \\ub0a8\\uc740 \\uad6c\\uac04\\uc774 2*MIN_STEAL \\ubbf8\\ub9cc\r\n860:         sh.slots[1].0 = big - MIN_STEAL;\r\n861:         assert!(!sh.claim(2) && sh.slots[2] == (0, 0));\r\n862:         assert_eq!(sh.remaining().len(), 2);\r\n863:     }\r\n864: }\r\n","exit_code":0,"status":"completed"}}
