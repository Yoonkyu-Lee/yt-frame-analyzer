ir_all(dir).ok();\r\n  866:     }\r\n  867: \r\n  868:     // D7: ���� ��Ʈ�� ��ҵ� Ok(None)�̸� ������ �ƹ��͵� ������ �ʴ´�.\r\n  869:     #[test]\r\n  870:     fn cancel_during_single_stream_returns_none_and_cleans_up() {\r\n  871:         let (dir, s) = (tmp_dir(\"scancel\"), serve(pattern(2_000_000), Opt { ignore_range: true, chunk_ms: 20, ..Default::default() }));\r\n  872:         let cancel = Arc::new(AtomicBool::new(false));\r\n  873:         let (flag, served) = (cancel.clone(), s.served.clone());\r\n  874:         std::thread::spawn(move || {\r\n  875:             while served.load(Ordering::SeqCst) < 300_000 {\r\n  876:                 std::thread::sleep(Duration::from_millis(1));\r\n  877:             }\r\n  878:             flag.store(true, Ordering::SeqCst);\r\n  879:         });\r\n  880:         assert_eq!(run(&format!(\"{}/file.bin\", s.url), &dir.join(\"a.bin\"), cancel, |_| {}).unwrap(), None);\r\n  881:         assert!(files(&dir).is_empty());\r\n  882:         std::fs::remove_dir_all(dir).ok();\r\n  883:     }\r\n  884: \r\n  885:     // D9: ��� �ִ� ��Ű/���۷��� ������ �ʴ´�.\r\n  886:     #[test]\r\n  887:     fn empty_cookie_and_referer_are_not_sent() {\r\n  888:         let (dir, s) = (tmp_dir(\"empty\"), serve(pattern(1000), Opt::default()));\r\n  889:         let request = DownloadRequest {\r\n  890:             url: format!(\"{}/file.bin\", s.url),\r\n  891:             destination: dir.join(\"a.bin\"),\r\n  892:             cookie_header: Some(String::new()),\r\n  893:             referer: Some(String::new()),\r\n  894:         };\r\n  895:         let rt = tokio::runtime::Runtime::new().unwrap();\r\n  896:         rt.block_on(download(request, Arc::new(AtomicBool::new(false)), |_| {})).unwrap();\r\n  897:         let log = s.log.lock().unwrap().join(\"\").to_ascii_lowercase();\r\n  898:         assert!(!log.contains(\"cookie:\") && !log.contains(\"referer:\"));\r\n  899:         std::fs::remove_dir_all(dir).ok();\r\n  900:     }\r\n  901: \r\n  902:     // D7: ��ū ������Ʈ��.\r\n  903:     #[test]\r\n  904:     fn cancel_tokens_register_request_clear() {\r\n  905:         let flag = register_cancel(\"t-w3\");\r\n  906:         assert!(!flag.load(Ordering::SeqCst));\r\n  907:         assert!(request_cancel(\"t-w3\") && flag.load(Ordering::SeqCst));\r\n  908:         clear_cancel(\"t-w3\");\r\n  909:         assert!(!request_cancel(\"t-w3\") && !request_cancel(\"never-registered\"));\r\n  910:         assert!(!register_cancel(\"t-w3\").load(Ordering::SeqCst), \"�� ����� �� �÷���\");\r\n  911:         clear_cancel(\"t-w3\");\r\n  912:     }\r\n  913: \r\n  914:     // �����ٸ�: �̹��� ���� ����, ������ ���� ���� ���� ������ �� ����, �ʹ� ������ ����. ������ ��ġ�� �ʴ´�.\r\n  915:     #[test]\r\n  916:     fn claim_takes_todo_then_steals_half_then_gives_up() {\r\n  917:         let big = 10 * MIN_STEAL;\r\n  918:         let state = std::fs::File::create(std::env::temp_dir().join(format!(\"segdl-claim-{}\", std::process::id()))).unwrap();\r\n  919:         let mut sh = Shared { todo: vec![(0, big)], slots: vec![(0, 0); 3], state, done: 0, last_ckpt: 0, last_emit: Instant::now() };\r\n  920:         assert!(sh.claim(0) && sh.slots[0] == (0, big));\r\n  921:         sh.slots[0].0 = 2 * MIN_STEAL; // ���� 0�� ���� ���� ��\r\n  922:         assert!(sh.claim(1));\r\n  923:         let mid = 2 * MIN_STEAL + 4 * MIN_STEAL;\r\n  924:         assert_eq!((sh.slots[0], sh.slots[1]), ((2 * MIN_STEAL, mid), (mid, big)));\r\n  925:         sh.slots[0].0 = mid - MIN_STEAL; // ���� ������ 2*MIN_STEAL �̸�\r\n  926:         sh.slots[1].0 = big - MIN_STEAL;\r\n  927:         assert!(!sh.claim(2) && sh.slots[2] == (0, 0));\r\n  928:         assert_eq!(sh.remaining().len(), 2);\r\n  929:     }\r\n  930: }\r\n","exit_code":0,"status":"completed"}}
