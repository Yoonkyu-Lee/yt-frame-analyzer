����)��ŭ�� ���� ����/���¸� �����Ѵ�. ������ �� ä������ true.\r\n  164:     fn accept(&self, slot: usize, file: &mut std::fs::File, chunk: &[u8]) -> Result<bool, String> {\r\n  165:         let mut sh = self.lock();\r\n  166:         let (pos, end) = sh.slots[slot];\r\n  167:         let n = (chunk.len() as u64).min(end - pos);\r\n  168:         file.write_all(&chunk[..n as usize]).map_err(|e| format!(\"���� ���� ����: {e}\"))?;\r\n  169:         sh.slots[slot].0 += n;\r\n  170:         sh.done += n;\r\n  171:         if sh.done - sh.last_ckpt >= CHECKPOINT_BYTES {\r\n  172:             sh.last_ckpt = sh.done;\r\n  173:             sh.checkpoint(self.total)?;\r\n  174:         }\r\n  175:         if sh.last_emit.elapsed() >= PROGRESS_EVERY {\r\n  176:             sh.last_emit = Instant::now();\r\n  177:             self.emit(sh.done); // D8: ��� �ȿ��� ������ �� ������ ����� ������ �ڹٲ��� �ʴ´�\r\n  178:         }\r\n  179:         Ok(pos + n == end)\r\n  180:     }\r\n  181: \r\n  182:     /// �� ���� Range ��û���� `slot`�� ������ �̾� �޴´�. D5: ������ �ٸ� Content-Range�� ��û���� �� ������ ġ����.\r\n  183:     async fn stream(&self, slot: usize, file: &mut std::fs::File, pos: u64, end: u64) -> Result<(), Fail> {\r\n  184:         let mut resp = get(&self.client, &self.req)\r\n  185:             .header(RANGE, format!(\"bytes={pos}-{}\", end - 1))\r\n  186:             .send()\r\n  187:             .await\r\n  188:             .map_err(|e| Fail::Retry(format!(\"���� ���� ����: {e}\")))?;\r\n  189:         if resp.status() != StatusCode::PARTIAL_CONTENT {\r\n  190:             return Err(Fail::Retry(format!(\"Range ������ �ƴմϴ�: HTTP {}\", resp.status())));\r\n  191:         }\r\n  192:         // �ѷ����� �¾ƾ� �Ѵ�: ���κ�� �ٸ� ũ�⸦ ���ϴ� ������ ������ �߸� ä �ϼ����� �ʴ´�\r\n  193:         let (head, tail) = (format!(\"bytes {pos}-\"), format!(\"/{}\", self.total));\r\n  194:         let range = resp.headers().get(CONTENT_RANGE).and_then(|v| v.to_str().ok());\r\n  195:         if !range.is_some_and(|v| v.starts_with(&head) && v.ends_with(&tail)) {\r\n  196:             return Err(Fail::Fatal(\"Content-Range�� ��û ������ �ٸ��ϴ�\".into()));\r\n  197:         }\r\n  198:         file.seek(SeekFrom::Start(pos)).map_err(|e| Fail::Fatal(format!(\"seek ����: {e}\")))?;\r\n  199:         let mut at = pos;\r\n  200:         while let Some(chunk) = resp.chunk().await.map_err(|e| Fail::Retry(format!(\"���� ����: {e}\")))? {\r\n  201:             if self.cancel.load(Ordering::Relaxed) {\r\n  202:                 return Err(Fail::Fatal(CANCELLED.into()));\r\n  203:             }\r\n  204:             at += chunk.len() as u64;\r\n  205:             if at > end {\r\n  206:                 return Err(Fail::Fatal(\"������ ��û�� ũ�⸦ �ʰ��߽��ϴ�\".into()));\r\n  207:             }\r\n  208:             if self.accept(slot, file, &chunk).map_err(Fail::Fatal)? {\r\n  209:                 return Ok(());\r\n  210:             }\r\n  211:         }\r\n  212:         Err(Fail::Retry(\"������ ��û�� ũ�⺸�� ª���ϴ�\".into()))\r\n  213:     }\r\n  214: \r\n  215:     /// D6: ������ ������ ������ �޴´�. ��õ��� ���� ������ �̾� ����.\r\n  216:     async fn fetch(&self, slot: usize) -> Result<(), String> {\r\n  217:         let mut file = std::fs::OpenOptions::new()\r\n  218:             .write(true)\r\n  219:             .open(&self.part)\r\n  220:             .map_err(|e| format!(\"�ӽ� ���� ���� ����: {e}\"))?;\r\n  221:         let mut last = String::new();\r\n  222:         for attempt in 0..MAX_TRIES {\r\n  223:             if attempt > 0 {\r\n  224:                 tokio::time::sleep(Duration::from_millis(500 * attempt as u64)).await;\r\n  225:             }\r\n  226:             if self.cancel.load(Ordering::Relaxed) {\r\n  227:                 return Err(CANCELLED.into());\r\n  228:             }\r\n  229:             let (pos, end) = self.lock().slots[slot];\r\n  230:             if pos >= end {\r\n  231:                 return Ok(());\r\n  232:             }\r\n  233:             match self.stream(slot, &mut file, pos, end).await {\r\n  234:                 Ok(()) => return Ok(()),\r\n  235:                 Err(Fail::Fatal(e)) => return Err(e),\r\n  236:                 Err(Fail::Retry(e)) => last = e,\r\n  237:             }\r\n  238:         }\r\n  239:         Err(format!(\"�ٿ�ε� ����(��õ� {MAX_TRIES}ȸ �ʰ�): {last}\"))\r\n  240:     }\r\n  241: }\r\n  242: \r\n  243: fn fnv(text: &str) -> u64 {\r\n  244:     text.bytes().fold(0xcbf2_9ce4_8422_2325, |h, b| (h ^ u64::from(b)).wrapping_mul(0x0100_0000_01b3))\r\n  245: }\r\n  246: \r\n  247: /// D4/D5: �簳 ���� �ؽ�Ʈ = �ѷ�, ���� ������, �� ������ FNV-1a ��, �� ǥ��. ����� �߷�\r\n  248: /// ���� �Ϻθ� �ٲ� ������ ���� ���� �ʾ� ��������(�������� �ռ� ������ �������� ���Ѵ�).\r\n  249: fn state_text(total: u64, spans: &[Span]) -> String {\r\n  250:     let mut body = format!(\"{total}\\n\");\r\n  251:     for (a, b) in spans {\r\n  252:         body += &format!(\"{a} {b}\\n\");\r\n  253:     }\r\n  254:     let sum = fnv(&body);\r\n  255:     format!(\"{:<w$}\", format!(\"{body}sum {sum}\\nend\\n\"), w = STATE_BYTES)\r\n  256: }\r\n  257: \r\n  258: /// D4: ����� ���� ���� ���. ũ�⡤�ա����ġ������� �ϳ��� �̻��ϸ� None(�� ó������).\r\n  259: fn load_state(state: &Path, part: &Path, total: u64) -> Option<Vec<Span>> {\r\n  260:     let text = std::fs::read_to_string(state).ok()?;\r\n  261:     if std::fs::metadata(part).ok()?.len() != total {\r\n  262:         return None;\r\n  263:     }\r\n  264:     let (body, rest) = text.split_once(\"sum \")?;\r\n  265:     if rest.split_once(\"\\nend\\n\")?.0.parse::<u64>().ok()? != fnv(body) {\r\n  266:         return None;\r\n  267:     }\r\n  268:     let mut lines = body.lines();\r\n  269:     if lines.next()?.parse::<u64>().ok()? != total {\r\n  270:         return None;\r\n  271:     }\r\n  272:     let mut spans: Vec<Span> = lines\r\n  273:         .map(|l| {\r\n  274:             let (a, b) = l.split_once(' ')?;\r\n  275:             let (a, b) = (a.parse().ok()?, b.parse().ok()?);\r\n  276:             (a < b && b <= total).then_some((a, b))\r\n  277:         })\r\n  278:         .collect::<Option<_>>()?;\r\n  279:     // D5: ��ġ�� ������ �޾Ƶ��̸� ���� ����Ʈ�� �� �� ���� �ٸ� ���� ��� ä �Ϸ�ȴ�\r\n  280:     spans.sort_unstable();\r\n  281:     spans.windows(2).all(|w| w[0].1 <= w[1].0).then_some(spans)\r\n  282: }\r\n  283: \r\n  284: /// D2: `bytes=0-0` ���κ��� ���. ���κ� ������ ���⼭ ������ ������ ������ �ʴ´�(D3).\r\n  285: enum Plan {\r\n  286:     Segmented(u64),\r\n  287:     Single(Option<u64>), // 200�� �˷� �� ũ��: �� ��û�� ũ�⸦ �� �˷� �� �� ª�� ������ ��� ����\r\n  288: }\r\n  289: \r\n  290: async fn probe(client: &Client, req: &DownloadRequest) -> Result<Plan, String> {\r\n  291:     let resp = get(client, req)\r\n  292:         .header(RANGE, \"bytes=0-0\")\r\n  293:         .send()\r\n  294:         .await\r\n  295:         .map_err(|e| format!(\"�ٿ�ε� ���� ���� ����: {e}\"))?;\r\n  296:     match resp.status() {\r\n  297:         StatusCode::PARTIAL_CONTENT => Ok(resp\r\n  298:             .headers()\r\n  299:             .get(CONTENT_RANGE)\r\n  300:             .and_then(|v| v.to_str().ok())\r\n  301:             .and_then(|v| v.rsplit_once('/')?.1.parse().ok())\r\n  302:             .filter(|n| *n > 0)\r\n  303:             .map_or(Plan::Single(None), Plan::Segmented)),\r\n  304:         s if s.is_success() => Ok(Plan::Single(resp.content_length())),\r\n  305:         s => Err(format!(\"�ٿ�ε� ������ ��û�� �ź��߽��ϴ�: HTTP {s}\")),\r\n  306:     }\r\n  307: }\r\n  308: \r\n  309: async fn segmented(\r\n  310:     client: Client,\r\n  311:     req: DownloadRequest,\r\n  312:     total: u64,\r\n  313:     cancel: Arc<AtomicBool>,\r\n  314:     on_progress: Box<dyn Fn(DownloadProgress) + Send + Sync>,\r\n  315: ) -> Result<(), String> {\r\n  316:     let part = side(&req.destination, \".download\");\r\n  317:     let state_path = side(&req.destination, \".download.state\");\r\n  318:     let todo = match load_state(&state_path, &part, total) {\r\n  319:         Some(todo) => todo,\r\n  320:         None => {\r\n  321:             // �� ���º��� �����: ������ ���� ���� �� ũ�����ϸ� �� �Ϸ� ����� �� ������ �ǳʶٰ� �ȴ�\r\n  322:             if let Err(e) = std::fs::remove_file(&state_path) {\r\n  323:                 if e.kind() != std::io::ErrorKind::NotFound {\r\n  324:                     return Err(format!(\"���� �簳 ���� ���� ����: {e}\"));\r\n  325:                 }\r\n  326:             }\r\n  327:             let file = std::fs::File::create(&part).map_err(|e| format!(\"�ӽ� ���� ���� ����: {e}\"))?;\r\n  328:             file.set_len(total).map_err(|e| format!(\"�ӽ� ���� ũ�� ���� ����: {e}\"))?;\r\n  329:             let n = CONNECTIONS as u64;\r\n  330:             (0..n).map(|i| (total * i / n, total * (i + 1) / n)).filter(|(a, b)| a < b).collect()\r\n  331:         }\r\n  332:     };\r\n  333:     let left: u64 = todo.iter().map(|(a, b)| b - a).sum();\r\n  334:     let done = total.saturating_sub(left);\r\n  335:     let state = std::fs::OpenOptions::new()\r\n  336:         .write(true)\r\n  337:         .create(true)\r\n  338:         .truncate(false)\r\n  339:         .open(&state_path)\r\n  340:         .map_err(|e| format!(\"���� ���� ���� ����: {e}\"))?;\r\n  341:     let slots = vec![(0, 0); CONNECTIONS];\r\n  342:     let sh = Shared { todo, slots, state, done, last_ckpt: done, last_emit: Instant::now() };\r\n  343:     let ctx = Arc::new(Ctx { client, req, total, part, cancel, on_progress, sh: Mutex::new(sh) });\r\n  344:     ctx.emit(done);\r\n  345:     ctx.lock().checkpoint(total)?;\r\n  346: \r\n  347:     let mut workers = JoinSet::new();\r\n  348:     for slot in 0..CONNECTIONS {\r\n  349:         let ctx = ctx.clone();\r\n  350:         workers.spawn(async move {\r\n  351:             while ctx.lock().claim(slot) {\r\n  352:                 ctx.fetch(slot).await?;\r\n  353:             }\r\n  354:             Ok::<(), String>(())\r\n  355:         });\r\n  356:     }\r\n  357:     let mut result = Ok(());\r\n  358:     while let Some(joined) = workers.join_next().await {\r\n  359:         result = joined.map_err(|e| format!(\"�ٿ�ε� �۾� ���� ����: {e}\")).and_then(|r| r);\r\n  360:         if result.is_err() {\r\n  361:             break;\r\n  362:         }\r\n  363:     }\r\n  364:     workers.shutdown().await;\r\n  365:     let mut sh = ctx.lock();\r\n  366:     // D7: ���� ������ ���(�̹� �� ���� �簳) ��Ұ� ���� ������ �ϼ� ������ ������ �ʴ´�\r\n  367:     if result.is_err() || !sh.remaining().is_empty() || ctx.cancel.load(Ordering::Relaxed) {\r\n  368:         let saved = sh.checkpoint(total); // D4: �ߴ�/���� ������ ��Ȯ�� ��ġ�� �����\r\n  369:         return result.and(saved).and(Err(\"�Ϻ� ������ ���� ���߽��ϴ�\".into()));\r\n  370:     }\r\n  371:     drop(sh);\r\n  372:     ctx.emit(total);\r\n  373:     std::fs::rename(&ctx.part, &ctx.req.destination).map_err(|e| format!(\"�Ϸ� ���� �̵� ����: {e}\"))\r\n  374: }\r\n  375: \r\n  376: /// D2: Range ���� �� ���� �޴´�(�簳 �Ұ�). ����/��� �� �ӽ� ������ ������.\r\n  377: async fn single(\r\n  378:     client: Client,\r\n  379:     req: DownloadRequest,\r\n  380:     expected: Option<u64>,\r\n  381:     cancel: Arc<AtomicBool>,\r\n  382:     on_progress: Box<dyn Fn(DownloadProgress) + Send + Sync>,\r\n  383: ) -> Result<(), String> {\r\n  384:     let mut resp = get(&client, &req).send().await.map_err(|e| format!(\"�ٿ�ε� ���� ���� ����: {e}\"))?;\r\n  385:     // D5: Range ���� �������� ��ü(200)�� �޴´�. 206�� ������ �Ϻζ� �ϼ����� �� �� ����\r\n  386:     if resp.status() != StatusCode::OK {\r\n  387:         return Err(format!(\"�ٿ�ε� ������ ��ü ������ ���� �ʾҽ��ϴ�: HTTP {}\", resp.status()));\r\n  388:     }\r\n  389:     let total = resp.content_length().or(expected);\r\n  390:     let emit = |received| on_progress(DownloadProgress { received, total, mode: DownloadMode::Single });\r\n  391:     let part = side(&req.destination, \".download\");\r\n  392:     let copied = async {\r\n  393:         let mut file = std::fs::File::create(&part).map_err(|e| format!(\"�ӽ� ���� ���� ����: {e}\"))?;\r\n  394:         let (mut got, mut last) = (0u64, Instant::now());\r\n  395:         emit(0);\r\n  396:         while let Some(chunk) = resp.chunk().await.map_err(|e| format!(\"���� ����: {e}\"))? {\r\n  397:             if cancel.load(Ordering::Relaxed) {\r\n  398:                 return Err(CANCELLED.to_string());\r\n  399:             }\r\n  400:             file.write_all(&chunk).map_err(|e| format!(\"���� ���� ����: {e}\"))?;\r\n  401:             got += chunk.len() as u64;\r\n  402:             if last.elapsed() >= PROGRESS_EVERY {\r\n  403:                 last = Instant::now();\r\n  404:                 emit(got);\r\n  405:             }\r\n  406:         }\r\n  407:         if total.is_some_and(|t| t != got) {\r\n  408:             return Err(\"���� ũ�Ⱑ ���� ũ��� �ٸ��ϴ�\".to_string());\r\n  409:         }\r\n  410:         if cancel.load(Ordering::Relaxed) {\r\n  411:             return Err(CANCELLED.to_string()); // D7: ������ ûũ ��(�Ǵ� �� ����)�� ���� ���\r\n  412:         }\r\n  413:         emit(got);\r\n  414:         std::fs::rename(&part, &req.destination).map_err(|e| format!(\"�Ϸ� ���� �̵� ����: {e}\"))\r\n  415:     }\r\n  416:     .await;\r\n  417:     if copied.is_err() {\r\n  418:         let _ = std::fs::remove_file(&part);\r\n  419:     }\r\n  420:     copied\r\n  421: }\r\n  422: \r\n  423: /// `Ok(Some(path))` �Ϸ�, `Ok(None)` ���(�簳 ���� ����), `Err` ����(D10: �ѱ��� �޽���).\r\n  424: pub async fn download<F>(\r\n  425:     request: DownloadRequest,\r\n  426:     cancel: Arc<AtomicBool>,\r\n  427:     on_progress: F,\r\n  428: ) -> Result<Option<PathBuf>, String>\r\n  429: where\r\n  430:     F: Fn(DownloadProgress) + Send + Sync + 'static,\r\n  431: {\r\n  432:     let client = Client::builder()\r\n  433:         .connect_timeout(Duration::from_secs(20))\r\n  434:         .redirect(reqwest::redirect::Policy::