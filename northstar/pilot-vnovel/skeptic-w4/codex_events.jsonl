    served: Arc<AtomicU64>,\r\n  481:         peak: Arc<AtomicUsize>,\r\n  482:         active: Arc<AtomicUsize>,\r\n  483:         shorts: Arc<AtomicUsize>,\r\n  484:         data: Arc<Vec<u8>>,\r\n  485:         o: Opt,\r\n  486:     }\r\n  487: \r\n  488:     fn serve(data: Vec<u8>, o: Opt) -> Srv {\r\n  489:         let l = TcpListener::bind(\"127.0.0.1:0\").unwrap();\r\n  490:         let s = Srv {\r\n  491:             url: format!(\"http://{}\", l.local_addr().unwrap()),\r\n  492:             log: Default::default(),\r\n  493:             served: Default::default(),\r\n  494:             peak: Default::default(),\r\n  495:             active: Default::default(),\r\n  496:             shorts: Arc::new(AtomicUsize::new(o.short_first)),\r\n  497:             data: Arc::new(data),\r\n  498:             o,\r\n  499:         };\r\n  500:         let srv = s.clone();\r\n  501:         std::thread::spawn(move || {\r\n  502:             for conn in l.incoming().flatten() {\r\n  503:                 let srv = srv.clone();\r\n  504:                 std::thread::spawn(move || {\r\n  505:                     let _ = handle(&srv, conn);\r\n  506:                 });\r\n  507:             }\r\n  508:         });\r\n  509:         s\r\n  510:     }\r\n  511: \r\n  512:     fn handle(s: &Srv, mut c: TcpStream) -> std::io::Result<()> {\r\n  513:         let (mut buf, mut tmp) = (Vec::new(), [0u8; 1024]);\r\n  514:         while !buf.windows(4).any(|w| w == b\"\\r\\n\\r\\n\") {\r\n  515:             let n = c.read(&mut tmp)?;\r\n  516:             if n == 0 {\r\n  517:                 return Ok(());\r\n  518:             }\r\n  519:             buf.extend_from_slice(&tmp[..n]);\r\n  520:         }\r\n  521:         let head = String::from_utf8_lossy(&buf).into_owned();\r\n  522:         s.log.lock().unwrap().push(head.clone());\r\n  523:         let range = head\r\n  524:             .lines()\r\n  525:             .find_map(|l| l.to_ascii_lowercase().strip_prefix(\"range: bytes=\").map(str::to_string))\r\n  526:             .and_then(|v| {\r\n  527:                 let (a, b) = v.split_once('-')?;\r\n  528:                 Some((a.trim().parse::<usize>().ok()?, b.trim().parse::<usize>().ok()?))\r\n  529:             });\r\n  530:         if head.starts_with(\"GET /redirect\") {\r\n  531:             return write!(c, \"HTTP/1.1 302 Found\\r\\nLocation: /file.bin\\r\\nContent-Length: 0\\r\\nConnection: close\\r\\n\\r\\n\");\r\n  532:         }\r\n  533:         if s.o.status != 0 {\r\n  534:             return write!(c, \"HTTP/1.1 {} X\\r\\nContent-Length: 0\\r\\nConnection: close\\r\\n\\r\\n\", s.o.status);\r\n  535:         }\r\n  536:         let len = s.data.len();\r\n  537:         let probe = range == Some((0, 0));\r\n  538:         let (status, a, e, cr) = match range {\r\n  539:             Some((a, b)) if !s.o.ignore_range && a < len => {\r\n  540:                 let e = b.min(len - 1);\r\n  541:                 let shown = if s.o.wrong_start && !probe { a + 1 } else { a };\r\n  542:                 let t = if s.o.unknown_total { \"*\".to_string() } else { len.to_string() };\r\n  543:                 (\"206 Partial Content\", a, e, format!(\"Content-Range: bytes {shown}-{e}/{t}\\r\\n\"))\r\n  544:             }\r\n  545:             _ => (\"200 OK\", 0, len.saturating_sub(1), String::new()),\r\n  546:         };\r\n  547:         let mut body = if len == 0 { vec![] } else { s.data[a..=e].to_vec() };\r\n  548:         if s.o.extra_byte && !cr.is_empty() && !probe {\r\n  549:             body.push(0xAB);\r\n  550:         }\r\n  551:         write!(c, \"HTTP/1.1 {status}\\r\\nContent-Length: {}\\r\\n{cr}Connection: close\\r\\n\\r\\n\", body.len())?;\r\n  552:         let cut = !probe && s.shorts.fetch_update(Ordering::SeqCst, Ordering::SeqCst, |n| n.checked_sub(1)).is_ok();\r\n  553:         let limit = if cut { body.len() / 2 } else { body.len() };\r\n  554:         if !probe {\r\n  555:             s.peak.fetch_max(s.active.fetch_add(1, Ordering::SeqCst) + 1, Ordering::SeqCst);\r\n  556:             std::thread::sleep(Duration::from_millis(s.o.delay_ms));\r\n  557:         }\r\n  558:         let sent = (|| {\r\n  559:             for ch in body[..limit].chunks(64 * 1024) {\r\n  560:                 c.write_all(ch)?;\r\n  561:                 s.served.fetch_add(ch.len() as u64, Ordering::SeqCst);\r\n  562:                 std::thread::sleep(Duration::from_millis(s.o.chunk_ms));\r\n  563:             }\r\n  564:             std::io::Result::Ok(())\r\n  565:         })();\r\n  566:         if !probe {\r\n  567:             s.active.fetch_sub(1, Ordering::SeqCst);\r\n  568:         }\r\n  569:         sent\r\n  570:     }\r\n  571: \r\n  572:     fn pattern(n: usize) -> Vec<u8> {\r\n  573:         (0..n).map(|i| (i * 7 % 251) as u8).collect()\r\n  574:     }\r\n  575: \r\n  576:     fn tmp_dir(tag: &str) -> PathBuf {\r\n  577:         let t = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos();\r\n  578:         let dir = std::env::temp_dir().join(format!(\"segdl-{tag}-{}-{t}\", std::process::id()));\r\n  579:         std::fs::create_dir_all(&dir).unwrap();\r\n  580:         dir\r\n  581:     }\r\n  582: \r\n  583:     fn files(dir: &Path) -> Vec<String> {\r\n  584:         let mut v: Vec<String> =\r\n  585:             std::fs::read_dir(dir).unwrap().map(|e| e.unwrap().file_name().to_string_lossy().into_owned()).collect();\r\n  586:         v.sort();\r\n  587:         v\r\n  588:     }\r\n  589: \r\n  590:     fn run(\r\n  591:         url: &str,\r\n  592:         dest: &Path,\r\n  593:         cancel: Arc<AtomicBool>,\r\n  594:         cb: impl Fn(DownloadProgress) + Send + Sync + 'static,\r\n  595:     ) -> Result<Option<PathBuf>, String> {\r\n  596:         let request = DownloadRequest {\r\n  597:             url: url.to_string(),\r\n  598:             destination: dest.to_path_buf(),\r\n  599:             cookie_header: None,\r\n  600:             referer: None,\r\n  601:         };\r\n  602:         let rt = tokio::runtime::Builder::new_multi_thread().worker_threads(4).enable_all().build().unwrap();\r\n  603:         rt.block_on(download(request, cancel, cb))\r\n  604:     }\r\n  605: \r\n  606:     fn plain(url: &str, dest: &Path) -> Result<Option<PathBuf>, String> {\r\n  607:         run(&format!(\"{url}/file.bin\"), dest, Arc::new(AtomicBool::new(false)), |_| {})\r\n  608:     }\r\n  609: \r\n  610:     // D1: � ũ���(0 ����Ʈ ����) ����Ʈ�� ���� ������ ���� ���ϸ� ���´�.\r\n  611:     #[test]\r\n  612:     fn exact_bytes_and_no_leftovers_for_any_size() {\r\n  613:         for n in [0usize, 1, 7, 100, 1_000_003] {\r\n  614:             let (data, dir) = (pattern(n), tmp_dir(\"size\"));\r\n  615:             let dest = dir.join(\"a.bin\");\r\n  616:             let s = serve(data.clone(), Opt::default());\r\n  617:             assert_eq!(plain(&s.url, &dest).unwrap(), Some(dest.clone()), \"size {n}\");\r\n  618:             assert_eq!(std::fs::read(&dest).unwrap(), data, \"size {n}\");\r\n  619:             assert_eq!(files(&dir), vec![\"a.bin\"], \"size {n}\");\r\n  620:             std::fs::remove_dir_all(dir).ok();\r\n  621:         }\r\n  622:     }\r\n  623: \r\n  624:     // D3: ���� ������ ���� 8���� ���� �ʴ´�.\r\n  625:     #[test]\r\n  626:     fn uses_several_connections_but_at_most_eight() {\r\n  627:         let (dir, s) = (tmp_dir(\"conn\"), serve(pattern(4_000_000), Opt { delay_ms: 80, ..Default::default() }));\r\n  628:         plain(&s.url, &dir.join(\"a.bin\")).unwrap();\r\n  629:         let peak = s.peak.load(Ordering::SeqCst);\r\n  630:         assert!((2..=8).contains(&peak), \"peak {peak}\");\r\n  631:         std::fs::remove_dir_all(dir).ok();\r\n  632:     }\r\n  633: \r\n  634:     // D2 + D9: ù ��û�� bytes=0-0, ��� ��û�� identity/��Ű/���۷�/ũ�� UA, ����Ʈ�� ���󰣴�.\r\n  635:     #[test]\r\n  636:     fn probe_first_and_every_request_carries_headers() {\r\n  637:         let (dir, s) = (tmp_dir(\"hdr\"), serve(pattern(300_000), Opt::default()));\r\n  638:         let dest = dir.join(\"a.bin\");\r\n  639:         let request = DownloadRequest {\r\n  640:             url: format!(\"{}/redirect\", s.url),\r\n  641:             destination: dest.clone(),\r\n  642:             cookie_header: Some(\"sid=abc\".into()),\r\n  643:             referer: Some(\"https://host.example/page\".into()),\r\n  644:         };\r\n  645:         let rt = tokio::runtime::Runtime::new().unwrap();\r\n  646:         let r = rt.block_on(download(request, Arc::new(AtomicBool::new(false)), |_| {}));\r\n  647:         assert_eq!(r.unwrap(), Some(dest.clone()));\r\n  648:         assert_eq!(std::fs::read(&dest).unwrap(), pattern(300_000));\r\n  649:         let log = s.log.lock().unwrap();\r\n  650:         assert!(log[0].to_ascii_lowercase().contains(\"range: bytes=0-0\"), \"{}\", log[0]);\r\n  651:         for head in log.iter() {\r\n  652:             let h = head.to_ascii_lowercase();\r\n  653:             assert!(h.contains(\"accept-encoding: identity\"), \"{head}\");\r\n  654:             assert!(h.contains(\"cookie: sid=abc\"), \"{head}\");\r\n  655:             assert!(h.contains(\"referer: https://host.example/page\"), \"{head}\");\r\n  656:             assert!(h.contains(\"user-agent: mozilla/5.0 (windows nt 10.0\") && h.contains(\"chrome/\"), \"{head}\");\r\n  657:         }\r\n  658:         std::fs::remove_dir_all(dir).ok();\r\n  659:     }\r\n  660: \r\n  661:     // D2: Range ����(200)�� �ѷ� ��(`*`)�� ���� ��Ʈ������ �޴´�.\r\n  662:     #[test]\r\n  663:     fn range_ignored_or_unknown_total_uses_single_stream() {\r\n  664:         for o in [Opt { ignore_range: true, ..Default::default() }, Opt { unknown_total: true, ..Default::default() }] {\r\n  665:             let (data, dir) = (pattern(100_000), tmp_dir(\"single\"));\r\n  666:             let (s, dest) = (serve(data.clone(), o), dir.join(\"a.bin\"));\r\n  667:             let modes = Arc::new(Mutex::new(Vec::new()));\r\n  668:             let m = modes.clone();\r\n  669:             let r = run(&format!(\"{}/file.bin\", s.url), &dest, Arc::new(AtomicBool::new(false)), move |p| {\r\n  670:                 m.lock().unwrap().push((p.mode, p.received, p.total))\r\n  671:             });\r\n  672:             assert_eq!(r.unwrap(), Some(dest.clone()));\r\n  673:             assert_eq!(std::fs::read(&dest).unwrap(), data);\r\n  674:             let modes = modes.lock().unwrap();\r\n  675:             assert!(modes.iter().all(|m| m.0 == DownloadMode::Single));\r\n  676:             assert_eq!(modes.last().unwrap().1, 100_000);\r\n  677:             assert_eq!(files(&dir), vec![\"a.bin\"]);\r\n  678:             std::fs::remove_dir_all(dir).ok();\r\n  679:         }\r\n  680:     }\r\n  681: \r\n  682:     // D2 + D10: HTTP ������ �ѱ��� Err�̰� ������ ���� �ʴ´�.\r\n  683:     #[test]\r\n  684:     fn http_error_is_korean_err_and_leaves_nothing() {\r\n  685:         let (dir, s) = (tmp_dir(\"http\"), serve(pattern(10), Opt { status: 404, ..Default::default() }));\r\n  686:         let err = plain(&s.url, &dir.join(\"a.bin\")).unwrap_err();\r\n  687:         assert!(err.contains(\"HTTP 404\") && err.chars().any(|c| ('��'..='�R').contains(&c)), \"{err}\");\r\n  688:         assert!(files(&dir).is_empty());\r\n  689:         std::fs::remove_dir_all(dir).ok();\r\n  690:     }\r\n  691: \r\n  692:     // D6: �Ͻ��� ������ ��õ��� �����ǰ�, ��� �����ϸ� �� �� �ȿ� Err�� ������.\r\n  693:     #[test]\r\n  694:     fn transient_drops_retry_and_persistent_failure_errs_quickly() {\r\n  695:         let (data, dir) = (pattern(1_000_000), tmp_dir(\"retry\"));\r\n  696:         let s = serve(data.clone(), Opt { short_first: 3, ..Default::default() });\r\n  697:         let dest = dir.join(\"a.bin\");\r\n  698:         assert_eq!(plain(&s.url, &dest).unwrap(), Some(dest.clone()));\r\n  699:         assert_eq!(std::fs::read(&dest).unwrap(), data);\r\n  700: \r\n  701:         let (dir2, s2) = (tmp_dir(\"re