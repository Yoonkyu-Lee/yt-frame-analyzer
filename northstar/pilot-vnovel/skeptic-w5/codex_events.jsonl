r\n311:}\r\n312:\r\n313:async fn download_segment(\r\n314:    client: &Client,\r\n315:    request_info: &DownloadRequest,\r\n316:    part_path: &Path,\r\n317:    state_file: Arc<Mutex<tokio::fs::File>>,\r\n318:    progress: Arc<ProgressEmitter>,\r\n319:    cancel: Arc<AtomicBool>,\r\n320:    segment_count: usize,\r\n321:    index: usize,\r\n322:    initial_offset: u64,\r\n323:) -> Result<(), String> {\r\n324:    let total = progress\r\n325:        .total\r\n326:        .expect(\"분할 다운로드는 전체 크기가 필요하다\");\r\n327:    let (segment_start, segment_end) = segment_bounds(total, segment_count, index);\r\n328:    let segment_len = segment_end.saturating_sub(segment_start).saturating_add(1);\r\n329:    if initial_offset >= segment_len {\r\n330:        return Ok(());\r\n331:    }\r\n332:\r\n333:    let mut completed = initial_offset;\r\n334:    let mut checkpointed = initial_offset;\r\n335:    for attempt in 0..MAX_RETRIES {\r\n336:        if cancelled(&cancel) {\r\n337:            return Err(CANCEL_SENTINEL.to_string());\r\n338:        }\r\n339:        let start = segment_start + completed;\r\n340:        let mut response = match request(client, reqwest::Method::GET, request_info)\r\n341:            .header(RANGE, format!(\"bytes={start}-{segment_end}\"))\r\n342:            .send()\r\n343:            .await\r\n344:        {\r\n345:            Ok(response) if response.status() == StatusCode::PARTIAL_CONTENT => response,\r\n346:            Ok(response) => {\r\n347:                return Err(format!(\r\n348:                    \"Range 응답이 아닙니다(구간 {index}, HTTP {})\",\r\n349:                    response.status()\r\n350:                ))\r\n351:            }\r\n352:            Err(e) if attempt + 1 < MAX_RETRIES => {\r\n353:                tokio::time::sleep(Duration::from_millis(500 * (attempt as u64 + 1))).await;\r\n354:                eprintln!(\"[segmented-download] 구간 {index} 재시도: {e}\");\r\n355:                continue;\r\n356:            }\r\n357:            Err(e) => return Err(format!(\"구간 {index} 다운로드 실패: {e}\")),\r\n358:        };\r\n359:        let expected_range_prefix = format!(\"bytes {start}-\");\r\n360:        let valid_range = response\r\n361:            .headers()\r\n362:            .get(CONTENT_RANGE)\r\n363:            .and_then(|value| value.to_str().ok())\r\n364:            .is_some_and(|value| value.starts_with(&expected_range_prefix));\r\n365:        if !valid_range {\r\n366:            return Err(format!(\r\n367:                \"구간 {index}의 Content-Range가 요청 범위와 다릅니다\"\r\n368:            ));\r\n369:        }\r\n370:\r\n371:        let mut file = tokio::fs::OpenOptions::new()\r\n372:            .write(true)\r\n373:            .open(part_path)\r\n374:            .await\r\n375:            .map_err(|e| format!(\"임시 파일 열기 실패: {e}\"))?;\r\n376:        file.seek(std::io::SeekFrom::Start(start))\r\n377:            .await\r\n378:            .map_err(|e| format!(\"구간 {index} seek 실패: {e}\"))?;\r\n379:\r\n380:        let transfer = async {\r\n381:            while let Some(chunk) = response\r\n382:                .chunk()\r\n383:                .await\r\n384:                .map_err(|e| format!(\"구간 {index} 수신 실패: {e}\"))?\r\n385:            {\r\n386:                if cancelled(&cancel) {\r\n387:                    return Err(CANCEL_SENTINEL.to_string());\r\n388:                }\r\n389:                let remaining = segment_len.saturating_sub(completed);\r\n390:                if chunk.len() as u64 > remaining {\r\n391:                    return Err(format!(\"구간 {index}이 예정 크기를 초과했습니다\"));\r\n392:                }\r\n393:                file.write_all(&chunk)\r\n394:                    .await\r\n395:                    .map_err(|e| format!(\"구간 {index} 쓰기 실패: {e}\"))?;\r\n396:                completed += chunk.len() as u64;\r\n397:                progress\r\n398:                    .received\r\n399:                    .fetch_add(chunk.len() as u64, Ordering::Relaxed);\r\n400:                progress.emit_if_due();\r\n401:\r\n402:                if completed.saturating_sub(checkpointed) >= RESUME_CHECKPOINT_BYTES\r\n403:                    || completed == segment_len\r\n404:                {\r\n405:                    let mut state = state_file.lock().await;\r\n406:                    state\r\n407:                        .seek(std::io::SeekFrom::Start((index * 8) as u64))\r\n408:                        .await\r\n409:                        .map_err(|e| format!(\"구간 상태 seek 실패: {e}\"))?;\r\n410:                    state\r\n411:                        .write_all(&completed.to_le_bytes())\r\n412:                        .await\r\n413:                        .map_err(|e| format!(\"구간 상태 저장 실패: {e}\"))?;\r\n414:                    checkpointed = completed;\r\n415:                }\r\n416:            }\r\n417:            file.flush()\r\n418:                .await\r\n419:                .map_err(|e| format!(\"구간 {index} flush 실패: {e}\"))?;\r\n420:            Ok::<(), String>(())\r\n421:        }\r\n422:        .await;\r\n423:\r\n424:        match transfer {\r\n425:            Ok(()) if completed == segment_len => return Ok(()),\r\n426:            Ok(()) if attempt + 1 < MAX_RETRIES => {\r\n427:                tokio::time::sleep(Duration::from_millis(500 * (attempt as u64 + 1))).await;\r\n428:            }\r\n429:            Ok(()) => {\r\n430:                return Err(format!(\r\n431:                    \"구간 {index} 크기 불일치: {completed}/{segment_len} bytes\"\r\n432:                ))\r\n433:            }\r\n434:            // 취소는 재시도하지 않고 즉시 올린다.\r\n435:            Err(e) if e == CANCEL_SENTINEL => return Err(e),\r\n436:            Err(e) if attempt + 1 < MAX_RETRIES => {\r\n437:                tokio::time::sleep(Duration::from_millis(500 * (attempt as u64 + 1))).await;\r\n438:                eprintln!(\"[segmented-download] 구간 {index} 재시도: {e}\");\r\n439:            }\r\n440:            Err(e) => return Err(e),\r\n441:        }\r\n442:    }\r\n443:    Err(format!(\"구간 {index} 재시도 횟수 초과\"))\r\n444:}\r\n445:\r\n446:async fn segmented<F>(\r\n447:    client: Client,\r\n448:    request_info: DownloadRequest,\r\n449:    total: u64,\r\n450:    cancel: Arc<AtomicBool>,\r\n451:    callback: Arc<F>,\r\n452:) -> Result<PathBuf, String>\r\n453:where\r\n454:    F: Fn(DownloadProgress) + Send + Sync + 'static,\r\n455:{\r\n456:    let segment_count = (CONNECTIONS * SEGMENTS_PER_CONNECTION)\r\n457:        .min(usize::try_from(total.max(1)).unwrap_or(usize::MAX))\r\n458:        .max(1);\r\n459:    let (part_path, meta_path, state_path, offsets) =\r\n460:        prepare_resume(&request_info.destination, total, segment_count).await?;\r\n461:    let resumed = offsets.iter().copied().sum::<u64>().min(total);\r\n462:    let received = Arc::new(AtomicU64::new(resumed));\r\n463:    let callback: Arc<dyn Fn(DownloadProgress) + Send + Sync> = callback;\r\n464:    let progress = Arc::new(ProgressEmitter::new(\r\n465:        received,\r\n466:        Some(total),\r\n467:        DownloadMode::Segmented,\r\n468:        callback,\r\n469:    ));\r\n470:    progress.emit();\r\n471:\r\n472:    let state_file = Arc::new(Mutex::new(\r\n473:        tokio::fs::OpenOptions::new()\r\n474:            .read(true)\r\n475:            .write(true)\r\n476:            .open(&state_path)\r\n477:            .await\r\n478:            .map_err(|e| format!(\"구간 상태 열기 실패: {e}\"))?,\r\n479:    ));\r\n480:    let next = Arc::new(AtomicUsize::new(0));\r\n481:    let offsets = Arc::new(offsets);\r\n482:    let mut workers = JoinSet::new();\r\n483:\r\n484:    for _ in 0..CONNECTIONS.min(segment_count) {\r\n485:        let client = client.clone();\r\n486:        let request_info = request_info.clone();\r\n487:        let part_path = part_path.clone();\r\n488:        let state_file = state_file.clone();\r\n489:        let progress = progress.clone();\r\n490:        let next = next.clone();\r\n491:        let offsets = offsets.clone();\r\n492:        let cancel = cancel.clone();\r\n493:        workers.spawn(async move {\r\n494:            loop {\r\n495:                if cancelled(&cancel) {\r\n496:                    return Err::<(), String>(CANCEL_SENTINEL.to_string());\r\n497:                }\r\n498:                let index = next.fetch_add(1, Ordering::Relaxed);\r\n499:                if index >= segment_count {\r\n500:                    return Ok::<(), String>(());\r\n501:                }\r\n502:                download_segment(\r\n503:                    &client,\r\n504:                    &request_info,\r\n505:                    &part_path,\r\n506:                    state_file.clone(),\r\n507:                    progress.clone(),\r\n508:                    cancel.clone(),\r\n509:                    segment_count,\r\n510:                    index,\r\n511:                    offsets[index],\r\n512:                )\r\n513:                .await?;\r\n514:            }\r\n515:        });\r\n516:    }\r\n517:\r\n518:    while let Some(result) = workers.join_next().await {\r\n519:        let joined = result.map_err(|e| format!(\"다운로드 작업 실행 실패: {e}\"))?;\r\n520:        if let Err(e) = joined {\r\n521:            // 취소 sentinel은 감싸지 않고 그대로 올려 `download`가 Ok(None)으로 바꾸게 한다.\r\n522:            if e == CANCEL_SENTINEL {\r\n523:                return Err(CANCEL_SENTINEL.to_string());\r\n524:            }\r\n525:            return Err(format!(\"분할 다운로드 실패: {e}\"));\r\n526:        }\r\n527:    }\r\n528:\r\n529:    progress.received.store(total, Ordering::Relaxed);\r\n530:    progress.emit();\r\n531:    tokio::fs::rename(&part_path, &request_info.destination)\r\n532:        .await\r\n533:        .map_err(|e| {\r\n534:            format!(\r\n535:                \"완료 파일 이동 실패({}): {e}\",\r\n536:                request_info.destination.display()\r\n537:            )\r\n538:        })?;\r\n539:    let _ = tokio::fs::remove_file(meta_path).await;\r\n540:    let _ = tokio::fs::remove_file(state_path).await;\r\n541:    Ok(request_info.destination)\r\n542:}\r\n543:\r\n544:async fn single<F>(\r\n545:    client: Client,\r\n546:    request_info: DownloadRequest,\r\n547:    expected_total: Option<u64>,\r\n548:    cancel: Arc<AtomicBool>,\r\n549:    callback: Arc<F>,\r\n550:) -> Result<PathBuf, String>\r\n551:where\r\n552:    F: Fn(DownloadProgress) + Send + Sync + 'static,\r\n553:{\r\n554:    let part_path = sidecar_path(&request_info.destination, \"download\");\r\n555:    let mut response = request(&client, reqwest::Method::GET, &request_info)\r\n556:        .send()\r\n557:        .await\r\n558:        .map_err(|e| format!(\"단일 다운로드 연결 실패: {e}\"))?;\r\n559:    if !response.status().is_success() {\r\n560:        return Err(format!(\"다운로드 서버 오류: HTTP {}\", response.status()));\r\n561:    }\r\n562:    let total = response.content_length().or(expected_total);\r\n563:    let received = Arc::new(AtomicU64::new(0));\r\n564:    let callback: Arc<dyn Fn(DownloadProgress) + Send + Sync> = callback;\r\n565:    let progress = ProgressEmitter::new(received, total, DownloadMode::Single, callback);\r\n566:    progress.emit();\r\n567:\r\n568:    let mut file = tokio::fs::File::create(&part_path)\r\n569:        .await\r\n570:        .map_err(|e| format!(\"임시 파일 생성 실패({}): {e}\", part_path.display()))?;\r\n571:    while let Some(chunk) = response\r\n572:        .chunk()\r\n573:        .await\r\n574:        .map_err(|e| format!(\"다운로드 수신 실패: {e}\"))?\r\n575:    {\r\n576:        if cancelled(&cancel) {\r\n577:            return Err(CANCEL_SENTINEL.to_string());\r\n578:        }\r\n579:        file.write_all(&chunk)\r\n580:            .await\r\n581:            .map_err(|e| format!(\"파일 쓰기 실패: {e}\"))?;\r\n582:        progress\r\n583:            .received\r\n584:            .fetch_add(chunk.len() as u64, Ordering::Relaxed);\r\n585:        progress.emit_if_due();\r\n586:    }\r\n587:    file.flush()\r\n588:        .await\r\n589:        .map_err(|e| format!(\"파일 flush 실패: {e}\"))?;\r\n590:    progress.emit();\r\n591:    tokio::fs::rename(&part_path, &request_info.destination)\r\n592:        .await\r\n593:        .map_err(|e| {\r\n594:            format!(\r\n595:                \"완료 파일 이동 실패({}): {e}\",\r\n596:                request_info.destination.display()\r\n597:            )\r\n598:        })?;\r\n599:    Ok(request_info.destination)\r\n600:}\r\n601:\r\n602:/// 최종 URL을 받아 파일을 전송한다. `Ok(Some(path))` 성공, `Ok(None)` 취소, `Err` 실패.\r\n603:/// 취소 시 sidecar를 남겨 다음 실행에서 재개할 수 있게 한다.\r\n604:pub async fn download<F>(\r\n605:    request_info: DownloadRequest,\r\n606:    cancel: Arc<AtomicBool>,\r\n607:    on_progress: F,\r\n608:) -> Result<Option<PathBuf>, String>\r\n609:where\r\n610:    F: Fn(DownloadProgress) + Send + Sync + 'static,\r\n611:{\r\n612:    let client = client()?;\r\n613:    let (range_supported, total) = probe_range(&client, &request_info).await?;\r\n614:    let callback = Arc::new(on_progress);\r\n615:    let result = match (range_supported, total) {\r\n616:        (true, Some(total)) => segmented(client, request_info, total, cancel, callback).await,\r\n617:        _ => single(client, request_info, total, cancel, callback).await,\r\n618:    };\r\n619:    match result {\r\n620:        Ok(path) => Ok(Some(path)),\r\n621:        Err(e) if e == CANCEL_SENTINEL => Ok(None),\r\n622:        Err(e) => Err(e),\r\n623:    }\r\n624:}\r\n625:\r\n","exit_code":0,"status":"completed"}}
