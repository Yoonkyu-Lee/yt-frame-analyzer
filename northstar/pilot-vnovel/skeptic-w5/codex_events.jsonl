{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"\"C:\\\\windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -NoProfile -Command 'rg -n \"''^\" after/segmented_download.rs -m 496'","aggregated_output":"1://! Intent: 최종 파일 URL을 최대 8개 연결로 나눠 받아 재개 가능하게 완성한다. 잘못된 바이트로 끝난 파일은 만들지 않는다(D1-D10).\n2://! Data: 남은 구간 목록 `[start,end)`(미배정 `todo` + 연결별 진행 중 `slots`)이 전부다. 재개 상태는 이 목록을 적은 고정 크기 텍스트 sidecar 한 개다(FNV 합 + 끝 표식).\n3://! Assumes: 같은 URL은 진행/중단 동안 같은 바이트를 준다(크기만 검증). 서버는 `Content-Range`(시작·총량)를 지킨다. 파일 쓰기는 짧아서 async 안에서 블로킹해도 된다.\n4://! Weak: 같은 크기의 다른 파일은 못 알아챈다(섞인다). fsync를 하지 않아 정전 시 상태가 데이터보다 앞설 수 있다. 단일 스트림은 재개도 자동 재시도도 없다(0부터 다시 받게 되므로). 파일 쓰기가 오래 멈추면 그동안 비동기 작업자를 붙잡는다.\n5://! Cost: 청크마다 mutex 하나(기록+진행 갱신), 1 MiB마다 상태 파일 제자리 덮어쓰기. 느린 연결은 끝에서 남은 구간을 빈 연결에 넘겨(steal) 보완하되 버려지는 전송 중 바이트가 있다.\n6:\n7:use reqwest::header::{ACCEPT_ENCODING, CONTENT_RANGE, COOKIE, RANGE, REFERER};\n8:use reqwest::{Client, RequestBuilder, StatusCode};\n9:use serde::Serialize;\n10:use std::collections::HashMap;\n11:use std::io::{Seek, SeekFrom, Write};\n12:use std::path::{Path, PathBuf};\n13:use std::sync::atomic::{AtomicBool, Ordering};\n14:use std::sync::{Arc, LazyLock, Mutex, MutexGuard, PoisonError};\n15:use std::time::{Duration, Instant};\n16:use tokio::task::JoinSet;\n17:\n18:const CONNECTIONS: usize = 8; // D3: 동시 연결 상한\n19:const MAX_TRIES: usize = 4; // D6: 프로브·구간당 시도 횟수 (대기 0.5s, 1s, 1.5s)\n20:// D6: 연결만 열어 두고 이만큼 아무것도 보내지 않으면 실패로 본다 (테스트에서는 짧게)\n21:const STALL_SECS: u64 = if cfg!(test) { 2 } else { 30 };\n22:const PROGRESS_EVERY: Duration = Duration::from_millis(250); // D8\n23:const CHECKPOINT_BYTES: u64 = 1024 * 1024; // D4: 상태 기록 간격 = 재수신 상한\n24:const MIN_STEAL: u64 = 128 * 1024; // 남은 구간이 이 두 배 미만이면 쪼개지 않는다\n25:const STATE_BYTES: usize = 4096; // 상태 파일은 항상 이 크기로 덮어써 낡은 꼬리가 남지 않는다\n26:const CANCELLED: &str = \"취소됨\";\n27:const USER_AGENT: &str = \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 \\\n28:     (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36\";\n29:\n30:#[derive(Debug, Clone)]\n31:pub struct DownloadRequest {\n32:    pub url: String,\n33:    pub destination: PathBuf,\n34:    pub cookie_header: Option<String>,\n35:    pub referer: Option<String>,\n36:}\n37:\n38:#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize)]\n39:#[serde(rename_all = \"lowercase\")]\n40:pub enum DownloadMode {\n41:    Segmented,\n42:    Single,\n43:}\n44:\n45:#[derive(Debug, Clone, Copy)]\n46:pub struct DownloadProgress {\n47:    pub received: u64,\n48:    pub total: Option<u64>,\n49:    pub mode: DownloadMode,\n50:}\n51:\n52:// D7: 토큰 → 취소 플래그. dist_host가 spawn한 task를 취소 커맨드가 토큰으로 찾는다.\n53:static CANCELLERS: LazyLock<Mutex<HashMap<String, Arc<AtomicBool>>>> = LazyLock::new(Default::default);\n54:\n55:fn registry() -> MutexGuard<'static, HashMap<String, Arc<AtomicBool>>> {\n56:    CANCELLERS.lock().unwrap_or_else(PoisonError::into_inner)\n57:}\n58:\n59:pub fn register_cancel(token: &str) -> Arc<AtomicBool> {\n60:    let flag = Arc::new(AtomicBool::new(false));\n61:    registry().insert(token.to_string(), flag.clone());\n62:    flag\n63:}\n64:\n65:pub fn request_cancel(token: &str) -> bool {\n66:    registry().get(token).map(|f| f.store(true, Ordering::SeqCst)).is_some()\n67:}\n68:\n69:pub fn clear_cancel(token: &str) {\n70:    registry().remove(token);\n71:}\n72:\n73:/// D9: 모든 요청의 공통 헤더. identity가 아니면 바이트 오프셋이 파일 오프셋과 달라진다.\n74:fn get(client: &Client, req: &DownloadRequest) -> RequestBuilder {\n75:    let mut b = client.get(&req.url).header(ACCEPT_ENCODING, \"identity\");\n76:    if let Some(v) = req.cookie_header.as_deref().filter(|v| !v.is_empty()) {\n77:        b = b.header(COOKIE, v);\n78:    }\n79:    if let Some(v) = req.referer.as_deref().filter(|v| !v.is_empty()) {\n80:        b = b.header(REFERER, v);\n81:    }\n82:    b\n83:}\n84:\n85:fn side(dest: &Path, suffix: &str) -> PathBuf {\n86:    let mut s = dest.as_os_str().to_owned();\n87:    s.push(suffix);\n88:    s.into()\n89:}\n90:\n91:type Span = (u64, u64); // [start, end)\n92:\n93:/// 스케줄링 상태 전부: 미배정 구간, 연결별 진행 중 구간(start가 곧 재개 오프셋), 받은 총량.\n94:struct Shared {\n95:    todo: Vec<Span>,\n96:    slots: Vec<Span>,\n97:    state: std::fs::File,\n98:    done: u64,\n99:    last_ckpt: u64,\n100:    last_emit: Instant,\n101:}\n102:\n103:impl Shared {\n104:    /// 연결 `slot`에 구간을 배정한다: 미배정 구간 우선, 없으면 가장 많이 남은 연결의 뒤 절반을\n105:    /// 가져온다(느린 연결을 빠른 연결이 돕는다). 줄 게 없으면 false.\n106:    fn claim(&mut self, slot: usize) -> bool {\n107:        let span = self.todo.pop().or_else(|| {\n108:            let (v, (pos, end)) =\n109:                self.slots.iter().copied().enumerate().max_by_key(|(_, (p, e))| e - p)?;\n110:            let rest = end - pos;\n111:            if rest < 2 * MIN_STEAL {\n112:                return None;\n113:            }\n114:            self.slots[v].1 = pos + rest / 2;\n115:            Some((pos + rest / 2, end))\n116:        });\n117:        self.slots[slot] = span.unwrap_or((0, 0));\n118:        span.is_some()\n119:    }\n120:\n121:    /// D4: 남은 구간을 상태 파일에 제자리로 쓴다. 상태는 항상 실제보다 덜 진행된 쪽(남은 구간의 상위\n122:    /// 집합)이라 낡은 기록도 안전하다. 쓰기 실패는 재개 보장이 깨진 것이므로 숨기지 않고 오류로 올린다.\n123:    fn checkpoint(&mut self, total: u64) -> Result<(), String> {\n124:        let text = state_text(total, &self.remaining());\n125:        self.state\n126:            .seek(SeekFrom::Start(0))\n127:            .and_then(|_| self.state.write_all(text.as_bytes()))\n128:            .map_err(|e| format!(\"재개 상태 저장 실패: {e}\"))\n129:    }\n130:\n131:    /// 아직 안 받은 모든 구간 (D4 상태이자 완료 판정 근거).\n132:    fn remaining(&self) -> Vec<Span> {\n133:        self.todo.iter().chain(&self.slots).copied().filter(|(a, b)| a < b).collect()\n134:    }\n135:}\n136:\n137:struct Ctx {\n138:    client: Client,\n139:    req: DownloadRequest,\n140:    total: u64,\n141:    part: PathBuf,\n142:    cancel: Arc<AtomicBool>,\n143:    on_progress: Box<dyn Fn(DownloadProgress) + Send + Sync>,\n144:    sh: Mutex<Shared>,\n145:}\n146:\n147:enum Fail {\n148:    Retry(String),\n149:    Fatal(String),\n150:}\n151:\n152:impl Fail {\n153:    fn text(self) -> String {\n154:        match self {\n155:            Fail::Retry(e) | Fail::Fatal(e) => e,\n156:        }\n157:    }\n158:}\n159:\n160:/// D6/D7: 응답·청크를 기다리되 1초마다 취소를 보고, STALL_SECS 동안 아무것도 오지 않으면 재시도할\n161:/// 실패로 본다. 연결만 열어 두고 침묵하는 서버 앞에서 영원히 기다리며 취소도 듣지 않던 것을 막는다.\n162:async fn wait<T, E: std::fmt::Display>(\n163:    fut: impl std::future::Future<Output = Result<T, E>>,\n164:    cancel: &AtomicBool,\n165:    what: &str,\n166:) -> Result<T, Fail> {\n167:    let mut fut = std::pin::pin!(fut);\n168:    for _ in 0..STALL_SECS {\n169:        match tokio::time::timeout(Duration::from_secs(1), &mut fut).await {\n170:            Ok(r) => return r.map_err(|e| Fail::Retry(format!(\"{what}: {e}\"))),\n171:            Err(_) if cancel.load(Ordering::Relaxed) => return Err(Fail::Fatal(CANCELLED.into())),\n172:            Err(_) => {}\n173:        }\n174:    }\n175:    Err(Fail::Retry(format!(\"{what}: {STALL_SECS}초 동안 서버가 아무것도 보내지 않았습니다\")))\n176:}\n177:\n178:impl Ctx {\n179:    fn lock(&self) -> MutexGuard<'_, Shared> {\n180:        self.sh.lock().unwrap_or_else(PoisonError::into_inner)\n181:    }\n182:\n183:    fn emit(&self, received: u64) {\n184:        (self.on_progress)(DownloadProgress {\n185:            received,\n186:            total: Some(self.total),\n187:            mode: DownloadMode::Segmented,\n188:        });\n189:    }\n190:\n191:    /// 청크를 자기 구간(steal로 줄었을 수 있음)만큼만 쓰고 진행/상태를 갱신한다. 구간을 다 채웠으면 true.\n192:    fn accept(&self, slot: usize, file: &mut std::fs::File, chunk: &[u8]) -> Result<bool, String> {\n193:        let mut sh = self.lock();\n194:        let (pos, end) = sh.slots[slot];\n195:        let n = (chunk.len() as u64).min(end - pos);\n196:        file.write_all(&chunk[..n as usize]).map_err(|e| format!(\"파일 쓰기 실패: {e}\"))?;\n197:        sh.slots[slot].0 += n;\n198:        sh.done += n;\n199:        if sh.done - sh.last_ckpt >= CHECKPOINT_BYTES {\n200:            sh.last_ckpt = sh.done;\n201:            sh.checkpoint(self.total)?;\n202:        }\n203:        if sh.last_emit.elapsed() >= PROGRESS_EVERY {\n204:            sh.last_emit = Instant::now();\n205:            self.emit(sh.done); // D8: 잠금 안에서 보내야 두 연결의 진행률 순서가 뒤바뀌지 않는다\n206:        }\n207:        Ok(pos + n == end)\n208:    }\n209:\n210:    /// 한 번의 Range 요청으로 `slot`의 구간을 이어 받는다. D5: 시작이 다른 Content-Range나 요청보다 긴 본문은 치명적.\n211:    async fn stream(&self, slot: usize, file: &mut std::fs::File, pos: u64, end: u64) -> Result<(), Fail> {\n212:        let request = get(&self.client, &self.req).header(RANGE, format!(\"bytes={pos}-{}\", end - 1)).send();\n213:        let mut resp = wait(request, &self.cancel, \"구간 연결 실패\").await?;\n214:        if resp.status() != StatusCode::PARTIAL_CONTENT {\n215:            return Err(Fail::Retry(format!(\"Range 응답이 아닙니다: HTTP {}\", resp.status())));\n216:        }\n217:        // 총량까지 맞아야 한다: 프로브와 다른 크기를 말하는 서버의 파일을 잘린 채 완성하지 않는다\n218:        let (head, tail) = (format!(\"bytes {pos}-\"), format!(\"/{}\", self.total));\n219:        let range = resp.headers().get(CONTENT_RANGE).and_then(|v| v.to_str().ok());\n220:        if !range.is_some_and(|v| v.starts_with(&head) && v.ends_with(&tail)) {\n221:            return Err(Fail::Fatal(\"Content-Range가 요청 범위와 다릅니다\".into()));\n222:        }\n223:        // D5: 요청한 길이를 다 채우면 남은 본문을 읽지 않고 끝내므로(넘겨받기 때문), 더 긴 응답은 미리 거른다\n224:        if resp.content_length().is_some_and(|n| n != end - pos) {\n225:            return Err(Fail::Fatal(\"응답 길이가 요청한 구간과 다릅니다\".into()));\n226:        }\n227:        file.seek(SeekFrom::Start(pos)).map_err(|e| Fail::Fatal(format!(\"seek 실패: {e}\")))?;\n228:        let mut at = pos;\n229:        while let Some(chunk) = wait(resp.chunk(), &self.cancel, \"수신 실패\").await? {\n230:            if self.cancel.load(Ordering::Relaxed) {\n231:                return Err(Fail::Fatal(CANCELLED.into()));\n232:            }\n233:            at += chunk.len() as u64;\n234:            if at > end {\n235:                return Err(Fail::Fatal(\"응답이 요청한 크기를 초과했습니다\".into()));\n236:            }\n237:            if self.accept(slot, file, &chunk).map_err(Fail::Fatal)? {\n238:                return Ok(());\n239:            }\n240:        }\n241:        Err(Fail::Retry(\"응답이 요청한 크기보다 짧습니다\".into()))\n242:    }\n243:\n244:    /// D6: 배정된 구간을 끝까지 받는다. 재시도는 받은 곳부터 이어 간다.\n245:    async fn fetch(&self, slot: usize) -> Result<(), String> {\n246:        let mut file = std::fs::OpenOptions::new()\n247:            .write(true)\n248:            .open(&self.part)\n249:            .map_err(|e| format!(\"임시 파일 열기 실패: {e}\"))?;\n250:        let mut last = String::new();\n251:        for attempt in 0..MAX_TRIES {\n252:            if attempt > 0 {\n253:                tokio::time::sleep(Duration::from_millis(500 * attempt as u64)).await;\n254:            }\n255:            if self.cancel.load(Ordering::Relaxed) {\n256:                return Err(CANCELLED.into());\n257:            }\n258:            let (pos, end) = self.lock().slots[slot];\n259:            if pos >= end {\n260:                return Ok(());\n261:            }\n262:            match self.stream(slot, &mut file, pos, end).await {\n263:                Ok(()) => return Ok(()),\n264:                Err(Fail::Fatal(e)) => return Err(e),\n265:                Err(Fail::Retry(e)) => last = e,\n266:            }\n267:        }\n268:        Err(format!(\"다운로드 실패(재시도 {MAX_TRIES}회 초과): {last}\"))\n269:    }\n270:}\n271:\n272:fn fnv(text: &str) -> u64 {\n273:    text.bytes().fold(0xcbf2_9ce4_8422_2325, |h, b| (h ^ u64::from(b)).wrapping_mul(0x0100_0000_01b3))\n274:}\n275:\n276:/// D4/D5: 재개 상태 텍스트 = 총량, 남은 구간들, 그 본문의 FNV-1a 합, 끝 표식. 덮어쓰다 잘려\n277:/// 숫자 일부만 바뀐 파일은 합이 맞지 않아 버려진다(실제보다 앞선 진행을 주장하지 못한다).\n278:fn state_text(total: u64, spans: &[Span]) -> String {\n279:    let mut body = format!(\"{total}\\n\");\n280:    for (a, b) in spans {\n281:        body += &format!(\"{a} {b}\\n\");\n282:    }\n283:    let sum = fnv(&body);\n284:    format!(\"{:<w$}\", format!(\"{body}sum {sum}\\nend\\n\"), w = STATE_BYTES)\n285:}\n286:\n287:/// D4: 저장된 남은 구간 목록. 크기·합·형식·범위가 하나라도 이상하면 None(→ 처음부터).\n288:fn load_state(state: &Path, part: &Path, total: u64) -> Option<Vec<Span>> {\n289:    let text = std::fs::read_to_string(state).ok()?;\n290:    if std::fs::metadata(part).ok()?.len() != total {\n291:        return None;\n292:    }\n293:    let (body, rest) = text.split_once(\"sum \")?;\n294:    if rest.split_once(\"\\nend\\n\")?.0.parse::<u64>().ok()? != fnv(body) {\n295:        return None;\n296:    }\n297:    let mut lines = body.lines();\n298:    if lines.next()?.parse::<u64>().ok()? != total {\n299:        return None;\n300:    }\n301:    let mut spans: Vec<Span> = lines\n302:        .map(|l| {\n303:            let (a, b) = l.split_once(' ')?;\n304:            let (a, b) = (a.parse().ok()?, b.parse().ok()?);\n305:            (a < b && b <= total).then_some((a, b))\n306:        })\n307:        .collect::<Option<_>>()?;\n308:    // D5: 겹치는 구간을 받아들이면 같은 바이트를 두 번 세고 다른 곳을 비운 채 완료된다\n309:    spans.sort_unstable();\n310:    spans.windows(2).all(|w| w[0].1 <= w[1].0).then_some(spans)\n311:}\n312:\n313:/// D2: `bytes=0-0` 프로브의 결론. 프로브 응답은 여기서 버려져 연결을 붙잡지 않는다(D3).\n314:enum Plan {\n315:    Segmented(u64),\n316:    Single(Option<u64>), // 200이 알려 준 크기: 본 요청이 크기를 안 알려 줄 때 짧은 파일을 잡는 기준\n317:}\n318:\n319:/// D6: 프로브도 일시적 실패는 재시도한다. 첫 연결이 한 번 끊겼다고 작업 전체를 실패시키지 않는다.\n320:async fn probe(client: &Client, req: &DownloadRequest, cancel: &AtomicBool) -> Result<Plan, String> {\n321:    let mut last = String::new();\n322:    for attempt in 0..MAX_TRIES {\n323:        if attempt > 0 {\n324:            tokio::time::sleep(Duration::from_millis(500 * attempt as u64)).await;\n325:        }\n326:        let sent = get(client, req).header(RANGE, \"bytes=0-0\").send();\n327:        let resp = match wait(sent, cancel, \"다운로드 서버 연결 실패\").await {\n328:            Ok(resp) => resp,\n329:            Err(Fail::Retry(e)) => {\n330:                last = e;\n331:                continue;\n332:            }\n333:            Err(Fail::Fatal(e)) => return Err(e),\n334:        };\n335:        return match resp.status() {\n336:            StatusCode::PARTIAL_CONTENT => Ok(resp\n337:                .headers()\n338:                .get(CONTENT_RANGE)\n339:                .and_then(|v| v.to_str().ok())\n340:                .and_then(|v| v.rsplit_once('/')?.1.parse().ok())\n341:                .filter(|n| *n > 0)\n342:                .map_or(Plan::Single(None), Plan::Segmented)),\n343:            s if s.is_success() => Ok(Plan::Single(resp.content_length())),\n344:            s => Err(format!(\"다운로드 서버가 요청을 거부했습니다: HTTP {s}\")),\n345:        };\n346:    }\n347:    Err(format!(\"{last} (재시도 {MAX_TRIES}회 초과)\"))\n348:}\n349:\n350:async fn segmented(\n351:    client: Client,\n352:    req: DownloadRequest,\n353:    total: u64,\n354:    cancel: Arc<AtomicBool>,\n355:    on_progress: Box<dyn Fn(DownloadProgress) + Send + Sync>,\n356:) -> Result<(), String> {\n357:    let part = side(&req.destination, \".download\");\n358:    let state_path = side(&req.destination, \".download.state\");\n359:    let todo = match load_state(&state_path, &part, total) {\n360:        Some(todo) => todo,\n361:        None => {\n362:            // 옛 상태부터 지운다: 본문을 새로 만든 뒤 크래시하면 옛 완료 기록이 빈 구간을 건너뛰게 된다\n363:            if let Err(e) = std::fs::remove_file(&state_path) {\n364:                if e.kind() != std::io::ErrorKind::NotFound {\n365:                    return Err(format!(\"이전 재개 상태 정리 실패: {e}\"));\n366:                }\n367:            }\n368:            let file = std::fs::File::create(&part).map_err(|e| format!(\"임시 파일 생성 실패: {e}\"))?;\n369:            file.set_len(total).map_err(|e| format!(\"임시 파일 크기 설정 실패: {e}\"))?;\n370:            let n = CONNECTIONS as u64;\n371:            (0..n).map(|i| (total * i / n, total * (i + 1) / n)).filter(|(a, b)| a < b).collect()\n372:        }\n373:    };\n374:    let left: u64 = todo.iter().map(|(a, b)| b - a).sum();\n375:    let done = total.saturating_sub(left);\n376:    let state = std::fs::OpenOptions::new()\n377:        .write(true)\n378:        .create(true)\n379:        .truncate(false)\n380:        .open(&state_path)\n381:        .map_err(|e| format!(\"상태 파일 열기 실패: {e}\"))?;\n382:    let slots = vec![(0, 0); CONNECTIONS];\n383:    let sh = Shared { todo, slots, state, done, last_ckpt: done, last_emit: Instant::now() };\n384:    let ctx = Arc::new(Ctx { client, req, total, part, cancel, on_progress, sh: Mutex::new(sh) });\n385:    ctx.emit(done);\n386:    ctx.lock().checkpoint(total)?;\n387:\n388:    let mut workers = JoinSet::new();\n389:    for slot in 0..CONNECTIONS {\n390:        let ctx = ctx.clone();\n391:        workers.spawn(async move {\n392:            while ctx.lock().claim(slot) {\n393:                ctx.fetch(slot).await?;\n394:            }\n395:            Ok::<(), String>(())\n396:        });\n397:    }\n398:    let mut result = Ok(());\n399:    while let Some(joined) = workers.join_next().await {\n400:        result = joined.map_err(|e| format!(\"다운로드 작업 실행 실패: {e}\")).and_then(|r| r);\n401:        if result.is_err() {\n402:            break;\n403:        }\n404:    }\n405:    workers.shutdown().await;\n406:    let mut sh = ctx.lock();\n407:    // D7: 남은 구간이 없어도(이미 다 받은 재개) 취소가 켜져 있으면 완성 파일을 내놓지 않는다\n408:    if result.is_err() || !sh.remaining().is_empty() || ctx.cancel.load(Ordering::Relaxed) {\n409:        let saved = sh.checkpoint(total); // D4: 중단/실패 시점의 정확한 위치를 남긴다\n410:        return result.and(saved).and(Err(\"일부 구간을 받지 못했습니다\".into()));\n411:    }\n412:    drop(sh);\n413:    ctx.emit(total);\n414:    std::fs::rename(&ctx.part, &ctx.req.destination).map_err(|e| format!(\"완료 파일 이동 실패: {e}\"))\n415:}\n416:\n417:/// D2: Range 없이 한 번에 받는다(재개 불가). 실패/취소 시 임시 파일은 버린다.\n418:async fn single(\n419:    client: Client,\n420:    req: DownloadRequest,\n421:    expected: Option<u64>,\n422:    cancel: Arc<AtomicBool>,\n423:    on_progress: Box<dyn Fn(DownloadProgress) + Send + Sync>,\n424:) -> Result<(), String> {\n425:    let mut resp = wait(get(&client, &req).send(), &cancel, \"다운로드 서버 연결 실패\").await.map_err(Fail::text)?;\n426:    // D5: Range 없이 물었으니 전체(200)만 받는다. 206은 파일의 일부라 완성본이 될 수 없다\n427:    if resp.status() != StatusCode::OK {\n428:        return Err(format!(\"다운로드 서버가 전체 파일을 주지 않았습니다: HTTP {}\", resp.status()));\n429:    }\n430:    let total = resp.content_length().or(expected);\n431:    let emit = |received| on_progress(DownloadProgress { received, total, mode: DownloadMode::Single });\n432:    let part = side(&req.destination, \".download\");\n433:    let copied = async {\n434:        let mut file = std::fs::File::create(&part).map_err(|e| format!(\"임시 파일 생성 실패: {e}\"))?;\n435:        let (mut got, mut last) = (0u64, Instant::now());\n436:        emit(0);\n437:        while let Some(chunk) = wait(resp.chunk(), &cancel, \"수신 실패\").await.map_err(Fail::text)? {\n438:            if cancel.load(Ordering::Relaxed) {\n439:                return Err(CANCELLED.to_string());\n440:            }\n441:            file.write_all(&chunk).map_err(|e| format!(\"파일 쓰기 실패: {e}\"))?;\n442:            got += chunk.len() as u64;\n443:            if last.elapsed() >= PROGRESS_EVERY {\n444:                last = Instant::now();\n445:                emit(got);\n446:            }\n447:        }\n448:        if total.is_some_and(|t| t != got) {\n449:            return Err(\"응답 크기가 예정 크기와 다릅니다\".to_string());\n450:        }\n451:        if cancel.load(Ordering::Relaxed) {\n452:            return Err(CANCELLED.to_string()); // D7: 마지막 청크 뒤(또는 빈 본문)에 켜진 취소\n453:        }\n454:        emit(got);\n455:        std::fs::rename(&part, &req.destination).map_err(|e| format!(\"완료 파일 이동 실패: {e}\"))\n456:    }\n457:    .await;\n458:    if copied.is_err() {\n459:        let _ = std::fs::remove_file(&part);\n460:    }\n461:    copied\n462:}\n463:\n464:/// `Ok(Some(path))` 완료, `Ok(None)` 취소(재개 상태 유지), `Err` 실패(D10: 한국어 메시지).\n465:pub async fn download<F>(\n466:    request: DownloadRequest,\n467:    cancel: Arc<AtomicBool>,\n468:    on_progress: F,\n469:) -> Result<Option<PathBuf>, String>\n470:where\n471:    F: Fn(DownloadProgress) + Send + Sync + 'static,\n472:{\n473:    let client = Client::builder()\n474:        .connect_timeout(Duration::from_secs(20))\n475:        .redirect(reqwest::redirect::Policy::limited(10))\n476:        .referer(false) // D9: 리디렉트 뒤에도 호출자가 준 Referer를 그대로 보낸다\n477:        .user_agent(USER_AGENT)\n478:        .build()\n479:        .map_err(|e| format!(\"HTTP 클라이언트 생성 실패: {e}\"))?;\n480:    let dest = request.destination.clone();\n481:    let on_progress = Box::new(on_progress);\n482:    let flag = cancel.clone();\n483:    let result = match probe(&client, &request, &cancel).await {\n484:        Ok(Plan::Segmented(total)) => segmented(client, request, total, cancel, on_progress).await,\n485:        Ok(Plan::Single(expected)) => single(client, request, expected, cancel, on_progress).await,\n486:        Err(e) => Err(e), // 프로브 중 취소도 아래에서 Ok(None)이 된다\n487:    };\n488:    match result {\n489:        Ok(()) => {\n490:            let _ = std::fs::remove_file(side(&dest, \".download.state\")); // D1: 성공 뒤 잔여물 없음\n491:            Ok(Some(dest))\n492:        }\n493:        Err(_) if flag.load(Ordering::Relaxed) => Ok(None),\n494:        Err(e) => Err(e),\n495:    }\n496:}\n","exit_code":0,"status":"completed"}}
