\r\n  314 enum Plan {\r\n  315     Segmented(u64),\r\n  316     Single(Option<u64>), // 200�� �˷� �� ũ��: �� ��û�� ũ�⸦ �� �˷� �� �� ª�� ������ ��� ����\r\n  317 }\r\n  318 \r\n  319 /// D6: ���κ굵 �Ͻ��� ���д� ��õ��Ѵ�. ù ������ �� �� ����ٰ� �۾� ��ü�� ���н�Ű�� �ʴ´�.\r\n  320 async fn probe(client: &Client, req: &DownloadRequest, cancel: &AtomicBool) -> Result<Plan, String> {\r\n  321     let mut last = String::new();\r\n  322     for attempt in 0..MAX_TRIES {\r\n  323         if attempt > 0 {\r\n  324             tokio::time::sleep(Duration::from_millis(500 * attempt as u64)).await;\r\n  325         }\r\n  326         let sent = get(client, req).header(RANGE, \"bytes=0-0\").send();\r\n  327         let resp = match wait(sent, cancel, \"�ٿ�ε� ���� ���� ����\").await {\r\n  328             Ok(resp) => resp,\r\n  329             Err(Fail::Retry(e)) => {\r\n  330                 last = e;\r\n  331                 continue;\r\n  332             }\r\n  333             Err(Fail::Fatal(e)) => return Err(e),\r\n  334         };\r\n  335         return match resp.status() {\r\n  336             StatusCode::PARTIAL_CONTENT => Ok(resp\r\n  337                 .headers()\r\n  338                 .get(CONTENT_RANGE)\r\n  339                 .and_then(|v| v.to_str().ok())\r\n  340                 .and_then(|v| v.rsplit_once('/')?.1.parse().ok())\r\n  341                 .filter(|n| *n > 0)\r\n  342                 .map_or(Plan::Single(None), Plan::Segmented)),\r\n  343             s if s.is_success() => Ok(Plan::Single(resp.content_length())),\r\n  344             s => Err(format!(\"�ٿ�ε� ������ ��û�� �ź��߽��ϴ�: HTTP {s}\")),\r\n  345         };\r\n  346     }\r\n  347     Err(format!(\"{last} (��õ� {MAX_TRIES}ȸ �ʰ�)\"))\r\n  348 }\r\n  349 \r\n  350 async fn segmented(\r\n  351     client: Client,\r\n  352     req: DownloadRequest,\r\n  353     total: u64,\r\n  354     cancel: Arc<AtomicBool>,\r\n  355     on_progress: Box<dyn Fn(DownloadProgress) + Send + Sync>,\r\n  356 ) -> Result<(), String> {\r\n  357     let part = side(&req.destination, \".download\");\r\n  358     let state_path = side(&req.destination, \".download.state\");\r\n  359     let todo = match load_state(&state_path, &part, total) {\r\n  360         Some(todo) => todo,\r\n  361         None => {\r\n  362             // �� ���º��� �����: ������ ���� ���� �� ũ�����ϸ� �� �Ϸ� ����� �� ������ �ǳʶٰ� �ȴ�\r\n  363             if let Err(e) = std::fs::remove_file(&state_path) {\r\n  364                 if e.kind() != std::io::ErrorKind::NotFound {\r\n  365                     return Err(format!(\"���� �簳 ���� ���� ����: {e}\"));\r\n  366                 }\r\n  367             }\r\n  368             let file = std::fs::File::create(&part).map_err(|e| format!(\"�ӽ� ���� ���� ����: {e}\"))?;\r\n  369             file.set_len(total).map_err(|e| format!(\"�ӽ� ���� ũ�� ���� ����: {e}\"))?;\r\n  370             let n = CONNECTIONS as u64;\r\n  371             (0..n).map(|i| (total * i / n, total * (i + 1) / n)).filter(|(a, b)| a < b).collect()\r\n  372         }\r\n  373     };\r\n  374     let left: u64 = todo.iter().map(|(a, b)| b - a).sum();\r\n  375     let done = total.saturating_sub(left);\r\n  376     let state = std::fs::OpenOptions::new()\r\n  377         .write(true)\r\n  378         .create(true)\r\n  379         .truncate(false)\r\n  380         .open(&state_path)\r\n  381         .map_err(|e| format!(\"���� ���� ���� ����: {e}\"))?;\r\n  382     let slots = vec![(0, 0); CONNECTIONS];\r\n  383     let sh = Shared { todo, slots, state, done, last_ckpt: done, last_emit: Instant::now() };\r\n  384     let ctx = Arc::new(Ctx { client, req, total, part, cancel, on_progress, sh: Mutex::new(sh) });\r\n  385     ctx.emit(done);\r\n  386     ctx.lock().checkpoint(total)?;\r\n  387 \r\n  388     let mut workers = JoinSet::new();\r\n  389     for slot in 0..CONNECTIONS {\r\n  390         let ctx = ctx.clone();\r\n  391         workers.spawn(async move {\r\n  392             while ctx.lock().claim(slot) {\r\n  393                 ctx.fetch(slot).await?;\r\n  394             }\r\n  395             Ok::<(), String>(())\r\n  396         });\r\n  397     }\r\n  398     let mut result = Ok(());\r\n  399     while let Some(joined) = workers.join_next().await {\r\n  400         result = joined.map_err(|e| format!(\"�ٿ�ε� �۾� ���� ����: {e}\")).and_then(|r| r);\r\n  401         if result.is_err() {\r\n  402             break;\r\n  403         }\r\n  404     }\r\n  405     workers.shutdown().await;\r\n  406     let mut sh = ctx.lock();\r\n  407     // D7: ���� ������ ���(�̹� �� ���� �簳) ��Ұ� ���� ������ �ϼ� ������ ������ �ʴ´�\r\n  408     if result.is_err() || !sh.remaining().is_empty() || ctx.cancel.load(Ordering::Relaxed) {\r\n  409         let saved = sh.checkpoint(total); // D4: �ߴ�/���� ������ ��Ȯ�� ��ġ�� �����\r\n  410         return result.and(saved).and(Err(\"�Ϻ� ������ ���� ���߽��ϴ�\".into()));\r\n  411     }\r\n  412     drop(sh);\r\n  413     ctx.emit(total);\r\n  414     std::fs::rename(&ctx.part, &ctx.req.destination).map_err(|e| format!(\"�Ϸ� ���� �̵� ����: {e}\"))\r\n  415 }\r\n  416 \r\n  417 /// D2: Range ���� �� ���� �޴´�(�簳 �Ұ�). ����/��� �� �ӽ� ������ ������.\r\n  418 async fn single(\r\n  419     client: Client,\r\n  420     req: DownloadRequest,\r\n  421     expected: Option<u64>,\r\n  422     cancel: Arc<AtomicBool>,\r\n  423     on_progress: Box<dyn Fn(DownloadProgress) + Send + Sync>,\r\n  424 ) -> Result<(), String> {\r\n  425     let mut resp = wait(get(&client, &req).send(), &cancel, \"�ٿ�ε� ���� ���� ����\").await.map_err(Fail::text)?;\r\n  426     // D5: Range ���� �������� ��ü(200)�� �޴´�. 206�� ������ �Ϻζ� �ϼ����� �� �� ����\r\n  427     if resp.status() != StatusCode::OK {\r\n  428         return Err(format!(\"�ٿ�ε� ������ ��ü ������ ���� �ʾҽ��ϴ�: HTTP {}\", resp.status()));\r\n  429     }\r\n  430     let total = resp.content_length().or(expected);\r\n  431     let emit = |received| on_progress(DownloadProgress { received, total, mode: DownloadMode::Single });\r\n  432     let part = side(&req.destination, \".download\");\r\n  433     let copied = async {\r\n  434         let mut file = std::fs::File::create(&part).map_err(|e| format!(\"�ӽ� ���� ���� ����: {e}\"))?;\r\n  435         let (mut got, mut last) = (0u64, Instant::now());\r\n  436         emit(0);\r\n  437         while let Some(chunk) = wait(resp.chunk(), &cancel, \"���� ����\").await.map_err(Fail::text)? {\r\n  438             if cancel.load(Ordering::Relaxed) {\r\n  439                 return Err(CANCELLED.to_string());\r\n  440             }\r\n  441             file.write_all(&chunk).map_err(|e| format!(\"���� ���� ����: {e}\"))?;\r\n  442             got += chunk.len() as u64;\r\n  443             if last.elapsed() >= PROGRESS_EVERY {\r\n  444                 last = Instant::now();\r\n  445                 emit(got);\r\n  446             }\r\n  447         }\r\n  448         if total.is_some_and(|t| t != got) {\r\n  449             return Err(\"���� ũ�Ⱑ ���� ũ��� �ٸ��ϴ�\".to_string());\r\n  450         }\r\n  451         if cancel.load(Ordering::Relaxed) {\r\n  452             return Err(CANCELLED.to_string()); // D7: ������ ûũ ��(�Ǵ� �� ����)�� ���� ���\r\n  453         }\r\n  454         emit(got);\r\n  455         std::fs::rename(&part, &req.destination).map_err(|e| format!(\"�Ϸ� ���� �̵� ����: {e}\"))\r\n  456     }\r\n  457     .await;\r\n  458     if copied.is_err() {\r\n  459         let _ = std::fs::remove_file(&part);\r\n  460     }\r\n  461     copied\r\n  462 }\r\n  463 \r\n  464 /// `Ok(Some(path))` �Ϸ�, `Ok(None)` ���(�簳 ���� ����), `Err` ����(D10: �ѱ��� �޽���).\r\n  465 pub async fn download<F>(\r\n  466     request: DownloadRequest,\r\n  467     cancel: Arc<AtomicBool>,\r\n  468     on_progress: F,\r\n  469 ) -> Result<Option<PathBuf>, String>\r\n  470 where\r\n  471     F: Fn(DownloadProgress) + Send + Sync + 'static,\r\n  472 {\r\n  473     let client = Client::builder()\r\n  474         .connect_timeout(Duration::from_secs(20))\r\n  475         .redirect(reqwest::redirect::Policy::limited(10))\r\n  476         .referer(false) // D9: ����Ʈ �ڿ��� ȣ���ڰ� �� Referer�� �״�� ������\r\n  477         .user_agent(USER_AGENT)\r\n  478         .build()\r\n  479         .map_err(|e| format!(\"HTTP Ŭ���̾�Ʈ ���� ����: {e}\"))?;\r\n  480     let dest = request.destination.clone();\r\n  481     let on_progress = Box::new(on_progress);\r\n  482     let flag = cancel.clone();\r\n  483     let result = match probe(&client, &request, &cancel).await {\r\n  484         Ok(Plan::Segmented(total)) => segmented(client, request, total, cancel, on_progress).await,\r\n  485         Ok(Plan::Single(expected)) => single(client, request, expected, cancel, on_progress).await,\r\n  486         Err(e) => Err(e), // ���κ� �� ��ҵ� �Ʒ����� Ok(None)�� �ȴ�\r\n  487     };\r\n  488     match result {\r\n  489         Ok(()) => {\r\n  490             let _ = std::fs::remove_file(side(&dest, \".download.state\")); // D1: ���� �� �ܿ��� ����\r\n  491             Ok(Some(dest))\r\n  492         }\r\n  493         Err(_) if flag.load(Ordering::Relaxed) => Ok(None),\r\n  494         Err(e) => Err(e),\r\n  495     }\r\n  496 }\r\n  497 \r\n  498 #[cfg(test)]\r\n  499 mod tests {\r\n  500     use super::*;\r\n  501     use std::io::Read;\r\n  502     use std::net::{TcpListener, TcpStream};\r\n  503     use std::sync::atomic::{AtomicU64, AtomicUsize};\r\n  504 \r\n  505     /// �׽�Ʈ ���� ���� ����ġ (0/false = ����).\r\n  506     #[derive(Clone, Default)]\r\n  507     struct Opt {\r\n  508         ignore_range: bool,\r\n  509         unknown_total: bool,\r\n  510         status: u16,\r\n  511         wrong_start: bool,\r\n  512         extra_byte: bool,\r\n  513         short_first: usize, // ó�� N���� ���� ������ ���ݸ� ������ ���´�\r\n  514         delay_ms: u64,      // ���� �� ��� (���� ���� ������)\r\n  515         chunk_ms: u64,      // 64 KiB���� ��� (���� ����)\r\n  516         drop_probe: usize,  // ó�� N���� ���κ�� ���� ���� ���´�\r\n  517         stall_first: usize, // ó�� N���� ���� ������ ���ݸ� ������ ������ �� ä ħ���Ѵ�\r\n  518     }\r\n  519 \r\n  520     #[derive(Clone)]\r\n  521     struct Srv {\r\n  522         url: String,\r\n  523         log: Arc<Mutex<Vec<String>>>,\r\n  524         served: Arc<AtomicU64>,\r\n  525         peak: Arc<AtomicUsize>,\r\n  526         active: Arc<AtomicUsize>,\r\n  527         shorts: Arc<AtomicUsize>,\r\n  528         probe_drops: Arc<AtomicUsize>,\r\n  529         stalls: Arc<AtomicUsize>,\r\n  530         data: Arc<Vec<u8>>,\r\n  531         o: Opt,\r\n  532     }\r\n  533 \r\n  534     fn serve(data: Vec<u8>, o: Opt) -> Srv {\r\n  535         let l = TcpListener::bind(\"127.0.0.1:0\").unwrap();\r\n  536         let s = Srv {\r\n  537             url: format!(\"http://{}\", l.local_addr().unwrap()),\r\n  538             log: Default::default(),\r\n  539             served: Default::default(),\r\n  540             peak: Default::default(),\r\n","exit_code":0,"status":"completed"}}
