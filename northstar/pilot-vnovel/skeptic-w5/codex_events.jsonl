  .unwrap_or_else(|| \"download\".to_string());\r\n219:    destination.with_file_name(format!(\"{name}.{suffix}\"))\r\n220:}\r\n221:\r\n222:\r\n223:/// 저장된 구간 오프셋을 검증한다. 정상 checkpoint는 `completed`(≤ 구간 길이)만 기록하므로\r\n224:/// 구간 길이를 넘는 값은 손상(예: 하드 크래시 중 상태 파일 torn-write)이다.\r\n225:/// 그런 값을 완료로 오인하면 미수신 바이트를 건너뛰어 파일이 조용히 손상되므로,\r\n226:/// 처음부터 다시 받도록 0으로 되돌린다.\r\n227:fn valid_resume_offset(saved: u64, segment_len: u64) -> u64 {\r\n228:    if saved <= segment_len {\r\n229:        saved\r\n230:    } else {\r\n231:        0\r\n232:    }\r\n233:}\r\n234:\r\n235:fn segment_bounds(total: u64, count: usize, index: usize) -> (u64, u64) {\r\n236:    let count = count.max(1) as u64;\r\n237:    let index = index as u64;\r\n238:    let base = total / count;\r\n239:    let remainder = total % count;\r\n240:    // 나머지 바이트를 앞쪽 구간에 하나씩 배분하면 모든 구간이 빈틈·중복 없이 이어진다.\r\n241:    let start = index * base + index.min(remainder);\r\n242:    let size = base + u64::from(index < remainder);\r\n243:    let end = start.saturating_add(size).saturating_sub(1);\r\n244:    (start, end)\r\n245:}\r\n246:\r\n247:async fn prepare_resume(\r\n248:    destination: &Path,\r\n249:    total: u64,\r\n250:    segment_count: usize,\r\n251:) -> Result<(PathBuf, PathBuf, PathBuf, Vec<u64>), String> {\r\n252:    let part_path = sidecar_path(destination, \"download\");\r\n253:    let meta_path = sidecar_path(destination, \"download.json\");\r\n254:    let state_path = sidecar_path(destination, \"download.state\");\r\n255:    let expected = ResumeMeta {\r\n256:        version: 1,\r\n257:        total,\r\n258:        segment_count,\r\n259:    };\r\n260:\r\n261:    let existing_meta = tokio::fs::read_to_string(&meta_path)\r\n262:        .await\r\n263:        .ok()\r\n264:        .and_then(|s| serde_json::from_str::<ResumeMeta>(&s).ok());\r\n265:    let reusable = existing_meta\r\n266:        .as_ref()\r\n267:        .is_some_and(|m| m.version == 1 && m.total == total && m.segment_count == segment_count)\r\n268:        &&