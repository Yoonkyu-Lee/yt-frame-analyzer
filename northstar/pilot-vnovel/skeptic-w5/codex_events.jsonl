 22 const PROGRESS_EVERY: Duration = Duration::from_millis(250); // D8\r\n   23 const CHECKPOINT_BYTES: u64 = 1024 * 1024; // D4: ���� ��� ���� = ����� ����\r\n   24 const MIN_STEAL: u64 = 128 * 1024; // ���� ������ �� �� �� �̸��̸� �ɰ��� �ʴ´�\r\n   25 const STATE_BYTES: usize = 4096; // ���� ������ �׻� �� ũ��� ����� ���� ������ ���� �ʴ´�\r\n   26 const CANCELLED: &str = \"��ҵ�\";\r\n   27 const USER_AGENT: &str = \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 \\\r\n   28      (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36\";\r\n   29 \r\n   30 #[derive(Debug, Clone)]\r\n   31 pub struct DownloadRequest {\r\n   32     pub url: String,\r\n   33     pub destination: PathBuf,\r\n   34     pub cookie_header: Option<String>,\r\n   35     pub referer: Option<String>,\r\n   36 }\r\n   37 \r\n   38 #[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize)]\r\n   39 #[serde(rename_all = \"lowercase\")]\r\n   40 pub enum DownloadMode {\r\n   41     Segmented,\r\n   42     Single,\r\n   43 }\r\n   44 \r\n   45 #[derive(Debug, Clone, Copy)]\r\n   46 pub struct DownloadProgress {\r\n   47     pub received: u64,\r\n   48     pub total: Option<u64>,\r\n   49     pub mode: DownloadMode,\r\n   50 }\r\n   51 \r\n   52 // D7: ��ū �� ��� �÷���. dist_host�� spawn�� task�� ��� Ŀ�ǵ尡 ��ū���� ã�´�.\r\n   53 static CANCELLERS: LazyLock<Mutex<HashMap<String, Arc<AtomicBool>>>> = LazyLock::new(Default::default);\r\n   54 \r\n   55 fn registry() -> MutexGuard<'static, HashMap<String, Arc<AtomicBool>>> {\r\n   56     CANCELLERS.lock().unwrap_or_else(PoisonError::into_inner)\r\n   57 }\r\n   58 \r\n   59 pub fn register_cancel(token: &str) -> Arc<AtomicBool> {\r\n   60     let flag = Arc::new(AtomicBool::new(false));\r\n   61     registry().insert(token.to_string(), flag.clone());\r\n   62     flag\r\n   63 }\r\n   64 \r\n   65 pub fn request_cancel(token: &str) -> bool {\r\n   66     registry().get(token).map(|f| f.store(true, Ordering::SeqCst)).is_some()\r\n   67 }\r\n   68 \r\n   69 pub fn clear_cancel(token: &str) {\r\n   70     registry().remove(token);\r\n   71 }\r\n   72 \r\n   73 /// D9: ��� ��û�� ���� ���. identity�� �ƴϸ� ����Ʈ �������� ���� �����°� �޶�����.\r\n   74 fn get(client: &Client, req: &DownloadRequest) -> RequestBuilder {\r\n   75     let mut b = client.get(&req.url).header(ACCEPT_ENCODING, \"identity\");\r\n   76     if let Some(v) = req.cookie_header.as_deref().filter(|v| !v.is_empty()) {\r\n   77         b = b.header(COOKIE, v);\r\n   78     }\r\n   79     if let Some(v) = req.referer.as_deref().filter(|v| !v.is_empty()) {\r\n   80         b = b.header(REFERER, v);\r\n   81     }\r\n   82     b\r\n   83 }\r\n   84 \r\n   85 fn side(dest: &Path, suffix: &str) -> PathBuf {\r\n   86     let mut s = dest.as_os_str().to_owned();\r\n   87     s.push(suffix);\r\n   88     s.into()\r\n   89 }\r\n   90 \r\n   91 type Span = (u64, u64); // [start, end)\r\n   92 \r\n   93 /// �����ٸ� ���� ����: �̹��� ����, ���Ằ ���� �� ����(start�� �� �簳 ������), ���� �ѷ�.\r\n   94 struct Shared {\r\n   95     todo: Vec<Span>,\r\n   96     slots: Vec<Span>,\r\n   97     state: std::fs::File,\r\n   98     done: u64,\r\n   99     last_ckpt: u64,\r\n  100     last_emit: Instant,\r\n  101 }\r\n  102 \r\n  103 impl Shared {\r\n  104     /// ���� `slot`�� ������ �����Ѵ�: �̹��� ���� �켱, ������ ���� ���� ���� ������ �� ������\r\n  105     /// �����´�(���� ������ ���� ������ ���´�). �� �� ������ false.\r\n  106     fn claim(&mut self, slot: usize) -> bool {\r\n  107         let span = self.todo.pop().or_else(|| {\r\n  108             let (v, (pos, end)) =\r\n  109                 self.slots.iter().copied().enumerate().max_by_key(|(_, (p, e))| e - p)?;\r\n  110             let rest = end - pos;\r\n  111             if rest < 2 * MIN_STEAL {\r\n  112                 return None;\r\n  113             }\r\n  114             self.slots[v].1 = pos + rest / 2;\r\n  115             Some((pos + rest / 2, end))\r\n  116         });\r\n  117         self.slots[slot] = span.unwrap_or((0, 0));\r\n  118         span.is_some()\r\n  119     }\r\n  120 \r\n  121     /// D4: ���� ������ ���� ���Ͽ� ���ڸ��� ����. ���´� �׻� �������� �� ����� ��(���� ������ ����\r\n  122     /// ����)�̶� ���� ��ϵ� �����ϴ�. ���� ���д� �簳 ������ ���� ���̹Ƿ� ������ �ʰ� ������ �ø���.\r\n  123     fn checkpoint(&mut self, total: u64) -> Result<(), String> {\r\n  124         let text = state_text(total, &self.remaining());\r\n  125         self.state\r\n  126             .seek(SeekFrom::Start(0))\r\n  127             .and_then(|_| self.state.write_all(text.as_bytes()))\r\n  128             .map_err(|e| format!(\"�簳 ���� ���� ����: {e}\"))\r\n  129     }\r\n  130 \r\n  131     /// ���� �� ���� ��� ���� (D4 �������� �Ϸ� ���� �ٰ�).\r\n  132     fn remaining(&self) -> Vec<Span> {\r\n  133         self.todo.iter().chain(&self.slots).copied().filter(|(a, b)| a < b).collect()\r\n  134     }\r\n  135 }\r\n  136 \r\n  137 struct Ctx {\r\n  138     client: Client,\r\n  139     req: DownloadRequest,\r\n  140     total: u64,\r\n  141     part: PathBuf,\r\n  142     cancel: Arc<AtomicBool>,\r\n  143     on_progress: Box<dyn Fn(DownloadProgress) + Send + Sync>,\r\n  144     sh: Mutex<Shared>,\r\n  145 }\r\n  146 \r\n  147 enum Fail {\r\n  148     Retry(String),\r\n  149     Fatal(String),\r\n  150 }\r\n  151 \r\n  152 impl Fail {\r\n  153     fn text(self) -> String {\r\n  154         match self {\r\n  155             Fail::Retry(e) | Fail::Fatal(e) => e,\r\n  156         }\r\n  157     }\r\n  158 }\r\n  159 \r\n  160 /// D6/D7: ���䡤ûũ�� ��ٸ��� 1�ʸ��� ��Ҹ� ����, STALL_SECS ���� �ƹ��͵� ���� ������ ��õ���\r\n  161 /// ���з� ����. ���Ḹ ���� �ΰ� ħ���ϴ� ���� �տ��� ������ ��ٸ��� ��ҵ� ���� �ʴ� ���� ���´�.\r\n  162 async fn wait<T, E: std::fmt::Display>(\r\n  163     fut: impl std::future::Future<Output = Result<T, E>>,\r\n  164     cancel: &AtomicBool,\r\n  165     what: &str,\r\n  166 ) -> Result<T, Fail> {\r\n  167     let mut fut = std::pin::pin!(fut);\r\n  168     for _ in 0..STALL_SECS {\r\n  169         match tokio::time::timeout(Duration::from_secs(1), &mut fut).await {\r\n  170             Ok(r) => return r.map_err(|e| Fail::Retry(format!(\"{what}: {e}\"))),\r\n  171             Err(_) if cancel.load(Ordering::Relaxed) => return Err(Fail::Fatal(CANCELLED.into())),\r\n  172             Err(_) => {}\r\n  173         }\r\n  174     }\r\n  175     Err(Fail::Retry(format!(\"{what}: {STALL_SECS}�� ���� ������ �ƹ��͵� ������ �ʾҽ��ϴ�\")))\r\n  176 }\r\n  177 \r\n  178 impl Ctx {\r\n  179     fn lock(&self) -> MutexGuard<'_, Shared> {\r\n  180         self.sh.lock().unwrap_or_else(PoisonError::into_inner)\r\n  181     }\r\n  182 \r\n  183     fn emit(&self, received: u64) {\r\n  184         (self.on_progress)(DownloadProgress {\r\n  185             received,\r\n  186             total: Some(self.total),\r\n  187             mode: DownloadMode::Segmented,\r\n  188         });\r\n  189     }\r\n  190 \r\n  191     /// ûũ�� �ڱ� ����(steal�� �پ��� �� ����)��ŭ�� ���� ����/���¸� �����Ѵ�. ������ �� ä������ true.\r\n  192     fn accept(&self, slot: usize, file: &mut std::fs::File, chunk: &[u8]) -> Result<bool, String> {\r\n  193         let mut sh = self.lock();\r\n  194         let (pos, end) = sh.slots[slot];\r\n  195         let n = (chunk.len() as u64).min(end - pos);\r\n  196         file.write_all(&chunk[..n as usize]).map_err(|e| format!(\"���� ���� ����: {e}\"))?;\r\n  197         sh.slots[slot].0 += n;\r\n  198         sh.done += n;\r\n  199         if sh.done - sh.last_ckpt >= CHECKPOINT_BYTES {\r\n  200             sh.last_ckpt = sh.done;\r\n  201             sh.checkpoint(self.total)?;\r\n  202         }\r\n  203         if sh.last_emit.elapsed() >= PROGRESS_EVERY {\r\n  204             sh.last_emit = Instant::now();\r\n  205             self.emit(sh.done); // D8: ��� �ȿ��� ������ �� ������ ����� ������ �ڹٲ��� �ʴ´�\r\n  206         }\r\n  207         Ok(pos + n == end)\r\n  208     }\r\n  209 \r\n  210     /// �� ���� Range ��û���� `slot`�� ������ �̾� �޴´�. D5: ������ �ٸ� Content-Range�� ��û���� �� ������ ġ����.\r\n  211     async fn stream(&self, slot: usize, file: &mut std::fs::File, pos: u64, end: u64) -> Result<(), Fail> {\r\n  212         let request = get(&self.client, &self.req).header(RANGE, format!(\"bytes={pos}-{}\", end - 1)).send();\r\n  213         let mut resp = wait(request, &self.cancel, \"���� ���� ����\").await?;\r\n  214         if resp.status() != StatusCode::PARTIAL_CONTENT {\r\n  215             return Err(Fail::Retry(format!(\"Range ������ �ƴմϴ�: HTTP {}\", resp.status())));\r\n  216         }\r\n  217         // �ѷ����� �¾ƾ� �Ѵ�: ���κ�� �ٸ� ũ�⸦ ���ϴ� ������ ������ �߸� ä �ϼ����� �ʴ´�\r\n  218         let (head, tail) = (format!(\"bytes {pos}-\"), format!(\"/{}\", self.total));\r\n  219         let range = resp.headers().get(CONTENT_RANGE).and_then(|v| v.to_str().ok());\r\n  220         if !range.is_some_and(|v| v.starts_with(&head) && v.ends_with(&tail)) {\r\n  221             return Err(Fail::Fatal(\"Content-Range�� ��û ������ �ٸ��ϴ�\".into()));\r\n  222         }\r\n  223         // D5: ��û�� ���̸� �� ä��� ���� ������ ���� �ʰ� �����Ƿ�(�Ѱܹޱ� ����), �� �� ������ �̸� �Ÿ���\r\n  224         if resp.content_length().is_some_and(|n| n != end - pos) {\r\n  225             return Err(Fail::Fatal(\"���� ���̰� ��û�� ������ �ٸ��ϴ�\".into()));\r\n  226         }\r\n  227         file.seek(SeekFrom::Start(pos)).map_err(|e| Fail::Fatal(format!(\"seek ����: {e}\")))?;\r\n  228         let mut at = pos;\r\n  229         while let Some(chunk) = wait(resp.chunk(), &self.cancel, \"���� ����\").await? {\r\n  230             if self.cancel.load(Ordering::Relaxed) {\r\n  231                 return Err(Fail::Fatal(CANCELLED.into()));\r\n  232             }\r\n  233             at += chunk.len() as u64;\r\n  234             if at > end {\r\n  235                 return Err(Fail::Fatal(\"������ ��û�� ũ�⸦ �ʰ��߽��ϴ�\".into()));\r\n  236             }\r\n  237             if self.accept(slot, file, &chunk).map_err(Fail::Fatal)? {\r\n  238                 return Ok(());\r\n  239             }\r\n  240         }\r\n  241         Err(Fail::Retry(\"������ ��û�� ũ�⺸�� ª���ϴ�\".into()))\r\n  242     }\r\n  243 \r\n  244     /// D6: ������ ������ ������ �޴´�. ��õ��� ���� ������ �̾� ����.\r\n  245     async fn fetch(&self, slot: usize) -> Result<(), String> {\r\n  246         let mut file = std::fs::OpenOptions::new()\r\n  247             .write(true)\r\n  248             .open(&self.part)\r\n  249             .map_err(|e| format!(\"�ӽ� ���� ���� ����: {e}\"))?;\r\n  250         let mut last = String::new();\r\n  251         for attempt in 0..MAX_TRIES {\r\n  252             if attempt > 0 {\r\n  253                 tokio::time::sleep(Duration::from_millis(500 * attempt as u64)).await;\r\n  254             }\r\n  255             if self.cancel.load(Ordering::Relaxed) {\r\n  256                 return Err(CANCELLED.into());\r\n  257             }\r\n  258             let (pos, end) = self.lock().slots[slot];\r\n  259             if pos >= end {\r\n  260                 return Ok(());\r\n  261             }\r\n  262             match self.stream(slot, &mut file, pos, end).await {\r\n  263                 Ok(()) => return Ok(()),\r\n  264                 Err(Fail::Fatal(e)) => return Err(e),\r\n  265                 Err(Fail::Retry(e)) => last = e,\r\n  266             }\r\n  267         }\r\n  268         Err(format!(\"�ٿ�ε� ����(��õ� {MAX_TRIES}ȸ �ʰ�): {last}\"))\r\n  269     }\r\n  270 }\r\n  271 \r\n  272 fn fnv(text: &str) -> u64 {\r\n  273     text.bytes().fold(0xcbf2_9ce4_8422_2325, |h, b| (h ^ u64::from(b)).wrapping_mul(0x0100_0000_01b3))\r\n  274 }\r\n  275 \r\n  276 /// D4/D5: �簳 ���� �ؽ�Ʈ = �ѷ�, ���� ������, �� ������ FNV-1a ��, �� ǥ��. ����� �߷�\r\n  277 /// ���� �Ϻθ� �ٲ� ������ ���� ���� �ʾ� ��������(�������� �ռ� ������ �������� ���Ѵ�).\r\n  278 fn state_text(total: u64, spans: &[Span]) -> String {\r\n  279     let mut body = format!(\"{total}\\n\");\r\n  280     for (a, b) in spans {\r\n  281         body += &format!(\"{a} {b}\\n\");\r\n  282     }\r\n  283     let sum = fnv(&body);\r\n  284     format!(\"{:<w$}\", format!(\"{body}sum {sum}\\nend\\n\"), w = STATE_BYTES)\r\n  285 }\r\n  286 \r\n  287 /// D4: ����� ���� ���� ���. ũ�⡤�ա����ġ������� �ϳ��� �̻��ϸ� None(�� ó������).\r\n  288 fn load_state(state: &Path, part: &Path, total: u64) -> Option<Vec<Span>> {\r\n  289     let text = std::fs::read_to_string(state).ok()?;\r\n  290     if std::fs::metadata(part).ok()?.len() != total {\r\n  291         return None;\r\n  292     }\r\n  293     let (body, rest) = text.split_once(\"sum \")?;\r\n  294     if rest.split_once(\"\\nend\\n\")?.0.parse::<u64>().ok()? != fnv(body) {\r\n  295         return None;\r\n  296     }\r\n  297     let mut lines = body.lines();\r\n  298     if lines.next()?.parse::<u64>().ok()? != total {\r\n  299         return None;\r\n  300     }\r\n  301     let mut spans: Vec<Span> = lines\r\n  302         .map(|l| {\r\n  303             let (a, b) = l.split_once(' ')?;\r\n  304             let (a, b) = (a.parse().ok()?, b.parse().ok()?);\r\n  305             (a < b && b <= total).then_some((a, b))\r\n  306         })\r\n  307         .collect::<Option<_>>()?;\r\n  308     // D5: ��ġ�� ������ �޾Ƶ��̸� ���� ����Ʈ�� �� �� ���� �ٸ� ���� ��� ä �Ϸ�ȴ�\r\n  309     spans.sort_unstable();\r\n  310     spans.windows(2).all(|w| w[0].1 <= w[1].0).then_some(spans)\r\n  311 }\r\n  312 \r\n  313 /// D2: `bytes=0-0` ���κ��� ���. ���κ� ������ ���⼭ ������ ������ ������ �ʴ´�(D3).\r\n  314 enum Plan {\r\n  315     Segmented(u64),\r\n  316     Single(Option<u64>), // 200�� �˷� �� ũ��: �� ��û�� ũ�⸦ �� �˷� �� �� ª�� ������ ��� ����\r\n  317 }\r\n  318 \r\n  319 /// D6: ���κ굵 �Ͻ��� ���д� ��õ��Ѵ�. ù ������ �� �� ����ٰ� �۾� ��ü�� ���н�Ű�� �ʴ´�.\r\n  320 async fn probe(client: &Client, req: &DownloadRequest, cancel: &AtomicBool) -> Result<Plan, String> {\r\n  321     let mut last = String::new();\r\n  322     for attempt in 0..MAX_TRIES {\r\n  323         if attempt > 0 {\r\n  324             tokio::time::sleep(Duration::from_millis(500 * attempt as u64)).await;\r\n  325         }\r\n  326         let sent = get(client, req).header(RANGE, \"bytes=0-0\").send();\r\n  327         let resp = match wait(sent, cancel, \"�ٿ�ε� ���� ���� ����\").await {\r\n  328             Ok(resp) => resp,\r\n  329             Err(Fail::Retry(e)) => {\r\n  330                 last = e;\r\n  331                 continue;\r\n  332             }\r\n  333             Err(Fail::Fatal(e)) => return Err(e),\r\n  334         };\r\n  335         return match resp.status() {\r\n  336             StatusCode::PARTIAL_CONTENT => Ok(resp\r\n  337                 .headers()\r\n  338                 .get(CONTENT_RANGE)\r\n  339                 .and_then(|v| v.to_str().ok())\r\n  340                 .and_then(|v| v.rsplit_once('/')?.1.parse().ok())\r\n  341                 .filter(|n| *n > 0)\r\n  342                 .map_or(Plan::Single(None), Plan::Segmented)),\r\n  343             s if s.is_success() => Ok(Plan::Single(resp.content_length())),\r\n  344             s => Err(format!(\"�ٿ�ε� ������ ��û�� �ź��߽��ϴ�: HTTP {s}\")),\r\n  345         };\r\n  346     }\r\n  347     Err(format!(\"{last} (��õ� {MAX_TRIES}ȸ �ʰ�)\"))\r\n  348 }\r\n  349 \r\n  350 async fn segmented(\r\n  351     client: Client,\r\n  352     req: DownloadRequest,\r\n  353     total: u64,\r\n  354     cancel: Arc<AtomicBool>,\r\n  355     on_progress: Box<dyn Fn(DownloadProgress) + Send + Sync>,\r\n  356 ) -> Result<(), String> {\r\n  357     let part = side(&req.destination, \".download\");\r\n  358     let state_path = side(&req.destination, \".download.state\");\r\n  359     let todo = match load_state(&state_path, &part, total) {\r\n  360         Some(todo) => todo,\r\n  361         None => {\r\n  362             // �� ���º��� �����: ������ ���� ���� �� ũ�����ϸ� �� �Ϸ� ����� �� ������ �ǳʶٰ� �ȴ�\r\n  363             if let Err(e) = std::fs::remove_file(&state_path) {\r\n  364                 if e.kind() != std::io::ErrorKind::NotFound {\r\n  365                     return Err(format!(\"���� �簳 ���� ���� ����: {e}\"));\r\n  366                 }\r\n  367             }\r\n  368             let file = std::fs::File::create(&part).map_err(|e| format!(\"�ӽ� ���� ���� ����: {e}\"))?;\r\n  369             file.set_len(total).map_err(|e| format!(\"�ӽ� ���� ũ�� ���� ����: {e}\"))?;\r\n  370             let n = CONNECTIONS as u64;\r\n  371             (0..n).map(|i| (total * i / n, total * (i + 1) / n)).filter(|(a, b)| a < b).collect()\r\n  372         }\r\n  373     };\r\n  374     let left: u64 = todo.iter().map(|(a, b)| b - a).sum();\r\n  375     let done = total.saturating_sub(left);\r\n  376     let state = std::fs::OpenOptions::new()\r\n  377         .write(true)\r\n  378         .create(true)\r\n  379         .truncate(false)\r\n  380         .open(&state_path)\r\n  381         .map_err(|e| format!(\"���� ���� ���� ����: {e}\"))?;\r\n  382     let slots = vec![(0, 0); CONNECTIONS];\r\n  383     let sh = Shared { todo, slots, state, done, last_ckpt: done, last_emit: Instant::now() };\r\n  384     let ctx = Arc::new(Ctx { client, req, total, part, cancel, on_progress, sh: Mutex::new(sh) });\r\n  385     ctx.emit(done);\r\n  386     ctx.lock().checkpoint(total)?;\r\n  387 \r\n  388     let mut workers = JoinSet::new();\r\n  389     for slot in 0..CONNECTIONS {\r\n  390         let ctx = ctx.clone();\r\n  391         workers.spawn(async move {\r\n  392             while ctx.lock().claim(slot) {\r\n  393                 ctx.fetch(slot).await?;\r\n  394             }\r\n  395             Ok::<(), String>(())\r\n  396         });\r\n  397     }\r\n  398     let mut result = Ok(());\r\n  399     while let Some(joined) = workers.join_next().await {\r\n  400         result = joined.map_err(|e| format!(\"�ٿ�ε� �۾� ���� ����: {e}\")).and_then(|r| r);\r\n  401         if result.is_err() {\r\n  402             break;\r\n  403         }\r\n  404     }\r\n  405     workers.shutdown().await;\r\n  406     let mut sh = ctx.lock();\r\n  407     // D7: ���� ������ ���(�̹� �� ���� �簳) ��Ұ� ���� ������ �ϼ� ������ ������ �ʴ´�\r\n  408     if result.is_err() || !sh.remaining().is_empty() || ctx.cancel.load(Ordering::Relaxed) {\r\n  409         let saved = sh.checkpoint(total); // D4: �ߴ�/���� ������ ��Ȯ�� ��ġ�� �����\r\n  410         return result.and(saved).and(Err(\"�Ϻ� ������ ���� ���߽��ϴ�\".into()));\r\n  411     }\r\n  412     drop(sh);\r\n  413     ctx.emit(total);\r\n  414     std::fs::rename(&ctx.part, &ctx.req.destination).map_err(|e| format!(\"�Ϸ� ���� �̵� ����: {e}\"))\r\n  415 }\r\n  416 \r\n  417 /// D2: Range ���� �� ���� �޴´�(�簳 �Ұ�). ����/��� �� �ӽ� ������ ������.\r\n  418 async fn single(\r\n  419     client: Client,\r\n  420     req: DownloadRequest,\r\n  421     expected: Option<u64>,\r\n  422     cancel: Arc<AtomicBool>,\r\n  423     on_progress: Box<dyn Fn(DownloadProgress) + Send + Sync>,\r\n  424 ) -> Result<(), String> {\r\n  425     let mut resp = wait(get(&client, &req).send(), &cancel, \"�ٿ�ε� ���� ���� ����\").await.map_err(Fail::text)?;\r\n  426     // D5: Range ���� �������� ��ü(200)�� �޴´�. 206�� ������ �Ϻζ� �ϼ����� �� �� ����\r\n  427     if resp.status() != StatusCode::OK {\r\n  428         return Err(format!(\"�ٿ�ε� ������ ��ü ������ ���� �ʾҽ��ϴ�: HTTP {}\", resp.status()));\r\n  429     }\r\n  430     let total = resp.content_length().or(expected);\r\n  431     let emit = |received| on_progress(DownloadProgress { received, total, mode: DownloadMode::Single });\r\n  432     let part = side(&req.destination, \".download\");\r\n  433     let copied = async {\r\n  434         let mut file = std::fs::File::create(&part).map_err(|e| format!(\"�ӽ� ���� ���� ����: {e}\"))?;\r\n  435         let (mut got, mut last) = (0u64, Instant::now());\r\n  436         emit(0);\r\n  437         while let Some(chunk) = wait(resp.chunk(), &cancel, \"���� ����\").await.map_err(Fail::text)? {\r\n  438             if cancel.load(Ordering::Relaxed) {\r\n  439                 return Err(CANCELLED.to_string());\r\n  440             }\r\n  441             file.write_all(&chunk).map_err(|e| format!(\"���� ���� ����: {e}\"))?;\r\n  442             got += chunk.len() as u64;\r\n  443             if last.elapsed() >= PROGRESS_EVERY {\r\n  444                 last = Instant::now();\r\n  445                 emit(got);\r\n  446             }\r\n  447         }\r\n  448         if total.is_some_and(|t| t != got) {\r\n  449             return Err(\"���� ũ�Ⱑ ���� ũ��� �ٸ��ϴ�\".to_string());\r\n  450         }\r\n  451         if cancel.load(Ordering::Relaxed) {\r\n  452             return Err(CANCELLED.to_string()); // D7: ������ ûũ ��(�Ǵ� �� ����)�� ���� ���\r\n  453         }\r\n  454         emit(got);\r\n  455         std::fs::rename(&part, &req.destination).map_err(|e| format!(\"�Ϸ� ���� �̵� ����: {e}\"))\r\n  456     }\r\n  457     .await;\r\n  458     if copied.is_err() {\r\n  459         let _ = std::fs::remove_file(&part);\r\n  460     }\r\n  461     copied\r\n  462 }\r\n  463 \r\n  464 /// `Ok(Some(path))` �Ϸ�, `Ok(None)` ���(�簳 ���� ����), `Err` ����(D10: �ѱ��� �޽���).\r\n  465 pub async fn download<F>(\r\n  466     request: DownloadRequest,\r\n  467     cancel: Arc<AtomicBool>,\r\n  468     on_progress: F,\r\n  469 ) -> Result<Option<PathBuf>, String>\r\n  470 where\r\n  471     F: Fn(DownloadProgress) + Send + Sync + 'static,\r\n  472 {\r\n  473     let client = Client::builder()\r\n  474         .connect_timeout(Duration::from_secs(20))\r\n  475         .redirect(reqwest::redirect::Policy::limited(10))\r\n  476         .referer(false) // D9: ����Ʈ �ڿ��� ȣ���ڰ� �� Referer�� �״�� ������\r\n  477         .user_agent(USER_AGENT)\r\n  478         .build()\r\n  479         .map_err(|e| format!(\"HTTP Ŭ���̾�Ʈ ���� ����: {e}\"))?;\r\n  480     let dest = request.destination.clone();\r\n  481     let on_progress = Box::new(on_progress);\r\n  482     let flag = cancel.clone();\r\n  483     let result = match probe(&client, &request, &cancel).await {\r\n  484         Ok(Plan::Segmented(total)) => segmented(client, request, total, cancel, on_progress).await,\r\n  485         Ok(Plan::Single(expected)) => single(client, request, expected, cancel, on_progress).await,\r\n  486         Err(e) => Err(e), // ���κ� �� ��ҵ� �Ʒ����� Ok(None)�� �ȴ�\r\n  487     };\r\n  488     match result {\r\n  489         Ok(()) => {\r\n  490             let _ = std::fs::remove_file(side(&dest, \".download.state\")); // D1: ���� �� �ܿ��� ����\r\n  491             Ok(Some(dest))\r\n  492         }\r\n  493         Err(_) if flag.load(Ordering::Relaxed) => Ok(None),\r\n  494         Err(e) => Err(e),\r\n  495     }\r\n  496 }\r\n  497 \r\n  498 #[cfg(test)]\r\n  499 mod tests {\r\n  500     use super::*;\r\n  501     use std::io::Read;\r\n  502     use std::net::{TcpListener, TcpStream};\r\n  503     use std::sync::atomic::{AtomicU64, AtomicUsize};\r\n  504 \r\n  505     /// �׽�Ʈ ���� ���� ����ġ (0/false = ����).\r\n  506     #[derive(Clone, Default)]\r\n  507     struct Opt {\r\n  508         ignore_range: bool,\r\n  509         unknown_total: bool,\r\n  510         status: u16,\r\n  511         wrong_start: bool,\r\n  512         extra_byte: bool,\r\n  513         short_first: usize, // ó�� N���� ���� ������ ���ݸ� ������ ���´�\r\n  514         delay_ms: u64,      // ���� �� ��� (���� ���� ������)\r\n  515         chunk_ms: u64,      // 64 KiB���� ��� (���� ����)\r\n  516         drop_probe: usize,  // ó�� N���� ���κ�� ���� ���� ���´�\r\n  517         stall_first: usize, // ó�� N���� ���� ������ ���ݸ� ������ ������ �� ä ħ���Ѵ�\r\n  518     }\r\n  519 \r\n  520     #[derive(Clone)]\r\n  521     struct Srv {\r\n  522         url: String,\r\n  523         log: Arc<Mutex<Vec<String>>>,\r\n  524         served: Arc<AtomicU64>,\r\n  525         peak: Arc<AtomicUsize>,\r\n  526         active: Arc<AtomicUsize>,\r\n  527         shorts: Arc<AtomicUsize>,\r\n  528         probe_drops: Arc<AtomicUsize>,\r\n  529         stalls: Arc<AtomicUsize>,\r\n  530         data: Arc<Vec<u8>>,\r\n  531         o: Opt,\r\n  532     }\r\n  533 \r\n  534     fn serve(data: Vec<u8>, o: Opt) -> Srv {\r\n  535         let l = TcpListener::bind(\"127.0.0.1:0\").unwrap();\r\n  536         let s = Srv {\r\n  537             url: format!(\"http://{}\", l.local_addr().unwrap()),\r\n  538             log: Default::default(),\r\n  539             served: Default::default(),\r\n  540             peak: Default::default(),\r\n  541             active: Default::default(),\r\n  542             shorts: Arc::new(AtomicUsize::new(o.short_first)),\r\n  543             probe_drops: Arc::new(AtomicUsize::new(o.drop_probe)),\r\n  544             stalls: Arc::new(AtomicUsize::new(o.stall_first)),\r\n  545             data: Arc::new(data),\r\n  546             o,\r\n  547         };\r\n  548         let srv = s.clone();\r\n  549         std::thread::spawn(move || {\r\n  550             for conn in l.incoming().flatten() {\r\n  551                 let srv = srv.clone();\r\n  552                 std::thread::spawn(move || {\r\n  553                     let _ = handle(&srv, conn);\r\n  554                 });\r\n  555             }\r\n  556         });\r\n  557         s\r\n  558     }\r\n  559 \r\n  560     fn handle(s: &Srv, mut c: TcpStream) -> std::io::Result<()> {\r\n  561         let (mut buf, mut tmp) = (Vec::new(), [0u8; 1024]);\r\n  562         while !buf.windows(4).any(|w| w == b\"\\r\\n\\r\\n\") {\r\n  563             let n = c.read(&mut tmp)?;\r\n  564             if n == 0 {\r\n  565                 return Ok(());\r\n  566             }\r\n  567             buf.extend_from_slice(&tmp[..n]);\r\n  568         }\r\n  569         let head = String::from_utf8_lossy(&buf).into_owned();\r\n  570         s.log.lock().unwrap().push(head.clone());\r\n  571         let range = head\r\n  572             .lines()\r\n  573             .find_map(|l| l.to_ascii_lowercase().strip_prefix(\"range: bytes=\").map(str::to_string))\r\n  574             .and_then(|v| {\r\n  575                 let (a, b) = v.split_once('-')?;\r\n  576                 Some((a.trim().parse::<usize>().ok()?, b.trim().parse::<usize>().ok()?))\r\n  577             });\r\n  578         if head.starts_with(\"GET /redirect\") {\r\n  579             return write!(c, \"HTTP/1.1 302 Found\\r\\nLocation: /file.bin\\r\\nContent-Length: 0\\r\\nConnection: close\\r\\n\\r\\n\");\r\n  580         }\r\n  581         if s.o.status != 0 {\r\n  582             return write!(c, \"HTTP/1.1 {} X\\r\\nContent-Length: 0\\r\\nConnection: close\\r\\n\\r\\n\", s.o.status);\r\n  583         }\r\n  584         let len = s.data.len();\r\n  585         let probe = range == Some((0, 0));\r\n  586         let take = |n: &AtomicUsize| n.fetch_update(Ordering::SeqCst, Ordering::SeqCst, |n| n.checked_sub(1)).is_ok();\r\n  587         if probe && take(&s.probe_drops) {\r\n  588             return Ok(()); // ���� ���� ������ �ݴ´�\r\n  589         }\r\n  590         let stall = !probe && take(&s.stalls);\r\n  591         let (status, a, e, cr) = match range {\r\n  592             Some((a, b)) if !s.o.ignore_range && a < len => {\r\n  593                 let e = b.min(len - 1);\r\n  594                 let shown = if s.o.wrong_start && !probe { a + 1 } else { a };\r\n  595                 let t = if s.o.unknown_total { \"*\".to_string() } else { len.to_string() };\r\n  596                 (\"206 Partial Content\", a, e, format!(\"Content-Range: bytes {shown}-{e}/{t}\\r\\n\"))\r\n  597             }\r\n  598             _ => (\"200 OK\", 0, len.saturating_sub(1), String::new()),\r\n  599         };\r\n  600         let mut body = if len == 0 { vec![] } else { s.data[a..=e].to_vec() };\r\n  601         if s.o.extra_byte && !cr.is_empty() && !probe {\r\n  602             body.push(0xAB);\r\n  603         }\r\n  604         write!(c, \"HTTP/1.1 {status}\\r\\nContent-Length: {}\\r\\n{cr}Connection: close\\r\\n\\r\\n\", body.len())?;\r\n  605         let cut = !probe && s.shorts.fetch_update(Ordering::SeqCst, Ordering::SeqCst, |n| n.checked_sub(1)).is_ok();\r\n  606         let limit = if cut || stall { body.len() / 2 } else { body.len() };\r\n  607         if !probe {\r\n  608             s.peak.fetch_max(s.active.fetch_add(1, Ordering::SeqCst) + 1, Ordering::SeqCst);\r\n  609             std::thread::sleep(Duration::from_millis(s.o.delay_ms));\r\n  610         }\r\n  611         // �ʰ� ����Ʈ�� ���� �ʰ� ������: ��û�� ���̸� �� ä�� �ڿ� �����ϴ� ������ �䳻 ����\r\n  612         let split = if s.o.extra_byte && !cr.is_empty() && !probe { limit.saturating_sub(1) } else { limit };\r\n  613         let sent = (|| {\r\n  614             for ch in body[..split].chunks(64 * 1024) {\r\n  615                 c.write_all(ch)?;\r\n  616                 s.served.fetch_add(ch.len() as u64, Ordering::SeqCst);\r\n  617                 std::thread::sleep(Duration::from_millis(s.o.chunk_ms));\r\n  618             }\r\n  619             if split < limit {\r\n  620                 c.flush()?;\r\n  621                 std::thread::sleep(Duration::from_millis(30));\r\n  622                 c.write_all(&body[split..limit])?;\r\n  623             }\r\n  624             std::io::Result::Ok(())\r\n  625         })();\r\n  626         if stall {\r\n  627             std::thread::sleep(Duration::from_secs(60)); // ������ �� ä ħ��\r\n  628         }\r\n  629         if !probe {\r\n  630             s.active.fetch_sub(1, Ordering::SeqCst);\r\n  631         }\r\n  632         sent\r\n  633     }\r\n  634 \r\n  635     fn pattern(n: usize) -> Vec<u8> {\r\n  636         (0..n).map(|i| (i * 7 % 251) as u8).collect()\r\n  637     }\r\n  638 \r\n  639     fn tmp_dir(tag: &str) -> PathBuf {\r\n  640         let t = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos();\r\n  641         let dir = std::env::temp_dir().join(format!(\"segdl-{tag}-{}-{t}\", std::process::id()));\r\n  642         std::fs::create_dir_all(&dir).unwrap();\r\n  643         dir\r\n  644     }\r\n  645 \r\n  646     fn files(dir: &Path) -> Vec<String> {\r\n  647         let mut v: Vec<String> =\r\n  648             std::fs::read_dir(dir).unwrap().map(|e| e.unwrap().file_name().to_string_lossy().into_owned()).collect();\r\n  649         v.sort();\r\n  650         v\r\n  651     }\r\n  652 \r\n  653     fn run(\r\n  654         url: &str,\r\n  655         dest: &Path,\r\n  656         cancel: Arc<AtomicBool>,\r\n  657         cb: impl Fn(DownloadProgress) + Send + Sync + 'static,\r\n  658     ) -> Result<Option<PathBuf>, String> {\r\n  659         let request = DownloadRequest {\r\n  660             url: url.to_string(),\r\n  661             destination: dest.to_path_buf(),\r\n  662             cookie_header: None,\r\n  663             referer: None,\r\n  664         };\r\n  665         let rt = tokio::runtime::Builder::new_multi_thread().worker_threads(4).enable_all().build().unwrap();\r\n  666         rt.block_on(download(request, cancel, cb))\r\n  667     }\r\n  668 \r\n  669     fn plain(url: &str, dest: &Path) -> Result<Option<PathBuf>, String> {\r\n  670         run(&format!(\"{url}/file.bin\"), dest, Arc::new(AtomicBool::new(false)), |_| {})\r\n  671     }\r\n  672 \r\n  673     // D1: � ũ���(0 ����Ʈ ����) ����Ʈ�� ���� ������ ���� ���ϸ� ���´�.\r\n  674     #[test]\r\n  675     fn exact_bytes_and_no_leftovers_for_any_size() {\r\n  676         for n in [0usize, 1, 7, 100, 1_000_003] {\r\n  677             let (data, dir) = (pattern(n), tmp_dir(\"size\"));\r\n  678             let dest = dir.join(\"a.bin\");\r\n  679             let s = serve(data.clone(), Opt::default());\r\n  680             assert_eq!(plain(&s.url, &dest).unwrap(), Some(dest.clone()), \"size {n}\");\r\n  681             assert_eq!(std::fs::read(&dest).unwrap(), data, \"size {n}\");\r\n  682             assert_eq!(files(&dir), vec![\"a.bin\"], \"size {n}\");\r\n  683             std::fs::remove_dir_all(dir).ok();\r\n  684         }\r\n  685     }\r\n  686 \r\n  687     // D3: ���� ������ ���� 8���� ���� �ʴ´�.\r\n  688     #[test]\r\n  689     fn uses_several_connections_but_at_most_eight() {\r\n  690         let (dir, s) = (tmp_dir(\"conn\"), serve(pattern(4_000_000), Opt { delay_ms: 80, ..Default::default() }));\r\n  691         plain(&s.url, &dir.join(\"a.bin\")).unwrap();\r\n  692         let peak = s.peak.load(Ordering::SeqCst);\r\n  693         assert!((2..=8).contains(&peak), \"peak {peak}\");\r\n  694         std::fs::remove_dir_all(dir).ok();\r\n  695     }\r\n  696 \r\n  697     // D2 + D9: ù ��û�� bytes=0-0, ��� ��û�� identity/��Ű/���۷�/ũ�� UA, ����Ʈ�� ���󰣴�.\r\n  698     #[test]\r\n  699     fn probe_first_and_every_request_carries_headers() {\r\n  700         let (dir, s) = (tmp_dir(\"hdr\"), serve(pattern(300_000), Opt::default()));\r\n  701         let dest = dir.join(\"a.bin\");\r\n  702         let request = DownloadRequest {\r\n  703             url: format!(\"{}/redirect\", s.url),\r\n  704             destination: dest.clone(),\r\n  705             cookie_header: Some(\"sid=abc\".into()),\r\n  706             referer: Some(\"https://host.example/page\".into()),\r\n  707         };\r\n  708         let rt = tokio::runtime::Runtime::new().unwrap();\r\n  709         let r = rt.block_on(download(request, Arc::new(AtomicBool::new(false)), |_| {}));\r\n  710         assert_eq!(r.unwrap(), Some(dest.clone()));\r\n  711         assert_eq!(std::fs::read(&dest).unwrap(), pattern(300_000));\r\n  712         let log = s.log.lock().unwrap();\r\n  713         assert!(log[0].to_ascii_lowercase().contains(\"range: bytes=0-0\"), \"{}\", log[0]);\r\n  714         for head in log.iter() {\r\n  715             let h = head.to_ascii_lowercase();\r\n  716             assert!(h.contains(\"accept-encoding: identity\"), \"{head}\");\r\n  717             assert!(h.contains(\"cookie: sid=abc\"), \"{head}\");\r\n  718             assert!(h.contains(\"referer: https://host.example/page\"), \"{head}\");\r\n  719             assert!(h.contains(\"user-agent: mozilla/5.0 (windows nt 10.0\") && h.contains(\"chrome/\"), \"{head}\");\r\n  720         }\r\n  721         std::fs::remove_dir_all(dir).ok();\r\n  722     }\r\n  723 \r\n  724     // D2: Range ����(200)�� �ѷ� ��(`*`)�� ���� ��Ʈ������ �޴´�.\r\n  725     #[test]\r\n  726     fn range_ignored_or_unknown_total_uses_single_stream() {\r\n  727         for o in [Opt { ignore_range: true, ..Default::default() }, Opt { unknown_total: true, ..Default::default() }] {\r\n  728             let (data, dir) = (pattern(100_000), tmp_dir(\"single\"));\r\n  729             let (s, dest) = (serve(data.clone(), o), dir.join(\"a.bin\"));\r\n  730             let modes = Arc::new(Mutex::new(Vec::new()));\r\n  731             let m = modes.clone();\r\n  732             let r = run(&format!(\"{}/file.bin\", s.url), &dest, Arc::new(AtomicBool::new(false)), move |p| {\r\n  733                 m.lock().unwrap().push((p.mode, p.received, p.total))\r\n  734             });\r\n  735             assert_eq!(r.unwrap(), Some(dest.clone()));\r\n  736             assert_eq!(std::fs::read(&dest).unwrap(), data);\r\n  737             let modes = modes.lock().unwrap();\r\n  738             assert!(modes.iter().all(|m| m.0 == DownloadMode::Single));\r\n  739             assert_eq!(modes.last().unwrap().1, 100_000);\r\n  740             assert_eq!(files(&dir), vec![\"a.bin\"]);\r\n  741             std::fs::remove_dir_all(dir).ok();\r\n  742         }\r\n  743     }\r\n  744 \r\n  745     // D2 + D10: HTTP ������ �ѱ��� Err�̰� ������ ���� �ʴ´�.\r\n  746     #[test]\r\n  747     fn http_error_is_korean_err_and_leaves_nothing() {\r\n  748         let (dir, s) = (tmp_dir(\"http\"), serve(pattern(10), Opt { status: 404, ..Default::default() }));\r\n  749         let err = plain(&s.url, &dir.join(\"a.bin\")).unwrap_err();\r\n  750         assert!(err.contains(\"HTTP 404\") && err.chars().any(|c| ('��'..='�R').contains(&c)), \"{err}\");\r\n  751         assert!(files(&dir).is_empty());\r\n  752         std::fs::remove_dir_all(dir).ok();\r\n  753     }\r\n  754 \r\n  755     // D6: �Ͻ��� ������ ��õ��� �����ǰ�, ��� �����ϸ� �� �� �ȿ� Err�� ������.\r\n  756     #[test]\r\n  757     fn transient_drops_retry_and_persistent_failure_errs_quickly() {\r\n  758         let (data, dir) = (pattern(1_000_000), tmp_dir(\"retry\"));\r\n  759         let s = serve(data.clone(), Opt { short_first: 3, ..Default::default() });\r\n  760         let dest = dir.join(\"a.bin\");\r\n  761         assert_eq!(plain(&s.url, &dest).unwrap(), Some(dest.clone()));\r\n  762         assert_eq!(std::fs::read(&dest).unwrap(), data);\r\n  763 \r\n  764         let (dir2, s2) = (tmp_dir(\"retry2\"), serve(data, Opt { short_first: 10_000, ..Default::default() }));\r\n  765         let t = Instant::now();\r\n  766         let err = plain(&s2.url, &dir2.join(\"a.bin\")).unwrap_err();\r\n  767         assert!(t.elapsed() < Duration::from_secs(15), \"{:?}\", t.elapsed());\r\n  768         assert!(!err.is_empty() && !dir2.join(\"a.bin\").exists());\r\n  769         std::fs::remove_dir_all(dir).ok();\r\n  770         std::fs::remove_dir_all(dir2).ok();\r\n  771     }\r\n  772 \r\n  773     // D5: ������ ��߳� Content-Range / �� �� ������ Err�̰ų� �ùٸ� �����̾�� �ϸ� Ʋ�� ������ ����.\r\n  774     #[test]\r\n  775     fn wrong_range_or_oversize_never_yields_wrong_file() {\r\n  776         for o in [Opt { wrong_start: true, ..Default::default() }, Opt { extra_byte: true, ..Default::default() }] {\r\n  777             let (data, dir) = (pattern(500_000), tmp_dir(\"bad\"));\r\n  778             let (s, dest) = (serve(data.clone(), o.clone()), dir.join(\"a.bin\"));\r\n  779             let r = plain(&s.url, &dest);\r\n  780             // ��û���� �� ������ ������ ��Ű�� �ʴ� ������: �պκи� �޾Ƶ� ������ ����Ʈ�� �� �ִ�\r\n  781             assert!(r.is_err(), \"��߳� Content-Range / ��û���� �� ������ Err\");\r\n  782             if dest.exists() {\r\n  783                 assert_eq!(std::fs::read(&dest).unwrap(), data);\r\n  784             } else {\r\n  785                 assert!(r.is_err());\r\n  786             }\r\n  787             std::fs::remove_dir_all(dir).ok();\r\n  788         }\r\n  789     }\r\n  790 \r\n  791     // D6: ���κ갡 �� �� ���ܵ� ��õ��ؼ� �޴´�.\r\n  792     #[test]\r\n  793     fn probe_failure_is_retried() {\r\n  794         let (data, dir) = (pattern(300_000), tmp_dir(\"probe\"));\r\n  795         let s = serve(data.clone(), Opt { drop_probe: 1, ..Default::default() });\r\n  796         let dest = dir.join(\"a.bin\");\r\n  797         assert_eq!(plain(&s.url, &dest).unwrap(), Some(dest.clone()));\r\n  798         assert_eq!(std::fs::read(&dest).unwrap(), data);\r\n  799         std::fs::remove_dir_all(dir).ok();\r\n  800     }\r\n  801 \r\n  802     // D6: ������ �� ä ħ���ϴ� ������ STALL_SECS �� �����ϰ� ���� ������ �ٽ� �޴´�.\r\n  803     #[test]\r\n  804     fn stalled_piece_is_given_up_and_retried() {\r\n  805         let (data, dir) = (pattern(1_000_000), tmp_dir(\"stall\"));\r\n  806         let s = serve(data.clone(), Opt { stall_first: 1, ..Default::default() });\r\n  807         let dest = dir.join(\"a.bin\");\r\n  808         let t = Instant::now();\r\n  809         assert_eq!(plain(&s.url, &dest).unwrap(), Some(dest.clone()));\r\n  810         assert_eq!(std::fs::read(&dest).unwrap(), data);\r\n  811         assert!(t.elapsed() < Duration::from_secs(STALL_SECS + 5), \"{:?}\", t.elapsed());\r\n  812         std::fs::remove_dir_all(dir).ok();\r\n  813     }\r\n  814 \r\n  815     // D7: ������ ħ���ص�(���ҡ����� ���) ��Ҵ� �� 1�� �ȿ� ��´�.\r\n  816     #[test]\r\n  817     fn cancel_is_prompt_while_the_server_is_silent() {\r\n  818         for ignore_range in [false, true] {\r\n  819             let o = Opt { ignore_range, stall_first: 100, ..Default::default() };\r\n  820             let (dir, s) = (tmp_dir(\"silent\"), serve(pattern(1_000_000), o));\r\n  821             let dest = dir.join(\"a.bin\");\r\n  822             let cancel = Arc::new(AtomicBool::new(false));\r\n  823             let flag = cancel.clone();\r\n  824             std::thread::spawn(move || {\r\n  825                 std::thread::sleep(Duration::from_millis(500));\r\n  826                 flag.store(true, Ordering::SeqCst);\r\n  827             });\r\n  828             let t = Instant::now();\r\n  829             assert_eq!(run(&format!(\"{}/file.bin\", s.url), &dest, cancel, |_| {}).unwrap(), None);\r\n  830             assert!(t.elapsed() < Duration::from_millis(1900), \"ignore_range={ignore_range}: {:?}\", t.elapsed());\r\n  831             assert!(!dest.exists());\r\n  832             std::fs::remove_dir_all(dir).ok();\r\n  833         }\r\n  834     }\r\n  835 \r\n  836     // D7: �̸� �� ��Ҵ� ���κ길 ������ Ok(None), ���� ���� ����, �簳 ���� ����.\r\n  837     #[test]\r\n  838     fn preset_cancel_returns_none_and_keeps_state() {\r\n  839         let (dir, s) = (tmp_dir(\"pre\"), serve(pattern(200_000), Opt::default()));\r\n  840         let dest = dir.join(\"a.bin\");\r\n  841         let r = run(&format!(\"{}/file.bin\", s.url), &dest, Arc::new(AtomicBool::new(true)), |_| {});\r\n  842         assert_eq!(r.unwrap(), None);\r\n  843         assert!(!dest.exists() && side(&dest, \".download\").exists() && side(&dest, \".download.state\").exists());\r\n  844         assert_eq!(s.log.lock().unwrap().len(), 1, \"���κ길\");\r\n  845         std::fs::remove_dir_all(dir).ok();\r\n  846     }\r\n  847 \r\n  848     // D4 + D7: ���� �� ��� �� ���� ���� �� ���� URL ������� ���� ��ŭ�� �޴´�.\r\n  849     #[test]\r\n  850     fn cancel_midway_then_resume_fetches_only_missing() {\r\n  851         let (data, dir) = (pattern(8_000_000), tmp_dir(\"resume\"));\r\n  852         let dest = dir.join(\"a.bin\");\r\n  853         let s = serve(data.clone(), Opt { chunk_ms: 20, ..Default::default() });\r\n  854         let cancel = Arc::new(AtomicBool::new(false));\r\n  855         let (flag, served) = (cancel.clone(), s.served.clone());\r\n  856         std::thread::spawn(move || {\r\n  857             while served.load(Ordering::SeqCst) < 2_000_000 {\r\n  858                 std::thread::sleep(Duration::from_millis(1));\r\n  859             }\r\n  860             flag.store(true, Ordering::SeqCst);\r\n  861         });\r\n  862         assert_eq!(run(&format!(\"{}/file.bin\", s.url), &dest, cancel, |_| {}).unwrap(), None);\r\n  863         assert!(!dest.exists());\r\n  864         let state = std::fs::read_to_string(side(&dest, \".download.state\")).unwrap();\r\n  865         let left: u64 = state.split_once(\"sum \").unwrap().0.lines().skip(1).map(|l| {\r\n  866             let (a, b) = l.split_once(' ').unwrap();\r\n  867             b.parse::<u64>().unwrap() - a.parse::<u64>().unwrap()\r\n  868         }).sum();\r\n  869 \r\n  870         let s2 = serve(data.clone(), Opt::default());\r\n  871         assert_eq!(plain(&s2.url, &dest).unwrap(), Some(dest.clone()));\r\n  872         assert_eq!(std::fs::read(&dest).unwrap(), data);\r\n  873         let fetched = s2.served.load(Ordering::SeqCst) - 1;\r\n  874         assert!(fetched >= left && fetched <= left + 8 * 1024 * 1024, \"���� {left} �� ���� ����: {fetched}\");\r\n  875         assert!(left < 8_000_000, \"��� �� ������� �ٽ� ���� �ʴ´�\");\r\n  876         assert_eq!(files(&dir), vec![\"a.bin\"]);\r\n  877         std::fs::remove_dir_all(dir).ok();\r\n  878     }\r\n  879 \r\n  880     // D4: ���� ������ ����Ű�� ���� ������ ��û�Ѵ�.\r\n  881     #[test]\r\n  882     fn saved_state_limits_requests_to_remaining_spans() {\r\n  883         let (data, dir) = (pattern(1_000_000), tmp_dir(\"state\"));\r\n  884         let dest = dir.join(\"a.bin\");\r\n  885         let mut part = data.clone();\r\n  886         part[300_000..400_000].fill(0);\r\n  887         part[900_000..].fill(0);\r\n  888         std::fs::write(side(&dest, \".download\"), &part).unwrap();\r\n  889         std::fs::write(side(&dest, \".download.state\"), state_text(1_000_000, &[(300_000, 400_000), (900_000, 1_000_000)]))\r\n  890             .unwrap();\r\n  891         let s = serve(data.clone(), Opt::default());\r\n  892         assert_eq!(plain(&s.url, &dest).unwrap(), Some(dest.clone()));\r\n  893         assert_eq!(std::fs::read(&dest).unwrap(), data);\r\n  894         assert_eq!(s.served.load(Ordering::SeqCst), 200_000 + 1, \"���� ���� + ���κ� 1����Ʈ\");\r\n  895         assert_eq!(files(&dir), vec![\"a.bin\"]);\r\n  896         std::fs::remove_dir_all(dir).ok();\r\n  897     }\r\n  898 \r\n  899     // D4 + D5: �ٸ� ũ��/�ջ�/���� �� ���´� ������ ó������ �޴´�.\r\n  900     #[test]\r\n  901     fn foreign_or_damaged_state_is_discarded() {\r\n  902         let data = pattern(400_000);\r\n  903         for (state, part_len) in [\r\n  904             (\"garbage\", 400_000),\r\n  905             (\"999\\n0 999\\n\", 400_000),             // �ٸ� ����(ũ�� �ٸ�)\r\n  906             (\"400000\\n0 99999999\\n\", 400_000),     // ������ ���� ��\r\n  907             (\"400000\\n5 3\\n\", 400_000),            // ������ ����\r\n  908             (\"400000\\nabc def\\n\", 400_000),        // ���ڰ� �ƴ�\r\n  909             (\"400000\\nend\\n\", 12_345),            // �ӽ� ���� ũ�� ����ġ\r\n  910             (\"400000\\n0 400000\\n\", 400_000),      // �� ǥ�� ����(���� �� ����)\r\n  911         ] {\r\n  912             let dir = tmp_dir(\"dmg\");\r\n  913             let dest = dir.join(\"a.bin\");\r\n  914             std::fs::write(side(&dest, \".download\"), vec![0xFFu8; part_len]).unwrap();\r\n  915             std::fs::write(side(&dest, \".download.state\"), state).unwrap();\r\n  916             let s = serve(data.clone(), Opt::default());\r\n  917             assert_eq!(plain(&s.url, &dest).unwrap(), Some(dest.clone()), \"{state:?}\");\r\n  918             assert_eq!(std::fs::read(&dest).unwrap(), data, \"{state:?}\");\r\n  919             std::fs::remove_dir_all(dir).ok();\r\n  920         }\r\n  921     }\r\n  922 \r\n  923     // D4 + D5: ����� �߷� ���� �Ϻθ� �ٲ� ����(�� ����ġ)�� ��ġ�� ������ ������ ó������ �޴´�.\r\n  924     #[test]\r\n  925     fn torn_or_overlapping_state_is_discarded() {\r\n  926         let data = pattern(1_000_000);\r\n  927         let torn = state_text(1_000_000, &[(200_000, 1_000_000)]).replacen(\"200000\", \"900000\", 1);\r\n  928         let overlap = state_text(1_000_000, &[(0, 500_000), (0, 500_000)]);\r\n  929         for state in [torn, overlap] {\r\n  930             let dir = tmp_dir(\"torn\");\r\n  931             let dest = dir.join(\"a.bin\");\r\n  932             std::fs::write(side(&dest, \".download\"), vec![0u8; 1_000_000]).unwrap();\r\n  933             std::fs::write(side(&dest, \".download.state\"), &state).unwrap();\r\n  934             let s = serve(data.clone(), Opt::default());\r\n  935             assert_eq!(plain(&s.url, &dest).unwrap(), Some(dest.clone()));\r\n  936             assert_eq!(std::fs::read(&dest).unwrap(), data, \"{state:.40}\");\r\n  937             std::fs::remove_dir_all(dir).ok();\r\n  938         }\r\n  939     }\r\n  940 \r\n  941     // D7: ���� ������ ���� �簳 ���¶� ��Ұ� �̸� ���� ������ �ϼ� ������ ������ �ʴ´�.\r\n  942     #[test]\r\n  943     fn completed_state_with_preset_cancel_is_not_published() {\r\n  944         let (data, dir) = (pattern(300_000), tmp_dir(\"donecancel\"));\r\n  945         let dest = dir.join(\"a.bin\");\r\n  946         std::fs::write(side(&dest, \".download\"), &data).unwrap();\r\n  947         std::fs::write(side(&dest, \".download.state\"), state_text(300_000, &[])).unwrap();\r\n  948         let s = serve(data, Opt::default());\r\n  949         let r = run(&format!(\"{}/file.bin\", s.url), &dest, Arc::new(AtomicBool::new(true)), |_| {});\r\n  950         assert_eq!(r.unwrap(), None);\r\n  951         assert!(!dest.exists());\r\n  952         std::fs::remove_dir_all(dir).ok();\r\n  953     }\r\n  954 \r\n  955     // D8: received�� �ڷ� ���� �ʰ�, total�� ��ü ũ��, mode�� ���, �ʴ� 4ȸ ����, �������� received == total.\r\n  956     #[test]\r\n  957     fn progress_is_monotone_rate_limited_and_ends_at_total() {\r\n  958         let (dir, s) = (tmp_dir(\"prog\"), serve(pattern(4_000_000), Opt { chunk_ms: 25, ..Default::default() }));\r\n  959         let events = Arc::new(Mutex::new(Vec::new()));\r\n  960         let e = events.clone();\r\n  961         let t = Instant::now();\r\n  962         run(&format!(\"{}/file.bin\", s.url), &dir.join(\"a.bin\"), Arc::new(AtomicBool::new(false)), move |p| {\r\n  963             e.lock().unwrap().push(p)\r\n  964         })\r\n  965         .unwrap();\r\n  966         let secs = t.elapsed().as_secs_f64();\r\n  967         let ev = events.lock().unwrap();\r\n  968         assert!(ev.windows(2).all(|w| w[0].received <= w[1].received));\r\n  969         assert!(ev.iter().all(|p| p.total == Some(4_000_000) && p.mode == DownloadMode::Segmented));\r\n  970         assert_eq!(ev.last().unwrap().received, 4_000_000);\r\n  971         assert!(ev.len() as f64 <= secs * 4.0 + 4.0, \"{} events in {secs}s\", ev.len());\r\n  972         std::fs::remove_dir_all(dir).ok();\r\n  973     }\r\n  974 \r\n  975     // D7: ���� ��Ʈ�� ��ҵ� Ok(None)�̸� ������ �ƹ��͵� ������ �ʴ´�.\r\n  976     #[test]\r\n  977     fn cancel_during_single_stream_returns_none_and_cleans_up() {\r\n  978         let (dir, s) = (tmp_dir(\"scancel\"), serve(pattern(2_000_000), Opt { ignore_range: true, chunk_ms: 20, ..Default::default() }));\r\n  979         let cancel = Arc::new(AtomicBool::new(false));\r\n  980         let (flag, served) = (cancel.clone(), s.served.clone());\r\n  981         std::thread::spawn(move || {\r\n  982             while served.load(Ordering::SeqCst) < 300_000 {\r\n  983                 std::thread::sleep(Duration::from_millis(1));\r\n  984             }\r\n  985             flag.store(true, Ordering::SeqCst);\r\n  986         });\r\n  987         assert_eq!(run(&format!(\"{}/file.bin\", s.url), &dir.join(\"a.bin\"), cancel, |_| {}).unwrap(), None);\r\n  988         assert!(files(&dir).is_empty());\r\n  989         std::fs::remove_dir_all(dir).ok();\r\n  990     }\r\n  991 \r\n  992     // D9: ��� �ִ� ��Ű/���۷��� ������ �ʴ´�.\r\n  993     #[test]\r\n  994     fn empty_cookie_and_referer_are_not_sent() {\r\n  995         let (dir, s) = (tmp_dir(\"empty\"), serve(pattern(1000), Opt::default()));\r\n  996         let request = DownloadRequest {\r\n  997             url: format!(\"{}/file.bin\", s.url),\r\n  998             destination: dir.join(\"a.bin\"),\r\n  999             cookie_header: Some(String::new()),\r\n 1000             referer: Some(String::new()),\r\n 1001         };\r\n 1002         let rt = tokio::runtime::Runtime::new().unwrap();\r\n 1003         rt.block_on(download(request, Arc::new(AtomicBool::new(false)), |_| {})).unwrap();\r\n 1004         let log = s.log.lock().unwrap().join(\"\").to_ascii_lowercase();\r\n 1005         assert!(!log.contains(\"cookie:\") && !log.contains(\"referer:\"));\r\n 1006         std::fs::remove_dir_all(dir).ok();\r\n 1007     }\r\n 1008 \r\n 1009     // D7: ��ū ������Ʈ��.\r\n 1010     #[test]\r\n 1011     fn cancel_tokens_register_request_clear() {\r\n 1012         let flag = register_cancel(\"t-w3\");\r\n 1013         assert!(!flag.load(Ordering::SeqCst));\r\n 1014         assert!(request_cancel(\"t-w3\") && flag.load(Ordering::SeqCst));\r\n 1015         clear_cancel(\"t-w3\");\r\n 1016         assert!(!request_cancel(\"t-w3\") && !request_cancel(\"never-registered\"));\r\n 1017         assert!(!register_cancel(\"t-w3\").load(Ordering::SeqCst), \"�� ����� �� �÷���\");\r\n 1018         clear_cancel(\"t-w3\");\r\n 1019     }\r\n 1020 \r\n 1021     // �����ٸ�: �̹��� ���� ����, ������ ���� ���� ���� ������ �� ����, �ʹ� ������ ����. ������ ��ġ�� �ʴ´�.\r\n 1022     #[test]\r\n 1023     fn claim_takes_todo_then_steals_half_then_gives_up() {\r\n 1024         let big = 10 * MIN_STEAL;\r\n 1025         let state = std::fs::File::create(std::env::temp_dir().join(format!(\"segdl-claim-{}\", std::process::id()))).unwrap();\r\n 1026         let mut sh = Shared { todo: vec![(0, big)], slots: vec![(0, 0); 3], state, done: 0, last_ckpt: 0, last_emit: Instant::now() };\r\n 1027         assert!(sh.claim(0) && sh.slots[0] == (0, big));\r\n 1028         sh.slots[0].0 = 2 * MIN_STEAL; // ���� 0�� ���� ���� ��\r\n 1029         assert!(sh.claim(1));\r\n 1030         let mid = 2 * MIN_STEAL + 4 * MIN_STEAL;\r\n 1031         assert_eq!((sh.slots[0], sh.slots[1]), ((2 * MIN_STEAL, mid), (mid, big)));\r\n 1032         sh.slots[0].0 = mid - MIN_STEAL; // ���� ������ 2*MIN_STEAL �̸�\r\n 1033         sh.slots[1].0 = big - MIN_STEAL;\r\n 1034         assert!(!sh.claim(2) && sh.slots[2] == (0, 0));\r\n 1035         assert_eq!(sh.remaining().len(), 2);\r\n 1036     }\r\n 1037 }\r\n","exit_code":0,"status":"completed"}}
