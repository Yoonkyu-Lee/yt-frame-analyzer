    drop(sh);\r\n  432:     ctx.emit(total);\r\n  433:     std::fs::rename(&ctx.part, &ctx.req.destination).map_err(|e| format!(\"�Ϸ� ���� �̵� ����: {e}\"))\r\n  434: }\r\n  435: \r\n  436: /// D2: Range ���� �� ���� �޴´�(�簳 �Ұ�). ����/��� �� �ӽ� ������ ������.\r\n  437: async fn single(\r\n  438:     client: Client,\r\n  439:     req: DownloadRequest,\r\n  440:     expected: Option<u64>,\r\n  441:     cancel: Arc<AtomicBool>,\r\n  442:     on_progress: Box<dyn Fn(DownloadProgress) + Send + Sync>,\r\n  443: ) -> Result<(), String> {\r\n  444:     let mut resp = wait(get(&client, &req).send(), &cancel, \"�ٿ�ε� ���� ���� ����\").await.map_err(Fail::text)?;\r\n  445:     // D5: Range ���� �������� ��ü�� �޾ƾ� �Ѵ�. 206�� ������ �Ϻζ� �ϼ����� �� �� ����\r\n  446:     if resp.status() == StatusCode::PARTIAL_CONTENT || !resp.status().is_success() {\r\n  447:         return Err(format!(\"�ٿ�ε� ������ ��ü ������ ���� �ʾҽ��ϴ�: HTTP {}\", resp.status()));\r\n  448:     }\r\n  449:     let total = match (resp.content_length(), expected) {\r\n  450:         (Some(now), Some(probed)) if now != probed => {\r\n  451:             return Err(format!(\"������ �˷� �� ũ�Ⱑ ���� �ٸ��ϴ�: {probed} / {now} bytes\"));\r\n  452:         }\r\n  453:         (now, probed) => now.or(probed),\r\n  454:     };\r\n  455:     let emit = |received| on_progress(DownloadProgress { received, total, mode: DownloadMode::Single });\r\n  456:     let part = side(&req.destination, \".download\");\r\n  457:     forget_state(&side(&req.destination, \".download.state\"))?;\r\n  458:     let copied = async {\r\n  459:         let mut file = std::fs::File::create(&part).map_err(|e| format!(\"�ӽ� ���� ���� ����: {e}\"))?;\r\n  460:         let (mut got, mut last) = (0u64, Instant::now());\r\n  461:         emit(0);\r\n  462:         while let Some(chunk) = wait(resp.chunk(), &cancel, \"���� ����\").await.map_err(Fail::text)? {\r\n  463:             if cancel.load(Ordering::Relaxed) {\r\n  464:                 return Err(CANCELLED.to_string());\r\n  465:             }\r\n  466:             file.write_all(&chunk).map_err(|e| format!(\"���� ���� ����: {e}\"))?;\r\n  467:             got += chunk.len() as u64;\r\n  468:             if last.elapsed() >= PROGRESS_EVERY {\r\n  469:                 last = Instant::now();\r\n  470:                 emit(got);\r\n  471:             }\r\n  472:         }\r\n  473:         if total.is_some_and(|t| t != got) {\r\n  474:             return Err(\"���� ũ�Ⱑ ���� ũ��� �ٸ��ϴ�\".to_string());\r\n  475:         }\r\n  476:         if cancel.load(Ordering::Relaxed) {\r\n  477:             return Err(CANCELLED.to_string()); // D7: ������ ûũ ��(�Ǵ� �� ����)�� ���� ���\r\n  478:         }\r\n  479:         // D8: ũ�⸦ ����� �������� �ȴ� ? ������ �̺�Ʈ�� received == total\r\n  480:         on_progress(DownloadProgress { received: got, total: Some(got), mode: DownloadMode::Single });\r\n  481:         std::fs::rename(&part, &req.destination).map_err(|e| format!(\"�Ϸ� ���� �̵� ����: {e}\"))\r\n  482:     }\r\n  483:     .await;\r\n  484:     if copied.is_err() {\r\n  485:         let _ = std::fs::remove_file(&part);\r\n  486:     }\r\n  487:     copied\r\n  488: }\r\n  489: \r\n  490: /// `Ok(Some(path))` �Ϸ�, `Ok(None)` ���(�簳 ���� ����), `Err` ����(D10: �ѱ��� �޽���).\r\n  491: pub async fn download<F>(\r\n  492:     request: DownloadRequest,\r\n  493:     cancel: Arc<AtomicBool>,\r\n  494:     on_progress: F,\r\n  495: ) -> Result<Option<PathBuf>, String>\r\n  496: where\r\n  497:     F: Fn(DownloadProgress) + Send + Sync + 'static,\r\n  498: {\r\n  499:     let client = Client::builder()\r\n  500:         .connect_timeout(Duration::from_secs(20))\r\n  501:         .redirect(reqwest::redirect::Policy::limited(10))\r\n  502:         .referer(false) // D9: ����Ʈ �ڿ��� ȣ���ڰ� �� Referer�� �״�� ������\r\n  503:         .user_agent(USER_AGENT)\r\n  504:         .build()\r\n  505:         .map_err(|e| format!(\"HTTP Ŭ���̾�Ʈ ���� ����: {e}\"))?;\r\n  506:     let dest = request.destination.clone();\r\n  507:     let on_progress = Box::new(on_progress);\r\n  508:     let flag = cancel.clone();\r\n  509:     let result = match probe(&client, &request, &cancel).await {\r\n  510:         Ok(Plan::Segmented(total)) => segmented(client, request, total, cancel, on_progress).await,\r\n  511:         Ok(Plan::Single(expected)) => single(client, request, expected, cancel, on_progress).await,\r\n  512:         Err(e) => Err(e), // ���κ� �� ��ҵ� �Ʒ����� Ok(None)�� �ȴ�\r\n  513:     };\r\n  514:     match result {\r\n  515:         Ok(()) => {\r\n  516:             let _ = std::fs::remove_file(side(&dest, \".download.state\")); // D1: ���� �� �ܿ��� ����\r\n  517:             Ok(Some(dest))\r\n  518:         }\r\n  519:         Err(_) if flag.load(Ordering::Relaxed) => Ok(None),\r\n  520:         Err(e) => Err(e),\r\n  521:     }\r\n  522: }\r\n  523: \r\n  524: #[cfg(test)]\r\n  525: mod tests {\r\n  526:     use super::*;\r\n  527:     use std::io::Read;\r\n  528:     use std::net::{TcpListener, TcpStream};\r\n  529:     use std::sync::atomic::{AtomicU64, AtomicUsize};\r\n  530: \r\n  531:     /// �׽�Ʈ ���� ���� ����ġ (0/false = ����).\r\n  532:     #[derive(Clone, Default)]\r\n  533:     struct Opt {\r\n  534:         ignore_range: bool,\r\n  535:         unknown_total: bool,\r\n  536:         status: u16,\r\n  537:         wrong_start: bool,\r\n  538:         extra_byte: bool,\r\n  539:         short_first: usize, // ó�� N���� ���� ������ ���ݸ� ������ ���´�\r\n  540:         delay_ms: u64,      // ���� �� ��� (���� ���� ������)\r\n  541:         chunk_ms: u64,      // 64 KiB���� ��� (���� ����)\r\n  542:         drop_probe: usize,  // ó�� N���� ���κ�� ���� ���� ���´�\r\n  543:         stall_first: usize, // ó�� N���� ���� ������ ���ݸ� ������ ������ �� ä ħ���Ѵ�\r\n  544:         no_length: bool,    // Content-Length ���� ������ (���� ����� ���� �˸���)\r\n  545:         short_plain: bool,  // Range ���� ��û���� �� ���ݸ�, �� ���̸� Content-Length�� ������\r\n  546:     }\r\n  547: \r\n  548:     #[derive(Clone)]\r\n  549:     struct Srv {\r\n  550:         url: String,\r\n  551:         log: Arc<Mutex<Vec<String>>>,\r\n  552:         served: Arc<AtomicU64>,\r\n  553:         peak: Arc<AtomicUsize>,\r\n  554:         active: Arc<AtomicUsize>,\r\n  555:         shorts: Arc<AtomicUsize>,\r\n  556:         probe_drops: Arc<AtomicUsize>,\r\n  557:         stalls: Arc<AtomicUsize>,\r\n  558:         data: Arc<Vec<u8>>,\r\n  559:         o: Opt,\r\n  560:     }\r\n  561: \r\n  562:     fn serve(data: Vec<u8>, o: Opt) -> Srv {\r\n  563:         let l = TcpListener::bind(\"127.0.0.1:0\").unwrap();\r\n  564:         let s = Srv {\r\n  565:             url: format!(\"http://{}\", l.local_addr().unwrap()),\r\n  566:             log: Default::default(),\r\n  567:             served: Default::default(),\r\n  568:             peak: Default::default(),\r\n  569:             active: Default::default(),\r\n  570:             shorts: Arc::new(AtomicUsize::new(o.short_first)),\r\n  571:             probe_drops: Arc::new(AtomicUsize::new(o.drop_probe)),\r\n  572:             stalls: Arc::new(AtomicUsize::new(o.stall_first)),\r\n  573:             data: Arc::new(data),\r\n  574:             o,\r\n  575:         };\r\n  576:         let srv = s.clone();\r\n  577:         std::thread::spawn(move || {\r\n  578:             for conn in l.incoming().flatten() {\r\n  579:                 let srv = srv.clone();\r\n  580:                 std::thread::spawn(move || {\r\n  581:                     let _ = handle(&srv, conn);\r\n  582:                 });\r\n  583:             }\r\n  584:         });\r\n  585:         s\r\n  586:     }\r\n  587: \r\n  588:     fn handle(s: &Srv, mut c: TcpStream) -> std::io::Result<()> {\r\n  589:         let (mut buf, mut tmp) = (Vec::new(), [0u8; 1024]);\r\n  590:         while !buf.windows(4).any(|w| w == b\"\\r\\n\\r\\n\") {\r\n  591:             let n = c.read(&mut tmp)?;\r\n  592:             if n == 0 {\r\n  593:                 return Ok(());\r\n  594:             }\r\n  595:             buf.extend_from_slice(&tmp[..n]);\r\n  596:         }\r\n  597:         let head = String::from_utf8_lossy(&buf).into_owned();\r\n  598:         s.log.lock().unwrap().push(head.clone());\r\n  599:         let range = head\r\n  600:             .lines()\r\n  601:             .find_map(|l| l.to_ascii_lowercase().strip_prefix(\"range: bytes=\").map(str::to_string))\r\n  602:             .and_then(|v| {\r\n  603:                 let (a, b) = v.split_once('-')?;\r\n  604:                 Some((a.trim().parse::<usize>().ok()?, b.trim().parse::<usize>().ok()?))\r\n  605:             });\r\n  606:         if head.starts_with(\"GET /redirect\") {\r\n  607:             return write!(c, \"HTTP/1.1 302 Found\\r\\nLocation: /file.bin\\r\\nContent-Length: 0\\r\\nConnection: close\\r\\n\\r\\n\");\r\n  608:         }\r\n  609:         if s.o.status != 0 {\r\n  610:             return write!(c, \"HTTP/1.1 {} X\\r\\nContent-Length: 0\\r\\nConnection: close\\r\\n\\r\\n\", s.o.status);\r\n  611:         }\r\n  612:         let len = s.data.len();\r\n  613:         let probe = range == Some((0, 0));\r\n  614:         let take = |n: &AtomicUsize| n.fetch_update(Ordering::SeqCst, Ordering::SeqCst, |n| n.checked_sub(1)).is_ok();\r\n  615:         if probe && take(&s.probe_drops) {\r\n  616:             return Ok(()); // ���� ���� ������ �ݴ´�\r\n  617:         }\r\n  618:         let stall = !probe && take(&s.stalls);\r\n  619:         let (status, a, e, cr) = match range {\r\n  620:             Some((a, b)) if !s.o.ignore_range && a < len => {\r\n  621:                 let e = b.min(len - 1);\r\n  622:                 let shown = if s.o.wrong_start && !probe { a + 1 } else { a };\r\n  623:                 let t = if s.o.unknown_total { \"*\".to_string() } else { len.to_string() };\r\n  624:                 (\"206 Partial Content\", a, e, format!(\"Content-Range: bytes {shown}-{e}/{t}\\r\\n\"))\r\n  625:             }\r\n  626:             _ => (\"200 OK\", 0, len.saturating_sub(1), String::new()),\r\n  627:         };\r\n  628:         let mut body = if len == 0 { vec![] } else { s.data[a..=e].to_vec() };\r\n  629:         if s.o.short_plain && range.is_none() {\r\n  630:             body.truncate(body.len() / 2);\r\n  631:         }\r\n  632:         if s.o.extra_byte && !cr.is_empty() && !probe {\r\n  633:             body.push(0xAB);\r\n  634:         }\r\n  635:         let length = if s.o.no_length { String::new() } else { format!(\"Content-Length: {}\\r\\n\", body.len()) };\r\n  636:         write!(c, \"HTTP/1.1 {status}\\r\\n{length}{cr}Connection: close\\r\\n\\r\\n\")?;\r\n  637:         let cut = !probe && s.shorts.fetch_update(Ordering::SeqCst, Ordering::SeqCst, |n| n.checked_sub(1)).is_ok();\r\n  638:         let limit = if cut || stall { body.len() / 2 } else { body.len() };\r\n  639:         if !probe {\r\n  640:             s.peak.fetch_max(s.active.fetch_add(1, Ordering::SeqCst) + 1, Ordering::SeqCst);\r\n  641:             std::thread::sleep(Duration::from_millis(s.o.delay_ms));\r\n  642:         }\r\n  643:         // �ʰ� ����Ʈ�� ���� �ʰ� ������: ��û�� ���̸� �� ä�� �ڿ� �����ϴ� ������ �䳻 ����\r\n  644:         let split = if s.o.extra_byte && !cr.is_empty() && !probe { limit.saturating_sub(1) } else { limit };\r\n  645:         let sent = (|| {\r\n  646:             for ch in body[..split].chunks(64 * 1024) {\r\n  647:                 c.write_all(ch)?;\r\n  648:                 s.served.fetch_add(ch.len() as u64, Ordering::SeqCst);\r\n  649:                 std::thread::sleep(Duration::from_millis(s.o.chunk_ms));\r\n  650:             }\r\n  651:             if split < limit {\r\n  652:                 c.flush()?;\r\n  653:                 std::thread::sleep(Duration::from_millis(30));\r\n  654:                 c.write_all(&body[split..limit])?;\r\n  655:             }\r\n  656:             std::io::Result::Ok(())\r\n  657:         })();\r\n  658:         if stall {\r\n  659:             std::thread::sleep(Duration::from_secs(60)); // ������ �� ä ħ��\r\n  660:         }\r\n  661:         if !probe {\r\n  662:             s.active.fetch_sub(1, Ordering::SeqCst);\r\n  663:         }\r\n  664:         sent\r\n  665:     }\r\n  666: \r\n  667:     fn pattern(n: usize) -> Vec<u8> {\r\n  668:         (0..n).map(|i| (i * 7 % 251) as u8).collect()\r\n  669:     }\r\n  670: \r\n  671:     fn tmp_dir(tag: &str) -> PathBuf {\r\n  672:         let t = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos();\r\n  673:         let dir = std::env::temp_dir().join(format!(\"segdl-{tag}-{}-{t}\", std::process::id()));\r\n  674:         std::fs::create_dir_all(&dir).unwrap();\r\n  675:         dir\r\n  676:     }\r\n  677: \r\n  678:     fn files(dir: &Path) -> Vec<String> {\r\n  679:         let mut v: Vec<String> =\r\n  680:             std::fs::read_dir(dir).unwrap().map(|e| e.unwrap().file_name().to_string_lossy().into_owned()).collect();\r\n  681:         v.sort();\r\n  682:         v\r\n  683:     }\r\n  684: \r\n  685:     fn run(\r\n  686:         url: &str,\r\n  687:         dest: &Path,\r\n  688:         cancel: Arc<AtomicBool>,\r\n  689:         cb: impl Fn(DownloadProgress) + Send + Sync + 'static,\r\n  690:     ) -> Result<Option<PathBuf>, String> {\r\n  691:         let request = DownloadRequest {\r\n  692:             url: url.to_string(),\r\n  693:             destination: dest.to_path_buf(),\r\n  694:             cookie_header: None,\r\n  695:             referer: None,\r\n  696:         };\r\n  697:         let rt = tokio::runtime::Builder::new_multi_thread().worker_threads(4).enable_all().build().unwrap();\r\n  698:         rt.block_on(download(request, cancel, cb))\r\n  699:     }\r\n  700: \r\n  701:     fn plain(url: &str, dest: &Path) -> Result<Option<PathBuf>, String> {\r\n  702:         run(&format!(\"{url}/file.bin\"), dest, Arc::new(AtomicBool::new(false)), |_| {})\r\n  703:     }\r\n  704: \r\n  705:     // D1: � ũ���(0 ����Ʈ ����) ����Ʈ�� ���� ������ ���� ���ϸ� ���´�.\r\n  706:     #[test]\r\n  707:     fn exact_bytes_and_no_leftovers_for_any_size() {\r\n  708:         for n in [0usize, 1, 7, 100, 1_000_003] {\r\n  709:             let (data, dir) = (pattern(n), tmp_dir(\"size\"));\r\n  710:             let dest = dir.join(\"a.bin\");\r\n  711:             let s = serve(data.clone(), Opt::default());\r\n  712:             assert_eq!(plain(&s.url, &dest).unwrap(), Some(dest.clone()), \"size {n}\");\r\n  713:             assert_eq!(std::fs::read(&dest).unwrap(), data, \"size {n}\");\r\n  714:             assert_eq!(files(&dir), vec![\"a.bin\"], \"size {n}\");\r\n  715:             std::fs::remove_dir_all(dir).ok();\r\n  716:         }\r\n  717:     }\r\n  718: \r\n  719:     // D3: ���� ������ ���� 8���� ���� �ʴ´�.\r\n  720:     #[test]\r\n  721:     fn uses_several_connections_but_at_most_eight() {\r\n  722:         let (dir, s) = (tmp_dir(\"conn\"), serve(pattern(4_000_000), Opt { delay_ms: 80, ..Default::default() }));\r\n  723:         plain(&s.url, &dir.join(\"a.bin\")).unwrap();\r\n  724:         let peak = s.peak.load(Ordering::SeqCst);\r\n  725:         assert!((2..=8).contains(&peak), \"peak {peak}\");\r\n  726:         std::fs::remove_dir_all(dir).ok();\r\n  727:     }\r\n  728: \r\n  729:     // D2 + D9: ù ��û�� bytes=0-0, ��� ��û�� identity/��Ű/���۷�/ũ�� UA, ����Ʈ�� ���󰣴�.\r\n  730:     #[test]\r\n  731:     fn probe_first_and_every_request_carries_headers() {\r\n  732:         let (dir, s) = (tmp_dir(\"hdr\"), serve(pattern(300_000), Opt::default()));\r\n  733:         let dest = dir.join(\"a.bin\");\r\n  734:         let request = DownloadRequest {\r\n  735:             url: format!(\"{}/redirect\", s.url),\r\n  736:             destination: dest.clone(),\r\n  737:             cookie_header: Some(\"sid=abc\".into()),\r\n  738:             referer: Some(\"https://host.example/page\".into()),\r\n  739:         };\r\n  740:         let rt = tokio::runtime::Runtime::new().unwrap();\r\n  741:         let r = rt.block_on(download(request, Arc::new(AtomicBool::new(false)), |_| {}));\r\n  742:         assert_eq!(r.unwrap(), Some(dest.clone()));\r\n  743:         assert_eq!(std::fs::read(&dest).unwrap(), pattern(300_000));\r\n  744:         let log = s.log.lock().unwrap();\r\n  745:         assert!(log[0].to_ascii_lowercase().contains(\"range: bytes=0-0\"), \"{}\", log[0]);\r\n  746:         for head in log.iter() {\r\n  747:             let h = head.to_ascii_lowercase();\r\n  748:             assert!(h.contains(\"accept-encoding: identity\"), \"{head}\");\r\n  749:             assert!(h.contains(\"cookie: sid=abc\"), \"{head}\");\r\n  750:             assert!(h.contains(\"referer: https://host.example/page\"), \"{head}\");\r\n  751:             assert!(h.contains(\"user-agent: mozilla/5.0 (windows nt 10.0\") && h.contains(\"chrome/\"), \"{head}\");\r\n  752:         }\r\n  753:         std::fs::remove_dir_all(dir).ok();\r\n  754:     }\r\n  755: \r\n  756:     // D2: Range ����(200)�� �ѷ� ��(`*`)�� ���� ��Ʈ������ �޴´�.\r\n  757:     #[test]\r\n  758:     fn range_ignored_or_unknown_total_uses_single_stream() {\r\n  759:         for o in [Opt { ignore_range: true, ..Default::default() }, Opt { unknown_total: true, ..Default::default() }] {\r\n  760:             let (data, dir) = (pattern(100_000), tmp_dir(\"single\"));\r\n  761:             let (s, dest) = (serve(data.clone(), o), dir.join(\"a.bin\"));\r\n  762:             let modes = Arc::new(Mutex::new(Vec::new()));\r\n  763:             let m = modes.clone();\r\n  764:             let r = run(&format!(\"{}/file.bin\", s.url), &dest, Arc::new(AtomicBool::new(false)), move |p| {\r\n  765:                 m.lock().unwrap().push((p.mode, p.received, p.total))\r\n  766:             });\r\n  767:             assert_eq!(r.unwrap(), Some(dest.clone()));\r\n  768:             assert_eq!(std::fs::read(&dest).unwrap(), data);\r\n  769:             let modes = modes.lock().unwrap();\r\n  770:             assert!(modes.iter().all(|m| m.0 == DownloadMode::Single));\r\n  771:             assert_eq!(modes.last().unwrap().1, 100_000);\r\n  772:             assert_eq!(files(&dir), vec![\"a.bin\"]);\r\n  773:             std::fs::remove_dir_all(dir).ok();\r\n  774:         }\r\n  775:     }\r\n  776: \r\n  777:     // D2 + D10: HTTP ������ �ѱ��� Err�̰� ������ ���� �ʴ´�.\r\n  778:     #[test]\r\n  779:     fn http_error_is_korean_err_and_leaves_nothing() {\r\n  780:         let (dir, s) = (tmp_dir(\"http\"), serve(pattern(10), Opt { status: 404, ..Default::default() }));\r\n  781:         let err = plain(&s.url, &dir.join(\"a.bin\")).unwrap_err();\r\n  782:         assert!(err.contains(\"HTTP 404\") && err.chars().any(|c| ('��'..='�R').contains(&c)), \"{err}\");\r\n  783:         assert!(files(&dir).is_empty());\r\n  784:         std::fs::remove_dir_all(dir).ok();\r\n  785:     }\r\n  786: \r\n  787:     // D6: �Ͻ��� ������ ��õ��� �����ǰ�, ��� �����ϸ� �� �� �ȿ� Err�� ������.\r\n  788:     #[test]\r\n  789:     fn transient_drops_retry_and_persistent_failure_errs_quickly() {\r\n  790:         let (data, dir) = (pattern(1_000_000), tmp_dir(\"retry\"));\r\n  791:         let s = serve(data.clone(), Opt { short_first: 3, ..Default::default() });\r\n  792:         let dest = dir.join(\"a.bin\");\r\n  793:         assert_eq!(plain(&s.url, &dest).unwrap(), Some(dest.clone()));\r\n  794:         assert_eq!(std::fs::read(&dest).unwrap(), data);\r\n  795: \r\n  796:         let (dir2, s2) = (tmp_dir(\"retry2\"), serve(data, Opt { short_first: 10_000, ..Default::default() }));\r\n  797:         let t = Instant::now();\r\n  798:         let err = plain(&s2.url, &dir2.join(\"a.bin\")).unwrap_err();\r\n  799:         assert!(t.elapsed() < Duration::from_secs(15), \"{:?}\", t.elapsed());\r\n  800:         assert!(!err.is_empty() && !dir2.join(\"a.bin\").exists());\r\n  801:         std::fs::remove_dir_all(dir).ok();\r\n  802:         std::fs::remove_dir_all(dir2).ok();\r\n  803:     }\r\n  804: \r\n  805:     // D5: ������ ��߳� Content-Range / �� �� ������ Err�̰ų� �ùٸ� �����̾�� �ϸ� Ʋ�� ������ ����.\r\n  806:     #[test]\r\n  807:     fn wrong_range_or_oversize_never_yields_wrong_file() {\r\n  808:         for o in [Opt { wrong_start: true, ..Default::default() }, Opt { extra_byte: true, ..Default::default() }] {\r\n  809:             let (data, dir) = (pattern(500_000), tmp_dir(\"bad\"));\r\n  810:             let (s, dest) = (serve(data.clone(), o.clone()), dir.join(\"a.bin\"));\r\n  811:             let r = plain(&s.url, &dest);\r\n  812:             // ��û���� �� ������ ������ ��Ű�� �ʴ� ������: �պκи� �޾Ƶ� ������ ����Ʈ�� �� �ִ�\r\n  813:             assert!(r.is_err(), \"��߳� Content-Range / ��û���� �� ������ Err\");\r\n  814:             if dest.exists() {\r\n  815:                 assert_eq!(std::fs::read(&dest).unwrap(), data);\r\n  816:             } else {\r\n  817:                 assert!(r.is_err());\r\n  818:             }\r\n  819:             std::fs::remove_dir_all(dir).ok();\r\n  820:         }\r\n  821:     }\r\n  822: \r\n  823:     // D6: ���κ갡 �� �� ���ܵ� ��õ��ؼ� �޴´�.\r\n  824:     #[test]\r\n  825:     fn probe_failure_is_retried() {\r\n  826:         let (data, dir) = (pattern(300_000), tmp_dir(\"probe\"));\r\n  827:         let s = serve(data.clone(), Opt { drop_probe: 1, ..Default::default() });\r\n  828:         let dest = dir.join(\"a.bin\");\r\n  829:         assert_eq!(plain(&s.url, &dest).unwrap(), Some(dest.clone()));\r\n  830:         assert_eq!(std::fs::read(&dest).unwrap(), data);\r\n  831:         std::fs::remove_dir_all(dir).ok();\r\n  832:     }\r\n  833: \r\n  834:     // D6: ������ �� ä ħ���ϴ� ������ STALL_SECS �� �����ϰ� ���� ������ �ٽ� �޴´�.\r\n  835:     #[test]\r\n  836:     fn stalled_piece_is_given_up_and_retried() {\r\n  837:         let (data, dir) = (pattern(1_000_000), tmp_dir(\"stall\"));\r\n  838:         let s = serve(data.clone(), Opt { stall_first: 1, ..Default::default() });\r\n  839:         let dest = dir.join(\"a.bin\");\r\n  840:         let t = Instant::now();\r\n  841:         assert_eq!(plain(&s.url, &dest).unwrap(), Some(dest.clone()));\r\n  842:         assert_eq!(std::fs::read(&dest).unwrap(), data);\r\n  843:         assert!(t.elapsed() < Duration::from_secs(STALL_SECS + 5), \"{:?}\", t.elapsed());\r\n  844:         std::fs::remove_dir_all(dir).ok();\r\n  845:     }\r\n  846: \r\n  847:     // D7: ������ ħ���ص�(���ҡ����� ���) ��Ҵ� �� 1�� �ȿ� ��´�.\r\n  848:     #[test]\r\n  849:     fn cancel_is_prompt_while_the_server_is_silent() {\r\n  850:         for ignore_range in [false, true] {\r\n  851:             let o = Opt { ignore_range, stall_first: 100, ..Default::default() };\r\n  852:             let (dir, s) = (tmp_dir(\"silent\"), serve(pattern(1_000_000), o));\r\n  853:             let dest = dir.join(\"a.bin\");\r\n  854:             let cancel = Arc::new(AtomicBool::new(false));\r\n  855:             let flag = cancel.clone();\r\n  856:             std::thread::spawn(move || {\r\n  857:                 std::thread::sleep(Duration::from_millis(500));\r\n  858:                 flag.store(true, Ordering::SeqCst);\r\n  859:             });\r\n  860:             let t = Instant::now();\r\n  861:             assert_eq!(run(&format!(\"{}/file.bin\", s.url), &dest, cancel, |_| {}).unwrap(), None);\r\n  862:             assert!(t.elapsed() < Duration::from_millis(1900), \"ignore_range={ignore_range}: {:?}\", t.elapsed());\r\n  863:             assert!(!dest.exists());\r\n  864:             std::fs::remove_dir_all(dir).ok();\r\n  865:         }\r\n  866:     }\r\n  867: \r\n  868:     // D5: ���� ��� ���� ��û���� �� ����(�ʰ� ����Ʈ�� �ʰ� ���� �´�)�� Err��.\r\n  869:     #[test]\r\n  870:     fn oversized_response_without_length_is_err() {\r\n  871:         let (dir, s) = (tmp_dir(\"nolen\"), serve(pattern(500_000), Opt { extra_byte: true, no_length: true, ..Default::default() }));\r\n  872:         let dest = dir.join(\"a.bin\");\r\n  873:         assert!(plain(&s.url, &dest).is_err());\r\n  874:         assert!(!dest.exists());\r\n  875:         std::fs::remove_dir_all(dir).ok();\r\n  876:     }\r\n  877: \r\n  878:     // D5: ���κ�(200)�� �˷� �� ũ��� �� ��û�� Content-Length�� �ٸ��� �߸� ������ ������ �ʴ´�.\r\n  879:     #[test]\r\n  880:     fn single_stream_length_contradicting_probe_is_err() {\r\n  881:         let o = Opt { ignore_range: true, short_plain: true, ..Default::default() };\r\n  882:         let (dir, s) = (tmp_dir(\"shortplain\"), serve(pattern(400_000), o));\r\n  883:         let dest = dir.join(\"a.bin\");\r\n  884:         assert!(plain(&s.url, &dest).is_err());\r\n  885:         assert!(!dest.exists());\r\n  886:         std::fs::remove_dir_all(dir).ok();\r\n  887:     }\r\n  888: \r\n  889:     // D7: ��õ� ���� ��� �߿��� ��Ҵ� �� 1�� �ȿ� ��´�.\r\n  890:     #[test]\r\n  891:     fn cancel_is_prompt_during_retry_backoff() {\r\n  892:         let (dir, s) = (tmp_dir(\"backoff\"), serve(pattern(1_000_000), Opt { short_first: 10_000, ..Default::default() }));\r\n  893:         let dest = dir.join(\"a.bin\");\r\n  894:         let cancel = Arc::new(AtomicBool::new(false));\r\n  895:         let flag = cancel.clone();\r\n  896:         std::thread::spawn(move || {\r\n  897:             std::thread::sleep(Duration::from_millis(600));\r\n  898:             flag.store(true, Ordering::SeqCst);\r\n  899:         });\r\n  900:         let t = Instant::now();\r\n  901:         assert_eq!(run(&format!(\"{}/file.bin\", s.url), &dest, cancel, |_| {}).unwrap(), None);\r\n  902:         assert!(t.elapsed() < Duration::from_millis(1200), \"{:?}\", t.elapsed());\r\n  903:         std::fs::remove_dir_all(dir).ok();\r\n  904:     }\r\n  905: \r\n  906:     // D7: �̸� �� ��Ҵ� ���κ길 ������ Ok(None), ���� ���� ����, �簳 ���� ����.\r\n  907:     #[test]\r\n  908:     fn preset_cancel_returns_none_and_keeps_state() {\r\n  909:         let (dir, s) = (tmp_dir(\"pre\"), serve(pattern(200_000), Opt::default()));\r\n  910:         let dest = dir.join(\"a.bin\");\r\n  911:         let r = run(&format!(\"{}/file.bin\", s.url), &dest, Arc::new(AtomicBool::new(true)), |_| {});\r\n  912:         assert_eq!(r.unwrap(), None);\r\n  913:         assert!(!dest.exists() && side(&dest, \".download\").exists() && side(&dest, \".download.state\").exists());\r\n  914:         assert_eq!(s.log.lock().unwrap().len(), 1, \"���κ길\");\r\n  915:         std::fs::remove_dir_all(dir).ok();\r\n  916:     }\r\n  917: \r\n  918:     // D4 + D7: ���� �� ��� �� ���� ���� �� ���� URL ������� ���� ��ŭ�� �޴´�.\r\n  919:     #[test]\r\n  920:     fn cancel_midway_then_resume_fetches_only_missing() {\r\n  921:         let (data, dir) = (pattern(8_000_000), tmp_dir(\"resume\"));\r\n  922:         let dest = dir.join(\"a.bin\");\r\n  923:         let s = serve(data.clone(), Opt { chunk_ms: 20, ..Default::default() });\r\n  924:         let cancel = Arc::new(AtomicBool::new(false));\r\n  925:         let (flag, served) = (cancel.clone(), s.served.clone());\r\n  926:         std::thread::spawn(move || {\r\n  927:             while served.load(Ordering::SeqCst) < 2_000_000 {\r\n  928:                 std::thread::sleep(Duration::from_millis(1));\r\n  929:             }\r\n  930:             flag.store(true, Ordering::SeqCst);\r\n  931:         });\r\n  932:         assert_eq!(run(&format!(\"{}/file.bin\", s.url), &dest, cancel, |_| {}).unwrap(), None);\r\n  933:         assert!(!dest.exists());\r\n  934:         let state = std::fs::read_to_string(side(&dest, \".download.state\")).unwrap();\r\n  935:         let left: u64 = state.split_once(\"sum \").unwrap().0.lines().skip(1).map(|l| {\r\n  936:             let (a, b) = l.split_once(' ').unwrap();\r\n  937:             b.parse::<u64>().unwrap() - a.parse::<u64>().unwrap()\r\n  938:         }).sum();\r\n  939: \r\n  940:         let s2 = serve(data.clone(), Opt::default());\r\n  941:         assert_eq!(plain(&s2.url, &dest).unwrap(), Some(dest.clone()));\r\n  942:         assert_eq!(std::fs::read(&dest).unwrap(), data);\r\n  943:         let fetched = s2.served.load(Ordering::SeqCst) - 1;\r\n  944:         assert!(fetched >= left && fetched <= left + 8 * 1024 * 1024, \"���� {left} �� ���� ����: {fetched}\");\r\n  945:         assert!(left < 8_000_000, \"��� �� ������� �ٽ� ���� �ʴ´�\");\r\n  946:         assert_eq!(files(&dir), vec![\"a.bin\"]);\r\n  947:         std::fs::remove_dir_all(dir).ok();\r\n  948:     }\r\n  949: \r\n  950:     // D4: ���� ������ ����Ű�� ���� ������ ��û�Ѵ�.\r\n  951:     #[test]\r\n  952:     fn saved_state_limits_requests_to_remaining_spans() {\r\n  953:         let (data, dir) = (pattern(1_000_000), tmp_dir(\"state\"));\r\n  954:         let dest = dir.join(\"a.bin\");\r\n  955:         let mut part = data.clone();\r\n  956:         part[300_000..400_000].fill(0);\r\n  957:         part[900_000..].fill(0);\r\n  958:         std::fs::write(side(&dest, \".download\"), &part).unwrap();\r\n  959:         std::fs::write(side(&dest, \".download.state\"), state_text(1_000_000, &[(300_000, 400_000), (900_000, 1_000_000)]))\r\n  960:             .unwrap();\r\n  961:         let s = serve(data.clone(), Opt::default());\r\n  962:         assert_eq!(plain(&s.url, &dest).unwrap(), Some(dest.clone()));\r\n  963:         assert_eq!(std::fs::read(&dest).unwrap(), data);\r\n  964:         assert_eq!(s.served.load(Ordering::SeqCst), 200_000 + 1, \"���� ���� + ���κ� 1����Ʈ\");\r\n  965:         assert_eq!(files(&dir), vec![\"a.bin\"]);\r\n  966:         std::fs::remove_dir_all(dir).ok();\r\n  967:     }\r\n  968: \r\n  969:     // D4 + D5: �ٸ� ũ��/�ջ�/���� �� ���´� ������ ó������ �޴´�.\r\n  970:     #[test]\r\n  971:     fn foreign_or_damaged_state_is_discarded() {\r\n  972:         let data = pattern(400_000);\r\n  973:         for (state, part_len) in [\r\n  974:             (\"garbage\", 400_000),\r\n  975:             (\"999\\n0 999\\n\", 400_000),             // �ٸ� ����(ũ�� �ٸ�)\r\n  976:             (\"400000\\n0 99999999\\n\", 400_000),     // ������ ���� ��\r\n  977:             (\"400000\\n5 3\\n\", 400_000),            // ������ ����\r\n  978:             (\"400000\\nabc def\\n\", 400_000),        // ���ڰ� �ƴ�\r\n  979:             (\"400000\\nend\\n\", 12_345),            // �ӽ� ���� ũ�� ����ġ\r\n  980:             (\"400000\\n0 400000\\n\", 400_000),      // �� ǥ�� ����(���� �� ����)\r\n  981:         ] {\r\n  982:             let dir = tmp_dir(\"dmg\");\r\n  983:             let dest = dir.join(\"a.bin\");\r\n  984:             std::fs::write(side(&dest, \".download\"), vec![0xFFu8; part_len]).unwrap();\r\n  985:             std::fs::write(side(&dest, \".download.state\"), state).unwrap();\r\n  986:             let s = serve(data.clone(), Opt::default());\r\n  987:             assert_eq!(plain(&s.url, &dest).unwrap(), Some(dest.clone()), \"{state:?}\");\r\n  988:             assert_eq!(std::fs::read(&dest).unwrap(), data, \"{state:?}\");\r\n  989:             std::fs::remove_dir_all(dir).ok();\r\n  990:         }\r\n  991:     }\r\n  992: \r\n  993:     // D4 + D5: ����� �߷� ���� �Ϻθ� �ٲ� ����(�� ����ġ)�� ��ġ�� ������ ������ ó������ �޴´�.\r\n  994:     #[test]\r\n  995:     fn torn_or_overlapping_state_is_discarded() {\r\n  996:         let data = pattern(1_000_000);\r\n  997:         let torn = state_text(1_000_000, &[(200_000, 1_000_000)]).replacen(\"200000\", \"900000\", 1);\r\n  998:         let overlap = state_text(1_000_000, &[(0, 500_000), (0, 500_000)]);\r\n  999:         for state in [torn, overlap] {\r\n 1000:             let dir = tmp_dir(\"torn\");\r\n 1001:             let dest = dir.join(\"a.bin\");\r\n 1002:             std::fs::write(side(&dest, \".download\"), vec![0u8; 1_000_000]).unwrap();\r\n 1003:             std::fs::write(side(&dest, \".download.state\"), &state).unwrap();\r\n 1004:             let s = serve(data.clone(), Opt::default());\r\n 1005:             assert_eq!(plain(&s.url, &dest).unwrap(), Some(dest.clone()));\r\n 1006:             assert_eq!(std::fs::read(&dest).unwrap(), data, \"{state:.40}\");\r\n 1007:             std::fs::remove_dir_all(dir).ok();\r\n 1008:         }\r\n 1009:     }\r\n 1010: \r\n 1011:     // D7: ���� ������ ���� �簳 ���¶� ��Ұ� �̸� ���� ������ �ϼ� ������ ������ �ʴ´�.\r\n 1012:     #[test]\r\n 1013:     fn completed_state_with_preset_cancel_is_not_published() {\r\n 1014:         let (data, dir) = (pattern(300_000), tmp_dir(\"donecancel\"));\r\n 1015:         let dest = dir.join(\"a.bin\");\r\n 1016:         std::fs::write(side(&dest, \".download\"), &data).unwrap();\r\n 1017:         std::fs::write(side(&dest, \".download.state\"), state_text(300_000, &[])).unwrap();\r\n 1018:         let s = serve(data, Opt::default());\r\n 1019:         let r = run(&format!(\"{}/file.bin\", s.url), &dest, Arc::new(AtomicBool::new(true)), |_| {});\r\n 1020:         assert_eq!(r.unwrap(), None);\r\n 1021:         assert!(!dest.exists());\r\n 1022:         std::fs::remove_dir_all(dir).ok();\r\n 1023:     }\r\n 1024: \r\n 1025:     // D8: received�� �ڷ� ���� �ʰ�, total�� ��ü ũ��, mode�� ���, �ʴ� 4ȸ ����, �������� received == total.\r\n 1026:     #[test]\r\n 1027:     fn progress_is_monotone_rate_limited_and_ends_at_total() {\r\n 1028:         let (dir, s) = (tmp_dir(\"prog\"), serve(pattern(4_000_000), Opt { chunk_ms: 25, ..Default::default() }));\r\n 1029:         let events = Arc::new(Mutex::new(Vec::new()));\r\n 1030:         let e = events.clone();\r\n 1031:         let t = Instant::now();\r\n 1032:         run(&format!(\"{}/file.bin\", s.url), &dir.join(\"a.bin\"), Arc::new(AtomicBool::new(false)), move |p| {\r\n 1033:             e.lock().unwrap().push(p)\r\n 1034:         })\r\n 1035:         .unwrap();\r\n 1036:         let secs = t.elapsed().as_secs_f64();\r\n 1037:         let ev = events.lock().unwrap();\r\n 1038:         assert!(ev.windows(2).all(|w| w[0].received <= w[1].received));\r\n 1039:         assert!(ev.iter().all(|p| p.total == Some(4_000_000) && p.mode == DownloadMode::Segmented));\r\n 1040:         assert_eq!(ev.last().unwrap().received, 4_000_000);\r\n 1041:         assert!(ev.len() as f64 <= secs * 4.0 + 4.0, \"{} events in {secs}s\", ev.len());\r\n 1042:         std::fs::remove_dir_all(dir).ok();\r\n 1043:     }\r\n 1044: \r\n 1045:     // D7: ���� ��Ʈ�� ��ҵ� Ok(None)�̸� ������ �ƹ��͵� ������ �ʴ´�.\r\n 1046:     #[test]\r\n 1047:     fn cancel_during_single_stream_returns_none_and_cleans_up() {\r\n 1048:         let (dir, s) = (tmp_dir(\"scancel\"), serve(pattern(2_000_000), Opt { ignore_range: true, chunk_ms: 20, ..Default::default() }));\r\n 1049:         let cancel = Arc::new(AtomicBool::new(false));\r\n 1050:         let (flag, served) = (cancel.clone(), s.served.clone());\r\n 1051:         std::thread::spawn(move || {\r\n 1052:             while served.load(Ordering::SeqCst) < 300_000 {\r\n 1053:                 std::thread::sleep(Duration::from_millis(1));\r\n 1054:             }\r\n 1055:             flag.store(true, Ordering::SeqCst);\r\n 1056:         });\r\n 1057:         assert_eq!(run(&format!(\"{}/file.bin\", s.url), &dir.join(\"a.bin\"), cancel, |_| {}).unwrap(), None);\r\n 1058:         assert!(files(&dir).is_empty());\r\n 1059:         std::fs::remove_dir_all(dir).ok();\r\n 1060:     }\r\n 1061: \r\n 1062:     // D9: ��� �ִ� ��Ű/���۷��� ������ �ʴ´�.\r\n 1063:     #[test]\r\n 1064:     fn empty_cookie_and_referer_are_not_sent() {\r\n 1065:         let (dir, s) = (tmp_dir(\"empty\"), serve(pattern(1000), Opt::default()));\r\n 1066:         let request = DownloadRequest {\r\n 1067:             url: format!(\"{}/file.bin\", s.url),\r\n 1068:             destination: dir.join(\"a.bin\"),\r\n 1069:             cookie_header: Some(String::new()),\r\n 1070:             referer: Some(String::new()),\r\n 1071:         };\r\n 1072:         let rt = tokio::runtime::Runtime::new().unwrap();\r\n 1073:         rt.block_on(download(request, Arc::new(Ato