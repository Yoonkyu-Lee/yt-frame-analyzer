Map<String, Arc<AtomicBool>>> {\r\n   56:     CANCELLERS.lock().unwrap_or_else(PoisonError::into_inner)\r\n   57: }\r\n   58: \r\n   59: pub fn register_cancel(token: &str) -> Arc<AtomicBool> {\r\n   60:     let flag = Arc::new(AtomicBool::new(false));\r\n   61:     registry().insert(token.to_string(), flag.clone());\r\n   62:     flag\r\n   63: }\r\n   64: \r\n   65: pub fn request_cancel(token: &str) -> bool {\r\n   66:     registry().get(token).map(|f| f.store(true, Ordering::SeqCst)).is_some()\r\n   67: }\r\n   68: \r\n   69: pub fn clear_cancel(token: &str) {\r\n   70:     registry().remove(token);\r\n   71: }\r\n   72: \r\n   73: /// D9: ��� ��û�� ���� ���. identity�� �ƴϸ� ����Ʈ �������� ���� �����°� �޶�����.\r\n   74: fn get(client: &Client, req: &DownloadRequest) -> RequestBuilder {\r\n   75:     let mut b = client.get(&req.url).header(ACCEPT_ENCODING, \"identity\");\r\n   76:     if let Some(v) = req.cookie_header.as_deref().filter(|v| !v.is_empty()) {\r\n   77:         b = b.header(COOKIE, v);\r\n   78:     }\r\n   79:     if let Some(v) = req.referer.as_deref().filter(|v| !v.is_empty()) {\r\n   80:         b = b.header(REFERER, v);\r\n   81:     }\r\n   82:     b\r\n   83: }\r\n   84: \r\n   85: fn side(dest: &Path, suffix: &str) -> PathBuf {\r\n   86:     let mut s = dest.as_os_str().to_owned();\r\n   87:     s.push(suffix);\r\n   88:     s.into()\r\n   89: }\r\n   90: \r\n   91: type Span = (u64, u64); // [start, end)\r\n   92: \r\n   93: /// �����ٸ� ���� ����: �̹��� ����, ���Ằ ���� �� ����(start�� �� �簳 ������), ���� �ѷ�.\r\n   94: struct Shared {\r\n   95:     todo: Vec<Span>,\r\n   96:     slots: Vec<Span>,\r\n   97:     state: std::fs::File,\r\n   98:     done: u64,\r\n   99:     last_ckpt: u64,\r\n  100:     last_emit: Instant,\r\n  101: }\r\n  102: \r\n  103: impl Shared {\r\n  104:     /// ���� `slot`�� ������ �����Ѵ�: �̹��� ���� �켱, ������ ���� ���� ���� ������ �� ������\r\n  105:     /// �����´�(���� ������ ���� ������ ���´�). �� �� ������ false.\r\n  106:     fn claim(&mut self, slot: usize) -> bool {\r\n  107:         let span = self.todo.pop().or_else(|| {\r\n  108:             let (v, (pos, end)) =\r\n  109:                 self.slots.iter().copied().enumerate().max_by_key(|(_, (p, e))| e - p)?;\r\n  110:             let rest = end - pos;\r\n  111:             if rest < 2 * MIN_STEAL {\r\n  112:                 return None;\r\n  113:             }\r\n  114:             self.slots[v].1 = pos + rest / 2;\r\n  115:             Some((pos + rest / 2, end))\r\n  116:         });\r\n  117:         self.slots[slot] = span.unwrap_or((0, 0));\r\n  118:         span.is_some()\r\n  119:     }\r\n  120: \r\n  121:     /// D4: ���� ������ ���� ���Ͽ� ���ڸ��� ����. ���´� �׻� �������� �� ����� ��(���� ������ ����\r\n  122:     /// ����)�̶� ���� ��ϵ� �����ϴ�. ���� ���д� �簳 ������ ���� ���̹Ƿ� ������ �ʰ� ������ �ø���.\r\n  123:     fn checkpoint(&mut self, total: u64) -> Result<(), String> {\r\n  124:         let text = state_text(total, &self.remaining());\r\n  125:         self.state\r\n  126:             .seek(SeekFrom::Start(0))\r\n  127:             .and_then(|_| self.state.write_all(text.as_bytes()))\r\n  128:             .map_err(|e| format!(\"�簳 ���� ���� ����: {e}\"))\r\n  129:     }\r\n  130: \r\n  131:     /// ���� �� ���� ��� ���� (D4 �������� �Ϸ� ���� �ٰ�).\r\n  132:     fn remaining(&self) -> Vec<Span> {\r\n  133:         self.todo.iter().chain(&self.slots).copied().filter(|(a, b)| a < b).collect()\r\n  134:     }\r\n  135: }\r\n  136: \r\n  137: struct Ctx {\r\n  138:     client: Client,\r\n  139:     req: DownloadRequest,\r\n  140:     total: u64,\r\n  141:     part: PathBuf,\r\n  142:     cancel: Arc<AtomicBool>,\r\n  143:     on_progress: Box<dyn Fn(DownloadProgress) + Send + Sync>,\r\n  144:     sh: Mutex<Shared>,\r\n  145: }\r\n  146: \r\n  147: enum Fail {\r\n  148:     Retry(String),\r\n  149:     Fatal(String),\r\n  150: }\r\n  151: \r\n  152: impl Fail {\r\n  153:     fn text(self) -> String {\r\n