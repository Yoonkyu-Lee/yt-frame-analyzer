wn(move || {\r\n643:            for stream in listener.incoming().take(expected_requests) {\r\n644:                let mut stream = stream.unwrap();\r\n645:                let mut buffer = vec![0u8; 8192];\r\n646:                let size = stream.read(&mut buffer).unwrap();\r\n647:                let headers = String::from_utf8_lossy(&buffer[..size]);\r\n648:                request_count.fetch_add(1, Ordering::Relaxed);\r\n649:\r\n650:                let range = headers\r\n651:                    .lines()\r\n652:                    .find(|line| line.to_ascii_lowercase().starts_with(\"range: bytes=\"))\r\n653:                    .and_then(|line| line.split_once('=').map(|(_, value)| value.trim()))\r\n654:                    .and_then(|value| value.split_once('-'))\r\n655:                    .and_then(|(start, end)| {\r\n656:                        Some((start.parse::<usize>().ok()?, end.parse::<usize>().ok()?))\r\n657:                    });\r\n658:                let (status, body, extra_header) = if supports_range {\r\n659:                    let (start, end) = range.unwrap();\r\n660:                    (\r\n661:                        \"206 Partial Content\",\r\n662:                        &data[start..=end],\r\n663:                        format!(\"Content-Range: bytes {start}-{end}/{}\\r\\n\", data.len()),\r\n664:                    )\r\n665:                } else {\r\n666:                    (\"200 OK\", data.as_slice(), String::new())\r\n667:                };\r\n668:                write!(\r\n669:                    stream,\r\n670:                    \"HTTP/1.1 {status}\\r\\nContent-Length: {}\\r\\n{extra_header}\\\r\n671:                     Connection: close\\r\\n\\r\\n\",\r\n672:                    body.len()\r\n673:                )\r\n674:                .unwrap();\r\n675:                stream.write_all(body).unwrap();\r\n676:            }\r\n677:        });\r\n678:        (format!(\"http://{address}/file.bin\"), requests, handle)\r\n679:    }\r\n680:\r\n681:    fn no_cancel() -> Arc<AtomicBool> {\r\n682:        Arc::new(AtomicBool::new(false))\r\n683:    }\r\n684:\r\n685:    fn test_runtime() -> tokio::runtime::Runtime {\r\n686:        tokio::runtime::Builder::new_multi_thread()\r\n687:            .worker_threads(4)\r\n688:            .enable_all()\r\n689:            .build()\r\n690:            .unwrap()\r\n691:    }\r\n692:\r\n693:    fn unique_test_dir(tag: &str) -> PathBuf {\r\n694:        let dir = std::env::temp_dir().join(format!(\r\n695:            \"vnlib-segmented-{tag}-{}-{}\",\r\n696:            std::process::id(),\r\n697:            std::time::SystemTime::now()\r\n698:                .duration_since(std::time::UNIX_EPOCH)\r\n699:                .unwrap()\r\n700:                .as_nanos()\r\n701:        ));\r\n702:        std::fs::create_dir_all(&dir).unwrap();\r\n703:        dir\r\n704:    }\r\n705:\r\n706:    #[test]\r\n707:    fn parses_content_range_total() {\r\n708:        assert_eq!(\r\n709:            parse_content_range(\"bytes 0-0/4722087959\"),\r\n710:            Some(4_722_087_959)\r\n711:        );\r\n712:        assert_eq!(parse_content_range(\"bytes 0-0/*\"), None);\r\n713:        assert_eq!(parse_content_range(\"invalid\"), None);\r\n714:    }\r\n715:\r\n716:    #[test]\r\n717:    fn resume_offset_rejects_corrupt_over_length_value() {\r\n718:        assert_eq!(valid_resume_offset(0, 10), 0);\r\n719:        assert_eq!(valid_resume_offset(5, 10), 5);\r\n720:        assert_eq!(valid_resume_offset(10, 10), 10); // 정확히 완료는 유효\r\n721:        assert_eq!(valid_resume_offset(11, 10), 0); // 길이 초과 = 손상 → 재다운로드\r\n722:        assert_eq!(valid_resume_offset(u64::MAX, 10), 0);\r\n723:    }\r\n724:\r\n725:    #[test]\r\n726:    fn segment_bounds_cover_file_without_overlap() {\r\n727:        let total = 101;\r\n728:        let count = 16;\r\n729:        let mut next = 0;\r\n730:        for index in 0..count {\r\n731:            let (start, end) = segment_bounds(total, count, index);\r\n732:            assert_eq!(start, next);\r\n733:            assert!(end >= start);\r\n734:            next = end + 1;\r\n735:        }\r\n736:        assert_eq!(next, total);\r\n737:    }\r\n738:\r\n739:\r\n740:    #[test]\r\n741:    fn range_server_is_downloaded_in_parallel_without_corruption() {\r\n742:        let data: Vec<u8> = (0..65_537).map(|i| (i % 251) as u8).collect();\r\n743:        let expected_requests = 1 + CONNECTIONS * SEGMENTS_PER_CONNECTION;\r\n744:        let (url, requests, server) = spawn_test_server(data.clone(), true, expected_requests);\r\n745:        let dir = unique_test_dir(\"range\");\r\n746:        let destination = dir.join(\"range.bin\");\r\n747:\r\n748:        let result = test_runtime().block_on(download(\r\n749:            DownloadRequest {\r\n750:                url,\r\n751:                destination: destination.clone(),\r\n752:                cookie_header: None,\r\n753:                referer: None,\r\n754:            },\r\n755:            no_cancel(),\r\n756:            |_| {},\r\n757:        ));\r\n758:\r\n759:        assert_eq!(result.unwrap(), Some(destination.clone()));\r\n760:        assert_eq!(std::fs::read(&destination).unwrap(), data);\r\n761:        assert_eq!(requests.load(Ordering::Relaxed), expected_requests);\r\n762:        server.join().unwrap();\r\n763:        std::fs::remove_dir_all(dir).ok();\r\n764:    }\r\n765:\r\n766:    #[test]\r\n767:    fn preset_cancel_stops_and_keeps_sidecars_for_resume() {\r\n768:        // 취소 플래그가 켜진 채 시작하면 즉시 Ok(None)이고, 재개용 sidecar가 남는다.\r\n769:        let data: Vec<u8> = (0..65_537).map(|i| (i % 251) as u8).collect();\r\n770:        // 서버는 프로브(1)만 받는다 — 취소로 구간 요청은 나가지 않는다.\r\n771:        let (url, requests, server) = spawn_test_server(data.clone(), true, 1);\r\n772:        let dir = unique_test_dir(\"cancel\");\r\n773:        let destination = dir.join(\"cancel.bin\");\r\n774:\r\n775:        let result = test_runtime().block_on(download(\r\n776:            DownloadRequest {\r\n777:                url,\r\n778:                destination: destination.clone(),\r\n779:                cookie_header: None,\r\n780:                referer: None,\r\n781:            },\r\n782:            Arc::new(AtomicBool::new(true)),\r\n783:            |_| {},\r\n784:        ));\r\n785:\r\n786:        assert_eq!(result.unwrap(), None, \"취소는 Ok(None)\");\r\n787:        assert!(!destination.exists(), \"취소 시 최종 파일은 없어야 한다\");\r\n788:        assert!(\r\n789:            sidecar_path(&destination, \"download\").exists(),\r\n790:            \"재개용 sidecar 유지\"\r\n791:        );\r\n792:        assert_eq!(requests.load(Ordering::Relaxed), 1, \"구간 요청 없이 프로브만\");\r\n793:        server.join().unwrap();\r\n794:        std::fs::remove_dir_all(dir).ok();\r\n795:    }\r\n796:\r\n797:    #[test]\r\n798:    fn server_without_range_support_falls_back_to_single_stream() {\r\n799:        let data: Vec<u8> = (0..4097).map(|i| (i % 239) as u8).collect();\r\n800:        let (url, requests, server) = spawn_test_server(data.clone(), false, 2);\r\n801:        let dir = unique_test_dir(\"single\");\r\n802:        let destination = dir.join(\"single.bin\");\r\n803:        let modes = Arc::new(std::sync::Mutex::new(Vec::new()));\r\n804:        let progress_modes = modes.clone();\r\n805:\r\n806:        let result = test_runtime().block_on(download(\r\n807:            DownloadRequest {\r\n808:                url,\r\n809:                destination: destination.clone(),\r\n810:                cookie_header: None,\r\n811:                referer: None,\r\n812:            },\r\n813:            no_cancel(),\r\n814:            move |progress| progress_modes.lock().unwrap().push(progress.mode),\r\n815:        ));\r\n816:\r\n817:        assert!(result.is_ok());\r\n818:        assert_eq!(std::fs::read(&destination).unwrap(), data);\r\n819:        assert_eq!(requests.load(Ordering::Relaxed), 2);\r\n820:        assert!(modes.lock().unwrap().contains(&DownloadMode::Single));\r\n821:        server.join().unwrap();\r\n822:        std::fs::remove_dir_all(dir).ok();\r\n823:    }\r\n824:\r\n825:    #[test]\r\n826:    fn resume_skips_completed_segments_and_finishes_correctly() {\r\n827:        let data: Vec<u8> = (0..65_537).map(|i| (i % 251) as u8).collect();\r\n828:        let total = data.len() as u64;\r\n829:        let segment_count = (CONNECTIONS * SEGMENTS_PER_CONNECTION).min(data.len()).max(1);\r\n830:\r\n831:        let dir = unique_test_dir(\"resume\");\r\n832:        let destination = dir.join(\"resume.bin\");\r\n833:        let part = sidecar_path(&destination, \"download\");\r\n834:        let meta = sidecar_path(&destination, \"download.json\");\r\n835:        let state = sidecar_path(&destination, \"download.state\");\r\n836:\r\n837:        // 전체 크기의 임시 본체를 0으로 만들고, 완료로 표시할 부분만 올바른 바이트로 채운다.\r\n838:        // 구간 7은 완전 완료, 구간 3은 절반 완료, 나머지는 미착수로 심는다.\r\n839:        let mut body = vec![0u8; data.len()];\r\n840:        let mut state_bytes = vec![0u8; segment_count * 8];\r\n841:        for index in 0..segment_count {\r\n842:            let (start, end) = segment_bounds(total, segment_count, index);\r\n843:            let len = end - start + 1;\r\n844:            let done = match index {\r\n845:                7 => len,\r\n846:                3 => len / 2,\r\n847:                _ => 0,\r\n848:            };\r\n849:            let s = start as usize;\r\n850:            let d = done as usize;\r\n851:            body[s..s + d].copy_from_slice(&data[s..s + d]);\r\n852:            state_bytes[index * 8..index * 8 + 8].copy_from_slice(&done.to_le_bytes());\r\n853:        }\r\n854:        std::fs::write(&part, &body).unwrap();\r\n855:        std::fs::write(\r\n856:            &meta,\r\n857:            serde_json::to_vec(&ResumeMeta {\r\n858:                version: 1,\r\n859:                total,\r\n860:                segment_count,\r\n861:            })\r\n862:            .unwrap(),\r\n863:        )\r\n864:        .unwrap();\r\n865:        std::fs::write(&state, &state_bytes).unwrap();\r\n866:\r\n867:        // 완전 완료된 구간 7은 요청이 아예 없어야 한다 → 프로브 1 + (구간 수 - 1).\r\n868:        // 재개가 완료 구간을 건너뛰지 못하면 요청이 하나 더 발생한다.\r\n869:        let expected_requests = 1 + segment_count - 1;\r\n870:        let (url, requests, server) = spawn_test_server(data.clone(), true, expected_requests);\r\n871:\r\n872:        let result = test_runtime().block_on(download(\r\n873:            DownloadRequest {\r\n874:                url,\r\n875:                destination: destination.clone(),\r\n876:                cookie_header: None,\r\n877:                referer: None,\r\n878:            },\r\n879:            no_cancel(),\r\n880:            |_| {},\r\n881:        ));\r\n882:\r\n883:        assert_eq!(result.unwrap(), Some(destination.clone()));\r\n884:        assert_eq!(std::fs::read(&destination).unwrap(), data);\r\n885:        assert_eq!(requests.load(Ordering::Relaxed), expected_requests);\r\n886:        assert!(!meta.exists() && !state.exists(), \"완료 후 sidecar 정리\");\r\n887:        server.join().unwrap();\r\n888:        std::fs::remove_dir_all(dir).ok();\r\n889:    }\r\n890:}\r\n","exit_code":0,"status":"completed"}}
