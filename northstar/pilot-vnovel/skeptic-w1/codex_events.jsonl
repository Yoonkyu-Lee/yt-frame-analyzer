t-a\");\n874:        assert!(!f.load(Relaxed));\n875:        assert!(!request_cancel(\"t-unknown\"));\n876:        assert!(request_cancel(\"t-a\") && f.load(Relaxed));\n877:        assert!(!register_cancel(\"t-a\").load(Relaxed), \"새 플래그는 꺼진 채\");\n878:        clear_cancel(\"t-a\");\n879:        assert!(!request_cancel(\"t-a\"));\n880:    }\n881:\n882:    // D4 D7: 중간에 취소(Ok(None)) → 다시 받으면 빠진 것만 요청하고 결과는 정확. 성공 뒤 폴더엔 목적지만 남음\n883:    #[test]\n884:    fn cancel_midway_then_resume_fetches_only_the_rest() {\n885:        let data = pattern(32 << 20);\n886:        let dir = tmp(\"resume\");\n887:        let dest = dir.join(\"r.bin\");\n888:        let cancel = no_cancel();\n889:        let first = serve(\n890:            data.clone(),\n891:            Opt {\n892:                cancel_at: Some((16 << 20, cancel.clone())),\n893:                ..Default::default()\n894:            },\n895:        );\n896:        assert_eq!(run(&first.url, &dest, cancel).unwrap(), None);\n897:        assert!(!dest.exists());\n898:        let second = serve(data.clone(), Opt::default());\n899:        assert_eq!(\n900:            run(&second.url, &dest, no_cancel()).unwrap(),\n901:            Some(dest.clone())\n902:        );\n903:        assert_eq!(std::fs::read(&dest).unwrap(), data);\n904:        assert_eq!(names(&dir), [\"r.bin\"]);\n905:        // 취소 때까지 16MiB 이상 받았고, 연결당 최대 1MiB만 다시 받을 수 있다 → 남은 요청량은 75% 이하\n906:        let sent = second.sent.load(Relaxed);\n907:        assert!(sent <= (data.len() as u64) * 3 / 4 + 1000, \"재요청 {sent}\");\n908:        std::fs::remove_dir_all(dir).ok();\n909:    }\n910:\n911:    // D4 D5: 다른 크기 파일의 잔여 상태, 손상된(구간 길이 초과) 상태, 길이가 어긋난 임시 파일은 버리고 정확한 파일을 만든다\n912:    #[test]\n913:    fn foreign_or_damaged_resume_state_is_discarded() {\n914:        let data = pattern(1_000_000);\n915:        for case in 0..3 {\n916:            let dir = tmp(\"dmg\");\n917:            let dest = dir.join(\"d.bin\");\n918:            let part = part_path(&dest);\n919:            let cancel = no_cancel();\n920:            // 먼저 (다른 크기 또는 같은 크기의) 다운로드를 중간에 멈춰 상태를 만든다\n921:            let seed = if case == 0 {\n922:                pattern(777_777)\n923:            } else {\n924:                data.clone()\n925:            };\n926:            let s = serve(\n927:                seed,\n928:                Opt {\n929:                    cancel_at: Some((400_000, cancel.clone())),\n930:                    ..Default::default()\n931:                },\n932:            );\n933:            assert_eq!(run(&s.url, &dest, cancel).unwrap(), None);\n934:            if case == 1 {\n935:                let mut raw = std::fs::read(&part).unwrap();\n936:                let tail = raw.len() - 8 * 16; // 구간 오프셋 전부를 구간 길이 초과 값으로 망가뜨린다\n937:                raw[tail..].iter_mut().for_each(|b| *b = 0xFF);\n938:                std::fs::write(&part, raw).unwrap();\n939:            }\n940:            if case == 2 {\n941:                std::fs::OpenOptions::new()\n942:                    .write(true)\n943:                    .open(&part)\n944:                    .unwrap()\n945:                    .set_len(1234)\n946:                    .unwrap();\n947:            }\n948:            let srv = serve(data.clone(), Opt::default());\n949:            assert_eq!(\n950:                run(&srv.url, &dest, no_cancel()).unwrap(),\n951:                Some(dest.clone()),\n952:                \"case {case}\"\n953:            );\n954:            assert_eq!(std::fs::read(&dest).unwrap(), data, \"case {case}\");\n955:            assert_eq!(names(&dir), [\"d.bin\"]);\n956:            std::fs::remove_dir_all(dir).ok();\n957:        }\n958:    }\n959:\n960:    // D7: 단일 스트림도 받는 도중 취소하면 Ok(None), 목적지 없음\n961:    #[test]\n962:    fn cancel_during_single_stream_returns_none() {\n963:        let cancel = no_cancel();\n964:        let opt = Opt {\n965:            no_range: true,\n966:            cancel_at: Some((16 << 10, cancel.clone())),\n967:            ..Default::default()\n968:        };\n969:        let srv = serve(pattern(8 << 20), opt);\n970:        let dir = tmp(\"scancel\");\n971:        let dest = dir.join(\"s.bin\");\n972:        assert_eq!(run(&srv.url, &dest, cancel).unwrap(), None);\n973:        assert!(!dest.exists());\n974:        std::fs::remove_dir_all(dir).ok();\n975:    }\n976:}\n","exit_code":0,"status":"completed"}}
