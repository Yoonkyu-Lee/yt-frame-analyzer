ck() {\r\n   32         map.insert(token.to_string(), flag.clone());\r\n   33     }\r\n   34     flag\r\n   35 }\r\n   36 \r\n   37 /// �ش� ��ū�� �ٿ�ε忡 ��Ҹ� ��ȣ�Ѵ�. ��ϵ� �� ������ true.\r\n   38 pub fn request_cancel(token: &str) -> bool {\r\n   39     if let Ok(map) = CANCELLERS.lock() {\r\n   40         if let Some(flag) = map.get(token) {\r\n   41             flag.store(true, Ordering::SeqCst);\r\n   42             return true;\r\n   43         }\r\n   44     }\r\n   45     false\r\n   46 }\r\n   47 \r\n   48 /// �Ϸᡤ���С���ҷ� ���� ��ū�� �÷��׸� �����Ѵ�.\r\n   49 pub fn clear_cancel(token: &str) {\r\n   50     if let Ok(mut map) = CANCELLERS.lock() {\r\n   51         map.remove(token);\r\n   52     }\r\n   53 }\r\n   54 \r\n   55 fn cancelled(flag: &AtomicBool) -> bool {\r\n   56     flag.load(Ordering::Relaxed)\r\n   57 }\r\n   58 \r\n   59 const CONNECTIONS: usize = 8;\r\n   60 const SEGMENTS_PER_CONNECTION: usize = 2;\r\n   61 const MAX_RETRIES: usize = 4;\r\n   62 const PROGRESS_EMIT_INTERVAL: Duration = Duration::from_millis(250);\r\n   63 const RESUME_CHECKPOINT_BYTES: u64 = 1024 * 1024;\r\n   64 const USER_AGENT: &str = \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 \\\r\n   65      (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36\";\r\n   66 \r\n   67 #[derive(Debug, Clone)]\r\n   68 pub struct DownloadRequest {\r\n   69     pub url: String,\r\n   70     pub destination: PathBuf,\r\n   71     pub cookie_header: Option<String>,\r\n   72     pub referer: Option<String>,\r\n   73 }\r\n   74 \r\n   75 #[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize)]\r\n   76 #[serde(rename_all = \"lowercase\")]\r\n   77 pub enum DownloadMode {\r\n   78     Segmented,\r\n   79     Single,\r\n   80 }\r\n   81 \r\n   82 #[derive(Debug, Clone, Copy)]\r\n   83 pub struct DownloadProgress {\r\n   84     pub received: u64,\r\n   85     pub total: Option<u64>,\r\n   86     pub mode: DownloadMode,\r\n   87 }\r\n   88 \r\n   89 #[derive(Debug, Serialize, Deserialize)]\r\n   90 struct ResumeMeta {\r\n   91     version: u8,\r\n   92     total: u64,\r\n   93     segment_count: usize,\r\n   94 }\r\n   95 \r\n   96 struct ProgressEmitter {\r\n   97     received: Arc<AtomicU64>,\r\n   98     total: Option<u64>,\r\n   99     mode: DownloadMode,\r\n  100     last_emit_ms: AtomicU64,\r\n  101     started: Instant,\r\n  102     callback: Arc<dyn Fn(DownloadProgress) + Send + Sync>,\r\n  103 }\r\n  104 \r\n  105 impl ProgressEmitter {\r\n  106     fn new(\r\n  107         received: Arc<AtomicU64>,\r\n  108         total: Option<u64>,\r\n  109         mode: DownloadMode,\r\n  110         callback: Arc<dyn Fn(DownloadProgress) + Send + Sync>,\r\n  111     ) -> Self {\r\n  112         Self {\r\n  113             received,\r\n  114             total,\r\n  115             mode,\r\n  116             last_emit_ms: AtomicU64::new(0),\r\n  117             started: Instant::now(),\r\n  118             callback,\r\n  119         }\r\n  120     }\r\n  121 \r\n  122     fn emit_if_due(&self) {\r\n  123         let elapsed = self.started.elapsed().as_millis().min(u64::MAX as u128) as u64;\r\n  124         let last = self.last_emit_ms.load(Ordering::Relaxed);\r\n  125         if elapsed.saturating_sub(last) < PROGRESS_EMIT_INTERVAL.as_millis() as u64 {\r\n  126             return;\r\n  127         }\r\n  128         if self\r\n  129             .last_emit_ms\r\n  130             .compare_exchange(last, elapsed, Ordering::Relaxed, Ordering::Relaxed)\r\n  131             .is_ok()\r\n  132         {\r\n  133             self.emit();\r\n  134         }\r\n  135     }\r\n  136 \r\n  137     fn emit(&self) {\r\n  138         (self.callback)(DownloadProgress {\r\n  139             received: self.received.load(Ordering::Relaxed),\r\n  140             total: self.total,\r\n  141             mode: self.mode,\r\n  142         });\r\n  143     }\r\n  144 }\r\n  145 \r\n  146 fn client() -> Result<Client, String> {\r\n  147     Client::builder()\r\n  148        