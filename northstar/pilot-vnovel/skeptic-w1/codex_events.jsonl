    fn tmp(tag: &str) -> PathBuf {\n572:        let t = std::time::UNIX_EPOCH.elapsed().unwrap().as_nanos();\n573:        let dir = std::env::temp_dir().join(format!(\"segdl-{tag}-{}-{t}\", std::process::id()));\n574:        std::fs::create_dir_all(&dir).unwrap();\n575:        dir\n576:    }\n577:\n578:    fn names(dir: &Path) -> Vec<String> {\n579:        std::fs::read_dir(dir)\n580:            .unwrap()\n581:            .map(|e| e.unwrap().file_name().to_string_lossy().into_owned())\n582:            .collect()\n583:    }\n584:\n585:    fn korean(e: &str) -> bool {\n586:        e.chars().any(|c| !c.is_ascii())\n587:    }\n588:\n589:    #[test]\n590:    fn bounds_tile_the_file_without_gap_or_overlap() {\n591:        for (total, n) in [(101, 16), (16, 16), (3, 3), (1, 1), (1 << 33, 16)] {\n592:            let mut next = 0;\n593:            for i in 0..n {\n594:                let (s, e) = bounds(total, n, i);\n595:                assert_eq!(s, next);\n596:                assert!(e > s);\n597:                next = e;\n598:            }\n599:            assert_eq!(next, total);\n600:        }\n601:    }\n602:\n603:    // D1 D2 D3: 정확한 바이트, 폴더에 목적지만 남음, 첫 요청은 bytes=0-0, 연결은 겹치되 8개 이하\n604:    #[test]\n605:    fn parallel_download_is_exact_clean_and_capped_at_8_connections() {\n606:        let data = pattern(3_000_001);\n607:        let srv = serve(\n608:            data.clone(),\n609:            Opt {\n610:                latency_ms: 50,\n611:                ..Default::default()\n612:            },\n613:        );\n614:        let dir = tmp(\"par\");\n615:        let dest = dir.join(\"a.bin\");\n616:        assert_eq!(\n617:            run(&srv.url, &dest, no_cancel()).unwrap(),\n618:            Some(dest.clone())\n619:        );\n620:        assert_eq!(std::fs::read(&dest).unwrap(), data);\n621:        assert_eq!(names(&dir), [\"a.bin\"]);\n622:        assert!(srv.reqs.lock().unwrap()[0]\n623:            .to_lowercase()\n624:            .contains(\"range: bytes=0-0\"));\n625:        let peak = srv.peak.load(Relaxed);\n626:        assert!((2..=8).contains(&peak), \"동시 연결 {peak}\");\n627:        std::fs::remove_dir_all(dir).ok();\n628:    }\n629:\n630:    // D1: 크기 0, 1, 작은 크기(구간 수보다 작음), 구간 수의 배수가 아닌 크기\n631:    #[test]\n632:    fn tiny_and_empty_files_are_exact() {\n633:        for n in [0, 1, 5, 17] {\n634:            let data = pattern(n);\n635:            let srv = serve(data.clone(), Opt::default());\n636:            let dir = tmp(\"tiny\");\n637:            let dest = dir.join(\"t.bin\");\n638:            assert_eq!(\n639:                run(&srv.url, &dest, no_cancel()).unwrap(),\n640:                Some(dest.clone()),\n641:                \"n={n}\"\n642:            );\n643:            assert_eq!(std::fs::read(&dest).unwrap(), data, \"n={n}\");\n644:            assert_eq!(names(&dir), [\"t.bin\"], \"n={n}\");\n645:            std::fs::remove_dir_all(dir).ok();\n646:        }\n647:    }\n648:\n649:    // D2 D8: Range 미지원(200)과 총 크기 모르는 206(`*`)은 단일 스트림. 마지막 이벤트 received == total\n650:    #[test]\n651:    fn no_range_or_unknown_total_uses_single_stream() {\n652:        for opt in [\n653:            Opt {\n654:                no_range: true,\n655:                ..Default::default()\n656:            },\n657:            Opt {\n658:                star: true,\n659:                ..Default::default()\n660:            },\n661:        ] {\n662:            let data = pattern(100_003);\n663:            let srv = serve(data.clone(), opt);\n664:            let dir = tmp(\"single\");\n665:            let dest = dir.join(\"s.bin\");\n666:            let events = Arc::new(Mutex::new(vec![]));\n667:            let e2 = events.clone();\n668:            run_with(&srv.url, &dest, no_cancel(), move |p| {\n669:                e2.lock().unwrap().push(p)\n670:            })\n671:            .unwrap();\n672:            assert_eq!(std::fs::read(&dest).unwrap(), data);\n673:            assert_eq!(names(&dir), [\"s.bin\"]);\n674:            let ev = events.lock().unwrap();\n675:            assert!(ev.iter().all(|p| p.mode == DownloadMode::Single));\n676:            let last = ev.last().unwrap();\n677:            assert_eq!((last.received, last.total), (100_003, Some(100_003)));\n678:            std::fs::remove_dir_all(dir).ok();\n679:        }\n680:    }\n681:\n682:    // D2 D10: HTTP 오류 → Err(한국어, 상태 코드 포함), 파일 없음\n683:    #[test]\n684:    fn http_error_is_err_without_files() {\n685:        let srv = serve(\n686:            pattern(10),\n687:            Opt {\n688:                status: 404,\n689:                ..Default::default()\n690:            },\n691:        );\n692:        let dir = tmp(\"404\");\n693:        let e = run(&srv.url, &dir.join(\"x.bin\"), no_cancel()).unwrap_err();\n694:        assert!(e.contains(\"404\") && korean(&e), \"{e}\");\n695:        assert!(names(&dir).is_empty());\n696:        std::fs::remove_dir_all(dir).ok();\n697:    }\n698:\n699:    // D8: received 단조 증가, total = 전체 크기, mode = Segmented, 이벤트는 초당 약 4회 이하, 마지막은 received == total\n700:    #[test]\n701:    fn progress_is_monotonic_rate_limited_and_ends_complete() {\n702:        let data = pattern(2_000_000);\n703:        let srv = serve(\n704:            data,\n705:            Opt {\n706:                latency_ms: 700,\n707:                ..Default::default()\n708:            },\n709:        );\n710:        let dir = tmp(\"prog\");\n711:        let events = Arc::new(Mutex::new(vec![]));\n712:        let e2 = events.clone();\n713:        let t = Instant::now();\n714:        run_with(&srv.url, &dir.join(\"p.bin\"), no_cancel(), move |p| {\n715:            e2.lock().unwrap().push(p)\n716:        })\n717:        .unwrap();\n718:        let secs = t.elapsed().as_secs_f64();\n719:        let ev = events.lock().unwrap();\n720:        assert!(ev.windows(2).all(|w| w[0].received <= w[1].received));\n721:        assert!(ev\n722:            .iter()\n723:            .all(|p| p.total == Some(2_000_000) && p.mode == DownloadMode::Segmented));\n724:        assert_eq!(ev.last().unwrap().received, 2_000_000);\n725:        assert!(\n726:            ev.len() as f64 <= secs * 4.0 + 3.0,\n727:            \"{}개/{secs:.2}s\",\n728:            ev.len()\n729:        );\n730:        std::fs::remove_dir_all(dir).ok();\n731:    }\n732:\n733:    // D9: identity 인코딩, 쿠키·referer(비어 있으면 생략), Chrome UA, 리다이렉트 추적. 구간 요청도 모두 같은 헤더\n734:    #[test]\n735:    fn requests_carry_required_headers_and_follow_redirects() {\n736:        let data = pattern(50_000);\n737:        let srv = serve(\n738:            data.clone(),\n739:            Opt {\n740:                redirect: true,\n741:                ..Default::default()\n742:            },\n743:        );\n744:        let dir = tmp(\"hdr\");\n745:        let dest = dir.join(\"h.bin\");\n746:        let req = DownloadRequest {\n747:            url: srv.url.clone(),\n748:            destination: dest.clone(),\n749:            cookie_header: Some(\"sid=abc\".into()),\n750:            referer: Some(\"http://ref.example/\".into()),\n751:        };\n752:        let rt = tokio::runtime::Runtime::new().unwrap();\n753:        rt.block_on(download(req, no_cancel(), |_| {})).unwrap();\n754:        assert_eq!(std::fs::read(&dest).unwrap(), data);\n755:        let reqs = srv.reqs.lock().unwrap();\n756:        assert!(reqs.len() > 4);\n757:        for r in reqs.iter().map(|r| r.to_lowercase()) {\n758:            assert!(\n759:                r.contains(\"accept-encoding: identity\")\n760:                    && r.contains(\"cookie: sid=abc\")\n761:                    && r.contains(\"referer: http://ref.example/\")\n762:                    && r.contains(\"chrome/\"),\n763:                \"{r}\"\n764:            );\n765:        }\n766:        drop(reqs);\n767:        // 빈 문자열은 헤더로 보내지 않는다\n768:        let srv = serve(data, Opt::default());\n769:        let req = DownloadRequest {\n770:            url: srv.url.clone(),\n771:            destination: dir.join(\"e.bin\"),\n772:            cookie_header: Some(String::new()),\n773:            referer: Some(String::new()),\n774:        };\n775:        rt.block_on(download(req, no_cancel(), |_| {})).unwrap();\n776:        assert!(srv.reqs.lock().unwrap().iter().all(\n777:            |r| !r.to_lowercase().contains(\"cookie:\") && !r.to_lowercase().contains(\"referer:\")\n778:        ));\n779:        std::fs::remove_dir_all(dir).ok();\n780:    }\n781:\n782:    // D5 D10: 시작점이 다른 Content-Range, 요청보다 긴 본문, 계속 짧은 본문 → 완성 파일 없이 Err(수 초 안에)\n783:    #[test]\n784:    fn wrong_range_long_body_and_short_body_never_complete() {\n785:        for opt in [\n786:            Opt {\n787:                bad_start: true,\n788:                ..Default::default()\n789:            },\n790:            Opt {\n791:                long: true,\n792:                ..Default::default()\n793:            },\n794:            Opt {\n795:                fail_first: usize::MAX,\n796:                ..Default::default()\n797:            },\n798:        ] {\n799:            let srv = serve(pattern(200_000), opt);\n800:            let dir = tmp(\"bad\");\n801:            let dest = dir.join(\"b.bin\");\n802:            let t = Instant::now();\n803:            let e = run(&srv.url, &dest, no_cancel()).unwrap_err();\n804:            assert!(korean(&e), \"{e}\");\n805:            assert!(!dest.exists());\n806:            assert!(t.elapsed() < Duration::from_secs(10), \"{:?}\", t.elapsed());\n807:            // 실패가 남긴 재개 상태로 이어받아도 이웃 구간이 오염되지 않아 결과가 정확하다\n808:            let good = serve(pattern(200_000), Opt::default());\n809:            run(&good.url, &dest, no_cancel()).unwrap();\n810:            assert_eq!(std::fs::read(&dest).unwrap(), pattern(200_000));\n811:            std::fs::remove_dir_all(dir).ok();\n812:        }\n813:    }\n814:\n815:    // D6: 일시적 실패(처음 5개 구간 요청이 중간에 끊김)는 재시도로 복구, 파일은 정확\n816:    #[test]\n817:    fn transient_failures_are_retried() {\n818:        let data = pattern(500_000);\n819:        let srv = serve(\n820:     