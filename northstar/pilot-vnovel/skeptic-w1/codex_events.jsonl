{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"\"C:\\\\windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -NoProfile -Command '$n=0; Get-Content -LiteralPath after/segmented_download.rs | ForEach-Object { $n++; '\"'{0,5} {1}' -f \"'$n, $_ }'","aggregated_output":"    1 //! Intent: 최종 ?�일 URL??받아 VN ?�더???�상 ?�는 ?�성 ?�일�?만든?? ?�로?� ?�스?�에??빠르�?Range 병렬, ?�결 최�? 8), 취소·?�시?????�어받기.\r\n    2 //! Data: `<dest>.download` ???�일 = [본문 total바이??[꼬리: total(u64) + 구간�??�료 바이??u64 x N(LE)]. ?�료?�면 꼬리�??�라?�고 rename.\r\n    3 //! Assumes: 같�? URL?� 진행·중단 ?�안 같�? 바이?��? 준??ETag 검�??�음). ??번에 ???�운로드. total??같으�?같�? ?�일�?본다.\r\n    4 //! Weak: ?�일 ?�트림�? ?�어받기 불�?(중단?�면 .download가 ?�고 ?�음??처음부??. ?�개 ?�태???�기·구간 길이�?검증하�??�용 ?�시???�다. ?�래????체크?�인?��? ?�이?�보???�설 ???�다(fsync ????. 구간 16�?고정?�라 극단?�으�??�린 ?�결 ?�나가 ?�을 ??�� ???�다. 모든 ?�류�??�시??최�? 4?? ??3�??�다. ?�류 문장 ?��?분�? ?�이브러리의 ?�어 ?�문?�다.\r\n    5 //! Cost: 구간 ?�청 16+1?? 구간???�일 ?�들 1�? 체크?�인?�는 구간??1MiB마다 8바이???�기. 메모리는 �?�� ?�기 ?��?.\r\n    6 \r\n    7 use reqwest::header::{ACCEPT_ENCODING, CONTENT_RANGE, COOKIE, RANGE, REFERER};\r\n    8 use reqwest::{Client, StatusCode};\r\n    9 use serde::Serialize;\r\n   10 use std::collections::HashMap;\r\n   11 use std::fmt::Display;\r\n   12 use std::io::SeekFrom::Start;\r\n   13 use std::path::{Path, PathBuf};\r\n   14 use std::sync::atomic::{AtomicBool, AtomicU64, AtomicUsize, Ordering::Relaxed};\r\n   15 use std::sync::{Arc, LazyLock, Mutex};\r\n   16 use std::time::{Duration, Instant};\r\n   17 use tokio::fs::{File, OpenOptions};\r\n   18 use tokio::io::{AsyncReadExt, AsyncSeekExt, AsyncWriteExt};\r\n   19 use tokio::task::JoinSet;\r\n   20 \r\n   21 const CONNECTIONS: usize = 8; // D3\r\n   22 const SEGMENTS: u64 = 16; // ?�결??2�? ?�린 ?�결???�어??빠른 ?�결???��? 구간??가?�간??P1)\r\n   23 const MAX_RETRIES: usize = 4; // D6\r\n   24 const CHECKPOINT: u64 = 1 << 20; // D4\r\n   25 const USER_AGENT: &str = \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 \\\r\n   26      (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36\";\r\n   27 \r\n   28 #[derive(Debug, Clone)]\r\n   29 pub struct DownloadRequest {\r\n   30     pub url: String,\r\n   31     pub destination: PathBuf,\r\n   32     pub cookie_header: Option<String>,\r\n   33     pub referer: Option<String>,\r\n   34 }\r\n   35 \r\n   36 #[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize)]\r\n   37 #[serde(rename_all = \"lowercase\")]\r\n   38 pub enum DownloadMode {\r\n   39     Segmented,\r\n   40     Single,\r\n   41 }\r\n   42 \r\n   43 #[derive(Debug, Clone, Copy)]\r\n   44 pub struct DownloadProgress {\r\n   45     pub received: u64,\r\n   46     pub total: Option<u64>,\r\n   47     pub mode: DownloadMode,\r\n   48 }\r\n   49 \r\n   50 type Callback = Box<dyn Fn(DownloadProgress) + Send + Sync>;\r\n   51 type Res<T> = Result<T, Box<dyn std::error::Error + Send + Sync>>; // D10: 경계(`download`)?�서 ??번만 ?�국??문장?�로 감싼??\r\n   52 // D7: 취소 ?�큰 ?��??�트�??�큰 ???�래�?\r\n   53 static CANCELLERS: LazyLock<Mutex<HashMap<String, Arc<AtomicBool>>>> =\r\n   54     LazyLock::new(Default::default);\r\n   55 \r\n   56 pub fn register_cancel(token: &str) -> Arc<AtomicBool> {\r\n   57     let flag = Arc::new(AtomicBool::new(false));\r\n   58     CANCELLERS\r\n   59         .lock()\r\n   60         .unwrap()\r\n   61         .insert(token.into(), flag.clone());\r\n   62     flag\r\n   63 }\r\n   64 \r\n   65 pub fn request_cancel(token: &str) -> bool {\r\n   66     let map = CANCELLERS.lock().unwrap();\r\n   67     map.get(token).map(|f| f.store(true, Relaxed)).is_some()\r\n   68 }\r\n   69 \r\n   70 pub fn clear_cancel(token: &str) {\r\n   71     CANCELLERS.lock().unwrap().remove(token);\r\n   72 }\r\n   73 \r\n   74 // D8: 진행 ?�벤?? 콜백???�금 ?�에??불러 received가 ?�로 가지 ?�고, 초당 4?�까지�??�다.\r\n   75 struct Progress {\r\n   76     received: AtomicU64,\r\n   77     last: Mutex<Instant>,\r\n   78     info: DownloadProgress,\r\n   79     callback: Callback,\r\n   80 }\r\n   81 \r\n   82 impl Progress {\r\n   83     fn new(received: u64, total: Option<u64>, mode: DownloadMode, callback: Callback) -> Self {\r\n   84         let info = DownloadProgress {\r\n   85             received,\r\n   86             total,\r\n   87             mode,\r\n   88         };\r\n   89         let p = Progress {\r\n   90             received: received.into(),\r\n   91             last: Mutex::new(Instant::now()),\r\n   92             info,\r\n   93             callback,\r\n   94         };\r\n   95         p.emit();\r\n   96         p\r\n   97     }\r\n   98 \r\n   99     fn emit(&self) {\r\n  100         (self.callback)(DownloadProgress {\r\n  101             received: self.received.load(Relaxed),\r\n  102             ..self.info\r\n  103         });\r\n  104     }\r\n  105 \r\n  106     fn add(&self, n: u64) {\r\n  107         self.received.fetch_add(n, Relaxed);\r\n  108         let mut last = self.last.lock().unwrap();\r\n  109         if last.elapsed() >= Duration::from_millis(250) {\r\n  110             *last = Instant::now();\r\n  111             self.emit();\r\n  112         }\r\n  113     }\r\n  114 }\r\n  115 \r\n  116 // D9: 모든 ?�청??공통 ?�더. identity??바이???�프??= ?�일 ?�프?�을 지?�기 ?�해?�다.\r\n  117 fn get(client: &Client, req: &DownloadRequest) -> reqwest::RequestBuilder {\r\n  118     let mut b = client.get(&req.url).header(ACCEPT_ENCODING, \"identity\");\r\n  119     if let Some(c) = req.cookie_header.as_deref().filter(|v| !v.is_empty()) {\r\n  120         b = b.header(COOKIE, c);\r\n  121     }\r\n  122     if let Some(r) = req.referer.as_deref().filter(|v| !v.is_empty()) {\r\n  123         b = b.header(REFERER, r);\r\n  124     }\r\n  125     b\r\n  126 }\r\n  127 \r\n  128 fn part_path(dest: &Path) -> PathBuf {\r\n  129     let mut name = dest.file_name().unwrap_or_default().to_os_string();\r\n  130     name.push(\".download\");\r\n  131     dest.with_file_name(name)\r\n  132 }\r\n  133 \r\n  134 async fn put(f: &mut File, at: u64, bytes: &[u8]) -> Res<()> {\r\n  135     f.seek(Start(at)).await?;\r\n  136     Ok(f.write_all(bytes).await?)\r\n  137 }\r\n  138 \r\n  139 /// 분할 ?�운로드 ?�업 ?�나(D3/D4).\r\n  140 struct Job {\r\n  141     client: Client,\r\n  142     req: DownloadRequest,\r\n  143     part: PathBuf,\r\n  144     total: u64,\r\n  145     n: u64,\r\n  146     offsets: Vec<u64>, // 구간�??��? 받�? 바이???�개 ?�태)\r\n  147     next: AtomicUsize,\r\n  148     progress: Progress,\r\n  149     cancel: Arc<AtomicBool>,\r\n  150 }\r\n  151 \r\n  152 /// 구간 i = [total*i/n, total*(i+1)/n): 빈틈·겹침 ?�이 ?�일????��??\r\n  153 fn bounds(total: u64, n: u64, i: u64) -> (u64, u64) {\r\n  154     (total * i / n, total * (i + 1) / n)\r\n  155 }\r\n  156 \r\n  157 /// D4/D5: ?�시 ?�일???�고 꼬리???�개 ?�태�??�는?? ?�기·total???�르거나 구간 ?�프?�이\r\n  158 /// 구간 길이�??�으�??�상) �?부분을 버리�?처음부??받는??\r\n  159 async fn open_part(part: &Path, total: u64, n: u64) -> Res<(File, Vec<u64>)> {\r\n  160     let mut f = OpenOptions::new()\r\n  161         .read(true)\r\n  162         .write(true)\r\n  163         .create(true)\r\n  164         .open(part)\r\n  165         .await?;\r\n  166     let want = total + 8 * (n + 1);\r\n  167     let mut tail = vec![0u8; 8 * (n as usize + 1)];\r\n  168     f.seek(Start(total)).await?;\r\n  169     let word = |t: &[u8], i: usize| u64::from_le_bytes(t[8 * i..8 * i + 8].try_into().unwrap());\r\n  170     let valid = f.metadata().await?.len() == want && f.read_exact(&mut tail).await.is_ok();\r\n  171     if !valid || word(&tail, 0) != total {\r\n  172         tail.fill(0);\r\n  173         tail[..8].copy_from_slice(&total.to_le_bytes());\r\n  174         f.set_len(0).await?;\r\n  175         f.set_len(want).await?;\r\n  176         put(&mut f, total, &tail).await?;\r\n  177         f.flush().await?;\r\n  178     }\r\n  179     let done = |i| {\r\n  180         let (s, e) = bounds(total, n, i);\r\n  181         Some(word(&tail, i as usize + 1))\r\n  182             .filter(|v| *v <= e - s)\r\n  183             .unwrap_or(0)\r\n  184     };\r\n  185     Ok((f, (0..n).map(done).collect()))\r\n  186 }\r\n  187 \r\n  188 /// D5/D6: 구간 i???��? 부분을 최�? MAX_RETRIES�?받는?? ?��? 받�? 바이??done)???��??�다.\r\n  189 async fn segment(job: &Job, i: usize) -> Res<()> {\r\n  190     let (s, e) = bounds(job.total, job.n, i as u64);\r\n  191     let mut f = OpenOptions::new().write(true).open(&job.part).await?;\r\n  192     let mut done = job.offsets[i];\r\n  193     let mut result = Ok(());\r\n  194     for attempt in 0..MAX_RETRIES {\r\n  195         if done == e - s {\r\n  196             break;\r\n  197         }\r\n  198         result = fetch(job, &mut f, i, s, e - s, &mut done).await;\r\n  199         if result.is_ok() || job.cancel.load(Relaxed) {\r\n  200             break;\r\n  201         }\r\n  202         if attempt + 1 < MAX_RETRIES {\r\n  203             tokio::time::sleep(Duration::from_millis(500 * (attempt as u64 + 1))).await;\r\n  204         }\r\n  205     }\r\n  206     let _ = f.flush().await;\r\n  207     result\r\n  208 }\r\n  209 \r\n  210 /// ?�청 ??�? 206?�고 Content-Range가 ?�청???�작?�이?�야 ?�며, ?�확??구간 ?�까지 받아??Ok(D5).\r\n  211 async fn fetch(job: &Job, f: &mut File, i: usize, s: u64, len: u64, done: &mut u64) -> Res<()> {\r\n  212     if job.cancel.load(Relaxed) {\r\n  213         return Err(\"취소??.into());\r\n  214     }\r\n  215     let from = s + *done;\r\n  216     let range = format!(\"bytes={from}-{}\", s + len - 1);\r\n  217     let mut res = get(&job.client, &job.req)\r\n  218         .header(RANGE, range)\r\n  219         .send()\r\n  220         .await?;\r\n  221     let start = res\r\n  222         .headers()\r\n  223         .get(CONTENT_RANGE)\r\n  224         .and_then(|v| v.to_str().ok());\r\n  225     if res.status() != StatusCode::PARTIAL_CONTENT\r\n  226         || !start.is_some_and(|v| v.starts_with(&format!(\"bytes {from}-\")))\r\n  227     {\r\n  228         return Err(format!(\"?�청??범위가 ?�닌 ?�답?�니??HTTP {})\", res.status()).into());\r\n  229     }\r\n  230     while let Some(chunk) = res.chunk().await? {\r\n  231         if job.cancel.load(Relaxed) {\r\n  232             return Err(\"취소??.into());\r\n  233         }\r\n  234         let n = chunk.len() as u64;\r\n  235         if n > len - *done {\r\n  236             return Err(\"구간???�정 ?�기�?초과?�습?�다\".into());\r\n  237         }\r\n  238         put(f, s + *done, &chunk).await?;\r\n  239         *done += n;\r\n  240         job.progress.add(n);\r\n  241         if *done == len || *done / CHECKPOINT > (*done - n) / CHECKPOINT {\r\n  242             // 같�? ?�들?�라 ?�이?��? 먼�? ?�이�??�태가 ?�따른다.\r\n  243             put(f, job.total + 8 + 8 * i as u64, &done.to_le_bytes()).await?;\r\n  244         }\r\n  245     }\r\n  246     f.flush().await?;\r\n  247     match *done == len {\r\n  248         true => Ok(()),\r\n  249         false => Err(format!(\"구간 {i} ?�기 불일�? {done}/{len} bytes\").into()),\r\n  250     }\r\n  251 }\r\n  252 \r\n  253 /// D1/D3/D4: ?�결 최�? 8개�? 구간 ?��? 비운?? ??받으�?꼬리�??�르�?rename(D1: ?�성???�에�?목적지가 ?�긴??.\r\n  254 async fn segmented(\r\n  255     client: Client,\r\n  256     req: DownloadRequest,\r\n  257     total: u64,\r\n  258     cancel: Arc<AtomicBool>,\r\n  259     cb: Callback,\r\n  260 ) -> Res<PathBuf> {\r\n  261     let n = SEGMENTS.min(total);\r\n  262     let (part, dest) = (part_path(&req.destination), req.destination.clone());\r\n  263     let (f, offsets) = open_part(&part, total, n).await?;\r\n  264     let progress = Progress::new(\r\n  265         offsets.iter().sum(),\r\n  266         Some(total),\r\n  267         DownloadMode::Segmented,\r\n  268         cb,\r\n  269     );\r\n  270     let job = Arc::new(Job {\r\n  271         client,\r\n  272         req,\r\n  273         part,\r\n  274         total,\r\n  275         n,\r\n  276         offsets,\r\n  277         next: 0.into(),\r\n  278         progress,\r\n  279         cancel,\r\n  280     });\r\n  281     let mut workers = JoinSet::new();\r\n  282     for _ in 0..CONNECTIONS.min(n as usize) {\r\n  283         let job = job.clone();\r\n  284         workers.spawn(async move {\r\n  285             loop {\r\n  286                 let i = job.next.fetch_add(1, Relaxed);\r\n  287                 if i as u64 >= job.n {\r\n  288                     return Ok::<(), String>(());\r\n  289                 }\r\n  290                 segment(&job, i)\r\n  291                     .await\r\n  292                     .map_err(|e| format!(\"구간 {i}: {e}\"))?;\r\n  293             }\r\n  294         });\r\n  295     }\r\n  296     while let Some(r) = workers.join_next().await {\r\n  297         r??;\r\n  298     }\r\n  299     job.progress.emit();\r\n  300     f.set_len(total).await?;\r\n  301     drop(f);\r\n  302     Ok(finish(&job.part, &dest).await?)\r\n  303 }\r\n  304 \r\n  305 /// D2: Range ?�는 ?�버??�??�기�?모르???�버????줄기�?받는???�어받기 ?�음).\r\n  306 async fn single(\r\n  307     client: Client,\r\n  308     req: DownloadRequest,\r\n  309     cancel: Arc<AtomicBool>,\r\n  310     cb: Callback,\r\n  311 ) -> Res<PathBuf> {\r\n  312     let mut res = get(&client, &req).send().await?.error_for_status()?;\r\n  313     let total = res.content_length();\r\n  314     let progress = Progress::new(0, total, DownloadMode::Single, cb);\r\n  315     let part = part_path(&req.destination);\r\n  316     let mut f = File::create(&part).await?;\r\n  317     while let Some(chunk) = res.chunk().await? {\r\n  318         if cancel.load(Relaxed) {\r\n  319             return Err(\"취소??.into());\r\n  320         }\r\n  321         f.write_all(&chunk).await?;\r\n  322         progress.add(chunk.len() as u64);\r\n  323     }\r\n  324     f.flush().await?;\r\n  325     drop(f);\r\n  326     if total.is_some_and(|t| t != progress.received.load(Relaxed)) {\r\n  327         return Err(\"받�? ?�기가 ?�버가 ?�린 ?�기?� ?�릅?�다\".into());\r\n  328     }\r\n  329     progress.emit();\r\n  330     Ok(finish(&part, &req.destination).await?)\r\n  331 }\r\n  332 \r\n  333 async fn finish(part: &Path, dest: &Path) -> std::io::Result<PathBuf> {\r\n  334     tokio::fs::rename(part, dest).await?;\r\n  335     Ok(dest.into())\r\n  336 }\r\n  337 \r\n  338 /// 최종 URL??받아 ?�일�?만든?? `Some(path)` ?�공, `None` 취소(?�개 ?�태 ?��?), `Err` ?�패.\r\n  339 pub async fn download<F>(\r\n  340     req: DownloadRequest,\r\n  341     cancel: Arc<AtomicBool>,\r\n  342     on_progress: F,\r\n  343 ) -> Result<Option<PathBuf>, String>\r\n  344 where\r\n  345     F: Fn(DownloadProgress) + Send + Sync + 'static,\r\n  346 {\r\n  347     let result = run(req, cancel.clone(), Box::new(on_progress)).await;\r\n  348     match result {\r\n  349         Ok(path) => Ok(Some(path)),\r\n  350         Err(_) if cancel.load(Relaxed) => Ok(None), // D7: 취소�??�한 ?�류???�패가 ?�니??        Err(e) => Err(format!(\"?�운로드 ?�패: {e}\")),\r\n  351     }\r\n  352 }\r\n  353 \r\n  354 async fn run(req: DownloadRequest, cancel: Arc<AtomicBool>, cb: Callback) -> Res<PathBuf> {\r\n  355     let client = Client::builder()\r\n  356         .connect_timeout(Duration::from_secs(20))\r\n  357         .redirect(reqwest::redirect::Policy::limited(10))\r\n  358         .referer(false) // D9: 리다?�렉???�에???�출?��? 준 referer�?그�?�??�다\r\n  359         .user_agent(USER_AGENT)\r\n  360         .build()?;\r\n  361     // D2: ?�로�? 206 + �??�기�????�만 분할. ?�류 ?�태???�패(�??�일??416?� ?�일 경로가 받는??.\r\n  362     let probe = get(&client, &req).header(RANGE, \"bytes=0-0\").send().await?;\r\n  363     let status = probe.status();\r\n  364     if !status.is_success() && status != StatusCode::RANGE_NOT_SATISFIABLE {\r\n  365         return Err(format!(\"?�버가 ?�청??거�??�습?�다(HTTP {status})\").into());\r\n  366     }\r\n  367     let total = probe\r\n  368         .headers()\r\n  369         .get(CONTENT_RANGE)\r\n  370         .and_then(|v| v.to_str().ok());\r\n  371     let total = total.and_then(|v| v.rsplit_once('/')?.1.parse::<u64>().ok());\r\n  372     match total.filter(|t| *t > 0 && status == StatusCode::PARTIAL_CONTENT) {\r\n  373         Some(t) => segmented(client, req, t, cancel, cb).await,\r\n  374         None => single(client, req, cancel, cb).await,\r\n  375     }\r\n  376 }\r\n  377 \r\n  378 #[cfg(test)]\r\n  379 mod tests {\r\n  380     use super::*;\r\n  381     use std::io::{Read, Write};\r\n  382     use std::net::{TcpListener, TcpStream};\r\n  383 \r\n  384     /// ?�스???�버???�작???�위�? 기본�?= ?�상 Range ?�버.\r\n  385     #[derive(Default)]\r\n  386     struct Opt {\r\n  387         no_range: bool,                            // Range�?무시?�고 ??�� 200\r\n  388         star: bool,                                // ?�로브에 `bytes 0-0/*`\r\n  389         status: u16,                               // 모든 ?�청?????�태\r\n  390         seg_status: u16,                           // ?�로브�? ?�닌 ?�청?????�태\r\n  391         bad_start: bool,                           // Content-Range ?�작?�이 ?�청�??�름\r\n  392         long: bool,                                // ?�청보다 �?본문\r\n  393         fail_first: usize,                         // 처음 k개의 구간 ?�청?� 본문??반만 보내�??�음\r\n  394         latency_ms: u64,                           // ?�청마다 지???�결 겹침 관찰용)\r\n  395         redirect: bool,                            // /start ??/file.bin 302\r\n  396         cancel_at: Option<(u64, Arc<AtomicBool>)>, // ?�만??보내�??�라?�언??취소 ?�래그�? 켠다\r\n  397     }\r\n  398 \r\n  399     struct Srv {\r\n  400         url: String,\r\n  401         reqs: Mutex<Vec<String>>, // 받�? ?�청 ?�더 ?�문\r\n  402         peak: AtomicUsize,        // ?�시 ?�결 최�?�?        sent: AtomicU64,          // 보낸 본문 바이??        active: AtomicUsize,\r\n  403         failed: AtomicUsize,\r\n  404         data: Vec<u8>,\r\n  405         opt: Opt,\r\n  406     }\r\n  407 \r\n  408     fn serve(data: Vec<u8>, opt: Opt) -> Arc<Srv> {\r\n  409         let listener = TcpListener::bind(\"127.0.0.1:0\").unwrap();\r\n  410         let url = format!(\r\n  411             \"http://{}/{}\",\r\n  412             listener.local_addr().unwrap(),\r\n  413             if opt.redirect { \"start\" } else { \"file.bin\" }\r\n  414         );\r\n  415         let srv = Arc::new(Srv {\r\n  416             url,\r\n  417             reqs: Default::default(),\r\n  418             peak: 0.into(),\r\n  419             sent: 0.into(),\r\n  420             active: 0.into(),\r\n  421             failed: 0.into(),\r\n  422             data,\r\n  423             opt,\r\n  424         });\r\n  425         let s = srv.clone();\r\n  426         std::thread::spawn(move || {\r\n  427             for stream in listener.incoming().flatten() {\r\n  428                 let s = s.clone();\r\n  429                 std::thread::spawn(move || handle(&s, stream));\r\n  430             }\r\n  431         });\r\n  432         srv\r\n  433     }\r\n  434 \r\n  435     fn handle(s: &Srv, mut conn: TcpStream) {\r\n  436         let mut buf = vec![0u8; 8192];\r\n  437         let n = conn.read(&mut buf).unwrap_or(0);\r\n  438         let head = String::from_utf8_lossy(&buf[..n]).to_string();\r\n  439         s.reqs.lock().unwrap().push(head.clone());\r\n  440         s.peak\r\n  441             .fetch_max(s.active.fetch_add(1, Relaxed) + 1, Relaxed);\r\n  442         std::thread::sleep(Duration::from_millis(s.opt.latency_ms));\r\n  443         let (o, len) = (&s.opt, s.data.len());\r\n  444         let range = head\r\n  445             .lines()\r\n  446             .find_map(|l| {\r\n  447                 l.to_ascii_lowercase()\r\n  448                     .strip_prefix(\"range: bytes=\")\r\n  449                     .map(String::from)\r\n  450             })\r\n  451             .and_then(|v| {\r\n  452                 let (a, b) = v.split_once('-')?;\r\n  453                 Some((\r\n  454                     a.trim().parse::<usize>().ok()?,\r\n  455                     b.trim().parse::<usize>().ok()?,\r\n  456                 ))\r\n  457             });\r\n  458         let probe = range == Some((0, 0));\r\n  459         let mut cut = false;\r\n  460         let (status, extra, body): (String, String, Vec<u8>) =\r\n  461             if o.redirect && head.contains(\"GET /start\") {\r\n  462                 (\r\n  463                     \"302 Found\".into(),\r\n  464                     format!(\"Location: /file.bin\\r\\n\"),\r\n  465                     vec![],\r\n  466                 )\r\n  467             } else if o.status != 0 || (o.seg_status != 0 && range.is_some() && !probe) {\r\n  468                 (\r\n  469                     format!(\r\n  470                         \"{} X\",\r\n  471                         if o.status != 0 {\r\n  472                             o.status\r\n  473                         } else {\r\n  474                             o.seg_status\r\n  475                         }\r\n  476                     ),\r\n  477                     String::new(),\r\n  478                     vec![],\r\n  479                 )\r\n  480             } else if range.is_some() && len == 0 {\r\n  481                 (\r\n  482                     \"416 Range Not Satisfiable\".into(),\r\n  483                     \"Content-Range: bytes */0\\r\\n\".into(),\r\n  484                     vec![],\r\n  485                 )\r\n  486             } else if let (Some((a, b)), false) = (range, o.no_range) {\r\n  487                 if o.star && probe {\r\n  488                     (\r\n  489                         \"206 Partial\".into(),\r\n  490                         \"Content-Range: bytes 0-0/*\\r\\n\".into(),\r\n  491                         s.data[..1].to_vec(),\r\n  492                     )\r\n  493                 } else {\r\n  494                     let b = b.min(len - 1);\r\n  495                     let mut body = s.data[a..=b].to_vec();\r\n  496                     if o.long && !probe {\r\n  497                         body.extend([7u8; 100]);\r\n  498                     }\r\n  499                     cut = !probe && s.failed.fetch_add(1, Relaxed) < o.fail_first;\r\n  500                     let shown = if o.bad_start && !probe { a + 1 } else { a };\r\n  501                     (\r\n  502                         \"206 Partial\".into(),\r\n  503                         format!(\"Content-Range: bytes {shown}-{b}/{len}\\r\\n\"),\r\n  504                         body,\r\n  505                     )\r\n  506                 }\r\n  507             } else {\r\n  508                 (\"200 OK\".into(), String::new(), s.data.clone())\r\n  509             };\r\n  510         let _ = write!(\r\n  511             conn,\r\n  512             \"HTTP/1.1 {status}\\r\\nContent-Length: {}\\r\\n{extra}Connection: close\\r\\n\\r\\n\",\r\n  513             body.len()\r\n  514         );\r\n  515         let send = if cut {\r\n  516             &body[..body.len() / 2]\r\n  517         } else {\r\n  518             &body[..]\r\n  519         };\r\n  520         for piece in send.chunks(16 << 10) {\r\n  521             if conn.write_all(piece).is_err() {\r\n  522                 break;\r\n  523             }\r\n  524             let total = s.sent.fetch_add(piece.len() as u64, Relaxed) + piece.len() as u64;\r\n  525             if let Some((at, flag)) = &o.cancel_at {\r\n  526                 if total >= *at {\r\n  527                     flag.store(true, Relaxed);\r\n  528                 }\r\n  529             }\r\n  530         }\r\n  531         s.active.fetch_sub(1, Relaxed);\r\n  532     }\r\n  533 \r\n  534     fn run(url: &str, dest: &Path, cancel: Arc<AtomicBool>) -> Result<Option<PathBuf>, String> {\r\n  535         run_with(url, dest, cancel, |_| {})\r\n  536     }\r\n  537 \r\n  538     fn run_with(\r\n  539         url: &str,\r\n  540         dest: &Path,\r\n  541         cancel: Arc<AtomicBool>,\r\n  542         cb: impl Fn(DownloadProgress) + Send + Sync + 'static,\r\n  543     ) -> Result<Option<PathBuf>, String> {\r\n  544         let req = DownloadRequest {\r\n  545             url: url.into(),\r\n  546             destination: dest.into(),\r\n  547             cookie_header: None,\r\n  548             referer: None,\r\n  549         };\r\n  550         let rt = tokio::runtime::Builder::new_multi_thread()\r\n  551             .worker_threads(4)\r\n  552             .enable_all()\r\n  553             .build()\r\n  554             .unwrap();\r\n  555         rt.block_on(download(req, cancel, cb))\r\n  556     }\r\n  557 \r\n  558     fn no_cancel() -> Arc<AtomicBool> {\r\n  559         Arc::new(AtomicBool::new(false))\r\n  560     }\r\n  561 \r\n  562     fn pattern(n: usize) -> Vec<u8> {\r\n  563         (0..n).map(|i| (i * 7 % 251) as u8).collect()\r\n  564     }\r\n  565 \r\n  566     /// �??�시 ?�더. ?�스???�에 지?�다.\r\n  567     fn tmp(tag: &str) -> PathBuf {\r\n  568         let t = std::time::UNIX_EPOCH.elapsed().unwrap().as_nanos();\r\n  569         let dir = std::env::temp_dir().join(format!(\"segdl-{tag}-{}-{t}\", std::process::id()));\r\n  570         std::fs::create_dir_all(&dir).unwrap();\r\n  571         dir\r\n  572     }\r\n  573 \r\n  574     fn names(dir: &Path) -> Vec<String> {\r\n  575         std::fs::read_dir(dir)\r\n  576             .unwrap()\r\n  577             .map(|e| e.unwrap().file_name().to_string_lossy().into_owned())\r\n  578             .collect()\r\n  579     }\r\n  580 \r\n  581     fn korean(e: &str) -> bool {\r\n  582         e.chars().any(|c| !c.is_ascii())\r\n  583     }\r\n  584 \r\n  585     #[test]\r\n  586     fn bounds_tile_the_file_without_gap_or_overlap() {\r\n  587         for (total, n) in [(101, 16), (16, 16), (3, 3), (1, 1), (1 << 33, 16)] {\r\n  588             let mut next = 0;\r\n  589             for i in 0..n {\r\n  590                 let (s, e) = bounds(total, n, i);\r\n  591                 assert_eq!(s, next);\r\n  592                 assert!(e > s);\r\n  593                 next = e;\r\n  594             }\r\n  595             assert_eq!(next, total);\r\n  596         }\r\n  597     }\r\n  598 \r\n  599     // D1 D2 D3: ?�확??바이?? ?�더??목적지�??�음, �??�청?� bytes=0-0, ?�결?� 겹치??8�??�하\r\n  600     #[test]\r\n  601     fn parallel_download_is_exact_clean_and_capped_at_8_connections() {\r\n  602         let data = pattern(3_000_001);\r\n  603         let srv = serve(\r\n  604             data.clone(),\r\n  605             Opt {\r\n  606                 latency_ms: 50,\r\n  607                 ..Default::default()\r\n  608             },\r\n  609         );\r\n  610         let dir = tmp(\"par\");\r\n  611         let dest = dir.join(\"a.bin\");\r\n  612         assert_eq!(\r\n  613             run(&srv.url, &dest, no_cancel()).unwrap(),\r\n  614             Some(dest.clone())\r\n  615         );\r\n  616         assert_eq!(std::fs::read(&dest).unwrap(), data);\r\n  617         assert_eq!(names(&dir), [\"a.bin\"]);\r\n  618         assert!(srv.reqs.lock().unwrap()[0]\r\n  619             .to_lowercase()\r\n  620             .contains(\"range: bytes=0-0\"));\r\n  621         let peak = srv.peak.load(Relaxed);\r\n  622         assert!((2..=8).contains(&peak), \"?�시 ?�결 {peak}\");\r\n  623         std::fs::remove_dir_all(dir).ok();\r\n  624     }\r\n  625 \r\n  626     // D1: ?�기 0, 1, ?��? ?�기(구간 ?�보???�음), 구간 ?�의 배수가 ?�닌 ?�기\r\n  627     #[test]\r\n  628     fn tiny_and_empty_files_are_exact() {\r\n  629         for n in [0, 1, 5, 17] {\r\n  630             let data = pattern(n);\r\n  631             let srv = serve(data.clone(), Opt::default());\r\n  632             let dir = tmp(\"tiny\");\r\n  633             let dest = dir.join(\"t.bin\");\r\n  634             assert_eq!(\r\n  635                 run(&srv.url, &dest, no_cancel()).unwrap(),\r\n  636                 Some(dest.clone()),\r\n  637                 \"n={n}\"\r\n  638             );\r\n  639             assert_eq!(std::fs::read(&dest).unwrap(), data, \"n={n}\");\r\n  640             assert_eq!(names(&dir), [\"t.bin\"], \"n={n}\");\r\n  641             std::fs::remove_dir_all(dir).ok();\r\n  642         }\r\n  643     }\r\n  644 \r\n  645     // D2 D8: Range 미�???200)�?�??�기 모르??206(`*`)?� ?�일 ?�트�? 마�?�??�벤??received == total\r\n  646     #[test]\r\n  647     fn no_range_or_unknown_total_uses_single_stream() {\r\n  648         for opt in [\r\n  649             Opt {\r\n  650                 no_range: true,\r\n  651                 ..Default::default()\r\n  652             },\r\n  653             Opt {\r\n  654                 star: true,\r\n  655                 ..Default::default()\r\n  656             },\r\n  657         ] {\r\n  658             let data = pattern(100_003);\r\n  659             let srv = serve(data.clone(), opt);\r\n  660             let dir = tmp(\"single\");\r\n  661             let dest = dir.join(\"s.bin\");\r\n  662             let events = Arc::new(Mutex::new(vec![]));\r\n  663             let e2 = events.clone();\r\n  664             run_with(&srv.url, &dest, no_cancel(), move |p| {\r\n  665                 e2.lock().unwrap().push(p)\r\n  666             })\r\n  667             .unwrap();\r\n  668             assert_eq!(std::fs::read(&dest).unwrap(), data);\r\n  669             assert_eq!(names(&dir), [\"s.bin\"]);\r\n  670             let ev = events.lock().unwrap();\r\n  671             assert!(ev.iter().all(|p| p.mode == DownloadMode::Single));\r\n  672             let last = ev.last().unwrap();\r\n  673             assert_eq!((last.received, last.total), (100_003, Some(100_003)));\r\n  674             std::fs::remove_dir_all(dir).ok();\r\n  675         }\r\n  676     }\r\n  677 \r\n  678     // D2 D10: HTTP ?�류 ??Err(?�국?? ?�태 코드 ?�함), ?�일 ?�음\r\n  679     #[test]\r\n  680     fn http_error_is_err_without_files() {\r\n  681         let srv = serve(\r\n  682             pattern(10),\r\n  683             Opt {\r\n  684                 status: 404,\r\n  685                 ..Default::default()\r\n  686             },\r\n  687         );\r\n  688         let dir = tmp(\"404\");\r\n  689         let e = run(&srv.url, &dir.join(\"x.bin\"), no_cancel()).unwrap_err();\r\n  690         assert!(e.contains(\"404\") && korean(&e), \"{e}\");\r\n  691         assert!(names(&dir).is_empty());\r\n  692         std::fs::remove_dir_all(dir).ok();\r\n  693     }\r\n  694 \r\n  695     // D8: received ?�조 증�?, total = ?�체 ?�기, mode = Segmented, ?�벤?�는 초당 ??4???�하, 마�?막�? received == total\r\n  696     #[test]\r\n  697     fn progress_is_monotonic_rate_limited_and_ends_complete() {\r\n  698         let data = pattern(2_000_000);\r\n  699         let srv = serve(\r\n  700             data,\r\n  701             Opt {\r\n  702                 latency_ms: 700,\r\n  703                 ..Default::default()\r\n  704             },\r\n  705         );\r\n  706         let dir = tmp(\"prog\");\r\n  707         let events = Arc::new(Mutex::new(vec![]));\r\n  708         let e2 = events.clone();\r\n  709         let t = Instant::now();\r\n  710         run_with(&srv.url, &dir.join(\"p.bin\"), no_cancel(), move |p| {\r\n  711             e2.lock().unwrap().push(p)\r\n  712         })\r\n  713         .unwrap();\r\n  714         let secs = t.elapsed().as_secs_f64();\r\n  715         let ev = events.lock().unwrap();\r\n  716         assert!(ev.windows(2).all(|w| w[0].received <= w[1].received));\r\n  717         assert!(ev\r\n  718             .iter()\r\n  719             .all(|p| p.total == Some(2_000_000) && p.mode == DownloadMode::Segmented));\r\n  720         assert_eq!(ev.last().unwrap().received, 2_000_000);\r\n  721         assert!(\r\n  722             ev.len() as f64 <= secs * 4.0 + 3.0,\r\n  723             \"{}�?{secs:.2}s\",\r\n  724             ev.len()\r\n  725         );\r\n  726         std::fs::remove_dir_all(dir).ok();\r\n  727     }\r\n  728 \r\n  729     // D9: identity ?�코?? 쿠키·referer(비어 ?�으�??�략), Chrome UA, 리다?�렉??추적. 구간 ?�청??모두 같�? ?�더\r\n  730     #[test]\r\n  731     fn requests_carry_required_headers_and_follow_redirects() {\r\n  732         let data = pattern(50_000);\r\n  733         let srv = serve(\r\n  734             data.clone(),\r\n  735             Opt {\r\n  736                 redirect: true,\r\n  737                 ..Default::default()\r\n  738             },\r\n  739         );\r\n  740         let dir = tmp(\"hdr\");\r\n  741         let dest = dir.join(\"h.bin\");\r\n  742         let req = DownloadRequest {\r\n  743             url: srv.url.clone(),\r\n  744             destination: dest.clone(),\r\n  745             cookie_header: Some(\"sid=abc\".into()),\r\n  746             referer: Some(\"http://ref.example/\".into()),\r\n  747         };\r\n  748         let rt = tokio::runtime::Runtime::new().unwrap();\r\n  749         rt.block_on(download(req, no_cancel(), |_| {})).unwrap();\r\n  750         assert_eq!(std::fs::read(&dest).unwrap(), data);\r\n  751         let reqs = srv.reqs.lock().unwrap();\r\n  752         assert!(reqs.len() > 4);\r\n  753         for r in reqs.iter().map(|r| r.to_lowercase()) {\r\n  754             assert!(\r\n  755                 r.contains(\"accept-encoding: identity\")\r\n  756                     && r.contains(\"cookie: sid=abc\")\r\n  757                     && r.contains(\"referer: http://ref.example/\")\r\n  758                     && r.contains(\"chrome/\"),\r\n  759                 \"{r}\"\r\n  760             );\r\n  761         }\r\n  762         drop(reqs);\r\n  763         // �?문자?��? ?�더�?보내지 ?�는??        let srv = serve(data, Opt::default());\r\n  764         let req = DownloadRequest {\r\n  765             url: srv.url.clone(),\r\n  766             destination: dir.join(\"e.bin\"),\r\n  767             cookie_header: Some(String::new()),\r\n  768             referer: Some(String::new()),\r\n  769         };\r\n  770         rt.block_on(download(req, no_cancel(), |_| {})).unwrap();\r\n  771         assert!(srv.reqs.lock().unwrap().iter().all(\r\n  772             |r| !r.to_lowercase().contains(\"cookie:\") && !r.to_lowercase().contains(\"referer:\")\r\n  773         ));\r\n  774         std::fs::remove_dir_all(dir).ok();\r\n  775     }\r\n  776 \r\n  777     // D5 D10: ?�작?�이 ?�른 Content-Range, ?�청보다 �?본문, 계속 짧�? 본문 ???�성 ?�일 ?�이 Err(??�??�에)\r\n  778     #[test]\r\n  779     fn wrong_range_long_body_and_short_body_never_complete() {\r\n  780         for opt in [\r\n  781             Opt {\r\n  782                 bad_start: true,\r\n  783                 ..Default::default()\r\n  784             },\r\n  785             Opt {\r\n  786                 long: true,\r\n  787                 ..Default::default()\r\n  788             },\r\n  789             Opt {\r\n  790                 fail_first: usize::MAX,\r\n  791                 ..Default::default()\r\n  792             },\r\n  793         ] {\r\n  794             let srv = serve(pattern(200_000), opt);\r\n  795             let dir = tmp(\"bad\");\r\n  796             let dest = dir.join(\"b.bin\");\r\n  797             let t = Instant::now();\r\n  798             let e = run(&srv.url, &dest, no_cancel()).unwrap_err();\r\n  799             assert!(korean(&e), \"{e}\");\r\n  800             assert!(!dest.exists());\r\n  801             assert!(t.elapsed() < Duration::from_secs(10), \"{:?}\", t.elapsed());\r\n  802             // ?�패가 ?�긴 ?�개 ?�태�??�어받아???�웃 구간???�염?��? ?�아 결과가 ?�확?�다\r\n  803             let good = serve(pattern(200_000), Opt::default());\r\n  804             run(&good.url, &dest, no_cancel()).unwrap();\r\n  805             assert_eq!(std::fs::read(&dest).unwrap(), pattern(200_000));\r\n  806             std::fs::remove_dir_all(dir).ok();\r\n  807         }\r\n  808     }\r\n  809 \r\n  810     // D6: ?�시???�패(처음 5�?구간 ?�청??중간???��?)???�시?�로 복구, ?�일?� ?�확\r\n  811     #[test]\r\n  812     fn transient_failures_are_retried() {\r\n  813         let data = pattern(500_000);\r\n  814         let srv = serve(\r\n  815             data.clone(),\r\n  816             Opt {\r\n  817                 fail_first: 5,\r\n  818                 ..Default::default()\r\n  819             },\r\n  820         );\r\n  821         let dir = tmp(\"retry\");\r\n  822         let dest = dir.join(\"r.bin\");\r\n  823         assert_eq!(\r\n  824             run(&srv.url, &dest, no_cancel()).unwrap(),\r\n  825             Some(dest.clone())\r\n  826         );\r\n  827         assert_eq!(std::fs::read(&dest).unwrap(), data);\r\n  828         std::fs::remove_dir_all(dir).ok();\r\n  829     }\r\n  830 \r\n  831     // D6: 구간 ?�청??계속 5xx�???�??�에 Err\r\n  832     #[test]\r\n  833     fn persistent_failure_ends_in_seconds() {\r\n  834         let srv = serve(\r\n  835             pattern(200_000),\r\n  836             Opt {\r\n  837                 seg_status: 503,\r\n  838                 ..Default::default()\r\n  839             },\r\n  840         );\r\n  841         let dir = tmp(\"fail\");\r\n  842         let t = Instant::now();\r\n  843         let e = run(&srv.url, &dir.join(\"f.bin\"), no_cancel()).unwrap_err();\r\n  844         assert!(korean(&e) && e.contains(\"503\"), \"{e}\");\r\n  845         assert!(t.elapsed() < Duration::from_secs(10));\r\n  846         assert!(!dir.join(\"f.bin\").exists());\r\n  847         std::fs::remove_dir_all(dir).ok();\r\n  848     }\r\n  849 \r\n  850     // D7: ?�작 ?�에 취소 ??구간 ?�청 ?�이 Ok(None), 목적지 ?�음, ?�개 ?�태 ?��?\r\n  851     #[test]\r\n  852     fn preset_cancel_returns_none_and_keeps_resume_state() {\r\n  853         let srv = serve(pattern(100_000), Opt::default());\r\n  854         let dir = tmp(\"pre\");\r\n  855         let dest = dir.join(\"c.bin\");\r\n  856         assert_eq!(\r\n  857             run(&srv.url, &dest, Arc::new(AtomicBool::new(true))).unwrap(),\r\n  858             None\r\n  859         );\r\n  860         assert!(!dest.exists() && part_path(&dest).exists());\r\n  861         assert_eq!(srv.reqs.lock().unwrap().len(), 1, \"?�로브만\");\r\n  862         std::fs::remove_dir_all(dir).ok();\r\n  863     }\r\n  864 \r\n  865     // D7: ?�큰 ?��??�트�?    #[test]\r\n  866     fn cancel_tokens_register_signal_and_clear() {\r\n  867         let f = register_cancel(\"t-a\");\r\n  8