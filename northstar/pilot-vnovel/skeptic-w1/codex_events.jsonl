{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"\"C:\\\\windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -NoProfile -Command \"rg -n '\"'^'\"' before/segmented_download.rs\"","aggregated_output":"1://! HTTP Range 기반 분할 다운로드 백엔드.\r\n2://!\r\n3://! 배포 사이트 자동화는 `dist_host.rs`가 담당하고, 이 모듈은 최종 파일 URL을 받은 뒤의\r\n4://! 전송·재시도·재개만 담당한다. 서버가 Range를 지원하지 않으면 단일 스트림으로 폴백한다.\r\n5:\r\n6:use reqwest::header::{ACCEPT_ENCODING, CONTENT_LENGTH, CONTENT_RANGE, COOKIE, RANGE, REFERER};\r\n7:use reqwest::{Client, StatusCode};\r\n8:use serde::{Deserialize, Serialize};\r\n9:use std::collections::HashMap;\r\n10:use std::path::{Path, PathBuf};\r\n11:use std::sync::atomic::{AtomicBool, AtomicU64, AtomicUsize, Ordering};\r\n12:use std::sync::{Arc, LazyLock};\r\n13:use std::time::{Duration, Instant};\r\n14:use tokio::io::{AsyncSeekExt, AsyncWriteExt};\r\n15:use tokio::sync::Mutex;\r\n16:use tokio::task::JoinSet;\r\n17:\r\n18:/// 취소는 협조적이다: 실행 중인 전송이 이 sentinel을 Err로 올리면 `download`가\r\n19:/// 실패가 아니라 취소(`Ok(None)`)로 변환한다. sidecar는 남겨 재개할 수 있게 한다.\r\n20:const CANCEL_SENTINEL: &str = \"__DIST_DOWNLOAD_CANCELLED__\";\r\n21:\r\n22:/// 진행 중인 다운로드의 취소 플래그 레지스트리(토큰 → 플래그).\r\n23:/// 다운로드 task는 `dist_host`가 spawn하므로, 취소 커맨드가 토큰으로 찾아 신호할 수 있게\r\n24:/// 한 곳에 모은다.\r\n25:static CANCELLERS: LazyLock<std::sync::Mutex<HashMap<String, Arc<AtomicBool>>>> =\r\n26:    LazyLock::new(|| std::sync::Mutex::new(HashMap::new()));\r\n27:\r\n28:/// 토큰에 대한 취소 플래그를 만들어 등록하고 돌려준다.\r\n29:pub fn register_cancel(token: &str) -> Arc<AtomicBool> {\r\n30:    let flag = Arc::new(AtomicBool::new(false));\r\n31:    if let Ok(mut map) = CANCELLERS.lock() {\r\n32:        map.insert(token.to_string(), flag.clone());\r\n33:    }\r\n34:    flag\r\n35:}\r\n36:\r\n37:/// 해당 토큰의 다운로드에 취소를 신호한다. 등록된 게 있으면 true.\r\n38:pub fn request_cancel(token: &str) -> bool {\r\n39:    if let Ok(map) = CANCELLERS.lock() {\r\n40:        if let Some(flag) = map.get(token) {\r\n41:            flag.store(true, Ordering::SeqCst);\r\n42:            return true;\r\n43:        }\r\n44:    }\r\n45:    false\r\n46:}\r\n47:\r\n48:/// 완료·실패·취소로 끝난 토큰의 플래그를 제거한다.\r\n49:pub fn clear_cancel(token: &str) {\r\n50:    if let Ok(mut map) = CANCELLERS.lock() {\r\n51:        map.remove(token);\r\n52:    }\r\n53:}\r\n54:\r\n55:fn cancelled(flag: &AtomicBool) -> bool {\r\n56:    flag.load(Ordering::Relaxed)\r\n57:}\r\n58:\r\n59:const CONNECTIONS: usize = 8;\r\n60:const SEGMENTS_PER_CONNECTION: usize = 2;\r\n61:const MAX_RETRIES: usize = 4;\r\n62:const PROGRESS_EMIT_INTERVAL: Duration = Duration::from_millis(250);\r\n63:const RESUME_CHECKPOINT_BYTES: u64 = 1024 * 1024;\r\n64:const USER_AGENT: &str = \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 \\\r\n65:     (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36\";\r\n66:\r\n67:#[derive(Debug, Clone)]\r\n68:pub struct DownloadRequest {\r\n69:    pub url: String,\r\n70:    pub destination: PathBuf,\r\n71:    pub cookie_header: Option<String>,\r\n72:    pub referer: Option<String>,\r\n73:}\r\n74:\r\n75:#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize)]\r\n76:#[serde(rename_all = \"lowercase\")]\r\n77:pub enum DownloadMode {\r\n78:    Segmented,\r\n79:    Single,\r\n80:}\r\n81:\r\n82:#[derive(Debug, Clone, Copy)]\r\n83:pub struct DownloadProgress {\r\n84:    pub received: u64,\r\n85:    pub total: Option<u64>,\r\n86:    pub mode: DownloadMode,\r\n87:}\r\n88:\r\n89:#[derive(Debug, Serialize, Deserialize)]\r\n90:struct ResumeMeta {\r\n91:    version: u8,\r\n92:    total: u64,\r\n93:    segment_count: usize,\r\n94:}\r\n95:\r\n96:struct ProgressEmitter {\r\n97:    received: Arc<AtomicU64>,\r\n98:    total: Option<u64>,\r\n99:    mode: DownloadMode,\r\n100:    last_emit_ms: AtomicU64,\r\n101:    started: Instant,\r\n102:    callback: Arc<dyn Fn(DownloadProgress) + Send + Sync>,\r\n103:}\r\n104:\r\n105:impl ProgressEmitter {\r\n106:    fn new(\r\n107:        received: Arc<AtomicU64>,\r\n108:        total: Option<u64>,\r\n109:        mode: DownloadMode,\r\n110:        callback: Arc<dyn Fn(DownloadProgress) + Send + Sync>,\r\n111:    ) -> Self {\r\n112:        Self {\r\n113:            received,\r\n114:            total,\r\n115:            mode,\r\n116:            last_emit_ms: AtomicU64::new(0),\r\n117:            started: Instant::now(),\r\n118:            callback,\r\n119:        }\r\n120:    }\r\n121:\r\n122:    fn emit_if_due(&self) {\r\n123:        let elapsed = self.started.elapsed().as_millis().min(u64::MAX as u128) as u64;\r\n124:        let last = self.last_emit_ms.load(Ordering::Relaxed);\r\n125:        if elapsed.saturating_sub(last) < PROGRESS_EMIT_INTERVAL.as_millis() as u64 {\r\n126:            return;\r\n127:        }\r\n128:        if self\r\n129:            .last_emit_ms\r\n130:            .compare_exchange(last, elapsed, Ordering::Relaxed, Ordering::Relaxed)\r\n131:            .is_ok()\r\n132:        {\r\n133:            self.emit();\r\n134:        }\r\n135:    }\r\n136:\r\n137:    fn emit(&self) {\r\n138:        (self.callback)(DownloadProgress {\r\n139:            received: self.received.load(Ordering::Relaxed),\r\n140:            total: self.total,\r\n141:            mode: self.mode,\r\n142:        });\r\n143:    }\r\n144:}\r\n145:\r\n146:fn client() -> Result<Client, String> {\r\n147:    Client::builder()\r\n148:        .connect_timeout(Duration::from_secs(20))\r\n149:        .redirect(reqwest::redirect::Policy::limited(10))\r\n150:        .user_agent(USER_AGENT)\r\n151:        .build()\r\n152:        .map_err(|e| format!(\"HTTP 클라이언트 생성 실패: {e}\"))\r\n153:}\r\n154:\r\n155:fn request(\r\n156:    client: &Client,\r\n157:    method: reqwest::Method,\r\n158:    request: &DownloadRequest,\r\n159:) -> reqwest::RequestBuilder {\r\n160:    let mut builder = client\r\n161:        .request(method, &request.url)\r\n162:        // 압축된 응답은 바이트 오프셋과 실제 파일 오프셋을 다르게 만들 수 있다.\r\n163:        .header(ACCEPT_ENCODING, \"identity\");\r\n164:    if let Some(cookie) = request.cookie_header.as_deref().filter(|v| !v.is_empty()) {\r\n165:        builder = builder.header(COOKIE, cookie);\r\n166:    }\r\n167:    if let Some(referer) = request.referer.as_deref().filter(|v| !v.is_empty()) {\r\n168:        builder = builder.header(REFERER, referer);\r\n169:    }\r\n170:    builder\r\n171:}\r\n172:\r\n173:fn parse_content_range(value: &str) -> Option<u64> {\r\n174:    // `bytes 0-0/4722087959`; 크기를 모르는 `bytes 0-0/*`는 거부한다.\r\n175:    let (_, total) = value.rsplit_once('/')?;\r\n176:    total.parse::<u64>().ok().filter(|n| *n > 0)\r\n177:}\r\n178:\r\n179:async fn probe_range(\r\n180:    client: &Client,\r\n181:    request_info: &DownloadRequest,\r\n182:) -> Result<(bool, Option<u64>), String> {\r\n183:    let response = request(client, reqwest::Method::GET, request_info)\r\n184:        .header(RANGE, \"bytes=0-0\")\r\n185:        .send()\r\n186:        .await\r\n187:        .map_err(|e| format!(\"다운로드 서버 연결 실패: {e}\"))?;\r\n188:\r\n189:    if response.status() == StatusCode::PARTIAL_CONTENT {\r\n190:        let total = response\r\n191:            .headers()\r\n192:            .get(CONTENT_RANGE)\r\n193:            .and_then(|v| v.to_str().ok())\r\n194:            .and_then(parse_content_range);\r\n195:        return Ok((total.is_some(), total));\r\n196:    }\r\n197:\r\n198:    if response.status().is_success() {\r\n199:        let total = response\r\n200:            .headers()\r\n201:            .get(CONTENT_LENGTH)\r\n202:            .and_then(|v| v.to_str().ok())\r\n203:            .and_then(|v| v.parse::<u64>().ok())\r\n204:            .filter(|n| *n > 0);\r\n205:        return Ok((false, total));\r\n206:    }\r\n207:\r\n208:    Err(format!(\r\n209:        \"다운로드 서버가 요청을 거부했습니다: HTTP {}\",\r\n210:        response.status()\r\n211:    ))\r\n212:}\r\n213:\r\n214:fn sidecar_path(destination: &Path, suffix: &str) -> PathBuf {\r\n215:    let name = destination\r\n216:        .file_name()\r\n217:        .map(|n| n.to_string_lossy().into_owned())\r\n218:        .unwrap_or_else(|| \"download\".to_string());\r\n219:    destination.with_file_name(format!(\"{name}.{suffix}\"))\r\n220:}\r\n221:\r\n222:\r\n223:/// 저장된 구간 오프셋을 검증한다. 정상 checkpoint는 `completed`(≤ 구간 길이)만 기록하므로\r\n224:/// 구간 길이를 넘는 값은 손상(예: 하드 크래시 중 상태 파일 torn-write)이다.\r\n225:/// 그런 값을 완료로 오인하면 미수신 바이트를 건너뛰어 파일이 조용히 손상되므로,\r\n226:/// 처음부터 다시 받도록 0으로 되돌린다.\r\n227:fn valid_resume_offset(saved: u64, segment_len: u64) -> u64 {\r\n228:    if saved <= segment_len {\r\n229:        saved\r\n230:    } else {\r\n231:        0\r\n232:    }\r\n233:}\r\n234:\r\n235:fn segment_bounds(total: u64, count: usize, index: usize) -> (u64, u64) {\r\n236:    let count = count.max(1) as u64;\r\n237:    let index = index as u64;\r\n238:    let base = total / count;\r\n239:    let remainder = total % count;\r\n240:    // 나머지 바이트를 앞쪽 구간에 하나씩 배분하면 모든 구간이 빈틈·중복 없이 이어진다.\r\n241:    let start = index * base + index.min(remainder);\r\n242:    let size = base + u64::from(index < remainder);\r\n243:    let end = start.saturating_add(size).saturating_sub(1);\r\n244:    (start, end)\r\n245:}\r\n246:\r\n247:async fn prepare_resume(\r\n248:    destination: &Path,\r\n249:    total: u64,\r\n250:    segment_count: usize,\r\n251:) -> Result<(PathBuf, PathBuf, PathBuf, Vec<u64>), String> {\r\n252:    let part_path = sidecar_path(destination, \"download\");\r\n253:    let meta_path = sidecar_path(destination, \"download.json\");\r\n254:    let state_path = sidecar_path(destination, \"download.state\");\r\n255:    let expected = ResumeMeta {\r\n256:        version: 1,\r\n257:        total,\r\n258:        segment_count,\r\n259:    };\r\n260:\r\n261:    let existing_meta = tokio::fs::read_to_string(&meta_path)\r\n262:        .await\r\n263:        .ok()\r\n264:        .and_then(|s| serde_json::from_str::<ResumeMeta>(&s).ok());\r\n265:    let reusable = existing_meta\r\n266:        .as_ref()\r\n267:        .is_some_and(|m| m.version == 1 && m.total == total && m.segment_count == segment_count)\r\n268:        && tokio::fs::metadata(&part_path)\r\n269:            .await\r\n270:            .is_ok_and(|m| m.len() == total);\r\n271:\r\n272:    if !reusable {\r\n273:        for path in [&part_path, &meta_path, &state_path] {\r\n274:            if let Err(e) = tokio::fs::remove_file(path).await {\r\n275:                if e.kind() != std::io::ErrorKind::NotFound {\r\n276:                    return Err(format!(\"이전 임시 파일 정리 실패({}): {e}\", path.display()));\r\n277:                }\r\n278:            }\r\n279:        }\r\n280:        let file = tokio::fs::File::create(&part_path)\r\n281:            .await\r\n282:            .map_err(|e| format!(\"임시 파일 생성 실패({}): {e}\", part_path.display()))?;\r\n283:        file.set_len(total)\r\n284:            .await\r\n285:            .map_err(|e| format!(\"임시 파일 크기 설정 실패: {e}\"))?;\r\n286:        tokio::fs::write(\r\n287:            &meta_path,\r\n288:            serde_json::to_vec(&expected).map_err(|e| format!(\"재개 정보 생성 실패: {e}\"))?,\r\n289:        )\r\n290:        .await\r\n291:        .map_err(|e| format!(\"재개 정보 저장 실패: {e}\"))?;\r\n292:        tokio::fs::write(&state_path, vec![0u8; segment_count * 8])\r\n293:            .await\r\n294:            .map_err(|e| format!(\"구간 상태 생성 실패: {e}\"))?;\r\n295:    }\r\n296:\r\n297:    let raw_state = tokio::fs::read(&state_path).await.unwrap_or_default();\r\n298:    let mut offsets = Vec::with_capacity(segment_count);\r\n299:    for index in 0..segment_count {\r\n300:        let pos = index * 8;\r\n301:        let value = raw_state\r\n302:            .get(pos..pos + 8)\r\n303:            .and_then(|bytes| bytes.try_into().ok())\r\n304:            .map(u64::from_le_bytes)\r\n305:            .unwrap_or(0);\r\n306:        let (start, end) = segment_bounds(total, segment_count, index);\r\n307:        let segment_len = end.saturating_sub(start).saturating_add(1);\r\n308:        offsets.push(valid_resume_offset(value, segment_len));\r\n309:    }\r\n310:    Ok((part_path, meta_path, state_path, offsets))\r\n311:}\r\n312:\r\n313:async fn download_segment(\r\n314:    client: &Client,\r\n315:    request_info: &DownloadRequest,\r\n316:    part_path: &Path,\r\n317:    state_file: Arc<Mutex<tokio::fs::File>>,\r\n318:    progress: Arc<ProgressEmitter>,\r\n319:    cancel: Arc<AtomicBool>,\r\n320:    segment_count: usize,\r\n321:    index: usize,\r\n322:    initial_offset: u64,\r\n323:) -> Result<(), String> {\r\n324:    let total = progress\r\n325:        .total\r\n326:        .expect(\"분할 다운로드는 전체 크기가 필요하다\");\r\n327:    let (segment_start, segment_end) = segment_bounds(total, segment_count, index);\r\n328:    let segment_len = segment_end.saturating_sub(segment_start).saturating_add(1);\r\n329:    if initial_offset >= segment_len {\r\n330:        return Ok(());\r\n331:    }\r\n332:\r\n333:    let mut completed = initial_offset;\r\n334:    let mut checkpointed = initial_offset;\r\n335:    for attempt in 0..MAX_RETRIES {\r\n336:        if cancelled(&cancel) {\r\n337:            return Err(CANCEL_SENTINEL.to_string());\r\n338:        }\r\n339:        let start = segment_start + completed;\r\n340:        let mut response = match request(client, reqwest::Method::GET, request_info)\r\n341:            .header(RANGE, format!(\"bytes={start}-{segment_end}\"))\r\n342:            .send()\r\n343:            .await\r\n344:        {\r\n345:            Ok(response) if response.status() == StatusCode::PARTIAL_CONTENT => response,\r\n346:            Ok(response) => {\r\n347:                return Err(format!(\r\n348:                    \"Range 응답이 아닙니다(구간 {index}, HTTP {})\",\r\n349:                    response.status()\r\n350:                ))\r\n351:            }\r\n352:            Err(e) if attempt + 1 < MAX_RETRIES => {\r\n353:                tokio::time::sleep(Duration::from_millis(500 * (attempt as u64 + 1))).await;\r\n354:                eprintln!(\"[segmented-download] 구간 {index} 재시도: {e}\");\r\n355:                continue;\r\n356:            }\r\n357:            Err(e) => return Err(format!(\"구간 {index} 다운로드 실패: {e}\")),\r\n358:        };\r\n359:        let expected_range_prefix = format!(\"bytes {start}-\");\r\n360:        let valid_range = response\r\n361:            .headers()\r\n362:            .get(CONTENT_RANGE)\r\n363:            .and_then(|value| value.to_str().ok())\r\n364:            .is_some_and(|value| value.starts_with(&expected_range_prefix));\r\n365:        if !valid_range {\r\n366:            return Err(format!(\r\n367:                \"구간 {index}의 Content-Range가 요청 범위와 다릅니다\"\r\n368:            ));\r\n369:        }\r\n370:\r\n371:        let mut file = tokio::fs::OpenOptions::new()\r\n372:            .write(true)\r\n373:            .open(part_path)\r\n374:            .await\r\n375:            .map_err(|e| format!(\"임시 파일 열기 실패: {e}\"))?;\r\n376:        file.seek(std::io::SeekFrom::Start(start))\r\n377:            .await\r\n378:            .map_err(|e| format!(\"구간 {index} seek 실패: {e}\"))?;\r\n379:\r\n380:        let transfer = async {\r\n381:            while let Some(chunk) = response\r\n382:                .chunk()\r\n383:                .await\r\n384:                .map_err(|e| format!(\"구간 {index} 수신 실패: {e}\"))?\r\n385:            {\r\n386:                if cancelled(&cancel) {\r\n387:                    return Err(CANCEL_SENTINEL.to_string());\r\n388:                }\r\n389:                let remaining = segment_len.saturating_sub(completed);\r\n390:                if chunk.len() as u64 > remaining {\r\n391:                    return Err(format!(\"구간 {index}이 예정 크기를 초과했습니다\"));\r\n392:                }\r\n393:                file.write_all(&chunk)\r\n394:                    .await\r\n395:                    .map_err(|e| format!(\"구간 {index} 쓰기 실패: {e}\"))?;\r\n396:                completed += chunk.len() as u64;\r\n397:                progress\r\n398:                    .received\r\n399:                    .fetch_add(chunk.len() as u64, Ordering::Relaxed);\r\n400:                progress.emit_if_due();\r\n401:\r\n402:                if completed.saturating_sub(checkpointed) >= RESUME_CHECKPOINT_BYTES\r\n403:                    || completed == segment_len\r\n404:                {\r\n405:                    let mut state = state_file.lock().await;\r\n406:                    state\r\n407:                        .seek(std::io::SeekFrom::Start((index * 8) as u64))\r\n408:                        .await\r\n409:                        .map_err(|e| format!(\"구간 상태 seek 실패: {e}\"))?;\r\n410:                    state\r\n411:                        .write_all(&completed.to_le_bytes())\r\n412:                        .await\r\n413:                        .map_err(|e| format!(\"구간 상태 저장 실패: {e}\"))?;\r\n414:                    checkpointed = completed;\r\n415:                }\r\n416:            }\r\n417:            file.flush()\r\n418:                .await\r\n419:                .map_err(|e| format!(\"구간 {index} flush 실패: {e}\"))?;\r\n420:            Ok::<(), String>(())\r\n421:        }\r\n422:        .await;\r\n423:\r\n424:        match transfer {\r\n425:            Ok(()) if completed == segment_len => return Ok(()),\r\n426:            Ok(()) if attempt + 1 < MAX_RETRIES => {\r\n427:                tokio::time::sleep(Duration::from_millis(500 * (attempt as u64 + 1))).await;\r\n428:            }\r\n429:            Ok(()) => {\r\n430:                return Err(format!(\r\n431:                    \"구간 {index} 크기 불일치: {completed}/{segment_len} bytes\"\r\n432:                ))\r\n433:            }\r\n434:            // 취소는 재시도하지 않고 즉시 올린다.\r\n435:            Err(e) if e == CANCEL_SENTINEL => return Err(e),\r\n436:            Err(e) if attempt + 1 < MAX_RETRIES => {\r\n437:                tokio::time::sleep(Duration::from_millis(500 * (attempt as u64 + 1))).await;\r\n438:                eprintln!(\"[segmented-download] 구간 {index} 재시도: {e}\");\r\n439:            }\r\n440:            Err(e) => return Err(e),\r\n441:        }\r\n442:    }\r\n443:    Err(format!(\"구간 {index} 재시도 횟수 초과\"))\r\n