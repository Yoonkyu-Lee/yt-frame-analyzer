�����(P1)\r\n   23 const MAX_RETRIES: usize = 4; // D6\r\n   24 const CHECKPOINT: u64 = 1 << 20; // D4\r\n   25 const USER_AGENT: &str = \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 \\\r\n   26      (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36\";\r\n   27 \r\n   28 #[derive(Debug, Clone)]\r\n   29 pub struct DownloadRequest {\r\n   30     pub url: String,\r\n   31     pub destination: PathBuf,\r\n   32     pub cookie_header: Option<String>,\r\n   33     pub referer: Option<String>,\r\n   34 }\r\n   35 \r\n   36 #[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize)]\r\n   37 #[serde(rename_all = \"lowercase\")]\r\n   38 pub enum DownloadMode {\r\n   39     Segmented,\r\n   40     Single,\r\n   41 }\r\n   42 \r\n   43 #[derive(Debug, Clone, Copy)]\r\n   44 pub struct DownloadProgress {\r\n   45     pub received: u64,\r\n   46     pub total: Option<u64>,\r\n   47     pub mode: DownloadMode,\r\n   48 }\r\n   49 \r\n   50 type Callback = Box<dyn Fn(DownloadProgress) + Send + Sync>;\r\n   51 type Res<T> = Result<T, Box<dyn std::error::Error + Send + Sync>>; // D10: ���(`download`)���� �� ���� �ѱ��� �������� ���Ѵ�\r\n   52 \r\n   53 // D7: ��� ��ū ������Ʈ��(��ū �� �÷���)\r\n   54 static CANCELLERS: LazyLock<Mutex<HashMap<String, Arc<AtomicBool>>>> =\r\n   55     LazyLock::new(Default::default);\r\n   56 \r\n   57 pub fn register_cancel(token: &str) -> Arc<AtomicBool> {\r\n   58     let flag = Arc::new(AtomicBool::new(false));\r\n   59     CANCELLERS\r\n   60         .lock()\r\n   61         .unwrap()\r\n   62         .insert(token.into(), flag.clone());\r\n   63     flag\r\n   64 }\r\n   65 \r\n   66 pub fn request_cancel(token: &str) -> bool {\r\n   67     let map = CANCELLERS.lock().unwrap();\r\n   68     map.get(token).map(|f| f.store(true, Relaxed)).is_some()\r\n   69 }\r\n   70 \r\n   71 pub fn clear_cancel(token: &str) {\r\n   72     CANCELLERS.lock().unwrap().remove(token);\r\n   73 }\r\n   74 \r\n   75 // D8: ���� �̺�Ʈ. �ݹ��� ��� �ȿ��� �ҷ� received�� �ڷ� ���� �ʰ�, �ʴ� 4ȸ������ ����.\r\n   76 struct Progress {\r\n   77     received: AtomicU64,\r\n   78     last: Mutex<Instant>,\r\n   79     info: DownloadProgress,\r\n   80     callback: Callback,\r\n   81 }\r\n   82 \r\n   83 impl Progress {\r\n   84     fn new(received: u64, total: Option<u64>, mode: DownloadMode, callback: Callback) -> Self {\r\n   85         let info = DownloadProgress {\r\n   86             received,\r\n   87             total,\r\n   88             mode,\r\n   89         };\r\n   90         let p = Progress {\r\n   91             received: received.into(),\r\n   92             last: Mutex::new(Instant::now()),\r\n   93             info,\r\n   94             callback,\r\n   95         };\r\n   96         p.emit();\r\n   97         p\r\n   98     }\r\n   99 \r\n  100     fn emit(&self) {\r\n  101         (self.callback)(DownloadProgress {\r\n  102             received: self.received.load(Relaxed),\r\n  103             ..self.info\r\n  104         });\r\n  105     }\r\n  106 \r\n  107     fn add(&self, n: u64) {\r\n  108         self.received.fetch_add(n, Relaxed);\r\n  109         let mut last = self.last.lock().unwrap();\r\n  110         if last.elapsed() >= Duration::from_millis(250) {\r\n  111             *last = Instant::now();\r\n  112             self.emit();\r\n  113         }\r\n  114     }\r\n  115 }\r\n  116 \r\n  117 // D9: ��� ��û�� ���� ���. identity�� ����Ʈ ������ = ���� �������� ��Ű�� ���ؼ���.\r\n  118 fn get(client: &Client, req: &DownloadRequest) -> reqwest::RequestBuilder {\r\n  119     let mut b = client.get(&req.url).header(ACCEPT_ENCODING, \"identity\");\r\n  120     if let Some(c) = req.cookie_header.as_deref().filter(|v| !v.is_empty()) {\r\n  121         b = b.header(COOKIE, c);\r\n  122     }\r\n  123     if let Some(r) = req.referer.as_deref().filter(|v| !v.is_empty()) {\r\n  124         b = b.header(REFERER, r);\r\n  125     }\r\n  126     b\r\n  127 }\r\n  128 \r\n  129 fn part_path(dest: &Path) -> PathBuf {\r\n  130     let mut name = dest.file_name().unwrap_or_default().to_os_string();\r\n  131     name.push(\".download\");\r\n  132     dest.with_file_name(name)\r\n  133 }\r\n  134 \r\n  135 async fn put(f: &mut File, at: u64, bytes: &[u8]) -> Res<()> {\r\n  136     f.seek(Start(at)).await?;\r\n  137     Ok(f.write_all(bytes).await?)\r\n  138 }\r\n  139 \r\n  140 /// ���� �ٿ�ε� �۾� �ϳ�(D3/D4).\r\n  141 struct Job {\r\n  142     client: Client,\r\n  143     req: DownloadRequest,\r\n  144     part: PathBuf,\r\n  145     total: u64,\r\n  146     n: u64,\r\n  147     offsets: Vec<u64>, // ������ �̹� ���� ����Ʈ(�簳 ����)\r\n  148     next: AtomicUsize,\r\n  149     progress: Progress,\r\n  150     cancel: Arc<AtomicBool>,\r\n  151 }\r\n  152 \r\n  153 /// ���� i = [total*i/n, total*(i+1)/n): ��ƴ����ħ ���� ������ ���´�.\r\n  154 fn bounds(total: u64, n: u64, i: u64) -> (u64, u64) {\r\n  155     (total * i / n, total * (i + 1) / n)\r\n  156 }\r\n  157 \r\n  158 /// D4/D5: �ӽ� ������ ���� ������ �簳 ���¸� �д´�. ũ�⡤total�� �ٸ��ų� ���� ��������\r\n  159 /// ���� ���̸� ������(�ջ�) �� �κ��� ������ ó������ �޴´�.\r\n  160 async fn open_part(part: &Path, total: u64, n: u64) -> Res<(File, Vec<u64>)> {\r\n  161     let mut f = OpenOptions::new()\r\n  162         .read(true)\r\n  163         .write(true)\r\n  164         .create(true)\r\n  165         .open(part)\r\n  166         .await?;\r\n  167     let want = total + 8 * (n + 1);\r\n  168     let mut tail = vec![0u8; 8 * (n as usize + 1)];\r\n  169     f.seek(Start(total)).await?;\r\n  170     let word = |t: &[u8], i: usize| u64::from_le_bytes(t[8 * i..8 * i + 8].try_into().unwrap());\r\n  171     let valid = f.metadata().await?.len() == want && f.read_exact(&mut tail).await.is_ok();\r\n  172     if !valid || word(&tail, 0) != total {\r\n  173         tail.fill(0);\r\n  174         tail[..8].copy_from_slice(&total.to_le_bytes());\r\n  175         f.set_len(0).await?;\r\n  176         f.set_len(want).await?;\r\n  177         put(&mut f, total, &tail).await?;\r\n  178         f.flush().await?;\r\n  179     }\r\n  180     let done = |i| {\r\n  181         let (s, e) = bounds(total, n, i);\r\n  182         Some(word(&tail, i as usize + 1))\r\n  183             .filter(|v| *v <= e - s)\r\n  184             .unwrap_or(0)\r\n  185     };\r\n  186     Ok((f, (0..n).map(done).collect()))\r\n  187 }\r\n  188 \r\n  189 /// D5/D6: ���� i�� ���� �κ��� �ִ� MAX_RETRIES�� �޴´�. �̹� ���� ����Ʈ(done)�� �����Ѵ�.\r\n  190 async fn segment(job: &Job, i: usize) -> Res<()> {\r\n  191     let (s, e) = bounds(job.total, job.n, i as u64);\r\n  192     let mut f = OpenOptions::new().write(true).open(&job.part).await?;\r\n  193     let mut done = job.offsets[i];\r\n  194     let mut result = Ok(());\r\n  195     for attempt in 0..MAX_RETRIES {\r\n  196         if done == e - s {\r\n  197             break;\r\n  198         }\r\n  199         result = fetch(job, &mut f, i, s, e - s, &mut done).await;\r\n  200         if result.is_ok() || job.cancel.load(Relaxed) {\r\n  201             break;\r\n  202         }\r\n  203         if attempt + 1 < MAX_RETRIES {\r\n  204             tokio::time::sleep(Duration::from_millis(500 * (attempt as u64 + 1))).await;\r\n  205         }\r\n  206     }\r\n  207     let _ = f.flush().await;\r\n  208     result\r\n  209 }\r\n  210 \r\n  211 /// ��û �� ��. 206�̰� Content-Range�� ��û�� �������̾�� �ϸ�, ��Ȯ�� ���� ������ �޾ƾ� Ok(D5).\r\n  212 async fn fetch(job: &Job, f: &mut File, i: usize, s: u64, len: u64, done: &mut u64) -> Res<()> {\r\n  213     if job.cancel.load(Relaxed) {\r\n  214         return Err(\"��ҵ�\".into());\r\n  215     }\r\n  216     let from = s + *done;\r\n  217     let range = format!(\"bytes={from}-{}\", s + len - 1);\r\n  218     let mut res = get(&job.client, &job.req)\r\n  219         .header(RANGE, range)\r\n  220         .send()\r\n  221         .await?;\r\n  222     let start = res\r\n  223         .headers()\r\n  224         .get(CONTENT_RANGE)\r\n  225         .and_then(|v| v.to_str().ok());\r\n  226     if res.status() != StatusCode::PARTIAL_CONTENT\r\n  227         || !start.is_some_and(|v| v.starts_with(&format!(\"bytes {from}-\")))\r\n  228     {\r\n  229         return Err(format!(\"��û�� ������ �ƴ� �����Դϴ�(HTTP {})\", res.status()).into());\r\n  230     }\r\n  231     while let Some(chunk) = res.chunk().await? {\r\n  232         if job.cancel.load(Relaxed) {\r\n  233             return Err(\"��ҵ�\".into());\r\n  234         }\r\n  235         let n = chunk.len() as u64;\r\n  236         if n > len - *done {\r\n  237             return Err(\"������ ���� ũ�⸦ �ʰ��߽��ϴ�\".into());\r\n  238         }\r\n  239         put(f, s + *done, &chunk).await?;\r\n  240         *done += n;\r\n  241         job.progress.add(n);\r\n  242         if *done == len || *done / CHECKPOINT > (*done - n) / CHECKPOINT {\r\n  243             // ���� �ڵ��̶� �����Ͱ� ���� ���̰� ���°� �ڵ�����.\r\n  244             put(f, job.total + 8 + 8 * i as u64, &done.to_le_bytes()).await?;\r\n  245         }\r\n  246     }\r\n  247     f.flush().await?;\r\n  248     match *done == len {\r\n  249         true => Ok(()),\r\n  250         false => Err(format!(\"���� {i} ũ�� ����ġ: {done}/{len} bytes\").into()),\r\n  251     }\r\n  252 }\r\n  253 \r\n  254 /// D1/D3/D4: ���� �ִ� 8���� ���� ť�� ����. �� ������ ������ �ڸ��� rename(D1: �ϼ��� �ڿ��� �������� �����).\r\n  255 async fn segmented(\r\n  256     client: Client,\r\n  257     req: DownloadRequest,\r\n  258     total: u64,\r\n  259     cancel: Arc<AtomicBool>,\r\n  260     cb: Callback,\r\n  261 ) -> Res<PathBuf> {\r\n  262     let n = SEGMENTS.min(total);\r\n  263     let (part, dest) = (part_path(&req.destination), req.destination.clone());\r\n  264     let (f, offsets) = open_part(&part, total, n).await?;\r\n  265     let progress = Progress::new(\r\n  266         offsets.iter().sum(),\r\n  267         Some(total),\r\n  268         DownloadMode::Segmented,\r\n  269         cb,\r\n  270     );\r\n  271     let job = Arc::new(Job {\r\n  272         client,\r\n  273         req,\r\n  274         part,\r\n  275         total,\r\n  276         n,\r\n  277         offsets,\r\n  278         next: 0.into(),\r\n  279         progress,\r\n  280         cancel,\r\n  281     });\r\n  282     let mut workers = JoinSet::new();\r\n  283     for _ in 0..CONNECTIONS.min(n as usize) {\r\n  284         let job = job.clone();\r\n  285         workers.spawn(async move {\r\n  286             loop {\r\n  287                 let i = job.next.fetch_add(1, Relaxed);\r\n  288                 if i as u64 >= job.n {\r\n  289                     return Ok::<(), String>(());\r\n  290                 }\r\n  291                 segment(&job, i)\r\n  292                     .await\r\n  293                     .map_err(|e| format!(\"���� {i}: {e}\"))?;\r\n  294             }\r\n  295         });\r\n  296     }\r\n  297     while let Some(r) = workers.join_next().await {\r\n  298         r??;\r\n  299     }\r\n  300     job.progress.emit();\r\n  301     f.set_len(total).await?;\r\n  302     drop(f);\r\n  303     Ok(finish(&job.part, &dest).await?)\r\n  304 }\r\n  305 \r\n  306 /// D2: Range ���� ������ �� ũ�⸦ �𸣴� ������ �� �ٱ�� �޴´�(�̾�ޱ� ����).\r\n  307 async fn single(\r\n  308     client: Client,\r\n  309     req: DownloadRequest,\r\n  310     cancel: Arc<AtomicBool>,\r\n  311     cb: Callback,\r\n  312 ) -> Res<PathBuf> {\r\n  313     let mut res = get(&client, &req).send().await?.error_for_status()?;\r\n  314     let total = res.content_length();\r\n  315     let progress = Progress::new(0, total, DownloadMode::Single, cb);\r\n  316     let part = part_path(&req.destination);\r\n  317     let mut f = File::create(&part).await?;\r\n  318     while let Some(chunk) = res.chunk().await? {\r\n  319         if cancel.load(Relaxed) {\r\n  320             return Err(\"��ҵ�\".into());\r\n  321         }\r\n  322         f.write_all(&chunk).await?;\r\n  323         progress.add(chunk.len() as u64);\r\n  324     }\r\n  325     f.flush().await?;\r\n  326     drop(f);\r\n  327     if total.is_some_and(|t| t != progress.received.load(Relaxed)) {\r\n  328         return Err(\"���� ũ�Ⱑ ������ �˸� ũ��� �ٸ��ϴ�\".into());\r\n  329     }\r\n  330     progress.emit();\r\n  331     Ok(finish(&part, &req.destination).await?)\r\n  332 }\r\n  333 \r\n  334 async fn finish(part: &Path, dest: &Path) -> std::io::Result<PathBuf> {\r\n  335     tokio::fs::rename(part, dest).await?;\r\n  336     Ok(dest.into())\r\n  337 }\r\n  338 \r\n  339 /// ���� URL�� �޾� ���Ϸ� �����. `Some(path)` ����, `None` ���(�簳 ���� ����), `Err` ����.\r\n  340 pub async fn download<F>(\r\n  341     req: DownloadRequest,\r\n  342     cancel: Arc<AtomicBool>,\r\n  343     on_progress: F,\r\n  344 ) -> Result<Option<PathBuf>, String>\r\n  345 where\r\n  346     F: Fn(DownloadProgress) + Send + Sync + 'static,\r\n  347 {\r\n  348     let result = run(req, cancel.clone(), Box::new(on_progress)).await;\r\n  349     match result {\r\n  350         Ok(path) => Ok(Some(path)),\r\n  351         Err(_) if cancel.load(Relaxed) => Ok(None), // D7: ��ҷ� ���� ������ ���а� �ƴϴ�\r\n  352         Err(e) => Err(format!(\"�ٿ�ε� ����: {e}\")),\r\n  353     }\r\n  354 }\r\n  355 \r\n  356 async fn run(req: DownloadRequest, cancel: Arc<AtomicBool>, cb: Callback) -> Res<PathBuf> {\r\n  357     let client = Client::builder()\r\n  358         .connect_timeout(Duration::from_secs(20))\r\n  359         .redirect(reqwest::redirect::Policy::limited(10))\r\n  360         .referer(false) // D9: �����̷�Ʈ �ڿ��� ȣ���ڰ� �� referer�� �״�� ����\r\n  361         .user_agent(USER_AGENT)\r\n  362         .build()?;\r\n  363     // D2: ���κ�. 206 + �� ũ�⸦ �� ���� ����. ���� ���´� ����(�� ������ 416�� ���� ��ΰ� �޴´�).\r\n  364     let probe = get(&client, &req).header(RANGE, \"bytes=0-0\").send().await?;\r\n  365     let status = probe.status();\r\n  366     if !status.is_success() && status != StatusCode::RANGE_NOT_SATISFIABLE {\r\n  367         return Err(format!(\"������ ��û�� �ź��߽��ϴ�(HTTP {status})\").into());\r\n  368     }\r\n  369     let total = probe\r\n  370         .headers()\r\n  371         .get(CONTENT_RANGE)\r\n  372         .and_then(|v| v.to_str().ok());\r\n  373     let total = total.and_then(|v| v.rsplit_once('/')?.1.parse::<u64>().ok());\r\n  374     match total.filter(|t| *t > 0 && status == StatusCode::PARTIAL_CONTENT) {\r\n  375         Some(t) => segmented(client, req, t, cancel, cb).await,\r\n  376         None => single(client, req, cancel, cb).await,\r\n  377     }\r\n","exit_code":0,"status":"completed"}}
