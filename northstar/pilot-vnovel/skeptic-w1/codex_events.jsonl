         for case in 0..3 {\r\n  909             let dir = tmp(\"dmg\");\r\n  910             let dest = dir.join(\"d.bin\");\r\n  911             let part = part_path(&dest);\r\n  912             let cancel = no_cancel();\r\n  913             // 먼�? (?�른 ?�기 ?�는 같�? ?�기?? ?�운로드�?중간??멈춰 ?�태�?만든??            let seed = if case == 0 {\r\n  914                 pattern(777_777)\r\n  915             } else {\r\n  916                 data.clone()\r\n  917             };\r\n  918             let s = serve(\r\n  919                 seed,\r\n  920                 Opt {\r\n  921                     cancel_at: Some((400_000, cancel.clone())),\r\n  922                     ..Default::default()\r\n  923                 },\r\n  924             );\r\n  925             assert_eq!(run(&s.url, &dest, cancel).unwrap(), None);\r\n  926             if case == 1 {\r\n  927                 let mut raw = std::fs::read(&part).unwrap();\r\n  928                 let tail = raw.len() - 8 * 16; // 구간 ?�프???��?�?구간 길이 초과 값으�?망�??�린??                raw[tail..].iter_mut().for_each(|b| *b = 0xFF);\r\n  929                 std::fs::write(&part, raw).unwrap();\r\n  930             }\r\n  931             if case == 2 {\r\n  932                 std::fs::OpenOptions::new()\r\n  933                     .write(true)\r\n  934                     .open(&part)\r\n  935                     .unwrap()\r\n  936                     .set_len(1234)\r\n  937                     .unwrap();\r\n  938             }\r\n  939             let srv = serve(data.clone(), Opt::default());\r\n  940             assert_eq!(\r\n  941                 run(&srv.url, &dest, no_cancel()).unwrap(),\r\n  942                 Some(dest.clone()),\r\n  943                 \"case {case}\"\r\n  944             );\r\n  945             assert_eq!(std::fs::read(&dest).unwrap(), data, \"case {case}\");\r\n  946             assert_eq!(names(&dir), [\"d.bin\"]);\r\n  947             std::fs::remove_dir_all(dir).ok();\r\n  948         }\r\n  949     