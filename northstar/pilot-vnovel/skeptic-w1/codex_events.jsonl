     fn serve(data: Vec<u8>, opt: Opt) -> Arc<Srv> {\r\n  413         let listener = TcpListener::bind(\"127.0.0.1:0\").unwrap();\r\n  414         let url = format!(\r\n  415             \"http://{}/{}\",\r\n  416             listener.local_addr().unwrap(),\r\n  417             if opt.redirect { \"start\" } else { \"file.bin\" }\r\n  418         );\r\n  419         let srv = Arc::new(Srv {\r\n  420             url,\r\n  421             reqs: Default::default(),\r\n  422             peak: 0.into(),\r\n  423             sent: 0.into(),\r\n  424             active: 0.into(),\r\n  425             failed: 0.into(),\r\n  426             data,\r\n  427             opt,\r\n  428         });\r\n  429         let s = srv.clone();\r\n  430         std::thread::spawn(move || {\r\n  431             for stream in listener.incoming().flatten() {\r\n  432                 let s = s.clone();\r\n  433                 std::thread::spawn(move || handle(&s, stream));\r\n  434             }\r\n  435         });\r\n  436         srv\r\n  437     }\r\n  438 \r\n  439     fn handle(s: &Srv, mut conn: TcpStream) {\r\n  440         let mut buf = vec![0u8; 8192];\r\n  441         let n = conn.read(&mut buf).unwrap_or(0);\r\n  442         let head = String::from_utf8_lossy(&buf[..n]).to_string();\r\n  443         s.reqs.lock().unwrap().push(head.clone());\r\n  444         s.peak\r\n  445             .fetch_max(s.active.fetch_add(1, Relaxed) + 1, Relaxed);\r\n  446         std::thread::sleep(Duration::from_millis(s.opt.latency_ms));\r\n  447         let (o, len) = (&s.opt, s.data.len());\r\n  448         let range = head\r\n  449             .lines()\r\n  450             .find_map(|l| {\r\n  451                 l.to_ascii_lowercase()\r\n  452                     .strip_prefix(\"range: bytes=\")\r\n  453                     .map(String::from)\r\n  454             })\r\n  455             .and_then(|v| {\r\n  456                 let (a, b) = v.split_once('-')?;\r\n  457                 Some((\r\n  458                     a.trim().parse::<usize>().ok()?,\r\n  459                     b.trim().parse::<usize>().ok()?,\r\n  460                 ))\r\n  461             });\r\n  462         let probe = range == Some((0, 0));\r\n  463         let mut cut = false;\r\n  464         let (status, extra, body): (String, String, Vec<u8>) =\r\n  465             if o.redirect && head.contains(\"GET /start\") {\r\n  466                 (\r\n  467                     \"302 Found\".into(),\r\n  468                     format!(\"Location: /file.bin\\r\\n\"),\r\n  469                     vec![],\r\n  470                 )\r\n  471             } else if o.status != 0 || (o.seg_status != 0 && range.is_some() && !probe) {\r\n  472                 (\r\n  473                     format!(\r\n  474                         \"{} X\",\r\n  475                         if o.status != 0 {\r\n  476                             o.status\r\n  477                         } else {\r\n  478                             o.seg_status\r\n  479                         }\r\n  480                     ),\r\n  481                     String::new(),\r\n  482                     vec![],\r\n  483                 )\r\n  484             } else if range.is_some() && len == 0 {\r\n  485                 (\r\n  486                     \"416 Range Not Satisfiable\".into(),\r\n  487                     \"Content-Range: bytes */0\\r\\n\".into(),\r\n  488                     vec![],\r\n  489                 )\r\n  490             } else if let (Some((a, b)), false) = (range, o.no_range) {\r\n  491                 if o.star && probe {\r\n  492                     (\r\n  493                         \"206 Partial\".into(),\r\n  494                         \"Content-Range: bytes 0-0/*\\r\\n\".into(),\r\n  495                         s.data[..1].to_vec(),\r\n  496                     )\r\n  497                 } else {\r\n  498                     let b = b.min(len - 1);\r\n  499                     let mut body = s.data[a..=b].to_vec();\r\n  500                     if o.long && !probe {\r\n  501                         body.extend([7u8; 100]);\r\n  502                     }\r\n  503                     cut = !probe && s.failed.fetch_add(1, Relaxed) < o.fail_first;\r\n  504                     let shown = if o.bad_start && !probe { a + 1 } else { a };\r\n  505                     (\r\n  506                         \"206 Partial\".into(),\r\n  507                         format!(\"Content-Range: bytes {shown}-{b}/{len}\\r\\n\"),\r\n  508                         body,\r\n  509                     )\r\n  510                 }\r\n  511             } else {\r\n  512                 (\"200 OK\".into(), String::new(), s.data.clone())\r\n  513             };\r\n  514         let _ = write!(\r\n  515             conn,\r\n  516             \"HTTP/1.1 {status}\\r\\nContent-Length: {}\\r\\n{extra}Connection: close\\r\\n\\r\\n\",\r\n  517             body.len()\r\n  518         );\r\n  519         let send = if cut {\r\n  520             &body[..body.len() / 2]\r\n  521         } else {\r\n  522             &body[..]\r\n  523         };\r\n  524         for piece in send.chunks(16 << 10) {\r\n  525             if conn.write_all(piece).is_err() {\r\n  526                 break;\r\n  527             }\r\n  528             let total = s.sent.fetch_add(piece.len() as u64, Relaxed) + piece.len() as u64;\r\n  529             if let Some((at, flag)) = &o.cancel_at {\r\n  530                 if total >= *at {\r\n  531                     flag.store(true, Relaxed);\r\n  532                 }\r\n  533             }\r\n  534         }\r\n  535         s.active.fetch_sub(1, Relaxed);\r\n  536     }\r\n  537 \r\n  538     fn run(url: &str, dest: &Path, cancel: Arc<AtomicBool>) -> Result<Option<PathBuf>, String> {\r\n  539         run_with(url, dest, cancel, |_| {})\r\n  540     }\r\n  541 \r\n  542     fn run_with(\r\n  543         url: &str,\r\n  544         dest: &Path,\r\n  545         cancel: Arc<AtomicBool>,\r\n  546         cb: impl Fn(DownloadProgress) + Send + Sync + 'static,\r\n  547     ) -> Result<Option<PathBuf>, String> {\r\n  548         let req = DownloadRequest {\r\n  549             url: url.into(),\r\n  550             destination: dest.into(),\r\n  551             cookie_header: None,\r\n  552             referer: None,\r\n  553         };\r\n  554         let rt = tokio::runtime::Builder::new_multi_thread()\r\n  555             .worker_threads(4)\r\n  556             .enable_all()\r\n  557             .build()\r\n  558             .unwrap();\r\n  559         rt.block_on(download(req, cancel, cb))\r\n  560     }\r\n  561 \r\n  562     fn no_cancel() -> Arc<AtomicBool> {\r\n  563         Arc::new(AtomicBool::new(false))\r\n  564     }\r\n  565 \r\n  566     fn pattern(n: usize) -> Vec<u8> {\r\n  567         (0..n).map(|i| (i * 7 % 251) as u8).collect()\r\n  568     }\r\n  569 \r\n  570     /// �� �ӽ� ����. �׽�Ʈ ���� �����.\r\n  571     fn tmp(tag: &str) -> PathBuf {\r\n  572         let t = std::time::UNIX_EPOCH.elapsed().unwrap().as_nanos();\r\n  573         let dir = std::env::temp_dir().join(format!(\"segdl-{tag}-{}-{t}\", std::process::id()));\r\n  574         std::fs::create_dir_all(&dir).unwrap();\r\n  575         dir\r\n  576     }\r\n  577 \r\n  578     fn names(dir: &Path) -> Vec<String> {\r\n  579         std::fs::read_dir(dir)\r\n  580             .unwrap()\r\n  581             .map(|e| e.unwrap().file_name().to_string_lossy().into_owned())\r\n  582             .collect()\r\n  583     }\r\n  584 \r\n  585     fn korean(e: &str) -> bool {\r\n  586         e.chars().any(|c| !c.is_ascii())\r\n  587     }\r\n  588 \r\n  589     #[test]\r\n  590     fn bounds_tile_the_file_without_gap_or_overlap() {\r\n  591         for (total, n) in [(101, 16), (16, 16), (3, 3), (1, 1), (1 << 33, 16)] {\r\n  592             let mut next = 0;\r\n  593             for i in 0..n {\r\n  594                 let (s, e) = bounds(total, n, i);\r\n  595                 assert_eq!(s, next);\r\n  596                 assert!(e > s);\r\n  597                 next = e;\r\n  598             }\r\n  599             assert_eq!(next, total);\r\n  600         }\r\n  601     }\r\n  602 \r\n  603     // D1 D2 D3: ��Ȯ�� ����Ʈ, ������ �������� ����, ù ��û�� bytes=0-0, ������ ��ġ�� 8�� ����\r\n  604     #[test]\r\n  605     fn parallel_download_is_exact_clean_and_capped_at_8_connections() {\r\n  606         let data = pattern(3_000_001);\r\n  607         let srv = serve(\r\n  608             data.clone(),\r\n  609             Opt {\r\n  610                 latency_ms: 50,\r\n  611                 ..Default::default()\r\n  612             },\r\n  613         );\r\n  614         let dir = tmp(\"par\");\r\n  615         let dest = dir.join(\"a.bin\");\r\n  616         assert_eq!(\r\n  617             run(&srv.url, &dest, no_cancel()).unwrap(),\r\n  618             Some(dest.clone())\r\n  619         );\r\n  620         assert_eq!(std::fs::read(&dest).unwrap(), data);\r\n  621         assert_eq!(names(&dir), [\"a.bin\"]);\r\n  622         assert!(srv.reqs.lock().unwrap()[0]\r\n  623             .to_lowercase()\r\n  624             .contains(\"range: bytes=0-0\"));\r\n  625         let peak = srv.peak.load(Relaxed);\r\n  626         assert!((2..=8).contains(&peak), \"���� ���� {peak}\");\r\n  627         std::fs::remove_dir_all(dir).ok();\r\n  628     }\r\n  629 \r\n  630     // D1: ũ�� 0, 1, ���� ũ��(���� ������ ����), ���� ���� ����� �ƴ� ũ��\r\n  631     #[test]\r\n  632     fn tiny_and_empty_files_are_exact() {\r\n  633         for n in [0, 1, 5, 17] {\r\n  634             let data = pattern(n);\r\n  635             let srv = serve(data.clone(), Opt::default());\r\n  636             let dir = tmp(\"tiny\");\r\n  637             let dest = dir.join(\"t.bin\");\r\n  638             assert_eq!(\r\n  639                 run(&srv.url, &dest, no_cancel()).unwrap(),\r\n  640                 Some(dest.clone()),\r\n  641                 \"n={n}\"\r\n  642             );\r\n  643             assert_eq!(std::fs::read(&dest).unwrap(), data, \"n={n}\");\r\n  644             assert_eq!(names(&dir), [\"t.bin\"], \"n={n}\");\r\n  645             std::fs::remove_dir_all(dir).ok();\r\n  646         }\r\n  647     }\r\n  648 \r\n  649     // D2 D8: Range ������(200)�� �� ũ�� �𸣴� 206(`*`)�� ���� ��Ʈ��. ������ �̺�Ʈ received == total\r\n  650     #[test]\r\n  651     fn no_range_or_unknown_total_uses_single_stream() {\r\n  652         for opt in [\r\n  653             Opt {\r\n  654                 no_range: true,\r\n  655                 ..Default::default()\r\n  656             },\r\n  657             Opt {\r\n  658                 star: true,\r\n  659                 ..Default::default()\r\n  660             },\r\n  661         ] {\r\n  662             let data = pattern(100_003);\r\n  663             let srv = serve(data.clone(), opt);\r\n  664             let dir = tmp(\"single\");\r\n  665             let dest = dir.join(\"s.bin\");\r\n  666             let events = Arc::new(Mutex::new(vec![]));\r\n  667             let e2 = events.clone();\r\n  668             run_with(&srv.url, &dest, no_cancel(), move |p| {\r\n  669                 e2.lock().unwrap().push(p)\r\n  670             })\r\n  671             .unwrap();\r\n  672             assert_eq!(std::fs::read(&dest).unwrap(), data);\r\n  673             assert_eq!(names(&dir), [\"s.bin\"]);\r\n  674             let ev = events.lock().unwrap();\r\n  675             assert!(ev.iter().all(|p| p.mode == DownloadMode::Single));\r\n  676             let last = ev.last().unwrap();\r\n  677             assert_eq!((last.received, last.total), (100_003, Some(100_003)));\r\n  678             std::fs::remove_dir_all(dir).ok();\r\n  679         }\r\n  680     }\r\n  681 \r\n  682     // D2 D10: HTTP ���� �� Err(�ѱ���, ���� �ڵ� ����), ���� ����\r\n  683     #[test]\r\n  684     fn http_error_is_err_without_files() {\r\n  685         let srv = serve(\r\n  686             pattern(10),\r\n  687             Opt {\r\n  688                 status: 404,\r\n  689                 ..Default::default()\r\n  690             },\r\n  691         );\r\n  692         let dir = tmp(\"404\");\r\n  693         let e = run(&srv.url, &dir.join(\"x.bin\"), no_cancel()).unwrap_err();\r\n  694         assert!(e.contains(\"404\") && korean(&e), \"{e}\");\r\n  695         assert!(names(&dir).is_empty());\r\n  696         std::fs::remove_dir_all(dir).ok();\r\n  697     }\r\n  698 \r\n  699     // D8: received ���� ����, total = ��ü ũ��, mode = Segmented, �̺�Ʈ�� �ʴ� �� 4ȸ ����, �������� received == total\r\n  700     #[test]\r\n  701     fn progress_is_monotonic_rate_limited_and_ends_complete() {\r\n  702         let data = pattern(2_000_000);\r\n  703         let srv = serve(\r\n  704             data,\r\n  705             Opt {\r\n  706                 latency_ms: 700,\r\n  707                 ..Default::default()\r\n  708             },\r\n  709         );\r\n  710         let dir = tmp(\"prog\");\r\n  711         let events = Arc::new(Mutex::new(vec![]));\r\n  712         let e2 = events.clone();\r\n  713         let t = Instant::now();\r\n  714         run_with(&srv.url, &dir.join(\"p.bin\"), no_cancel(), move |p| {\r\n  715             e2.lock().unwrap().push(p)\r\n  716         })\r\n  717         .unwrap();\r\n  718         let secs = t.elapsed().as_secs_f64();\r\n  719         let ev = events.lock().unwrap();\r\n  720         assert!(ev.windows(2).all(|w| w[0].received <= w[1].received));\r\n  721         assert!(ev\r\n  722             .iter()\r\n  723             .all(|p| p.total == Some(2_000_000) && p.mode == DownloadMode::Segmented));\r\n  724         assert_eq!(ev.last().unwrap().received, 2_000_000);\r\n  725         assert!(\r\n  726             ev.len() as f64 <= secs * 4.0 + 3.0,\r\n  727             \"{}��/{secs:.2}s\",\r\n  728             ev.len()\r\n  729         );\r\n  730         std::fs::remove_dir_all(dir).ok();\r\n  731     }\r\n  732 \r\n  733     // D9: identity ���ڵ�, ��Ű��referer(��� ������ ����), Chrome UA, �����̷�Ʈ ����. ���� ��û�� ��� ���� ���\r\n  734     #[test]\r\n  735     fn requests_carry_required_headers_and_follow_redirects() {\r\n  736         let data = pattern(50_000);\r\n  737         let srv = serve(\r\n  738             data.clone(),\r\n  739             Opt {\r\n  740                 redirect: true,\r\n  741                 ..Default::default()\r\n  742             },\r\n  743         );\r\n  744         let dir = tmp(\"hdr\");\r\n  745         let dest = dir.join(\"h.bin\");\r\n  746         let req = DownloadRequest {\r\n  747             url: srv.url.clone(),\r\n  748             destination: dest.clone(),\r\n  749             cookie_header: Some(\"sid=abc\".into()),\r\n  750             referer: Some(\"http://ref.example/\".into()),\r\n  751         };\r\n  752         let rt = tokio::runtime::Runtime::new().unwrap();\r\n  753         rt.block_on(download(req, no_cancel(), |_| {})).unwrap();\r\n  754         assert_eq!(std::fs::read(&dest).unwrap(), data);\r\n  755         let reqs = srv.reqs.lock().unwrap();\r\n  756         assert!(reqs.len() > 4);\r\n  757         for r in reqs.iter().map(|r| r.to_lowercase()) {\r\n  758             assert!(\r\n  759                 r.contains(\"accept-encoding: identity\")\r\n  760                     && r.contains(\"cookie: sid=abc\")\r\n  761                     && r.contains(\"referer: http://ref.example/\")\r\n  762                     && r.contains(\"chrome/\"),\r\n  763                 \"{r}\"\r\n  764             );\r\n  765         }\r\n  766         drop(reqs);\r\n  767         // �� ���ڿ��� ����� ������ �ʴ´�\r\n  768         let srv = serve(data, Opt::default());\r\n  769         let req = DownloadRequest {\r\n  770             url: srv.url.clone(),\r\n  771             destination: dir.join(\"e.bin\"),\r\n  772             cookie_header: Some(String::new()),\r\n  773             referer: Some(String::new()),\r\n  774         };\r\n  775         rt.block_on(download(req, no_cancel(), |_| {})).unwrap();\r\n  776         assert!(srv.reqs.lock().unwrap().iter().all(\r\n  777             |r| !r.to_lowercase().contains(\"cookie:\") && !r.to_lowercase().contains(\"referer:\")\r\n  778         ));\r\n  779         std::fs::remove_dir_all(dir).ok();\r\n  780     }\r\n  781 \r\n  782     // D5 D10: �������� �ٸ� Content-Range, ��û���� �� ����, ��� ª�� ���� �� �ϼ� ���� ���� Err(�� �� �ȿ�)\r\n  783     #[test]\r\n  784     fn wrong_range_long_body_and_short_body_never_complete() {\r\n  785         for opt in [\r\n  786             Opt {\r\n  787                 bad_start: true,\r\n  788                 ..Default::default()\r\n  789             },\r\n  790             Opt {\r\n  791                 long: true,\r\n  792                 ..Default::default()\r\n  793             },\r\n  794             Opt {\r\n  795                 fail_first: usize::MAX,\r\n  796                 ..Default::default()\r\n  797             },\r\n  798         ] {\r\n  799             let srv = serve(pattern(200_000), opt);\r\n  800             let dir = tmp(\"bad\");\r\n  801             let dest = dir.join(\"b.bin\");\r\n  802             let t = Instant::now();\r\n  803             let e = run(&srv.url, &dest, no_cancel()).unwrap_err();\r\n  804             assert!(korean(&e), \"{e}\");\r\n  805             assert!(!dest.exists());\r\n  806             assert!(t.elapsed() < Duration::from_secs(10), \"{:?}\", t.elapsed());\r\n  807             // ���а� ���� �簳 ���·� �̾�޾Ƶ� �̿� ������ �������� �ʾ� ����� ��Ȯ�ϴ�\r\n  808             let good = serve(pattern(200_000), Opt::default());\r\n  809             run(&good.url, &dest, no_cancel()).unwrap();\r\n  810             assert_eq!(std::fs::read(&dest).unwrap(), pattern(200_000));\r\n  811             std::fs::remove_dir_all(dir).ok();\r\n  812         }\r\n  813     }\r\n  814 \r\n  815     // D6: �Ͻ��� ����(ó�� 5�� ���� ��û�� �߰��� ����)�� ��õ��� ����, ������ ��Ȯ\r\n  816     #[test]\r\n  817     fn transient_failures_are_retried() {\r\n  818         let data = pattern(500_000);\r\n  819         let srv = serve(\r\n  820             data.clone(),\r\n  821             Opt {\r\n  822                 fail_first: 5,\r\n  823                 ..Default::default()\r\n  824             },\r\n  825         );\r\n  826         let dir = tmp(\"retry\");\r\n  827         let dest = dir.join(\"r.bin\");\r\n  828         assert_eq!(\r\n  829             run(&srv.url, &dest, no_cancel()).unwrap(),\r\n  830             Some(dest.clone())\r\n  831         );\r\n  832         assert_eq!(std::fs::read(&dest).unwrap(), data);\r\n  833         std::fs::remove_dir_all(dir).ok();\r\n  834     }\r\n  835 \r\n  836     // D6: ���� ��û�� ��� 5xx�� �� �� �ȿ� Err\r\n  837     #[test]\r\n  838     fn persistent_failure_ends_in_seconds() {\r\n  839         let srv = serve(\r\n  840             pattern(200_000),\r\n  841             Opt {\r\n  842                 seg_status: 503,\r\n  843                 ..Default::default()\r\n  844             },\r\n  845         );\r\n  846         let dir = tmp(\"fail\");\r\n  847         let t = Instant::now();\r\n  848         let e = run(&srv.url, &dir.join(\"f.bin\"), no_cancel()).unwrap_err();\r\n  849         assert!(korean(&e) && e.contains(\"503\"), \"{e}\");\r\n  850         assert!(t.elapsed() < Duration::from_secs(10));\r\n  851         assert!(!dir.join(\"f.bin\").exists());\r\n  852         std::fs::remove_dir_all(dir).ok();\r\n  853     }\r\n  854 \r\n  855     // D7: ���� ���� ��� �� ���� ��û ���� Ok(None), ������ ����, �簳 ���� ����\r\n  856     #[test]\r\n  857     fn preset_cancel_returns_none_and_keeps_resume_state() {\r\n  858         let srv = serve(pattern(100_000), Opt::default());\r\n  859         let dir = tmp(\"pre\");\r\n  860         let dest = dir.join(\"c.bin\");\r\n  861         assert_eq!(\r\n  862             run(&srv.url, &dest, Arc::new(AtomicBool::new(true))).unwrap(),\r\n  863             None\r\n  864         );\r\n  865         assert!(!dest.exists() && part_path(&dest).exists());\r\n  866         assert_eq!(srv.reqs.lock().unwrap().len(), 1, \"���κ길\");\r\n  867         std::fs::remove_dir_all(dir).ok();\r\n  868     }\r\n  869 \r\n  870     // D7: ��ū ������Ʈ��\r\n  871     #[test]\r\n  872     fn cancel_tokens_register_signal_and_clear() {\r\n  873         let f = register_cancel(\"t-a\");\r\n  874         assert!(!f.load(Relaxed));\r\n  875         assert!(!request_cancel(\"t-unknown\"));\r\n  876         assert!(request_cancel(\"t-a\") && f.load(Relaxed));\r\n  877         assert!(!register_cancel(\"t-a\").load(Relaxed), \"�� �÷��״� ���� ä\");\r\n  878         clear_cancel(\"t-a\");\r\n  879         assert!(!request_cancel(\"t-a\"));\r\n  880     }\r\n  881 \r\n  882     // D4 D7: �߰��� ���(Ok(None)) �� �ٽ� ������ ���� �͸� ��û�ϰ� ����� ��Ȯ. ���� �� ������ �������� ����\r\n  883     #[test]\r\n  884     fn cancel_midway_then_resume_fetches_only_the_rest() {\r\n  885         let data = pattern(32 << 20);\r\n  886         let dir = tmp(\"resume\");\r\n  887         let dest = dir.join(\"r.bin\");\r\n  888         let cancel = no_cancel();\r\n  889         let first = serve(\r\n  890             data.clone(),\r\n  891             Opt {\r\n  892                 cancel_at: Some((16 << 20, cancel.clone())),\r\n  893                 ..Default::default()\r\n  894             },\r\n  895         );\r\n  896         assert_eq!(run(&first.url, &dest, cancel).unwrap(), None);\r\n  897         assert!(!dest.exists());\r\n  898         let second = serve(data.clone(), Opt::default());\r\n  899         assert_eq!(\r\n  900             run(&second.url, &dest, no_cancel()).unwrap(),\r\n  901             Some(dest.clone())\r\n  902         );\r\n  903         assert_eq!(std::fs::read(&dest).unwrap(), data);\r\n  904         assert_eq!(names(&dir), [\"r.bin\"]);\r\n  905         // ��� ������ 16MiB �̻� �޾Ұ�, ����� �ִ� 1MiB�� �ٽ� ���� �� �ִ� �� ���� ��û���� 75% ����\r\n  906         let sent = second.sent.load(Relaxed);\r\n  907         assert!(sent <= (data.len() as u64) * 3 / 4 + 1000, \"���û {sent}\");\r\n  908         std::fs::remove_dir_all(dir).ok();\r\n  909     }\r\n  910 \r\n  911     // D4 D5: �ٸ� ũ�� ������ �ܿ� ����, �ջ��(���� ���� �ʰ�) ����, ���̰� ��߳� �ӽ� ������ ������ ��Ȯ�� ������ �����\r\n  912     #[test]\r\n  913     fn foreign_or_damaged_resume_state_is_discarded() {\r\n  914         let data = pattern(1_000_000);\r\n  915         for case in 0..3 {\r\n  916             let dir = tmp(\"dmg\");\r\n  917             let dest = dir.join(\"d.bin\");\r\n  918             let part = part_path(&dest);\r\n  919             let cancel = no_cancel();\r\n  920             // ���� (�ٸ� ũ�� �Ǵ� ���� ũ����) �ٿ�ε带 �߰��� ���� ���¸� �����\r\n  921             let seed = if case == 0 {\r\n  922                 pattern(777_777)\r\n  923             } else {\r\n  924                 data.clone()\r\n  925             };\r\n  926             let s = serve(\r\n  927                 seed,\r\n  928                 Opt {\r\n  929                     cancel_at: Some((400_000, cancel.clone())),\r\n  930                     ..Default::default()\r\n  931                 },\r\n  932             );\r\n  933             assert_eq!(run(&s.url, &dest, cancel).unwrap(), None);\r\n  934             if case == 1 {\r\n  935                 let mut raw = std::fs::read(&part).unwrap();\r\n  936                 let tail = raw.len() - 8 * 16; // ���� ������ ���θ� ���� ���� �ʰ� ������ �����߸���\r\n  937                 raw[tail..].iter_mut().for_each(|b| *b = 0xFF);\r\n  938                 std::fs::write(&part, raw).unwrap();\r\n  939             }\r\n  940             if case == 2 {\r\n  941                 std::fs::OpenOptions::new()\r\n  942                     .write(true)\r\n  943                     .open(&part)\r\n  944                     .unwrap()\r\n  945                     .set_len(1234)\r\n  946                     .unwrap();\r\n  947             }\r\n  948             let srv = serve(data.clone(), Opt::default());\r\n  949             assert_eq!(\r\n  950                 run(&srv.url, &dest, no_cancel()).unwrap(),\r\n  951                 Some(dest.clone()),\r\n  952                 \"case {case}\"\r\n  953             );\r\n  954             assert_eq!(std::fs::read(&dest).unwrap(), data, \"case {case}\");\r\n  955             assert_eq!(names(&dir), [\"d.bin\"]);\r\n  956             std::fs::remove_dir_all(dir).ok();\r\n  957         }\r\n  958     }\r\n  959 \r\n  960     // D7: ���� ��Ʈ���� �޴� ���� ����ϸ� Ok(None), ������ ����\r\n  961     #[test]\r\n  962     fn cancel_during_single_stream_returns_none() {\r\n  963         let cancel = no_cancel();\r\n  964         let opt = Opt {\r\n  965             no_range: true,\r\n  966             cancel_at: Some((16 << 10, cancel.clone())),\r\n  967             ..Default::default()\r\n  968         };\r\n  969         let srv = serve(pattern(8 << 20), opt);\r\n  970         let dir = tmp(\"scancel\");\r\n  971         let dest = dir.join(\"s.bin\");\r\n  972         assert_eq!(run(&srv.url, &dest, cancel).unwrap(), None);\r\n  973         assert!(!dest.exists());\r\n  974         std::fs::remove_dir_all(dir).ok();\r\n  975     }\r\n  976 }\r\n","exit_code":0,"status":"completed"}}
