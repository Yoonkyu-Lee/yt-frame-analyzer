.unwrap_or(usize::MAX))\r\n  458         .max(1);\r\n  459     let (part_path, meta_path, state_path, offsets) =\r\n  460         prepare_resume(&request_info.destination, total, segment_count).await?;\r\n  461     let resumed = offsets.iter().copied().sum::<u64>().min(total);\r\n  462     let received = Arc::new(AtomicU64::new(resumed));\r\n  463     let callback: Arc<dyn Fn(DownloadProgress) + Send + Sync> = callback;\r\n  464     let progress = Arc::new(ProgressEmitter::new(\r\n  465         received,\r\n  466         Some(total),\r\n  467         DownloadMode::Segmented,\r\n  468         callback,\r\n  469     ));\r\n  470     progress.emit();\r\n  471 \r\n  472     let state_file = Arc::new(Mutex::new(\r\n  473         tokio::fs::OpenOptions::new()\r\n  474             .read(true)\r\n  475             .write(true)\r\n  476             .open(&state_path)\r\n  477             .await\r\n  478             .map_err(|e| format!(\"���� ���� ���� ����: {e}\"))?,\r\n  479     ));\r\n  480     let next = Arc::new(AtomicUsize::new(0));\r\n  481     let offsets = Arc::new(offsets);\r\n  482     let mut workers = JoinSet::new();\r\n  483 \r\n  484     for _ in 0..CONNECTIONS.min(segment_count) {\r\n  485         let client = client.clone();\r\n  486         let request_info = request_info.clone();\r\n  487         let part_path = part_path.clone();\r\n  488         let state_file = state_file.clone();\r\n  489         let progress = progress.clone();\r\n  490         let next = next.clone();\r\n  491         let offsets = offsets.clone();\r\n  492         let cancel = cancel.clone();\r\n  493         workers.spawn(async move {\r\n  494             loop {\r\n  495                 if cancelled(&cancel) {\r\n  496                     return Err::<(), String>(CANCEL_SENTINEL.to_string());\r\n  497                 }\r\n  498                 let index = next.fetch_add(1, Ordering::Relaxed);\r\n  499                 if index >= segment_count {\r\n  500                     return Ok::<(), String>(());\r\n  501                 }\r\n  502                 download_segment(\r\n  503                     &client,\r\n  504                     &request_info,\r\n  505                     &part_path,\r\n  506                     state_file.clone(),\r\n  507                     progress.clone(),\r\n  508                     cancel.clone(),\r\n  509                     segment_count,\r\n  510                     index,\r\n  511                     offsets[index],\r\n  512                 )\r\n  513                 .await?;\r\n  514             }\r\n  515         });\r\n  516     }\r\n  517 \r\n  518     while let Some(result) = workers.join_next().await {\r\n  519         let joined = result.map_err(|e| format!(\"�ٿ�ε� �۾� ���� ����: {e}\"))?;\r\n  520         if let Err(e) = joined {\r\n  521             // ��� sentinel�� ������ �ʰ� �״�� �÷� `download`�� Ok(None)���� �ٲٰ� �Ѵ�.\r\n  522             if e == CANCEL_SENTINEL {\r\n  523                 return Err(CANCEL_SENTINEL.to_string());\r\n  524             }\r\n  525             return Err(format!(\"���� �ٿ�ε� ����: {e}\"));\r\n  526         }\r\n  527     }\r\n  528 \r\n  529     progress.received.store(total, Ordering::Relaxed);\r\n  530     progress.emit();\r\n  531     tokio::fs::rename(&part_path, &request_info.destination)\r\n  532         .await\r\n  533         .map_err(|e| {\r\n  534             format!(\r\n  535                 \"�Ϸ� ���� �̵� ����({}): {e}\",\r\n  536                 request_info.destination.display()\r\n  537             )\r\n  538         })?;\r\n  539     let _ = tokio::fs::remove_file(meta_path).await;\r\n  540     let _ = tokio::fs::remove_file(state_path).await;\r\n  541     Ok(request_info.destination)\r\n  542 }\r\n  543 \r\n  544 async fn single<F>(\r\n  545     client: Client,\r\n  546     request_info: DownloadRequest,\r\n  547     expected_total: Option<u64>,\r\n  548     cancel: Arc<AtomicBool>,\r\n  549     callback: Arc<F>,\r\n  550 ) -> Result<PathBuf, String>\r\n  551 where\r\n  552     F: Fn(DownloadProgress) + Send + Sync + 'static,\r\n  553 {\r\n  554     let part_path = sidecar_path(&request_info.destination, \"download\");\r\n  555     let mut response = request(&client, reqwest::Method::GET, &request_info)\r\n  556         .send()\r\n  557         .await\r\n  558         .map_err(|e| format!(\"���� �ٿ�ε� ���� ����: {e}\"))?;\r\n  559     if !response.status().is_success() {\r\n  560         return Err(format!(\"�ٿ�ε� ���� ����: HTTP {}\", response.status()));\r\n  561     }\r\n  562     let total = response.content_length().or(expected_total);\r\n  563     let received = Arc::new(AtomicU64::new(0));\r\n  564     let callback: Arc<dyn Fn(DownloadProgress) + Send + Sync> = callback;\r\n  565     let progress = ProgressEmitter::new(received, total, DownloadMode::Single, callback);\r\n  566     progress.emit();\r\n  567 \r\n  568     let mut file = tokio::fs::File::create(&part_path)\r\n  569         .await\r\n  570         .map_err(|e| format!(\"�ӽ� ���� ���� ����({}): {e}\", part_path.display()))?;\r\n  571     while let Some(chunk) = response\r\n  572         .chunk()\r\n  573         .await\r\n  574         .map_err(|e| format!(\"�ٿ�ε� ���� ����: {e}\"))?\r\n  575     {\r\n  576         if cancelled(&cancel) {\r\n  577             return Err(CANCEL_SENTINEL.to_string());\r\n  578         }\r\n  579         file.write_all(&chunk)\r\n  580             .await\r\n  581             .map_err(|e| format!(\"���� ���� ����: {e}\"))?;\r\n  582         progress\r\n  583             .received\r\n  584             .fetch_add(chunk.len() as u64, Ordering::Relaxed);\r\n  585         progress.emit_if_due();\r\n  586     }\r\n  587     file.flush()\r\n  588         .await\r\n  589         .map_err(|e| format!(\"���� flush ����: {e}\"))?;\r\n  590     progress.emit();\r\n  591     tokio::fs::rename(&part_path, &request_info.destination)\r\n  592         .await\r\n  593         .map_err(|e| {\r\n  594             format!(\r\n  595                 \"�Ϸ� ���� �̵� ����({}): {e}\",\r\n  596                 request_info.destination.display()\r\n  597             )\r\n  598         })?;\r\n  599     Ok(request_info.destination)\r\n  600 }\r\n  601 \r\n  602 /// ���� URL�� �޾� ������ �����Ѵ�. `Ok(Some(path))` ����, `Ok(None)` ���, `Err` ����.\r\n  603 /// ��� �� sidecar�� ���� ���� ���࿡�� �簳�� �� �ְ� �Ѵ�.\r\n  604 pub async fn download<F>(\r\n  605     request_info: DownloadRequest,\r\n  606     cancel: Arc<AtomicBool>,\r\n  607     on_progress: F,\r\n  608 ) -> Result<Option<PathBuf>, String>\r\n  609 where\r\n  610     F: Fn(DownloadProgress) + Send + Sync + 'static,\r\n  611 {\r\n  612     let client = client()?;\r\n  613     let (range_supported, total) = probe_range(&client, &request_info).await?;\r\n  614     let callback = Arc::new(on_progress);\r\n  615     let result = match (range_supported, total) {\r\n  616         (true, Some(total)) => segmented(client, request_info, total, cancel, callback).await,\r\n  617         _ => single(client, request_info, total, cancel, callback).await,\r\n  618     };\r\n  619     match result {\r\n  620         Ok(path) => Ok(Some(path)),\r\n  621         Err(e) if e == CANCEL_SENTINEL => Ok(None),\r\n  622         Err(e) => Err(e),\r\n  623     }\r\n  624 }\r\n  625 \r\n  626 #[cfg(test)]\r\n  627 mod tests {\r\n  628     use super::*;\r\n  629     use std::io::{Read, Write};\r\n  630     use std::net::TcpListener;\r\n  631     use std::sync::atomic::AtomicUsize;\r\n  632 \r\n  633     fn spawn_test_server(\r\n  634         data: Vec<u8>,\r\n  635         supports_range: bool,\r\n  636         expected_requests: usize,\r\n  637     ) -> (String, Arc<AtomicUsize>, std::thread::JoinHandle<()>) {\r\n  638         let listener = TcpListener::bind(\"127.0.0.1:0\").unwrap();\r\n  639         let address = listener.local_addr().unwrap();\r\n  640         let requests = Arc::new(AtomicUsize::new(0));\r\n  641         let request_count = requests.clone();\r\n  642         let handle = std::thread::spawn(move || {\r\n  643             for stream in listener.incoming().take(expected_requests) {\r\n  644                 let mut stream = stream.unwrap();\r\n  645                 let mut buffer = vec![0u8; 8192];\r\n  646                 let size = stream.read(&mut buffer).unwrap();\r\n  647                 let headers = String::from_utf8_lossy(&buffer[..size]);\r\n  648                 request_count.fetch_add(1, Ordering::Relaxed);\r\n  649 \r\n  650                 let range = headers\r\n  651                     .lines()\r\n  652                     .find(|line| line.to_ascii_lowercase().starts_with(\"range: bytes=\"))\r\n  653                     .and_then(|line| line.split_once('=').map(|(_, value)| value.trim()))\r\n  654                     .and_then(|value| value.split_once('-'))\r\n  655                     .and_then(|(start, end)| {\r\n  656                         Some((start.parse::<usize>().ok()?, end.parse::<usize>().ok()?))\r\n  657                     });\r\n  658                 let (status, body, extra_header) = if supports_range {\r\n  659                     let (start, end) = range.unwrap();\r\n  660                     (\r\n  661                         \"206 Partial Content\",\r\n  662                         &data[start..=end],\r\n  663                         format!(\"Content-Range: bytes {start}-{end}/{}\\r\\n\", data.len()),\r\n  664                     )\r\n  665                 } else {\r\n  666                     (\"200 OK\", data.as_slice(), String::new())\r\n  667                 };\r\n  668                 write!(\r\n  669                     stream,\r\n  670                     \"HTTP/1.1 {status}\\r\\nContent-Length: {}\\r\\n{extra_header}\\\r\n  671                      Connection: close\\r\\n\\r\\n\",\r\n  672                     body.len()\r\n  673                 )\r\n  674                 .unwrap();\r\n  675                 stream.write_all(body).unwrap();\r\n  676             }\r\n  677         });\r\n  678         (format!(\"http://{address}/file.bin\"), requests, handle)\r\n  679     }\r\n  680 \r\n  681     fn no_cancel() -> Arc<AtomicBool> {\r\n  682         Arc::new(AtomicBool::new(false))\r\n  683     }\r\n  684 \r\n  685     fn test_runtime() -> tokio::runtime::Runtime {\r\n  686         tokio::runtime::Builder::new_multi_thread()\r\n  687             .worker_threads(4)\r\n  688             .enable_all()\r\n  689             .build()\r\n  690             .unwrap()\r\n  691     }\r\n  692 \r\n  693     fn unique_test_dir(tag: &str) -> PathBuf {\r\n  694         let dir = std::env::temp_dir().join(format!(\r\n  695             \"vnlib-segmented-{tag}-{}-{}\",\r\n  696             std::process::id(),\r\n  697             std::time::SystemTime::now()\r\n  698                 .duration_since(std::time::UNIX_EPOCH)\r\n  699                 .unwrap()\r\n  700                 .as_nanos()\r\n  701         ));\r\n  702         std::fs::create_dir_all(&dir).unwrap();\r\n  703         dir\r\n  704     }\r\n  705 \r\n  706     #[test]\r\n  707     fn parses_content_range_total() {\r\n  708         assert_eq!(\r\n  709             parse_content_range(\"bytes 0-0/4722087959\"),\r\n  710             Some(4_722_087_959)\r\n  711         );\r\n  712         assert_eq!(parse_content_range(\"bytes 0-0/*\"), None);\r\n  713         assert_eq!(parse_content_range(\"invalid\"), None);\r\n  714     }\r\n  715 \r\n  716     #[test]\r\n  717     fn resume_offset_rejects_corrupt_over_length_value() {\r\n  718         assert_eq!(valid_resume_offset(0, 10), 0);\r\n  719         assert_eq!(valid_resume_offset(5, 10), 5);\r\n  720         assert_eq!(valid_resume_offset(10, 10), 10); // ��Ȯ�� �Ϸ�� ��ȿ\r\n  721         assert_eq!(valid_resume_offset(11, 10), 0); // ���� �ʰ� = �ջ� �� ��ٿ�ε�\r\n  722         assert_eq!(valid_resume_offset(u64::MAX, 10), 0);\r\n  723     }\r\n  724 \r\n  725     #[test]\r\n  726     fn segment_bounds_cover_file_without_overlap() {\r\n  727         let total = 101;\r\n  728         let count = 16;\r\n  729         let mut next = 0;\r\n  730         for index in 0..count {\r\n  731             let (start, end) = segment_bounds(total, count, index);\r\n  732             assert_eq!(start, next);\r\n  733             assert!(end >= start);\r\n  734             next = end + 1;\r\n  735         }\r\n  736         assert_eq!(next, total);\r\n  737     }\r\n  738 \r\n  739 \r\n  740     #[test]\r\n  741     fn range_server_is_downloaded_in_parallel_without_corruption() {\r\n  742         let data: Vec<u8> = (0..65_537).map(|i| (i % 251) as u8).collect();\r\n  743         let expected_requests = 1 + CONNECTIONS * SEGMENTS_PER_CONNECTION;\r\n  744         let (url, requests, server) = spawn_test_server(data.clone(), true, expected_requests);\r\n  745         let dir = unique_test_dir(\"range\");\r\n  746         let destination = dir.join(\"range.bin\");\r\n  747 \r\n  748         let result = test_runtime().block_on(download(\r\n  749             DownloadRequest {\r\n  750                 url,\r\n  751                 destination: destination.clone(),\r\n  752                 cookie_header: None,\r\n  753                 referer: None,\r\n  754             },\r\n  755             no_cancel(),\r\n  756             |_| {},\r\n  757         ));\r\n  758 \r\n  759         assert_eq!(result.unwrap(), Some(destination.clone()));\r\n  760         assert_eq!(std::fs::read(&destination).unwrap(), data);\r\n  761         assert_eq!(requests.load(Ordering::Relaxed), expected_requests);\r\n  762         server.join().unwrap();\r\n  763         std::fs::remove_dir_all(dir).ok();\r\n  764     }\r\n  765 \r\n  766     #[test]\r\n  767     fn preset_cancel_stops_and_keeps_sidecars_for_resume() {\r\n  768         // ��� �÷��װ� ���� ä �����ϸ� ��� Ok(None)�̰�, �簳�� sidecar�� ���´�.\r\n  769         let data: Vec<u8> = (0..65_537).map(|i| (i % 251) as u8).collect();\r\n  770         // ������ ���κ�(1)�� �޴´� ? ��ҷ� ���� ��û�� ������ �ʴ´�.\r\n  771         let (url, requests, server) = spawn_test_server(data.clone(), true, 1);\r\n  772         let dir = unique_test_dir(\"cancel\");\r\n  773         let destination = dir.join(\"cancel.bin\");\r\n  774 \r\n  775         let result = test_runtime().block_on(download(\r\n  776             DownloadRequest {\r\n  777                 url,\r\n  778                 destination: destination.clone(),\r\n  779                 cookie_header: None,\r\n  780                 referer: None,\r\n  781             },\r\n  782             Arc::new(AtomicBool::new(true)),\r\n  783             |_| {},\r\n  784         ));\r\n  785 \r\n  786         assert_eq!(result.unwrap(), None, \"��Ҵ� Ok(None)\");\r\n  787         assert!(!destination.exists(), \"��� �� ���� ������ ����� �Ѵ�\");\r\n  788         assert!(\r\n  789             sidecar_path(&destination, \"download\").exists(),\r\n  790             \"�簳�� sidecar ����\"\r\n  791         );\r\n  792         assert_eq!(requests.load(Ordering::Relaxed), 1, \"���� ��û ���� ���κ길\");\r\n  793         server.join().unwrap();\r\n  794         std::fs::remove_dir_all(dir).ok();\r\n  795     }\r\n  796 \r\n  797     #[test]\r\n  798     fn server_without_range_support_falls_back_to_single_stream() {\r\n  799         let data: Vec<u8> = (0..4097).map(|i| (i % 239) as u8).collect();\r\n  800         let (url, requests, server) = spawn_test_server(data.clone(), false, 2);\r\n  801         let dir = unique_test_dir(\"single\");\r\n  802         let destination = dir.join(\"single.bin\");\r\n  803         let modes = Arc::new(std::sync::Mutex::new(Vec::new()));\r\n  804         let progress_modes = modes.clone();\r\n  805 \r\n  806         let result = test_runtime().block_on(download(\r\n  807             DownloadRequest {\r\n  808                 url,\r\n  809                 destination: destination.clone(),\r\n  810                 cookie_header: None,\r\n  811                 referer: None,\r\n  812             },\r\n  813    