% 239) as u8).collect();\r\n  579         let (url, requests, server) = spawn_test_server(data.clone(), false, 2);\r\n  580         let dir = unique_test_dir(\"single\");\r\n  581         let destination = dir.join(\"single.bin\");\r\n  582         let modes = Arc::new(std::sync::Mutex::new(Vec::new()));\r\n  583         let progress_modes = modes.clone();\r\n  584 \r\n  585         let result = test_runtime().block_on(download(\r\n  586             DownloadRequest {\r\n  587                 url,\r\n  588                 destination: destination.clone(),\r\n  589                 cookie_header: None,\r\n  590                 referer: None,\r\n  591             },\r\n  592             no_cancel(),\r\n  593             move |progress| progress_modes.lock().unwrap().push(progress.mode),\r\n  594         ));\r\n  595 \r\n  596         assert!(result.is_ok());\r\n  597         assert_eq!(std::fs::read(&destination).unwrap(), data);\r\n  598         assert_eq!(requests.load(Ordering::Relaxed), 2);\r\n  599         assert!(modes.lock().unwrap().contains(&DownloadMode::Single));\r\n  600         server.join().unwrap();\r\n  601         std::fs::remove_dir_all(dir).ok();\r\n  602     }\r\n  603 \r\n  604     #[test]\r\n  605     fn resume_skips_completed_segments_and_finishes_correctly() {\r\n  606         let data: Vec<u8> = (0..65_537).map(|i| (i % 251) as u8).collect();\r\n  607         let total = data.len() as u64;\r\n  608         let segment_count = (CONNECTIONS * SEGMENTS_PER_CONNECTION)\r\n  609             .min(data.len())\r\n  610             .max(1);\r\n  611 \r\n  612         let dir = unique_test_dir(\"resume\");\r\n  613         let destination = dir.join(\"resume.bin\");\r\n  614         let part = sidecar_path(&destination, \"download\");\r\n  615         let meta = sidecar_path(&destination, \"download.json\");\r\n  616         let state = sidecar_path(&destination, \"download.state\");\r\n  617 \r\n  618         // ��ü ũ���� �ӽ� ��ü�� 0���� �����, �Ϸ�� ǥ���