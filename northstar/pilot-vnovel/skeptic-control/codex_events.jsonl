{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"\"C:\\\\windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -NoProfile -Command '$n=0; Get-Content -Encoding UTF8 -LiteralPath '\"'after/segmented_download.rs' | ForEach-Object { \"'$n++; '\"'{0,5} {1}' -f \"'$n, $_ }'","aggregated_output":"    1 //! HTTP Range downloads with resumable sidecars and a single-stream fallback.\r\n    2 \r\n    3 use reqwest::header::{ACCEPT_ENCODING, CONTENT_RANGE, COOKIE, RANGE, REFERER};\r\n    4 use reqwest::{Client, Response, StatusCode};\r\n    5 use serde::{Deserialize, Serialize};\r\n    6 use std::collections::HashMap;\r\n    7 use std::path::{Path, PathBuf};\r\n    8 use std::sync::atomic::{AtomicBool, Ordering};\r\n    9 use std::sync::{Arc, LazyLock, Mutex};\r\n   10 use std::time::{Duration, Instant};\r\n   11 use tokio::fs::{self, File, OpenOptions};\r\n   12 use tokio::io::{AsyncSeekExt, AsyncWriteExt};\r\n   13 use tokio::task::JoinSet;\r\n   14 \r\n   15 type TransferResult<T> = Result<T, Box<dyn std::error::Error + Send + Sync>>;\r\n   16 \r\n   17 const CONNECTIONS: usize = 8;\r\n   18 const SEGMENTS_PER_CONNECTION: usize = 2;\r\n   19 const MAX_RETRIES: usize = 4;\r\n   20 const RESUME_CHECKPOINT_BYTES: u64 = 1024 * 1024;\r\n   21 const CANCEL_SENTINEL: &str = \"__DIST_DOWNLOAD_CANCELLED__\";\r\n   22 const USER_AGENT: &str = \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 \\\r\n   23     (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36\";\r\n   24 \r\n   25 static CANCELLERS: LazyLock<Mutex<HashMap<String, Arc<AtomicBool>>>> =\r\n   26     LazyLock::new(|| Mutex::new(HashMap::new()));\r\n   27 \r\n   28 pub fn register_cancel(token: &str) -> Arc<AtomicBool> {\r\n   29     let flag = Arc::new(AtomicBool::new(false));\r\n   30     if let Ok(mut map) = CANCELLERS.lock() {\r\n   31         map.insert(token.to_owned(), flag.clone());\r\n   32     }\r\n   33     flag\r\n   34 }\r\n   35 \r\n   36 pub fn request_cancel(token: &str) -> bool {\r\n   37     if let Ok(map) = CANCELLERS.lock() {\r\n   38         if let Some(flag) = map.get(token) {\r\n   39             flag.store(true, Ordering::SeqCst);\r\n   40             return true;\r\n   41         }\r\n   42     }\r\n   43     false\r\n   44 }\r\n   45 \r\n   46 pub fn clear_cancel(token: &str) {\r\n   47     if let Ok(mut map) = CANCELLERS.lock() {\r\n   48         map.remove(token);\r\n   49     }\r\n   50 }\r\n   51 \r\n   52 #[derive(Debug, Clone)]\r\n   53 pub struct DownloadRequest {\r\n   54     pub url: String,\r\n   55     pub destination: PathBuf,\r\n   56     pub cookie_header: Option<String>,\r\n   57     pub referer: Option<String>,\r\n   58 }\r\n   59 \r\n   60 #[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize)]\r\n   61 #[serde(rename_all = \"lowercase\")]\r\n   62 pub enum DownloadMode {\r\n   63     Segmented,\r\n   64     Single,\r\n   65 }\r\n   66 \r\n   67 #[derive(Debug, Clone, Copy)]\r\n   68 pub struct DownloadProgress {\r\n   69     pub received: u64,\r\n   70     pub total: Option<u64>,\r\n   71     pub mode: DownloadMode,\r\n   72 }\r\n   73 \r\n   74 #[derive(Debug, Serialize, Deserialize, PartialEq, Eq)]\r\n   75 struct ResumeMeta {\r\n   76     version: u8,\r\n   77     total: u64,\r\n   78     segment_count: usize,\r\n   79 }\r\n   80 \r\n   81 fn request(client: &Client, info: &DownloadRequest) -> reqwest::RequestBuilder {\r\n   82     let mut builder = client.get(&info.url).header(ACCEPT_ENCODING, \"identity\");\r\n   83     for (name, value) in [(COOKIE, &info.cookie_header), (REFERER, &info.referer)] {\r\n   84         if let Some(value) = value.as_deref().filter(|s| !s.is_empty()) {\r\n   85             builder = builder.header(name, value);\r\n   86         }\r\n   87     }\r\n   88     builder\r\n   89 }\r\n   90 \r\n   91 fn parse_content_range(value: &str) -> Option<u64> {\r\n   92     value\r\n   93         .strip_prefix(\"bytes 0-0/\")?\r\n   94         .parse()\r\n   95         .ok()\r\n   96         .filter(|n| *n > 0)\r\n   97 }\r\n   98 \r\n   99 fn sidecar_path(destination: &Path, suffix: &str) -> PathBuf {\r\n  100     let mut name = destination.file_name().unwrap_or_default().to_os_string();\r\n  101     name.push(format!(\".{suffix}\"));\r\n  102     destination.with_file_name(name)\r\n  103 }\r\n  104 \r\n  105 fn valid_resume_offset(saved: u64, segment_len: u64) -> u64 {\r\n  106     if saved <= segment_len {\r\n  107         saved\r\n  108     } else {\r\n  109         0\r\n  110     }\r\n  111 }\r\n  112 \r\n  113 fn segment_bounds(total: u64, count: usize, index: usize) -> (u64, u64) {\r\n  114     let count = count as u64;\r\n  115     let index = index as u64;\r\n  116     let start = index * (total / count) + index.min(total % count);\r\n  117     let len = total / count + u64::from(index < total % count);\r\n  118     (start, start + len - 1)\r\n  119 }\r\n  120 \r\n  121 async fn prepare_resume(\r\n  122     part: &Path,\r\n  123     meta: &Path,\r\n  124     state: &Path,\r\n  125     total: u64,\r\n  126     segment_count: usize,\r\n  127 ) -> TransferResult<Vec<u64>> {\r\n  128     let expected = ResumeMeta {\r\n  129         version: 1,\r\n  130         total,\r\n  131         segment_count,\r\n  132     };\r\n  133     let saved = fs::read(meta)\r\n  134         .await\r\n  135         .ok()\r\n  136         .and_then(|bytes| serde_json::from_slice::<ResumeMeta>(&bytes).ok());\r\n  137     let reusable = saved.as_ref() == Some(&expected)\r\n  138         && fs::metadata(part).await.is_ok_and(|m| m.len() == total);\r\n  139     if !reusable {\r\n  140         // Invalidate old offsets before replacing the body or metadata.\r\n  141         fs::write(state, vec![0; segment_count * 8]).await?;\r\n  142         File::create(part).await?.set_len(total).await?;\r\n  143         fs::write(meta, serde_json::to_vec(&expected)?).await?;\r\n  144     }\r\n  145     let raw = fs::read(state).await.unwrap_or_default();\r\n  146     let offsets = (0..segment_count)\r\n  147         .map(|index| {\r\n  148             let saved = raw\r\n  149                 .get(index * 8..index * 8 + 8)\r\n  150                 .map(|bytes| u64::from_le_bytes(bytes.try_into().unwrap()))\r\n  151                 .unwrap_or(0);\r\n  152             let (start, end) = segment_bounds(total, segment_count, index);\r\n  153             valid_resume_offset(saved, end - start + 1)\r\n  154         })\r\n  155         .collect();\r\n  156     Ok(offsets)\r\n  157 }\r\n  158 \r\n  159 struct Transfer {\r\n  160     client: Client,\r\n  161     info: DownloadRequest,\r\n  162     part: PathBuf,\r\n  163     cancel: Arc<AtomicBool>,\r\n  164     progress: Mutex<(DownloadProgress, Instant)>,\r\n  165     callback: Box<dyn Fn(DownloadProgress) + Send + Sync>,\r\n  166     state: Option<tokio::sync::Mutex<File>>,\r\n  167     offsets: Vec<u64>,\r\n  168 }\r\n  169 \r\n  170 impl Transfer {\r\n  171     fn emit(&self, added: u64, force: bool) {\r\n  172         // Serialize callbacks as well as updates so progress cannot go backwards.\r\n  173         let mut progress = self.progress.lock().unwrap();\r\n  174         progress.0.received += added;\r\n  175         if force || progress.1.elapsed() >= Duration::from_millis(250) {\r\n  176             progress.1 = Instant::now();\r\n  177             (self.callback)(progress.0);\r\n  178         }\r\n  179     }\r\n  180 \r\n  181     fn check_cancel(&self) -> TransferResult<()> {\r\n  182         if self.cancel.load(Ordering::Relaxed) {\r\n  183             Err(CANCEL_SENTINEL.into())\r\n  184         } else {\r\n  185             Ok(())\r\n  186         }\r\n  187     }\r\n  188 \r\n  189     async fn checkpoint(&self, file: &mut File, index: usize, done: u64) -> TransferResult<()> {\r\n  190         // Finish pending data writes before recording their resume offset.\r\n  191         file.flush().await?;\r\n  192         let mut state = self.state.as_ref().unwrap().lock().await;\r\n  193         state\r\n  194             .seek(std::io::SeekFrom::Start((index * 8) as u64))\r\n  195             .await?;\r\n  196         state.write_all(&done.to_le_bytes()).await?;\r\n  197         state.flush().await?;\r\n  198         Ok(())\r\n  199     }\r\n  200 \r\n  201     async fn segment(&self, total: u64, index: usize) -> TransferResult<()> {\r\n  202         self.check_cancel()?;\r\n  203         let (first, end) = segment_bounds(total, self.offsets.len(), index);\r\n  204         let len = end - first + 1;\r\n  205         let mut done = self.offsets[index];\r\n  206         if done == len {\r\n  207             return Ok(());\r\n  208         }\r\n  209         let mut saved = done;\r\n  210         let mut file = OpenOptions::new().write(true).open(&self.part).await?;\r\n  211         for attempt in 0..MAX_RETRIES {\r\n  212             self.check_cancel()?;\r\n  213             let start = first + done;\r\n  214             let result: TransferResult<()> = async {\r\n  215                 let mut response = request(&self.client, &self.info)\r\n  216                     .header(RANGE, format!(\"bytes={start}-{end}\"))\r\n  217                     .send()\r\n  218                     .await?;\r\n  219                 let expected = format!(\"bytes {start}-{end}/{total}\");\r\n  220                 if response.status() != StatusCode::PARTIAL_CONTENT\r\n  221                     || response\r\n  222                         .headers()\r\n  223                         .get(CONTENT_RANGE)\r\n  224                         .and_then(|h| h.to_str().ok())\r\n  225                         != Some(expected.as_str())\r\n  226                     || response.content_length().is_some_and(|n| n != len - done)\r\n  227                 {\r\n  228                     return Err(format!(\"Invalid Range response for segment {index}\").into());\r\n  229                 }\r\n  230                 file.seek(std::io::SeekFrom::Start(start)).await?;\r\n  231                 while let Some(chunk) = response.chunk().await? {\r\n  232                     self.check_cancel()?;\r\n  233                     if chunk.len() as u64 > len - done {\r\n  234                         return Err(format!(\"Segment {index} exceeds its expected size\").into());\r\n  235                     }\r\n  236                     file.write_all(&chunk).await?;\r\n  237                     done += chunk.len() as u64;\r\n  238                     self.emit(chunk.len() as u64, false);\r\n  239                     if done - saved >= RESUME_CHECKPOINT_BYTES && done < len {\r\n  240                         self.checkpoint(&mut file, index, done).await?;\r\n  241                         saved = done;\r\n  242                     }\r\n  243                 }\r\n  244                 if done != len {\r\n  245                     return Err(format!(\"Incomplete segment {index}: {done}/{len} bytes\").into());\r\n  246                 }\r\n  247                 self.checkpoint(&mut file, index, done).await\r\n  248             }\r\n  249             .await;\r\n  250             if result.is_ok() || done == len || attempt + 1 == MAX_RETRIES {\r\n  251                 return result;\r\n  252             }\r\n  253             self.check_cancel()?;\r\n  254             tokio::time::sleep(Duration::from_millis(500 * (attempt as u64 + 1))).await;\r\n  255         }\r\n  256         unreachable!()\r\n  257     }\r\n  258 \r\n  259     async fn single(&self, mut response: Response) -> TransferResult<()> {\r\n  260         self.check_cancel()?;\r\n  261         for suffix in [\"download.json\", \"download.state\"] {\r\n  262             match fs::remove_file(sidecar_path(&self.info.destination, suffix)).await {\r\n  263                 Err(e) if e.kind() != std::io::ErrorKind::NotFound => return Err(e.into()),\r\n  264                 _ => {}\r\n  265             }\r\n  266         }\r\n  267         let mut file = File::create(&self.part).await?;\r\n  268         while let Some(chunk) = response.chunk().await? {\r\n  269             self.check_cancel()?;\r\n  270             file.write_all(&chunk).await?;\r\n  271             self.emit(chunk.len() as u64, false);\r\n  272         }\r\n  273         self.check_cancel()?;\r\n  274         file.flush().await?;\r\n  275         Ok(())\r\n  276     }\r\n  277 }\r\n  278 \r\n  279 /// `Ok(Some(path))` means success, `Ok(None)` cancellation, and `Err` failure.\r\n  280 /// Segmented downloads retain sidecars on cancellation or failure for later resume.\r\n  281 pub async fn download<F>(\r\n  282     request_info: DownloadRequest,\r\n  283     cancel: Arc<AtomicBool>,\r\n  284     on_progress: F,\r\n  285 ) -> Result<Option<PathBuf>, String>\r\n  286 where\r\n  287     F: Fn(DownloadProgress) + Send + Sync + 'static,\r\n  288 {\r\n  289     let result: TransferResult<PathBuf> = async {\r\n  290         let client = Client::builder()\r\n  291             .connect_timeout(Duration::from_secs(20))\r\n  292             .redirect(reqwest::redirect::Policy::limited(10))\r\n  293             .referer(false)\r\n  294             .user_agent(USER_AGENT)\r\n  295             .build()?;\r\n  296         let probe = request(&client, &request_info)\r\n  297             .header(RANGE, \"bytes=0-0\")\r\n  298             .send()\r\n  299             .await?\r\n  300             .error_for_status()?;\r\n  301         let range_total = if probe.status() == StatusCode::PARTIAL_CONTENT {\r\n  302             probe\r\n  303                 .headers()\r\n  304                 .get(CONTENT_RANGE)\r\n  305                 .and_then(|v| v.to_str().ok())\r\n  306                 .and_then(parse_content_range)\r\n  307         } else {\r\n  308             None\r\n  309         };\r\n  310         let mut total = if probe.status() == StatusCode::PARTIAL_CONTENT {\r\n  311             range_total\r\n  312         } else {\r\n  313             probe.content_length()\r\n  314         };\r\n  315         drop(probe);\r\n  316         let [part, meta, state_path] = [\"download\", \"download.json\", \"download.state\"]\r\n  317             .map(|suffix| sidecar_path(&request_info.destination, suffix));\r\n  318         let mut response = None;\r\n  319         let mut offsets = Vec::new();\r\n  320         let state = if let Some(total) = range_total {\r\n  321             let count = total.min((CONNECTIONS * SEGMENTS_PER_CONNECTION) as u64) as usize;\r\n  322             offsets = prepare_resume(&part, &meta, &state_path, total, count).await?;\r\n  323             Some(tokio::sync::Mutex::new(\r\n  324                 OpenOptions::new()\r\n  325                     .write(true)\r\n  326                     .create(true)\r\n  327                     .truncate(false)\r\n  328                     .open(&state_path)\r\n  329                     .await?,\r\n  330             ))\r\n  331         } else {\r\n  332             let body = request(&client, &request_info)\r\n  333                 .send()\r\n  334                 .await?\r\n  335                 .error_for_status()?;\r\n  336             total = body.content_length().or(total);\r\n  337             response = Some(body);\r\n  338             None\r\n  339         };\r\n  340         let transfer = Arc::new(Transfer {\r\n  341             client,\r\n  342             info: request_info,\r\n  343             part,\r\n  344             cancel,\r\n  345             state,\r\n  346             progress: Mutex::new((\r\n  347                 DownloadProgress {\r\n  348                     received: offsets.iter().sum(),\r\n  349                     total,\r\n  350                     mode: if range_total.is_some() {\r\n  351                         DownloadMode::Segmented\r\n  352                     } else {\r\n  353                         DownloadMode::Single\r\n  354                     },\r\n  355                 },\r\n  356                 Instant::now(),\r\n  357             )),\r\n  358             callback: Box::new(on_progress),\r\n  359             offsets,\r\n  360         });\r\n  361         transfer.emit(0, true);\r\n  362         if let Some(total) = range_total {\r\n  363             let mut next = 0;\r\n  364             let mut workers = JoinSet::new();\r\n  365             loop {\r\n  366                 while workers.len() < CONNECTIONS && next < transfer.offsets.len() {\r\n  367                     let transfer = transfer.clone();\r\n  368                     let index = next;\r\n  369                     workers.spawn(async move { transfer.segment(total, index).await });\r\n  370                     next += 1;\r\n  371                 }\r\n  372                 let Some(result) = workers.join_next().await else {\r\n  373                     break;\r\n  374                 };\r\n  375                 if let Err(e) = result.map_err(Into::into).and_then(|r| r) {\r\n  376                     workers.abort_all();\r\n  377                     while workers.join_next().await.is_some() {}\r\n  378                     return Err(e);\r\n  379                 }\r\n  380             }\r\n  381         } else {\r\n  382             transfer.single(response.unwrap()).await?;\r\n  383         }\r\n  384         transfer.emit(0, true);\r\n  385         transfer.check_cancel()?;\r\n  386         let destination = transfer.info.destination.clone();\r\n  387         let part = transfer.part.clone();\r\n  388         drop(transfer);\r\n  389         fs::rename(part, &destination).await?;\r\n  390         let _ = fs::remove_file(meta).await;\r\n  391         let _ = fs::remove_file(state_path).await;\r\n  392         Ok(destination)\r\n  393     }\r\n  394     .await;\r\n  395     match result {\r\n  396         Ok(path) => Ok(Some(path)),\r\n  397         Err(e) if e.to_string() == CANCEL_SENTINEL => Ok(None),\r\n  398         Err(e) => Err(e.to_string()),\r\n  399     }\r\n  400 }\r\n  401 \r\n  402 #[cfg(test)]\r\n  403 mod tests {\r\n  404     use super::*;\r\n  405     use std::io::{Read, Write};\r\n  406     use std::net::TcpListener;\r\n  407     use std::sync::atomic::AtomicUsize;\r\n  408 \r\n  409     fn spawn_test_server(\r\n  410         data: Vec<u8>,\r\n  411         supports_range: bool,\r\n  412         expected_requests: usize,\r\n  413     ) -> (String, Arc<AtomicUsize>, std::thread::JoinHandle<()>) {\r\n  414         let listener = TcpListener::bind(\"127.0.0.1:0\").unwrap();\r\n  415         let address = listener.local_addr().unwrap();\r\n  416         let requests = Arc::new(AtomicUsize::new(0));\r\n  417         let request_count = requests.clone();\r\n  418         let handle = std::thread::spawn(move || {\r\n  419             for stream in listener.incoming().take(expected_requests) {\r\n  420                 let mut stream = stream.unwrap();\r\n  421                 let mut buffer = vec![0u8; 8192];\r\n  422                 let size = stream.read(&mut buffer).unwrap();\r\n  423                 let headers = String::from_utf8_lossy(&buffer[..size]);\r\n  424                 request_count.fetch_add(1, Ordering::Relaxed);\r\n  425 \r\n  426                 let range = headers\r\n  427                     .lines()\r\n  428                     .find(|line| line.to_ascii_lowercase().starts_with(\"range: bytes=\"))\r\n  429                     .and_then(|line| line.split_once('=').map(|(_, value)| value.trim()))\r\n  430                     .and_then(|value| value.split_once('-'))\r\n  431                     .and_then(|(start, end)| {\r\n  432                         Some((start.parse::<usize>().ok()?, end.parse::<usize>().ok()?))\r\n  433                     });\r\n  434                 let (status, body, extra_header) = if supports_range {\r\n  435                     let (start, end) = range.unwrap();\r\n  436                     (\r\n  437                         \"206 Partial Content\",\r\n  438                         &data[start..=end],\r\n  439                         format!(\"Content-Range: bytes {start}-{end}/{}\\r\\n\", data.len()),\r\n  440                     )\r\n  441                 } else {\r\n  442                     (\"200 OK\", data.as_slice(), String::new())\r\n  443                 };\r\n  444                 write!(\r\n  445                     stream,\r\n  446                     \"HTTP/1.1 {status}\\r\\nContent-Length: {}\\r\\n{extra_header}\\\r\n  447                      Connection: close\\r\\n\\r\\n\",\r\n  448                     body.len()\r\n  449                 )\r\n  450                 .unwrap();\r\n  451                 stream.write_all(body).unwrap();\r\n  452             }\r\n  453         });\r\n  454         (format!(\"http://{address}/file.bin\"), requests, handle)\r\n  455     }\r\n  456 \r\n  457     fn no_cancel() -> Arc<AtomicBool> {\r\n  458         Arc::new(AtomicBool::new(false))\r\n  459     }\r\n  460 \r\n  461     fn test_runtime() -> tokio::runtime::Runtime {\r\n  462         tokio::runtime::Builder::new_multi_thread()\r\n  463             .worker_threads(4)\r\n  464             .enable_all()\r\n  465             .build()\r\n  466             .unwrap()\r\n  467     }\r\n  468 \r\n  469     fn unique_test_dir(tag: &str) -> PathBuf {\r\n  470         let dir = std::env::temp_dir().join(format!(\r\n  471             \"vnlib-segmented-{tag}-{}-{}\",\r\n  472             std::process::id(),\r\n  473             std::time::SystemTime::now()\r\n  474                 .duration_since(std::time::UNIX_EPOCH)\r\n  475                 .unwrap()\r\n  476                 .as_nanos()\r\n  477         ));\r\n  478         std::fs::create_dir_all(&dir).unwrap();\r\n  479         dir\r\n  480     }\r\n  481 \r\n  482     #[test]\r\n  483     fn parses_content_range_total() {\r\n  484         assert_eq!(\r\n  485             parse_content_range(\"bytes 0-0/4722087959\"),\r\n  486             Some(4_722_087_959)\r\n  487         );\r\n  488         assert_eq!(parse_content_range(\"bytes 0-0/*\"), None);\r\n  489         assert_eq!(parse_content_range(\"invalid\"), None);\r\n  490     }\r\n  491 \r\n  492     #[test]\r\n  493     fn resume_offset_rejects_corrupt_over_length_value() {\r\n  494         assert_eq!(valid_resume_offset(0, 10), 0);\r\n  495         assert_eq!(valid_resume_offset(5, 10), 5);\r\n  496         assert_eq!(valid_resume_offset(10, 10), 10); // ��Ȯ�� �Ϸ�� ��ȿ\r\n  497         assert_eq!(valid_resume_offset(11, 10), 0); // ���� �ʰ� = �ջ� �� ��ٿ�ε�\r\n  498         assert_eq!(valid_resume_offset(u64::MAX, 10), 0);\r\n  499     }\r\n  500 \r\n  501     #[test]\r\n  502     fn segment_bounds_cover_file_without_overlap() {\r\n  503         let total = 101;\r\n  504         let count = 16;\r\n  505         let mut next = 0;\r\n  506         for index in 0..count {\r\n  507             let (start, end) = segment_bounds(total, count, index);\r\n  508             assert_eq!(start, next);\r\n  509             assert!(end >= start);\r\n  510             next = end + 1;\r\n  511         }\r\n  512         assert_eq!(next, total);\r\n  513     }\r\n  514 \r\n  515     #[test]\r\n  516     fn range_server_is_downloaded_in_parallel_without_corruption() {\r\n  517         let data: Vec<u8> = (0..65_537).map(|i| (i % 251) as u8).collect();\r\n  518         let expected_requests = 1 + CONNECTIONS * SEGMENTS_PER_CONNECTION;\r\n  519         let (url, requests, server) = spawn_test_server(data.clone(), true, expected_requests);\r\n  520         let dir = unique_test_dir(\"range\");\r\n  521         let destination = dir.join(\"range.bin\");\r\n  522 \r\n  523         let result = test_runtime().block_on(download(\r\n  524             DownloadRequest {\r\n  525                 url,\r\n  526                 destination: destination.clone(),\r\n  527                 cookie_header: None,\r\n  528                 referer: None,\r\n  529             },\r\n  530             no_cancel(),\r\n  531             |_| {},\r\n  532         ));\r\n  533 \r\n  534         assert_eq!(result.unwrap(), Some(destination.clone()));\r\